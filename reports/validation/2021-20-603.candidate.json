              "ev-0d9bd5ffa502-0000-0004"
            ],
            "pages": {
              "end": 2,
              "start": 2
            }
          }
        ],
        "text": "The Supreme Court granted certiorari to decide whether USERRA\u2019s damages remedy against state employers is constitutional."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "0d9bd5ffa502bd21f5b05f50079d412e2fc00deb624222da935825c2ec2ba7fb",
            "evidence_ids": [
              "ev-0d9bd5ffa502-0001-0000"
            ],
            "pages": {
              "end": 20,
              "start": 20
            }
          }
        ],
        "text": "The Court held that a waiver under the Convention plan displaces state sovereign immunity, allowing suits against states for USERRA damages."
      }
    ],
