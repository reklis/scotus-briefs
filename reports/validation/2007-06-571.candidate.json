                "start": 3
              }
            }
          ],
          "text": "According to Petitioner, receipt of a firearm is not \u201cuse\u201d because the plain meaning of \u201cuse\u201d does not include merely receiving an item."
        },
        {
          "attribution": "Petitioner",
          "citations": [
            {
              "document_hash": "eff1f73fbf70d37f69a699155e1e416cb7820f54c7a7a0e00cefa7bc130e9e77",
              "evidence_ids": [
                "ev-eff1f73fbf70-0000-0004"
              ],
              "pages": {
                "end": 7,
                "start": 7
              }
            }
          ],
          "text": "According to Petitioner, the buyer\u2019s conduct presents a different type of risk than the seller\u2019s, suggesting a distinction in culpability."
        },
        {
          "attribution": "MR. KOCH",
          "citations": [
            {
              "document_hash": "eff1f73fbf70d37f69a699155e1e416cb7820f54c7a7a0e00cefa7bc130e9e77",
              "evidence_ids": [
