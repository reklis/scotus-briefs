{
  "background_and_question": {
    "claims": [
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "ed40ef933c84dc7711bb4329fc16f9eb5d364590e17b6842b44f42a142a6a6d0",
            "evidence_ids": [
              "ev-ed40ef933c84-0000-0000"
            ],
            "pages": {
              "end": 2,
              "start": 2
            }
          }
        ],
        "text": "The Internal Revenue Service has the power to issue summonses to pursue unpaid federal taxes and the people who owe them."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "ed40ef933c84dc7711bb4329fc16f9eb5d364590e17b6842b44f42a142a6a6d0",
            "evidence_ids": [
              "ev-ed40ef933c84-0000-0002"
            ],
            "pages": {
              "end": 2,
              "start": 2
            }
          }
        ],
        "text": "When a summons is issued \u201cin aid of the collection of an assessment \u2026 against the person with respect to whose liability the summons is issued,\u201d notice is not required."
      },
      {
        "attribution": "District Court",
        "citations": [
          {
            "document_hash": "ed40ef933c84dc7711bb4329fc16f9eb5d364590e17b6842b44f42a142a6a6d0",
            "evidence_ids": [
              "ev-ed40ef933c84-0000-0003"
            ],
            "pages": {
              "end": 2,
              "start": 2
            }
          }
        ],
        "text": "The District Court concluded that, under this exception, petitioners could not bring a motion to quash."
      }
    ],
    "heading": "Background",
    "status": "complete",
    "summary": null,
    "summary_citations": []
  },
  "case_id": "2022-21-1599",
  "decision": {
    "claims": [
      {
        "attribution": "Justice Jackson",
        "citations": [
          {
            "document_hash": "ed40ef933c84dc7711bb4329fc16f9eb5d364590e17b6842b44f42a142a6a6d0",
            "evidence_ids": [
              "ev-ed40ef933c84-0001-0003"
            ],
            "pages": {
              "end": 15,
              "start": 15
            }
          }
        ],
        "text": "According to Justice Jackson, the Court holds that there is no \u201clegal interest\u201d limitation on the IRS\u2019s power to summon records without notice under \u00a7\u202f7609(c)(2)(D)(i)."
      },
      {
        "attribution": "Justice Roberts",
        "citations": [
          {
            "document_hash": "ed40ef933c84dc7711bb4329fc16f9eb5d364590e17b6842b44f42a142a6a6d0",
            "evidence_ids": [
              "ev-ed40ef933c84-0000-0009"
            ],
            "pages": {
              "end": 7,
              "start": 7
            }
          }
        ],
        "text": "Justice Roberts, dissenting, argues that the statutory context requires a narrower construction of the notice exemption."
      }
    ],
