              "start": 46
            }
          }
        ],
        "text": "Justice Jackson asked about the argument that the subsection did not apply in the law\u2011firm situation."
      },
      {
        "attribution": "Justice Gorsuch",
        "citations": [
          {
            "document_hash": "9c05bb2b17b6cf0f27e8880766a1511340c32b0cd7e56b536f2681ba5fc847b3",
