  "overview": {
    "claims": [
      {
        "attribution": "McConnell Plaintiffs",
        "citations": [
          {
            "document_hash": "4c15a57010477a1c4ed30be79b8f455800660f89858b2bf792c2714ebac23328",
            "evidence_ids": [
              "ev-4c15a5701047-0000-0000"
            ],
            "pages": {
              "end": 5,
              "start": 4
            }
          }
        ],
        "text": "According to McConnell Plaintiffs, the petitioners argue that Title\u202fI of the Bipartisan Campaign Reform Act intrudes deeply into the political life of the nation and diminishes speech and associational activity of parties, which lie at the core of the First Amendment."
      },
      {
        "attribution": "Government",
        "citations": [
          {
            "document_hash": "4c15a57010477a1c4ed30be79b8f455800660f89858b2bf792c2714ebac23328",
            "evidence_ids": [
              "ev-4c15a5701047-0001-0001"
            ],
            "pages": {
              "end": 32,
              "start": 32
            }
          }
        ],
        "text": "The government contends that the statute must be narrowly tailored but is closely drawn to pursue a federal interest."
      },
      {
        "attribution": "Government",
        "citations": [
          {
            "document_hash": "4c15a57010477a1c4ed30be79b8f455800660f89858b2bf792c2714ebac23328",
            "evidence_ids": [
              "ev-4c15a5701047-0001-0002"
            ],
            "pages": {
              "end": 33,
              "start": 33
            }
          }
        ],
        "text": "The government also says that national parties are constrained by federal statute in activities relating to state and local elections."
      },
      {
        "attribution": "Solicitor General",
        "citations": [
          {
            "document_hash": "4c15a57010477a1c4ed30be79b8f455800660f89858b2bf792c2714ebac23328",
            "evidence_ids": [
              "ev-4c15a5701047-0001-0000"
            ],
            "pages": {
              "end": 21,
              "start": 21
            }
          }
        ],
        "text": "The Solicitor General argues that every state election has an effect on federal elections, leaving the states no room to legislate on their own elections."
      },
      {
        "attribution": "Republican National Committee",
        "citations": [
          {
            "document_hash": "4c15a57010477a1c4ed30be79b8f455800660f89858b2bf792c2714ebac23328",
            "evidence_ids": [
              "ev-4c15a5701047-0003-0001"
            ],
            "pages": {
              "end": 70,
              "start": 70
            }
          }
        ],
        "text": "The Republican National Committee brief claims that the Republican Party is a single unitary organization."
      },
      {
        "attribution": "Seth P. Waxman",
        "citations": [
          {
            "document_hash": "4c15a57010477a1c4ed30be79b8f455800660f89858b2bf792c2714ebac23328",
            "evidence_ids": [
              "ev-4c15a5701047-0004-0003"
            ],
            "pages": {
              "end": 84,
              "start": 84
            }
          }
        ],
        "text": "According to Seth P. Waxman, amicus counsel Seth\u202fWaxman says the issues raise the most fundamental challenge for any representative democracy."
      },
      {
        "attribution": "Senator Rudman",
        "citations": [
          {
            "document_hash": "4c15a57010477a1c4ed30be79b8f455800660f89858b2bf792c2714ebac23328",
            "evidence_ids": [
              "ev-4c15a5701047-0004-0002"
            ],
            "pages": {
              "end": 85,
              "start": 85
            }
          }
        ],
        "text": "According to Senator Rudman, senator Rudman testified that large soft\u2011money contributions distort the legislative process by influencing which members of Congress receive attention and input."
      },
      {
        "attribution": "Minor Plaintiffs",
        "citations": [
          {
            "document_hash": "4c15a57010477a1c4ed30be79b8f455800660f89858b2bf792c2714ebac23328",
            "evidence_ids": [
              "ev-4c15a5701047-0007-0004"
            ],
            "pages": {
              "end": 150,
              "start": 150
            }
          }
        ],
        "text": "Minor plaintiffs argue that Section\u202f318, which bans contributions by minors, is unconstitutional because it is a ban rather than a limitation and lacks symbolic or associational speech protection."
      }
    ],
