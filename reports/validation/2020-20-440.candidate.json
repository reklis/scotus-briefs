              "end": 6,
              "start": 6
            }
          }
        ],
        "text": "The majority held that assignor estoppel remains a valid doctrine and should not be discarded."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "5a65e28396b2a936381123d98771ee5175e298b36196be235eda02d6f7ad895b",
