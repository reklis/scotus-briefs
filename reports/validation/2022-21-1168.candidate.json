              "evidence_ids": [
                "ev-17c21e7f79a0-0000-0006"
              ],
              "pages": {
                "end": 22,
                "start": 22
              }
            }
          ],
          "text": "According to Ashley C. Keller, Keller testified that consent\u2011by\u2011registration statutes have existed since the 1820s, showing historical support for the doctrine."
        }
      ],
