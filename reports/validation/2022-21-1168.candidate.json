              "ev-5149e9957088-0000-0002"
            ],
            "pages": {
              "end": 7,
              "start": 7
            }
          }
        ],
        "text": "According to Mallory, the central issue is whether Norfolk Southern consented to Pennsylvania jurisdiction by registering to do business in the state."
      },
      {
        "attribution": "Justice Thomas",
        "citations": [
          {
            "document_hash": "17c21e7f79a06e3278d9174eccc41e891f7dcabb21978c156178e9e3dfaf0e58",
            "evidence_ids": [
              "ev-17c21e7f79a0-0000-0004"
            ],
            "pages": {
              "end": 6,
              "start": 6
            }
          }
        ],
        "text": "Justice Thomas asked how many states have statutes similar to Pennsylvania\u2019s and how to know when there is enough history to support the petitioner\u2019s position."
      },
      {
        "attribution": "Justice Gorsuch",
        "citations": [
          {
            "document_hash": "17c21e7f79a06e3278d9174eccc41e891f7dcabb21978c156178e9e3dfaf0e58",
            "evidence_ids": [
              "ev-17c21e7f79a0-0001-0001"
            ],
            "pages": {
              "end": 24,
              "start": 24
            }
          }
        ],
        "text": "Justice Gorsuch asked why the Court should distinguish between the two approaches and whether the distinction is relevant."
      },
      {
        "attribution": "Justice Kagan",
        "citations": [
          {
            "document_hash": "17c21e7f79a06e3278d9174eccc41e891f7dcabb21978c156178e9e3dfaf0e58",
            "evidence_ids": [
              "ev-17c21e7f79a0-0001-0002"
            ],
            "pages": {
              "end": 25,
              "start": 25
            }
          }
        ],
        "text": "Justice Kagan asked whether there is a pre\u2011existing right, a pre\u2011waiver, that the petitioner is asserting."
      },
      {
        "attribution": "Justice Kavanaugh",
        "citations": [
          {
            "document_hash": "17c21e7f79a06e3278d9174eccc41e891f7dcabb21978c156178e9e3dfaf0e58",
            "evidence_ids": [
              "ev-17c21e7f79a0-0002-0009"
            ],
            "pages": {
              "end": 48,
              "start": 48
            }
          }
        ],
        "text": "Justice Kavanaugh asked whether only Pennsylvania has a statute like the one at issue."
      },
      {
        "attribution": "Justice Sotomayor",
        "citations": [
          {
            "document_hash": "17c21e7f79a06e3278d9174eccc41e891f7dcabb21978c156178e9e3dfaf0e58",
            "evidence_ids": [
              "ev-17c21e7f79a0-0003-0001"
            ],
            "pages": {
              "end": 71,
              "start": 71
            }
          }
        ],
        "text": "Justice Sotomayor asked whether historical case law permits consent\u2011by\u2011registration for cases arising from doing business in the state."
      }
    ],
