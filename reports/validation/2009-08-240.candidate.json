            }
          },
          {
            "document_hash": "3ac3c5524336d6f6faaa187ad300efe6dd5fa95ea0d429dab75de6c252c57462",
            "evidence_ids": [
              "ev-3ac3c5524336-0002-0004"
            ],
            "pages": {
              "end": 49,
              "start": 48
            }
          }
        ],
        "text": "Dealers argue that injunctive relief is not a prerequisite for a claim under the PMPA."
      }
    ],
