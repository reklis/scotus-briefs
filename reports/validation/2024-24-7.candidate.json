              ],
              "pages": {
                "end": 65,
                "start": 65
              }
            }
          ],
          "text": "Petitioners say their declarations about remedy are conclusory and do not substantively demonstrate redressability."
        },
        {
          "attribution": "Petitioners",
          "citations": [
            {
              "document_hash": "05f2a4cd4aa661bb34fc5eed40dbcedbaee6f16ba85e0d323d6e65ffb6ea0a0d",
