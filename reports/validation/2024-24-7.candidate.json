              "pages": {
                "end": 67,
                "start": 67
              }
            }
          ],
          "text": "Petitioners claim the waiver is not needed because the 2019 rescission was struck down and the waiver makes no difference now."
        },
        {
          "attribution": "Petitioners",
          "citations": [
            {
              "document_hash": "05f2a4cd4aa661bb34fc5eed40dbcedbaee6f16ba85e0d323d6e65ffb6ea0a0d",
