              "ev-5ea82670f14b-0000-0001"
            ],
            "pages": {
              "end": 3,
              "start": 3
            }
          }
        ],
        "text": "The South Florida Water Management District contends that its pumps do not add pollutants to navigable waters, and therefore a Section\u202f402 permit is unnecessary."
      },
      {
        "attribution": "Tribe",
        "citations": [
          {
            "document_hash": "5ea82670f14b4829bdaaf4f108a4b8f9608958db13e10b2347d7790885064d3a",
