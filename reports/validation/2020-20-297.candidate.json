{
  "background_and_question": {
    "claims": [
      {
        "attribution": "Plaintiffs",
        "citations": [
          {
            "document_hash": "999fb878304c48611e3eebbbabd9f9eca746849fd296c5a12a59e1f9609824b6",
            "evidence_ids": [
              "ev-999fb878304c-0000-0000"
            ],
            "pages": {
              "end": 2,
              "start": 2
            }
          }
        ],
        "text": "According to Plaintiffs, a class of 8,185 individuals with OFAC alerts in their credit files sued TransUnion under the Fair Credit Reporting Act for failing to use reasonable procedures to ensure the accuracy of their credit files."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "999fb878304c48611e3eebbbabd9f9eca746849fd296c5a12a59e1f9609824b6",
            "evidence_ids": [
              "ev-999fb878304c-0001-0000"
            ],
            "pages": {
              "end": 11,
              "start": 11
            }
          }
        ],
        "text": "The District Court rejected all of TransUnion's post\u2011trial motions and awarded more than $60\u202fmillion."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "999fb878304c48611e3eebbbabd9f9eca746849fd296c5a12a59e1f9609824b6",
            "evidence_ids": [
              "ev-999fb878304c-0001-0002"
            ],
            "pages": {
              "end": 11,
              "start": 11
            }
          }
        ],
        "text": "The Supreme Court asked whether the 8,185 class members have Article\u202fIII standing for their three claims."
      }
    ],
    "heading": "Background and Question",
    "status": "complete",
    "summary": null,
    "summary_citations": []
  },
  "case_id": "2020-20-297",
  "decision": {
    "claims": [
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "999fb878304c48611e3eebbbabd9f9eca746849fd296c5a12a59e1f9609824b6",
            "evidence_ids": [
              "ev-999fb878304c-0001-0003"
            ],
            "pages": {
              "end": 13,
              "start": 13
            }
          }
        ],
        "text": "The Court held that under Article\u202fIII, a federal court may resolve only a real controversy with real impact on real persons."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "999fb878304c48611e3eebbbabd9f9eca746849fd296c5a12a59e1f9609824b6",
            "evidence_ids": [
              "ev-999fb878304c-0001-0005"
            ],
            "pages": {
              "end": 16,
              "start": 16
            }
          }
        ],
        "text": "The Court held that an injury in law is not an injury in fact."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "999fb878304c48611e3eebbbabd9f9eca746849fd296c5a12a59e1f9609824b6",
            "evidence_ids": [
              "ev-999fb878304c-0001-0007"
            ],
            "pages": {
              "end": 20,
              "start": 20
            }
          }
        ],
        "text": "The Court held that every class member must have Article\u202fIII standing to recover individual damages."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "999fb878304c48611e3eebbbabd9f9eca746849fd296c5a12a59e1f9609824b6",
            "evidence_ids": [
              "ev-999fb878304c-0002-0001"
            ],
            "pages": {
              "end": 21,
              "start": 21
            }
          }
        ],
        "text": "The Court concluded that 1,853 class members suffered a concrete harm qualifying as an injury in fact."
      },
      {
        "attribution": "Justice Thomas",
        "citations": [
          {
            "document_hash": "999fb878304c48611e3eebbbabd9f9eca746849fd296c5a12a59e1f9609824b6",
            "evidence_ids": [
              "ev-999fb878304c-0004-0001"
            ],
            "pages": {
              "end": 43,
              "start": 43
            }
          }
        ],
        "text": "Justice Thomas dissented, arguing that the majority\u2019s view improperly limits courts\u2019 ability to assess harms and that legislatures can create enforceable rights beyond common\u2011law roots."
      },
      {
        "attribution": "Justice Thomas",
        "citations": [
          {
            "document_hash": "999fb878304c48611e3eebbbabd9f9eca746849fd296c5a12a59e1f9609824b6",
            "evidence_ids": [
              "ev-999fb878304c-0004-0002"
            ],
            "pages": {
              "end": 44,
              "start": 44
            }
          }
        ],
        "text": "According to Justice Thomas (dissent), the plaintiffs only alleged receiving information in the wrong format, not a failure to receive required information."
      },
      {
        "attribution": "Justice Thomas",
        "citations": [
          {
            "document_hash": "999fb878304c48611e3eebbbabd9f9eca746849fd296c5a12a59e1f9609824b6",
            "evidence_ids": [
              "ev-999fb878304c-0004-0003"
            ],
            "pages": {
              "end": 45,
              "start": 45
            }
          }
        ],
        "text": "According to Justice Thomas (dissent), the plaintiffs did not receive the OFAC credit reports they requested."
      },
      {
        "attribution": "Justice Kagan",
        "citations": [
          {
            "document_hash": "999fb878304c48611e3eebbbabd9f9eca746849fd296c5a12a59e1f9609824b6",
            "evidence_ids": [
              "ev-999fb878304c-0004-0007"
            ],
            "pages": {
              "end": 49,
              "start": 49
            }
          }
        ],
        "text": "Justice Kagan (dissent) argued that many parties\u2014including Congress, the President, juries, and courts\u2014recognize injury from incomplete or misleading credit reports."
      },
      {
        "attribution": "Justice Kagan",
        "citations": [
          {
            "document_hash": "999fb878304c48611e3eebbbabd9f9eca746849fd296c5a12a59e1f9609824b6",
            "evidence_ids": [
              "ev-999fb878304c-0004-0009"
            ],
            "pages": {
              "end": 51,
              "start": 51
            }
          }
        ],
        "text": "According to Justice Kagan (dissent), nearly 25\u202f% of the class already had false reports sent to potential creditors."
      }
    ],
