              ],
              "pages": {
                "end": 4,
                "start": 4
              }
            }
          ],
          "text": "TransUnion contends that the mere risk of future harm, without more, cannot constitute concrete harm in a damages suit."
        },
        {
          "attribution": "TransUnion",
          "citations": [
            {
              "document_hash": "999fb878304c48611e3eebbbabd9f9eca746849fd296c5a12a59e1f9609824b6",
              "evidence_ids": [
