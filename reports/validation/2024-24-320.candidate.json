  "oral_argument": {
    "claims": [
      {
        "attribution": "Justice Thomas",
        "citations": [
          {
            "document_hash": "5562cf6cd09385c8179644f828094b21cf14dc1ee9ff727ba7615e3bc90b02d5",
            "evidence_ids": [
              "ev-5562cf6cd093-0000-0002"
            ],
            "pages": {
              "end": 6,
              "start": 6
            }
          }
        ],
        "text": "Justice Thomas asked whether agreeing with the petitioner would open the door to many other statutes that could confer settlement authority."
      },
      {
        "attribution": "Justice GORSUCH",
        "citations": [
          {
            "document_hash": "5562cf6cd09385c8179644f828094b21cf14dc1ee9ff727ba7615e3bc90b02d5",
            "evidence_ids": [
              "ev-5562cf6cd093-0001-0000"
            ],
            "pages": {
              "end": 24,
              "start": 24
            }
          }
        ],
        "text": "Justice Gorsuch asked who performs the offsets under the statute and how they are accounted for."
      },
      {
        "attribution": "Justice SOTOMAYOR",
        "citations": [
          {
            "document_hash": "5562cf6cd09385c8179644f828094b21cf14dc1ee9ff727ba7615e3bc90b02d5",
            "evidence_ids": [
              "ev-5562cf6cd093-0001-0002"
            ],
            "pages": {
              "end": 26,
              "start": 26
            }
          }
        ],
        "text": "Justice Sotomayor asked whether all of the offsets have been imposed by regulatory direction."
      },
      {
        "attribution": "Justice JACKSON",
        "citations": [
          {
            "document_hash": "5562cf6cd09385c8179644f828094b21cf14dc1ee9ff727ba7615e3bc90b02d5",
            "evidence_ids": [
              "ev-5562cf6cd093-0001-0004"
            ],
            "pages": {
              "end": 27,
              "start": 27
            }
          }
        ],
        "text": "Justice Jackson asked whether the six\u2011year statute of limitations in the Barring Act accrues from the filing date or works backwards from the applicant\u2019s submission."
      },
      {
        "attribution": "Justice SOTOMAYOR",
        "citations": [
          {
            "document_hash": "5562cf6cd09385c8179644f828094b21cf14dc1ee9ff727ba7615e3bc90b02d5",
            "evidence_ids": [
              "ev-5562cf6cd093-0001-0006"
            ],
            "pages": {
              "end": 28,
              "start": 28
            }
          }
        ],
        "text": "Justice Sotomayor clarified that a claimant cannot begin the application process until a VA rating has been obtained."
      },
      {
        "attribution": "Justice ALITO",
        "citations": [
          {
            "document_hash": "5562cf6cd09385c8179644f828094b21cf14dc1ee9ff727ba7615e3bc90b02d5",
            "evidence_ids": [
              "ev-5562cf6cd093-0001-0008"
            ],
            "pages": {
              "end": 31,
              "start": 31
            }
          }
        ],
        "text": "According to Justice ALITO, justice Alito questioned whether Congress intended the entire statutory span to be covered."
      },
      {
        "attribution": "Chief Justice Roberts",
        "citations": [
          {
            "document_hash": "5562cf6cd09385c8179644f828094b21cf14dc1ee9ff727ba7615e3bc90b02d5",
            "evidence_ids": [
              "ev-5562cf6cd093-0002-0000"
            ],
            "pages": {
              "end": 47,
              "start": 47
            }
          }
        ],
        "text": "Chief Justice Roberts asked what broader concerns the counsel had beyond the specific statute, noting the eligibility requirements for benefits."
      },
      {
        "attribution": "Justice Gorsuch",
        "citations": [
          {
            "document_hash": "5562cf6cd09385c8179644f828094b21cf14dc1ee9ff727ba7615e3bc90b02d5",
            "evidence_ids": [
              "ev-5562cf6cd093-0002-0002"
            ],
            "pages": {
              "end": 50,
              "start": 50
            }
          }
        ],
        "text": "Justice Gorsuch asked whether each of the six statutes contains a limitations period or some lack them."
      },
      {
        "attribution": "Justice Gorsuch",
        "citations": [
          {
            "document_hash": "5562cf6cd09385c8179644f828094b21cf14dc1ee9ff727ba7615e3bc90b02d5",
            "evidence_ids": [
