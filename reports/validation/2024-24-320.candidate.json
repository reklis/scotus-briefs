        ],
        "text": "According to Justice Barrett, justice Barrett addressed Ms. Flynn before proceeding."
      },
      {
        "attribution": "Justice Alito",
        "citations": [
          {
            "document_hash": "5562cf6cd09385c8179644f828094b21cf14dc1ee9ff727ba7615e3bc90b02d5",
            "evidence_ids": [
