  "case_id": "2021-21-5592",
  "decision": {
    "claims": [
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "b41787594986dab5f455267fa334f36b29b34b654ed3e781019755cfecb6548f",
            "evidence_ids": [
              "ev-b41787594986-0002-0002"
            ],
            "pages": {
              "end": 24,
              "start": 24
            }
          }
        ],
        "text": "The Court concluded that Ramirez is likely to prevail on his claim that Texas\u2019s categorical ban on religious touch in the execution chamber is inconsistent with his rights under RLUIPA."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "b41787594986dab5f455267fa334f36b29b34b654ed3e781019755cfecb6548f",
            "evidence_ids": [
              "ev-b41787594986-0001-0002"
            ],
            "pages": {
              "end": 20,
              "start": 20
            }
          }
        ],
        "text": "The Court held that the State failed to show that a categorical ban on audible prayer was the least restrictive means of furthering its compelling interests."
      },
      {
        "attribution": "Justice Sotomayor",
        "citations": [
          {
            "document_hash": "b41787594986dab5f455267fa334f36b29b34b654ed3e781019755cfecb6548f",
            "evidence_ids": [
              "ev-b41787594986-0002-0003"
            ],
            "pages": {
              "end": 28,
              "start": 28
            }
          }
        ],
        "text": "Justice Sotomayor (concurring) wrote that the judgment of the Fifth Circuit is reversed and the case remanded for further proceedings consistent with this opinion."
      },
      {
        "attribution": "Justice Kavanaugh",
        "citations": [
          {
            "document_hash": "b41787594986dab5f455267fa334f36b29b34b654ed3e781019755cfecb6548f",
            "evidence_ids": [
              "ev-b41787594986-0002-0004"
            ],
            "pages": {
              "end": 30,
              "start": 30
            }
          }
        ],
        "text": "Justice Kavanaugh (concurring) noted that the prison failed to give Ramirez timely notice of its restrictions on a spiritual advisor\u2019s actions in the execution room."
      },
      {
        "attribution": "Justice Thomas",
        "citations": [
          {
            "document_hash": "b41787594986dab5f455267fa334f36b29b34b654ed3e781019755cfecb6548f",
            "evidence_ids": [
              "ev-b41787594986-0003-0004",
              "ev-b41787594986-0004-0000"
            ],
            "pages": {
              "end": 44,
              "start": 43
            }
          }
        ],
        "text": "Justice Thomas (dissent) argued that Ramirez\u2019s litigation was dilatory and that the State\u2019s interests justified denying equitable relief."
      }
    ],
