              "pages": {
                "end": 6,
                "start": 6
              }
            }
          ],
          "text": "The State claimed Ramirez\u2019s litigation was filed too late and too early, violating procedural requirements."
        },
        {
          "attribution": "SETH KRETZER",
          "citations": [
            {
              "document_hash": "373ffcc233747286c8c020c74339d6a7c5718e5547d844a4e4e02f8924231da8",
              "evidence_ids": [
                "ev-373ffcc23374-0000-0002"
