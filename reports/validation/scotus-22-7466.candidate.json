              "start": 3
            }
          }
        ],
        "text": "According to Glossip, Richard Glossip sought post\u2011conviction relief after the State disclosed previously withheld documents relating to witness Justin Sneed\u2019s credibility."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "a99f203c6818a16ec5f5c72763acf2806ba455bebef7dcaa81832f982cddcae1",
            "evidence_ids": [
              "ev-a99f203c6818-0000-0001"
            ],
            "pages": {
              "end": 7,
              "start": 7
            }
          }
        ],
        "text": "The Court was asked to decide whether the State\u2019s failure to correct Sneed\u2019s false testimony constituted a *Napue* violation that required reversal of the conviction."
      }
    ],
    "heading": "Background and Question Presented",
    "status": "complete",
    "summary": null,
