            ],
            "pages": {
              "end": 3,
              "start": 3
            }
          }
        ],
        "text": "According to Narda Pierce, Washington\u2019s constitution contains a Blaine\u2011type amendment that limits government involvement in religious activities and prohibits state funding of religious education."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "f51bd0a967d5db87348ec45d0e4eebd4ecf00c3b799bad037b6b99797a2a74a1",
            "evidence_ids": [
              "ev-f51bd0a967d5-0001-0003"
            ],
            "pages": {
              "end": 30,
              "start": 30
            }
          }
        ],
        "text": "The scholarship check is sent directly to the student, not the school, and may be used for any educational expense."
      }
