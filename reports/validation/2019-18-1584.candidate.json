            "evidence_ids": [
              "ev-98179207626d-0001-0002"
            ],
            "pages": {
              "end": 25,
              "start": 25
            }
          }
        ],
        "text": "Justices also raised questions about whether the trail is part of the National Park System and what harm might result from restricting the analysis to certain aspects of the case."
      }
    ],
