          },
          {
            "document_hash": "c15656ca357998e9232b0fc2c6fe94d84e70b8eaff2f28f962d302e2dfb6e44c",
            "evidence_ids": [
              "ev-c15656ca3579-0000-0001"
            ],
            "pages": {
              "end": 9,
              "start": 9
            }
          }
        ],
        "text": "The case involved a dispute over whether draft biological opinions prepared by the United States Fish and Wildlife Service were subject to disclosure under the Freedom of Information Act."
      },
      {
        "attribution": "Petitioners (United States Fish and Wildlife Service)",
        "citations": [
          {
            "document_hash": "c15656ca357998e9232b0fc2c6fe94d84e70b8eaff2f28f962d302e2dfb6e44c",
