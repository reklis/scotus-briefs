                "ev-ec48348a8e17-0003-0006"
              ],
              "pages": {
                "end": 55,
                "start": 55
              }
            }
          ],
          "text": "Ms. Millett says the ATF regulation includes foreign convictions in the definition."
        },
        {
          "attribution": "Government",
          "citations": [
