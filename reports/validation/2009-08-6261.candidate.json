            "pages": {
              "end": 60,
              "start": 60
            }
          }
        ],
        "text": "According to Justice Scalia, justice Scalia stated that he does not know any court has ever asserted that it itself has the power to prosecute."
      },
      {
        "attribution": "Justice Kennedy",
        "citations": [
          {
            "document_hash": "e25f15dd25d6f23945887dda358dcac24a8632ecf7a22dce8ce4d08742f73946",
            "evidence_ids": [
