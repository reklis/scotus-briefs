              "end": 5,
              "start": 5
            }
          }
        ],
        "text": "According to Justice Sotomayor, justice Sotomayor noted that plea agreements in the Southern District of New York bind that district but do not necessarily bind other government agencies with jurisdiction over the same criminal activity."
      },
      {
        "attribution": "Justice Scalia",
        "citations": [
          {
            "document_hash": "e25f15dd25d6f23945887dda358dcac24a8632ecf7a22dce8ce4d08742f73946",
            "evidence_ids": [
              "ev-e25f15dd25d6-0000-0004"
            ],
            "pages": {
              "end": 16,
              "start": 16
            }
          }
        ],
        "text": "Justice Scalia asked whether the Justice Department concedes that the sovereign here is the United States."
      },
      {
        "attribution": "Justice STEVENS",
        "citations": [
          {
            "document_hash": "e25f15dd25d6f23945887dda358dcac24a8632ecf7a22dce8ce4d08742f73946",
            "evidence_ids": [
              "ev-e25f15dd25d6-0001-0000"
            ],
            "pages": {
              "end": 20,
              "start": 20
            }
          }
        ],
        "text": "Justice Stevens asked whether the lawyer who entered the settlement could bring a contempt proceeding against the adversary who violated the settlement."
      },
      {
        "attribution": "Justice BREYER",
        "citations": [
          {
            "document_hash": "e25f15dd25d6f23945887dda358dcac24a8632ecf7a22dce8ce4d08742f73946",
            "evidence_ids": [
              "ev-e25f15dd25d6-0001-0007"
            ],
            "pages": {
              "end": 38,
              "start": 38
            }
          }
        ],
        "text": "Justice Breyer asked whether the government could appoint a private person."
      },
      {
        "attribution": "Justice Scalia",
        "citations": [
          {
            "document_hash": "e25f15dd25d6f23945887dda358dcac24a8632ecf7a22dce8ce4d08742f73946",
            "evidence_ids": [
              "ev-e25f15dd25d6-0002-0000"
            ],
            "pages": {
              "end": 39,
              "start": 39
            }
          }
        ],
        "text": "Justice Scalia asked whether Congress could set up a private organization to expend Federal funds."
      },
      {
        "attribution": "Justice Sotomayor",
        "citations": [
          {
            "document_hash": "e25f15dd25d6f23945887dda358dcac24a8632ecf7a22dce8ce4d08742f73946",
            "evidence_ids": [
