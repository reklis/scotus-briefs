              "start": 5
            }
          }
        ],
        "text": "Dupree v. Younger concerned whether a party can preserve a purely legal issue for appellate review without filing additional motions after a summary\u2011judgment denial."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "edd396522ae99e3751f9b25bff8ee62d7fb6e030cc9306b4731cd17edd4868b6",
            "evidence_ids": [
              "ev-edd396522ae9-0000-0005"
            ],
            "pages": {
              "end": 11,
              "start": 11
            }
          }
        ],
        "text": "The Supreme Court vacated the judgment of the Court of Appeals and remanded the case for further proceedings consistent with this opinion."
      }
    ],
    "heading": "Overview",
    "status": "complete",
    "summary": null,
    "summary_citations": []
