              "start": 15
            }
          }
        ],
        "text": "Justice Sotomayor asked whether the Court should give Chevron deference to the agency\u2019s interpretation."
      },
      {
        "attribution": "Justice Barrett",
        "citations": [
          {
            "document_hash": "ce3cd1733405b188e0515be120ce13532626827088b86f6d8a73518c41385c28",
