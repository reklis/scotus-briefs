              "end": 25,
              "start": 25
            }
          }
        ],
        "text": "Justice Alito asked whether Congress intended the Court\u2019s interpretation of \u201centitled to benefits.\u201d"
      },
      {
        "attribution": "Justice Kagan",
        "citations": [
          {
            "document_hash": "ce3cd1733405b188e0515be120ce13532626827088b86f6d8a73518c41385c28",
            "evidence_ids": [
