              "end": 6,
              "start": 6
            }
          }
        ],
        "text": "Justice Thomas asked: what is the difference between \u201centitled to\u201d and \u201celigible for\u201d?"
      },
      {
        "attribution": "Justice Kavanaugh",
        "citations": [
          {
