        "start": 2
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "Smith has obtained fve full-scale IQ scores, ranging from 72 to 78, and his claim of intellectual disability depended in part on whether his IQ is 70 or below."
    },
    {
      "attribution": "Court",
      "case_id": "scotus-23-167",
      "confidence": 1.0,
      "document_hash": "b8bb843416bd0728270e476df524320954f34b1f90815459b84ef5aee734b691",
