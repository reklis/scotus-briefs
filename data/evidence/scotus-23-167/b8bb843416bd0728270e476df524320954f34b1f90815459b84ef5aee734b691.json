      "opinion_part": null,
      "pages": {
        "end": 2,
        "start": 2
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "The District Court below vacated the death sentence of Joseph Clifton Smith after concluding that he is intellectually disabled."
    },
    {
      "attribution": "Court",
      "case_id": "scotus-23-167",
      "confidence": 1.0,
      "document_hash": "b8bb843416bd0728270e476df524320954f34b1f90815459b84ef5aee734b691",
      "evidence_id": "ev-b8bb843416bd-0000-0006",
      "kind": "fact",
      "opinion_part": "per_curiam",
      "pages": {
        "end": 3,
        "start": 3
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "The Eleventh Circuit's opinion can be read in two ways."
    },
    {
      "attribution": "Court",
      "case_id": "scotus-23-167",
      "confidence": 1.0,
      "document_hash": "b8bb843416bd0728270e476df524320954f34b1f90815459b84ef5aee734b691",
      "evidence_id": "ev-b8bb843416bd-0000-0004",
      "kind": "justice_question",
      "opinion_part": "per_curiam",
      "pages": {
        "end": 4,
        "start": 4
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "Justice Thomas and Justice Gorsuch would grant the petition for a writ of certiorari and set the case for argument."
    },
    {
      "attribution": "Court",
      "case_id": "scotus-23-167",
      "confidence": 1.0,
      "document_hash": "b8bb843416bd0728270e476df524320954f34b1f90815459b84ef5aee734b691",
      "evidence_id": "ev-b8bb843416bd-0000-0005",
      "kind": "holding",
      "opinion_part": "per_curiam",
      "pages": {
        "end": 4,
        "start": 4
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "we grant the petition for certiorari and Smith's motion for leave to proceed in forma pauperis, vacate the judgment of the Eleventh Circuit, and remand the case for further consideration consistent with this opinion."
    }
