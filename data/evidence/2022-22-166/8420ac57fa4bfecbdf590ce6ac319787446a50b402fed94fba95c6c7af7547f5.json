      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "The District Court dismissed the suit for failure to state a claim, and the Eighth Circuit affrmed."
    },
    {
      "attribution": "Supreme Court",
      "case_id": "2022-22-166",
      "confidence": 1.0,
      "document_hash": "8420ac57fa4bfecbdf590ce6ac319787446a50b402fed94fba95c6c7af7547f5",
