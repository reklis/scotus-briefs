      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "Hennepin County, Minnesota, sold Geraldine Tyler's home for $40,000 to satisfy a $15,000 tax bill. Instead of returning the remaining $25,000, the County kept it for itself."
    },
    {
      "attribution": "Court",
      "case_id": "2022-22-166",
      "confidence": 1.0,
      "document_hash": "8420ac57fa4bfecbdf590ce6ac319787446a50b402fed94fba95c6c7af7547f5",
      "evidence_id": "ev-8420ac57fa4b-0001-0003",
      "kind": "holding",
      "opinion_part": "majority",
      "pages": {
        "end": 15,
        "start": 15
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "We rejected this belated argument."
    },
    {
      "attribution": "Hennepin County",
      "case_id": "2022-22-166",
      "confidence": 1.0,
      "document_hash": "8420ac57fa4bfecbdf590ce6ac319787446a50b402fed94fba95c6c7af7547f5",
      "evidence_id": "ev-8420ac57fa4b-0001-0001",
      "kind": "party_argument",
      "opinion_part": "majority",
      "pages": {
        "end": 17,
        "start": 17
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "The County argues that Tyler has no interest in the surplus because she constructively abandoned her home by failing to pay her taxes."
    },
    {
      "attribution": "Court",
      "case_id": "2022-22-166",
      "confidence": 1.0,
      "document_hash": "8420ac57fa4bfecbdf590ce6ac319787446a50b402fed94fba95c6c7af7547f5",
