        "start": 21
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "MR. STEWART: would say that for the -- for the consent to be valid, the individual's waiver of rights needs to bear some reasonable relationship to the fact that he's on probation."
    },
    {
      "attribution": "Justice Scalia",
      "case_id": "2001-00-1260",
      "confidence": 1.0,
      "document_hash": "d308d4d44a88da894367b357f5f3481ffc79da8b9be633d9c357a795835843bb",
