      },
      "schema_version": "1.0.0",
      "status": "uncertain",
      "text": "QUESTION: question?"
    },
    {
      "attribution": "Government (Mr. Stewart)",
      "case_id": "2001-00-1260",
      "confidence": 1.0,
      "document_hash": "d308d4d44a88da894367b357f5f3481ffc79da8b9be633d9c357a795835843bb",
      "evidence_id": "ev-d308d4d44a88-0001-0001",
      "kind": "party_argument",
