      "pages": {
        "end": 19,
        "start": 19
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "in our brief we suggested that it would be possible to grant summary judgment for the employer here on this record."
    },
    {
      "attribution": "Mr. Clement",
      "case_id": "2003-02-749",
      "confidence": 1.0,
      "document_hash": "32a8b1b0c0567bf76ffb6687f6c4b352c086154d9d76e29335808037d0cb8931",
      "evidence_id": "ev-32a8b1b0c056-0001-0001",
