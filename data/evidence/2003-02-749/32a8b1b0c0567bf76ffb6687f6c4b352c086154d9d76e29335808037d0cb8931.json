      "pages": {
        "end": 20,
        "start": 20
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "when an employer applies a neutral policy, it has not engaged in disparate treatment on the basis of disability."
    },
    {
      "attribution": "Mr. Clement",
      "case_id": "2003-02-749",
      "confidence": 1.0,
