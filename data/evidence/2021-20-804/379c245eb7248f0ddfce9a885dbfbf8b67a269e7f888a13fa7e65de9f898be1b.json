      "schema_version": "1.0.0",
      "status": "supported",
      "text": "the Fifth Circuit's holding, a purely verbal censure by an elected assembly of one of its own members may offend the First Amendment."
    },
    {
      "attribution": "Justice Gorsuch",
      "case_id": "2021-20-804",
      "confidence": 0.9,
      "document_hash": "379c245eb7248f0ddfce9a885dbfbf8b67a269e7f888a13fa7e65de9f898be1b",
      "evidence_id": "ev-379c245eb724-0001-0001",
      "kind": "fact",
      "opinion_part": "majority",
      "pages": {
        "end": 12,
        "start": 12
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "First, Mr. Wilson was an elected offcial. In this country,\nwe expect elected representatives to shoulder a degree of\ncriticism about their public service from their constituents\nand their peers\u2014and to continue exercising their free speech\nrights when the criticism comes."
    },
    {
      "attribution": "Court",
      "case_id": "2021-20-804",
      "confidence": 1.0,
      "document_hash": "379c245eb7248f0ddfce9a885dbfbf8b67a269e7f888a13fa7e65de9f898be1b",
