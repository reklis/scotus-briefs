  "records": [
    {
      "attribution": "Branch, et al.",
      "case_id": "2002-01-1437",
      "confidence": 1.0,
      "document_hash": "ba22edaf8247b97c013cabe81480a44e8f3170976523464802586543311e6192",
      "evidence_id": "ev-ba22edaf8247-0000-0000",
      "kind": "party_argument",
      "opinion_part": null,
