{
  "case_id": "2021-20-828",
  "document_hash": "57ea5d9bc577453e7df11fc4173900104e1d10f11d50c1ebfc1be0bd4bc6fc5b",
  "records": [
    {
      "attribution": "Supreme Court",
      "case_id": "2021-20-828",
      "confidence": 1.0,
