  "records": [
    {
      "attribution": "Court",
      "case_id": "2004-03-1160",
      "confidence": 1.0,
      "document_hash": "4dee917af5717fd9cb9ccf118ae6d99303df3413f3189ae31bae73e5ec1703fd",
      "evidence_id": "ev-4dee917af571-0000-0000",
      "kind": "procedural_event",
      "opinion_part": null,
      "pages": {
        "end": 1,
        "start": 1
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "The above-entitled matter came on for oral argument before the Supreme Court of the United States at 11:02 a.m."
    },
    {
      "attribution": "Court",
      "case_id": "2004-03-1160",
      "confidence": 1.0,
      "document_hash": "4dee917af5717fd9cb9ccf118ae6d99303df3413f3189ae31bae73e5ec1703fd",
      "evidence_id": "ev-4dee917af571-0000-0001",
      "kind": "procedural_event",
      "opinion_part": null,
      "pages": {
        "end": 1,
        "start": 1
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "APPEARANCES: THOMAS C. GOLDSTEIN, ESQ., Washington, D.C.; on behalf of the Petitioners. GLEN D. NAGER, ESQ., Washington, D.C.; on behalf of the Respondents."
    },
    {
      "attribution": "Petitioners",
      "case_id": "2004-03-1160",
      "confidence": 1.0,
      "document_hash": "4dee917af5717fd9cb9ccf118ae6d99303df3413f3189ae31bae73e5ec1703fd",
      "evidence_id": "ev-4dee917af571-0000-0002",
      "kind": "party_argument",
      "opinion_part": null,
      "pages": {
        "end": 3,
        "start": 3
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "Petitioners submit that the Age Discrimination in Employment Act prohibits an employment practice that has a significant disparate impact on older workers if that practice lacks any reasonable business justification."
    },
    {
      "attribution": "Justice Stevens",
      "case_id": "2004-03-1160",
      "confidence": 1.0,
      "document_hash": "4dee917af5717fd9cb9ccf118ae6d99303df3413f3189ae31bae73e5ec1703fd",
      "evidence_id": "ev-4dee917af571-0000-0003",
      "kind": "justice_question",
      "opinion_part": null,
      "pages": {
        "end": 3,
        "start": 3
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "JUSTICE STEVENS: Mr. Goldstein, let me just interrupt a minute. You say if it lacks the -- the business justification. But is it not a part of -- that is not a part of the plaintiffs' primary submission, is it, that it does not show? That's an affirmative defense."
    },
    {
      "attribution": "Justice Breyer",
      "case_id": "2004-03-1160",
      "confidence": 1.0,
      "document_hash": "4dee917af5717fd9cb9ccf118ae6d99303df3413f3189ae31bae73e5ec1703fd",
      "evidence_id": "ev-4dee917af571-0000-0004",
      "kind": "justice_question",
      "opinion_part": null,
      "pages": {
        "end": 4,
        "start": 4
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "JUSTICE BREYER: You put your finger on exactly what's the part of this case that's bothering me."
    },
    {
      "attribution": "Justice Scalia",
      "case_id": "2004-03-1160",
      "confidence": 1.0,
      "document_hash": "4dee917af5717fd9cb9ccf118ae6d99303df3413f3189ae31bae73e5ec1703fd",
      "evidence_id": "ev-4dee917af571-0000-0005",
      "kind": "justice_question",
      "opinion_part": null,
      "pages": {
        "end": 8,
        "start": 8
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "JUSTICE SCALIA: You don't care about those regs anyway. Right?"
    },
    {
      "attribution": "Justice O'Connor",
      "case_id": "2004-03-1160",
      "confidence": 1.0,
      "document_hash": "4dee917af5717fd9cb9ccf118ae6d99303df3413f3189ae31bae73e5ec1703fd",
      "evidence_id": "ev-4dee917af571-0000-0006",
      "kind": "justice_question",
      "opinion_part": null,
      "pages": {
        "end": 9,
        "start": 9
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "JUSTICE O'CONNOR: But was this an actual rule after notice and comment, or is it a -- an interpretation?"
    },
    {
      "attribution": "Justice Ginsburg",
      "case_id": "2004-03-1160",
      "confidence": 1.0,
      "document_hash": "4dee917af5717fd9cb9ccf118ae6d99303df3413f3189ae31bae73e5ec1703fd",
      "evidence_id": "ev-4dee917af571-0001-0000",
      "kind": "justice_question",
      "opinion_part": null,
      "pages": {
        "end": 20,
        "start": 20
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "Have there been mutual rules with a disparate impact that you can give us as examples? When you're talking about race and sex, the examples come to mind much more readily than in the age category."
    },
    {
      "attribution": "Mr. Goldstein",
      "case_id": "2004-03-1160",
      "confidence": 1.0,
      "document_hash": "4dee917af5717fd9cb9ccf118ae6d99303df3413f3189ae31bae73e5ec1703fd",
      "evidence_id": "ev-4dee917af571-0001-0002",
      "kind": "party_argument",
      "opinion_part": null,
      "pages": {
        "end": 20,
        "start": 20
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "The first is the examples identified by the Solicitor General in his cert petition defending the EEOC's position in the Francis W. Parker case in 1994. The EEOC pursued cases -- and they're cited in the cert petition -- involving rules that prohibit -- that require recent college graduates to get a job that forbid hiring someone who worked previously for a higher salary than"
    },
    {
      "attribution": "Justice Scalia",
      "case_id": "2004-03-1160",
      "confidence": 1.0,
      "document_hash": "4dee917af5717fd9cb9ccf118ae6d99303df3413f3189ae31bae73e5ec1703fd",
      "evidence_id": "ev-4dee917af571-0001-0001",
      "kind": "justice_question",
      "opinion_part": null,
      "pages": {
        "end": 21,
        "start": 21
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "Why isn't it a reasonable factor other than age that I don't want to hire somebody who's going to retire a year after I hire him?"
    },
    {
      "attribution": "Mr. Nager",
      "case_id": "2004-03-1160",
      "confidence": 1.0,
      "document_hash": "4dee917af5717fd9cb9ccf118ae6d99303df3413f3189ae31bae73e5ec1703fd",
      "evidence_id": "ev-4dee917af571-0001-0003",
      "kind": "party_argument",
      "opinion_part": null,
      "pages": {
        "end": 25,
        "start": 25
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "If I may, I'd like to go straight to the question as to why mere statistical correlations with age don't create a prima facie case of discrimination because of age."
    },
    {
      "attribution": "Mr. Nager",
      "case_id": "2004-03-1160",
      "confidence": 1.0,
      "document_hash": "4dee917af5717fd9cb9ccf118ae6d99303df3413f3189ae31bae73e5ec1703fd",
      "evidence_id": "ev-4dee917af571-0001-0006",
      "kind": "procedural_event",
      "opinion_part": null,
      "pages": {
        "end": 25,
        "start": 25
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "Thank you, Justice Stevens, and may it please the Court:"
    },
    {
      "attribution": "Justice Breyer",
      "case_id": "2004-03-1160",
      "confidence": 1.0,
      "document_hash": "4dee917af5717fd9cb9ccf118ae6d99303df3413f3189ae31bae73e5ec1703fd",
      "evidence_id": "ev-4dee917af571-0001-0004",
      "kind": "fact",
      "opinion_part": null,
      "pages": {
        "end": 35,
        "start": 35
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "All right. So we don't know what the Government's position is. They're not here."
    },
    {
      "attribution": "Justice Souter",
      "case_id": "2004-03-1160",
      "confidence": 1.0,
      "document_hash": "4dee917af5717fd9cb9ccf118ae6d99303df3413f3189ae31bae73e5ec1703fd",
      "evidence_id": "ev-4dee917af571-0002-0000",
      "kind": "justice_question",
      "opinion_part": null,
      "pages": {
        "end": 36,
        "start": 36
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "Mr. Nager, will you go to another one of Justice Breyer's premises?"
    },
    {
      "attribution": "Justice Stevens",
      "case_id": "2004-03-1160",
      "confidence": 1.0,
      "document_hash": "4dee917af5717fd9cb9ccf118ae6d99303df3413f3189ae31bae73e5ec1703fd",
      "evidence_id": "ev-4dee917af571-0002-0003",
      "kind": "justice_question",
      "opinion_part": null,
      "pages": {
        "end": 50,
        "start": 50
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "What I'm trying to think through is whether that issue is one that can be resolved on the pleadings, or does it always require a trial."
    },
    {
      "attribution": "Fifth Circuit",
      "case_id": "2004-03-1160",
      "confidence": 1.0,
      "document_hash": "4dee917af5717fd9cb9ccf118ae6d99303df3413f3189ae31bae73e5ec1703fd",
      "evidence_id": "ev-4dee917af571-0003-0000",
      "kind": "party_argument",
      "opinion_part": null,
      "pages": {
        "end": 53,
        "start": 53
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "Now, the second argument they have -- and this was the Fifth Circuit's argument -- is the RFOA provision exists in the ADEA, not in title VII."
    },
    {
      "attribution": "Justice Scalia",
      "case_id": "2004-03-1160",
      "confidence": 1.0,
      "document_hash": "4dee917af5717fd9cb9ccf118ae6d99303df3413f3189ae31bae73e5ec1703fd",
      "evidence_id": "ev-4dee917af571-0003-0001",
      "kind": "justice_question",
      "opinion_part": null,
      "pages": {
        "end": 54,
        "start": 54
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "JUSTICE SCALIA: What of dual motive?"
    },
    {
      "attribution": "Mr. Goldstein",
      "case_id": "2004-03-1160",
      "confidence": 1.0,
      "document_hash": "4dee917af5717fd9cb9ccf118ae6d99303df3413f3189ae31bae73e5ec1703fd",
      "evidence_id": "ev-4dee917af571-0003-0002",
      "kind": "party_argument",
      "opinion_part": null,
      "pages": {
        "end": 54,
        "start": 54
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "Because the statute refers to something otherwise unlawful, it can't be talking about Price Waterhouse mixed motive."
    },
    {
      "attribution": "Court",
      "case_id": "2004-03-1160",
      "confidence": 1.0,
      "document_hash": "4dee917af5717fd9cb9ccf118ae6d99303df3413f3189ae31bae73e5ec1703fd",
      "evidence_id": "ev-4dee917af571-0003-0003",
      "kind": "fact",
      "opinion_part": null,
      "pages": {
        "end": 54,
        "start": 54
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "It shall not be unlawful for an employer to take any action otherwise prohibited under subsection (a) where the differentiation is based on reasonable factors other than age."
    },
    {
      "attribution": "Court",
      "case_id": "2004-03-1160",
      "confidence": 1.0,
      "document_hash": "4dee917af5717fd9cb9ccf118ae6d99303df3413f3189ae31bae73e5ec1703fd",
      "evidence_id": "ev-4dee917af571-0003-0004",
      "kind": "procedural_event",
      "opinion_part": null,
      "pages": {
        "end": 55,
        "start": 55
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "The case is submitted."
    }
  ],
  "schema_version": "1.0.0"
}
