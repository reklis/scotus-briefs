        "start": 36
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "JUSTICE BREYER: What the question --"
    },
    {
      "attribution": "Justice Scalia",
      "case_id": "2012-12-96",
      "confidence": 1.0,
      "document_hash": "3c70f66ee180fe7e2f841688cc7deaf71fd02bb7ee972dda7c48e2246b744d8f",
      "evidence_id": "ev-3c70f66ee180-0002-0007",
      "kind": "justice_question",
