      "schema_version": "1.0.0",
      "status": "supported",
      "text": "JUSTICE SOTOMAYOR: Counsel, are you --"
    },
    {
      "attribution": "Mr. Rein",
      "case_id": "2012-12-96",
      "confidence": 1.0,
      "document_hash": "3c70f66ee180fe7e2f841688cc7deaf71fd02bb7ee972dda7c48e2246b744d8f",
