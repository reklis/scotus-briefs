        "start": 63
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "JUSTICE SOTOMAYOR: Do you think that the right to vote is a racial entitlement in Section 5?"
    },
    {
      "attribution": "Court",
      "case_id": "2012-12-96",
      "confidence": 1.0,
      "document_hash": "3c70f66ee180fe7e2f841688cc7deaf71fd02bb7ee972dda7c48e2246b744d8f",
