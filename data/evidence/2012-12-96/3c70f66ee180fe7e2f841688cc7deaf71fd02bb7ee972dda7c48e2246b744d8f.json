      "pages": {
        "end": 53,
        "start": 53
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "But that's true in every State, isn't it?"
    },
    {
      "attribution": "Justice Sotomayor",
      "case_id": "2012-12-96",
      "confidence": 1.0,
      "document_hash": "3c70f66ee180fe7e2f841688cc7deaf71fd02bb7ee972dda7c48e2246b744d8f",
      "evidence_id": "ev-3c70f66ee180-0003-0002",
