      "opinion_part": null,
      "pages": {
        "end": 6,
        "start": 6
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "And here Kuntrell Jackson was subject to life without parole."
    },
    {
      "attribution": "Chief Justice Roberts",
      "case_id": "2011-10-9647",
      "confidence": 1.0,
      "document_hash": "1d17a9f8eeea4bffeaf349d9d4ba207d75a06b4a5de88baa118f1ebcad6c5099",
