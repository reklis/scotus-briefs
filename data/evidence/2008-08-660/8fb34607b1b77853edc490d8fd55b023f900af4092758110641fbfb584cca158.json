      "text": "PAUL T. REPHEN, ESQ., New York, N.Y.; on behalf of the Respondents."
    },
    {
      "attribution": "United States (amicus curiae)",
      "case_id": "2008-08-660",
      "confidence": 0.99,
      "document_hash": "8fb34607b1b77853edc490d8fd55b023f900af4092758110641fbfb584cca158",
