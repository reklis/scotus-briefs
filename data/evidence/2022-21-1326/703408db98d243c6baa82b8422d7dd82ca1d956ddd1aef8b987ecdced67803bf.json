      "schema_version": "1.0.0",
      "status": "supported",
      "text": "The above-entitled matter came on for oral argument before the Supreme Court of the United States at 11:57 a.m."
    },
    {
      "attribution": "Justice Thomas",
      "case_id": "2022-21-1326",
      "confidence": 1.0,
      "document_hash": "703408db98d243c6baa82b8422d7dd82ca1d956ddd1aef8b987ecdced67803bf",
      "evidence_id": "ev-703408db98d2-0000-0002",
