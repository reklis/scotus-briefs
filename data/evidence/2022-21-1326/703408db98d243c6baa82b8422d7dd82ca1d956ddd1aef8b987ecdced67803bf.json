      "pages": {
        "end": 46,
        "start": 46
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "MR. STEWART: They believed it to be $4, yes."
    },
    {
      "attribution": "Justice Jackson",
      "case_id": "2022-21-1326",
      "confidence": 1.0,
      "document_hash": "703408db98d243c6baa82b8422d7dd82ca1d956ddd1aef8b987ecdced67803bf",
      "evidence_id": "ev-703408db98d2-0002-0002",
      "kind": "justice_question",
      "opinion_part": null,
      "pages": {
