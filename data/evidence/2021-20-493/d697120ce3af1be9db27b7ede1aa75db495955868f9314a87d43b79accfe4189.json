{
  "case_id": "2021-20-493",
  "document_hash": "d697120ce3af1be9db27b7ede1aa75db495955868f9314a87d43b79accfe4189",
  "records": [
    {
      "attribution": "Court",
      "case_id": "2021-20-493",
      "confidence": 1.0,
      "document_hash": "d697120ce3af1be9db27b7ede1aa75db495955868f9314a87d43b79accfe4189",
      "evidence_id": "ev-d697120ce3af-0000-0000",
      "kind": "fact",
      "opinion_part": null,
      "pages": {
        "end": 2,
        "start": 2
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "In 1968, Congress recognized the Ysleta del Sur Pueblo as an Indian tribe and assigned its trust responsibilities for the Tribe to Texas. 82 Stat. 93."
    },
    {
      "attribution": "Court",
      "case_id": "2021-20-493",
      "confidence": 1.0,
      "document_hash": "d697120ce3af1be9db27b7ede1aa75db495955868f9314a87d43b79accfe4189",
      "evidence_id": "ev-d697120ce3af-0000-0001",
      "kind": "fact",
      "opinion_part": null,
      "pages": {
        "end": 2,
        "start": 2
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "In 1983, Texas renounced its trust responsibilities as inconsistent with the State's Constitution."
    },
    {
      "attribution": "Court",
      "case_id": "2021-20-493",
      "confidence": 1.0,
      "document_hash": "d697120ce3af1be9db27b7ede1aa75db495955868f9314a87d43b79accfe4189",
      "evidence_id": "ev-d697120ce3af-0000-0002",
      "kind": "fact",
      "opinion_part": null,
      "pages": {
        "end": 2,
        "start": 2
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "Congress restored the Tribe's federal trust status in 1987 when it adopted the Ysleta del Sur Pueblo and Alabama and Coushatta Indian Tribes of Texas Restoration Act. 101 Stat. 666."
    },
    {
      "attribution": "Court",
      "case_id": "2021-20-493",
      "confidence": 1.0,
      "document_hash": "d697120ce3af1be9db27b7ede1aa75db495955868f9314a87d43b79accfe4189",
      "evidence_id": "ev-d697120ce3af-0000-0003",
      "kind": "fact",
      "opinion_part": null,
      "pages": {
        "end": 2,
        "start": 2
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "The Restoration Act also \u201cprohibited\u201d as a matter of federal law \u201c[a]ll gaming activities which are prohibited by the laws of the State of Texas.\u201d Id., at 668."
    },
    {
      "attribution": "Court",
      "case_id": "2021-20-493",
      "confidence": 1.0,
      "document_hash": "d697120ce3af1be9db27b7ede1aa75db495955868f9314a87d43b79accfe4189",
      "evidence_id": "ev-d697120ce3af-0000-0004",
      "kind": "fact",
      "opinion_part": null,
      "pages": {
        "end": 2,
        "start": 2
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "IGRA permitted Tribes to offer so-called class II games\u2014like bingo\u2014in States that \u201cpermi[t] such gaming for any purpose by any person, organization or entity.\u201d 25 U. S. C. \u00a7 2710(b)(1)(A)."
    },
    {
      "attribution": "Texas",
      "case_id": "2021-20-493",
      "confidence": 1.0,
      "document_hash": "d697120ce3af1be9db27b7ede1aa75db495955868f9314a87d43b79accfe4189",
      "evidence_id": "ev-d697120ce3af-0000-0005",
      "kind": "party_argument",
      "opinion_part": null,
      "pages": {
        "end": 2,
        "start": 2
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "Texas refused, arguing that the Restoration Act displaced IGRA and required the Tribe to follow all of the State's gaming laws on tribal lands."
    },
    {
      "attribution": "Court",
      "case_id": "2021-20-493",
      "confidence": 1.0,
      "document_hash": "d697120ce3af1be9db27b7ede1aa75db495955868f9314a87d43b79accfe4189",
      "evidence_id": "ev-d697120ce3af-0000-0006",
      "kind": "procedural_event",
      "opinion_part": null,
      "pages": {
        "end": 2,
        "start": 2
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "In subsequent federal litigation, the District Court held that Texas violated IGRA by failing to negotiate in good faith."
    },
    {
      "attribution": "Court",
      "case_id": "2021-20-493",
      "confidence": 1.0,
      "document_hash": "d697120ce3af1be9db27b7ede1aa75db495955868f9314a87d43b79accfe4189",
      "evidence_id": "ev-d697120ce3af-0000-0009",
      "kind": "fact",
      "opinion_part": null,
      "pages": {
        "end": 3,
        "start": 3
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "Section 107 of the Restoration Act directly addresses gaming on the lands of the Ysleta del Sur Pueblo. It provides in subsection (a) that \u201cgaming activities which are prohibited by [Texas law] are hereby prohibited on the reservation and on lands of the tribe.\u201d Subsection (b) insists that the statute does not grant Texas \u201ccivil or criminal regulatory jurisdiction\u201d with respect to matters covered by \u00a7 107."
    },
    {
      "attribution": "Court",
      "case_id": "2021-20-493",
      "confidence": 1.0,
      "document_hash": "d697120ce3af1be9db27b7ede1aa75db495955868f9314a87d43b79accfe4189",
      "evidence_id": "ev-d697120ce3af-0000-0012",
      "kind": "fact",
      "opinion_part": "majority",
      "pages": {
        "end": 6,
        "start": 6
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "Justice Gorsuch delivered the opinion of the Court."
    },
    {
      "attribution": "Court",
      "case_id": "2021-20-493",
      "confidence": 1.0,
      "document_hash": "d697120ce3af1be9db27b7ede1aa75db495955868f9314a87d43b79accfe4189",
      "evidence_id": "ev-d697120ce3af-0000-0013",
      "kind": "fact",
      "opinion_part": "majority",
      "pages": {
        "end": 6,
        "start": 6
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "Native American Tribes possess \u201cinherent sovereign authority over their members and territories.\u201d Oklahoma Tax Comm'n v. Citizen Band Potawatomi Tribe of Okla., 498 U. S. 505, 509 (1991)."
    },
    {
      "attribution": "Texas",
      "case_id": "2021-20-493",
      "confidence": 1.0,
      "document_hash": "d697120ce3af1be9db27b7ede1aa75db495955868f9314a87d43b79accfe4189",
      "evidence_id": "ev-d697120ce3af-0000-0014",
      "kind": "party_argument",
      "opinion_part": "majority",
      "pages": {
        "end": 6,
        "start": 6
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "In this case, Texas contends that Congress expressly ordained that all of its gaming laws should be treated as surrogate federal law enforceable on the Ysleta del Sur Pueblo Reservation."
    },
    {
      "attribution": "Texas",
      "case_id": "2021-20-493",
      "confidence": 1.0,
      "document_hash": "d697120ce3af1be9db27b7ede1aa75db495955868f9314a87d43b79accfe4189",
      "evidence_id": "ev-d697120ce3af-0001-0000",
      "kind": "party_argument",
      "opinion_part": "majority",
      "pages": {
        "end": 11,
        "start": 11
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "Texas argued, the Fifth Circuit was clear in Ysleta I that the Restoration Act forbids the Tribe from defying any of the State's gaming regulations."
    },
    {
      "attribution": "Court",
      "case_id": "2021-20-493",
      "confidence": 1.0,
      "document_hash": "d697120ce3af1be9db27b7ede1aa75db495955868f9314a87d43b79accfe4189",
      "evidence_id": "ev-d697120ce3af-0001-0001",
      "kind": "procedural_event",
      "opinion_part": "majority",
      "pages": {
        "end": 11,
        "start": 11
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "Finding itself bound by Ysleta I, the District Court sided with Texas and enjoined the Tribe's bingo operations . But the court also chose to stay its injunction pending appeal."
    },
    {
      "attribution": "United States",
      "case_id": "2021-20-493",
      "confidence": 1.0,
      "document_hash": "d697120ce3af1be9db27b7ede1aa75db495955868f9314a87d43b79accfe4189",
      "evidence_id": "ev-d697120ce3af-0001-0002",
      "kind": "amicus_argument",
      "opinion_part": "majority",
      "pages": {
        "end": 12,
        "start": 12
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "The United States argued that the Fifth Circuit's understanding of the Restoration Act took a wrong turn in Ysleta I and urged us to correct the error."
    },
    {
      "attribution": "Court",
      "case_id": "2021-20-493",
      "confidence": 1.0,
      "document_hash": "d697120ce3af1be9db27b7ede1aa75db495955868f9314a87d43b79accfe4189",
      "evidence_id": "ev-d697120ce3af-0001-0006",
      "kind": "procedural_event",
      "opinion_part": "majority",
      "pages": {
        "end": 12,
        "start": 12
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "After the Tribe fled a petition for certiorari, this Court called for the views of the Solicitor General."
    },
    {
      "attribution": "Tribe",
      "case_id": "2021-20-493",
      "confidence": 1.0,
      "document_hash": "d697120ce3af1be9db27b7ede1aa75db495955868f9314a87d43b79accfe4189",
      "evidence_id": "ev-d697120ce3af-0001-0003",
      "kind": "party_argument",
      "opinion_part": "majority",
      "pages": {
        "end": 13,
        "start": 13
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "The Tribe understands the Act to bar it from offering only those gaming activities the State fully prohibits. Consistent with Cabazon, the Tribe submits, if Texas merely regulates a game like bingo, it may offer that game\u2014and it may do so subject only to the limits found in federal law and its own law, not state law."
    },
    {
      "attribution": "Texas",
      "case_id": "2021-20-493",
      "confidence": 1.0,
      "document_hash": "d697120ce3af1be9db27b7ede1aa75db495955868f9314a87d43b79accfe4189",
      "evidence_id": "ev-d697120ce3af-0002-0002",
      "kind": "party_argument",
      "opinion_part": "majority",
      "pages": {
        "end": 25,
        "start": 24
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "Texas contends that Congress in the Restoration Act has allowed all of its state gaming laws to act as surrogate federal law on tribal lands."
    },
    {
      "attribution": "Court",
      "case_id": "2021-20-493",
      "confidence": 1.0,
      "document_hash": "d697120ce3af1be9db27b7ede1aa75db495955868f9314a87d43b79accfe4189",
      "evidence_id": "ev-d697120ce3af-0002-0000",
      "kind": "holding",
      "opinion_part": "majority",
      "pages": {
        "end": 25,
        "start": 25
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "The Restoration Act bans as a matter of federal law on tribal lands only those gaming activities also banned in Texas."
    },
    {
      "attribution": "Court",
      "case_id": "2021-20-493",
      "confidence": 1.0,
      "document_hash": "d697120ce3af1be9db27b7ede1aa75db495955868f9314a87d43b79accfe4189",
      "evidence_id": "ev-d697120ce3af-0002-0003",
      "kind": "fact",
      "opinion_part": "majority",
      "pages": {
        "end": 27,
        "start": 27
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "One states that the Tribe has \u201c[n]o interest in conducting high stakes bingo or other gambling operations on its reservation.\u201d"
    },
    {
      "attribution": "Tribe",
      "case_id": "2021-20-493",
      "confidence": 1.0,
      "document_hash": "d697120ce3af1be9db27b7ede1aa75db495955868f9314a87d43b79accfe4189",
      "evidence_id": "ev-d697120ce3af-0003-0002",
      "kind": "party_argument",
      "opinion_part": "majority",
      "pages": {
        "end": 32,
        "start": 32
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "The Tribe posits that this plain text may be read to refer only to the banning of entire games\u2014such as poker, baccarat, or roulette."
    },
    {
      "attribution": "Court",
      "case_id": "2021-20-493",
      "confidence": 1.0,
      "document_hash": "d697120ce3af1be9db27b7ede1aa75db495955868f9314a87d43b79accfe4189",
      "evidence_id": "ev-d697120ce3af-0003-0001",
      "kind": "holding",
      "opinion_part": "majority",
      "pages": {
        "end": 34,
        "start": 34
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "In sum, \u00a7 107(a) of the Restoration Act is best read to mean that all of Texas's gaming laws apply on the Tribe's reservation."
    }
  ],
  "schema_version": "1.0.0"
}
