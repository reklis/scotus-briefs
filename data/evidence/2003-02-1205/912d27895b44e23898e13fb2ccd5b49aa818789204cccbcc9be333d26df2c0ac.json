        "start": 53
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "QUESTION: I -- I don't know what you're saying when you say it takes it from them. Do you mean it just copies them in the new act? Are you counting situations in which they recite it in the new legislation?"
    },
    {
      "attribution": "Defendant",
      "case_id": "2003-02-1205",
      "confidence": 0.9,
      "document_hash": "912d27895b44e23898e13fb2ccd5b49aa818789204cccbcc9be333d26df2c0ac",
