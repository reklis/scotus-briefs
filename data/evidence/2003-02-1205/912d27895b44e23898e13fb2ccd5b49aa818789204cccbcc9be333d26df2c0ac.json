      "opinion_part": null,
      "pages": {
        "end": 45,
        "start": 45
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "If there are no other questions, Your Honors, I'd urge you to affirm."
    },
    {
      "attribution": "Justice (unspecified)",
      "case_id": "2003-02-1205",
      "confidence": 0.95,
      "document_hash": "912d27895b44e23898e13fb2ccd5b49aa818789204cccbcc9be333d26df2c0ac",
