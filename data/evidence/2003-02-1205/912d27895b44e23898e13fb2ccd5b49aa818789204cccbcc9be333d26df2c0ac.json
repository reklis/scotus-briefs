      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "ORAL ARGUMENT OF KEVIN C. NEWSOM ON BEHALF OF THE FOR ALABAMA, ET AL., AS AMICI CURIAE, SUPPORTING THE RESPONDENT"
    },
    {
      "attribution": "Mr. Phillips",
      "case_id": "2003-02-1205",
      "confidence": 1.0,
      "document_hash": "912d27895b44e23898e13fb2ccd5b49aa818789204cccbcc9be333d26df2c0ac",
      "evidence_id": "ev-912d27895b44-0002-0003",
