        "start": 24
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "ORAL ARGUMENT OF ASHLEY ROBERTSON FOR THE UNITED STATES, AS AMICUS CURIAE, SUPPORTING VACATUR"
    },
