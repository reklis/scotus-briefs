{
  "case_id": "2022-21-1436",
  "document_hash": "523f28ee5dcc03b08320fba42182bda07a87c6300af4eca30f8ded2febcc96ea",
  "records": [
    {
      "attribution": "Court",
      "case_id": "2022-21-1436",
      "confidence": 1.0,
      "document_hash": "523f28ee5dcc03b08320fba42182bda07a87c6300af4eca30f8ded2febcc96ea",
      "evidence_id": "ev-523f28ee5dcc-0000-0005",
      "kind": "stated_consequence",
      "opinion_part": null,
      "pages": {
        "end": 2,
        "start": 2
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "The \u201cjurisdictional\u201d tag carries potentially \u201c[h]arsh consequences.\u201d"
    },
    {
      "attribution": "Government",
      "case_id": "2022-21-1436",
      "confidence": 1.0,
      "document_hash": "523f28ee5dcc03b08320fba42182bda07a87c6300af4eca30f8ded2febcc96ea",
      "evidence_id": "ev-523f28ee5dcc-0001-0001",
      "kind": "party_argument",
      "opinion_part": "majority",
      "pages": {
        "end": 11,
        "start": 11
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "The Government insists that \u00a7 1252(d)(1) is jurisdictional because it is addressed to the \u201ccourt\u201d and limits \u201creview.\u201d"
    },
    {
      "attribution": "Court",
      "case_id": "2022-21-1436",
      "confidence": 1.0,
      "document_hash": "523f28ee5dcc03b08320fba42182bda07a87c6300af4eca30f8ded2febcc96ea",
      "evidence_id": "ev-523f28ee5dcc-0001-0002",
      "kind": "holding",
      "opinion_part": "majority",
      "pages": {
        "end": 14,
        "start": 14
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "Because \u00a7 1252(d)(1)'s exhaustion requirement is not jurisdictional, it is subject to waiver and forfeiture."
    },
    {
      "attribution": "Government",
      "case_id": "2022-21-1436",
      "confidence": 1.0,
      "document_hash": "523f28ee5dcc03b08320fba42182bda07a87c6300af4eca30f8ded2febcc96ea",
      "evidence_id": "ev-523f28ee5dcc-0001-0004",
      "kind": "party_argument",
      "opinion_part": "majority",
      "pages": {
        "end": 16,
        "start": 16
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "The Government acknowledges that because \u00a7 1252(d)(1) requires only exhaustion of remedies \u201cavailable . . . as of right,\u201d \u201ca noncitizen need not exhaust `discretionary' remedies.\u201d"
    },
    {
      "attribution": "Justice Alito",
      "case_id": "2022-21-1436",
      "confidence": 1.0,
      "document_hash": "523f28ee5dcc03b08320fba42182bda07a87c6300af4eca30f8ded2febcc96ea",
      "evidence_id": "ev-523f28ee5dcc-0002-0000",
      "kind": "concurrence",
      "opinion_part": "concurrence",
      "pages": {
        "end": 22,
        "start": 22
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "Section 1252(d)(1)'s exhaustion requirement is not jurisdictional and does not oblige a noncitizen to seek discretionary review, like reconsideration before the Board of Immigration Appeals. We vacate the portion of the judgment of the Court of Appeals dismissing Santos-Zacaria's petition for review and remand the case for further proceedings consistent with this opinion."
    }
  ],
  "schema_version": "1.0.0"
}
