  "records": [
    {
      "attribution": "Seth P. Waxman",
      "case_id": "2017-16-8255",
      "confidence": 1.0,
      "document_hash": "cfb0236509cbac0f2ef6b5008b3a725f97c911a1377a709f9f65a4c628902eba",
      "evidence_id": "ev-cfb0236509cb-0000-0000",
      "kind": "party_argument",
      "opinion_part": null,
