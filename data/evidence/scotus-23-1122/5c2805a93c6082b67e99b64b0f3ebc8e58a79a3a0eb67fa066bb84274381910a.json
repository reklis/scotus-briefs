{
  "case_id": "scotus-23-1122",
  "document_hash": "5c2805a93c6082b67e99b64b0f3ebc8e58a79a3a0eb67fa066bb84274381910a",
  "records": [
    {
      "attribution": "Texas",
      "case_id": "scotus-23-1122",
      "confidence": 1.0,
      "document_hash": "5c2805a93c6082b67e99b64b0f3ebc8e58a79a3a0eb67fa066bb84274381910a",
      "evidence_id": "ev-5c2805a93c60-0000-0000",
      "kind": "fact",
      "opinion_part": null,
      "pages": {
        "end": 2,
        "start": 2
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "In 2023, Texas enacted H. B. 1181, requiring certain commer-\ncial websites publishing sexually explicit content that is obscene to minors to verify that visitors are 18 or older."
    },
    {
      "attribution": "Free Speech Coalition, Inc.",
      "case_id": "scotus-23-1122",
      "confidence": 1.0,
      "document_hash": "5c2805a93c6082b67e99b64b0f3ebc8e58a79a3a0eb67fa066bb84274381910a",
      "evidence_id": "ev-5c2805a93c60-0000-0001",
      "kind": "party_argument",
      "opinion_part": null,
      "pages": {
        "end": 2,
        "start": 2
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "They alleged that adults have a right to access the covered speech, and that the statute impermissibly hinders them."
    },
    {
      "attribution": "Fifth Circuit",
      "case_id": "scotus-23-1122",
      "confidence": 1.0,
      "document_hash": "5c2805a93c6082b67e99b64b0f3ebc8e58a79a3a0eb67fa066bb84274381910a",
      "evidence_id": "ev-5c2805a93c60-0000-0002",
      "kind": "procedural_event",
      "opinion_part": null,
      "pages": {
        "end": 2,
        "start": 2
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "The Fifth Circuit held that an injunction was not warranted because petitioners were unlikely to succeed on their First Amendment claim."
    },
    {
      "attribution": "Texas",
      "case_id": "scotus-23-1122",
      "confidence": 1.0,
      "document_hash": "5c2805a93c6082b67e99b64b0f3ebc8e58a79a3a0eb67fa066bb84274381910a",
      "evidence_id": "ev-5c2805a93c60-0000-0004",
      "kind": "party_argument",
      "opinion_part": null,
      "pages": {
        "end": 4,
        "start": 4
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "(5) Texas contends that only rational-basis review applies."
    },
    {
      "attribution": "District Court",
      "case_id": "scotus-23-1122",
      "confidence": 1.0,
      "document_hash": "5c2805a93c6082b67e99b64b0f3ebc8e58a79a3a0eb67fa066bb84274381910a",
      "evidence_id": "ev-5c2805a93c60-0000-0006",
      "kind": "procedural_event",
      "opinion_part": "majority",
      "pages": {
        "end": 10,
        "start": 10
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "The District Court granted petitioners a preliminary in-\njunction after concluding that they were likely to succeed on their claim."
    },
    {
      "attribution": "Court",
      "case_id": "scotus-23-1122",
      "confidence": 1.0,
      "document_hash": "5c2805a93c6082b67e99b64b0f3ebc8e58a79a3a0eb67fa066bb84274381910a",
      "evidence_id": "ev-5c2805a93c60-0000-0007",
      "kind": "holding",
      "opinion_part": "majority",
      "pages": {
        "end": 10,
        "start": 10
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "The court held that because H. B. 1181 \u201cre-\nstricts access to speech\u201d that is constitutionally protected for adults \u201cbased on the material's content,\u201d it is subject to \u201cstrict scrutiny\u201d\u2014the onerous standard of scrutiny applica-\nble to direct invasions of First Amendment rights."
    },
    {
      "attribution": "Court",
      "case_id": "scotus-23-1122",
      "confidence": 1.0,
      "document_hash": "5c2805a93c6082b67e99b64b0f3ebc8e58a79a3a0eb67fa066bb84274381910a",
      "evidence_id": "ev-5c2805a93c60-0001-0000",
      "kind": "holding",
      "opinion_part": "majority",
      "pages": {
        "end": 11,
        "start": 11
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "survived petitioners' challenge because its \u201cage-verifcation requirement is rationally related to the government's legiti- mate interest in preventing minors' access to pornography.\u201d"
    },
    {
      "attribution": "Court",
      "case_id": "scotus-23-1122",
      "confidence": 1.0,
      "document_hash": "5c2805a93c6082b67e99b64b0f3ebc8e58a79a3a0eb67fa066bb84274381910a",
      "evidence_id": "ev-5c2805a93c60-0001-0001",
      "kind": "procedural_event",
      "opinion_part": "majority",
      "pages": {
        "end": 11,
        "start": 11
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "Petitioners sought a stay of the Fifth Circuit's judgment, which this Court denied."
    },
    {
      "attribution": "Court",
      "case_id": "scotus-23-1122",
      "confidence": 1.0,
      "document_hash": "5c2805a93c6082b67e99b64b0f3ebc8e58a79a3a0eb67fa066bb84274381910a",
      "evidence_id": "ev-5c2805a93c60-0001-0002",
      "kind": "procedural_event",
      "opinion_part": "majority",
      "pages": {
        "end": 11,
        "start": 11
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "We granted certiorari to determine whether H. B. 1181's agever- ifcation requirement is likely constitutional on its face."
    },
    {
      "attribution": "Justice Thomas",
      "case_id": "scotus-23-1122",
      "confidence": 1.0,
      "document_hash": "5c2805a93c6082b67e99b64b0f3ebc8e58a79a3a0eb67fa066bb84274381910a",
      "evidence_id": "ev-5c2805a93c60-0001-0004",
      "kind": "fact",
      "opinion_part": "majority",
      "pages": {
        "end": 12,
        "start": 12
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "Content-neutral laws, on the other hand, \u201care subject to an intermediate level of scrutiny because in most cases they pose a less substantial risk of excising certain ideas or view- points from the public dialogue.\u201d"
    },
    {
      "attribution": "Justice Thomas",
      "case_id": "scotus-23-1122",
      "confidence": 1.0,
      "document_hash": "5c2805a93c6082b67e99b64b0f3ebc8e58a79a3a0eb67fa066bb84274381910a",
      "evidence_id": "ev-5c2805a93c60-0001-0005",
      "kind": "fact",
      "opinion_part": "majority",
      "pages": {
        "end": 14,
        "start": 14
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "Miller v. California, 413 U. S. 15, 24 (1973) (internal quota- tion marks omitted). Our precedents refer to this standard as \u201cthe Miller test.\u201d"
    },
    {
      "attribution": "Justice Thomas",
      "case_id": "scotus-23-1122",
      "confidence": 1.0,
      "document_hash": "5c2805a93c6082b67e99b64b0f3ebc8e58a79a3a0eb67fa066bb84274381910a",
      "evidence_id": "ev-5c2805a93c60-0001-0006",
      "kind": "fact",
      "opinion_part": "majority",
      "pages": {
        "end": 15,
        "start": 15
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "Restrictions of this kind trigger no heightened First Amendment scrutiny and are subject only to rational-basis review, even though they encompass speech that is \u201cnot obscene for adults.\u201d Id., at 634, 639."
    },
    {
      "attribution": "Justice Thomas",
      "case_id": "scotus-23-1122",
      "confidence": 0.95,
      "document_hash": "5c2805a93c6082b67e99b64b0f3ebc8e58a79a3a0eb67fa066bb84274381910a",
      "evidence_id": "ev-5c2805a93c60-0002-0000",
      "kind": "fact",
      "opinion_part": "majority",
      "pages": {
        "end": 21,
        "start": 21
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "The facts of Ginsberg illustrate why age verifcation, as a practical matter, is necessary for an effective prohibition on minors accessing age-inappropriate sexual content. The statute in that case prohibited the knowing sale of sexual content to a minor under the age of 17. 390 U. S., at 633. The defendant was convicted of knowingly selling a porno- graphic magazine to a 16-year-old. Id., at 631."
    },
    {
      "attribution": "Justice Thomas",
      "case_id": "scotus-23-1122",
      "confidence": 0.95,
      "document_hash": "5c2805a93c6082b67e99b64b0f3ebc8e58a79a3a0eb67fa066bb84274381910a",
      "evidence_id": "ev-5c2805a93c60-0002-0003",
      "kind": "fact",
      "opinion_part": "majority",
      "pages": {
        "end": 22,
        "start": 22
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "The need for age verifcation online is even greater. Unlike a store clerk, a website operator cannot look at its visitors and estimate their ages. Without a requirement to submit proof of age, even clearly underage minors would be able to access sexual content undetected."
    },
    {
      "attribution": "Court",
      "case_id": "scotus-23-1122",
      "confidence": 0.95,
      "document_hash": "5c2805a93c6082b67e99b64b0f3ebc8e58a79a3a0eb67fa066bb84274381910a",
      "evidence_id": "ev-5c2805a93c60-0002-0002",
      "kind": "holding",
      "opinion_part": "majority",
      "pages": {
        "end": 24,
        "start": 24
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "Any burden experienced by adults is therefore only incidental to the statute's regulation of activity that is not protected by the First Amendment. That fact makes intermediate scrutiny the appropriate standard under our precedents. Dale, 530 U. S., at 659."
    },
    {
      "attribution": "Court",
      "case_id": "scotus-23-1122",
      "confidence": 1.0,
      "document_hash": "5c2805a93c6082b67e99b64b0f3ebc8e58a79a3a0eb67fa066bb84274381910a",
      "evidence_id": "ev-5c2805a93c60-0003-0000",
      "kind": "holding",
      "opinion_part": "majority",
      "pages": {
        "end": 32,
        "start": 32
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "For the reasons we have explained, we hold today that H. B. 1181 triggers only intermediate scrutiny."
    },
    {
      "attribution": "Texas",
      "case_id": "scotus-23-1122",
      "confidence": 1.0,
      "document_hash": "5c2805a93c6082b67e99b64b0f3ebc8e58a79a3a0eb67fa066bb84274381910a",
      "evidence_id": "ev-5c2805a93c60-0003-0001",
      "kind": "party_argument",
      "opinion_part": "majority",
      "pages": {
        "end": 36,
        "start": 36
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "Texas, like the Fifth Circuit, contends that intermediate scrutiny is too demanding and that only rational-basis review applies."
    },
    {
      "attribution": "Justice Thomas",
      "case_id": "scotus-23-1122",
      "confidence": 1.0,
      "document_hash": "5c2805a93c6082b67e99b64b0f3ebc8e58a79a3a0eb67fa066bb84274381910a",
      "evidence_id": "ev-5c2805a93c60-0003-0005",
      "kind": "fact",
      "opinion_part": "majority",
      "pages": {
        "end": 37,
        "start": 37
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "Texas's interest in shielding children from sexual content is important, even \u201ccompelling.\u201d"
    },
    {
      "attribution": "Justice Thomas",
      "case_id": "scotus-23-1122",
      "confidence": 1.0,
      "document_hash": "5c2805a93c6082b67e99b64b0f3ebc8e58a79a3a0eb67fa066bb84274381910a",
      "evidence_id": "ev-5c2805a93c60-0003-0004",
      "kind": "procedural_event",
      "opinion_part": "majority",
      "pages": {
        "end": 40,
        "start": 40
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "The judgment of the Court of Appeals for the Fifth Circuit is affrmed."
    },
    {
      "attribution": "Justice Kagan",
      "case_id": "scotus-23-1122",
      "confidence": 1.0,
      "document_hash": "5c2805a93c6082b67e99b64b0f3ebc8e58a79a3a0eb67fa066bb84274381910a",
      "evidence_id": "ev-5c2805a93c60-0004-0000",
      "kind": "dissent",
      "opinion_part": "dissent",
      "pages": {
        "end": 41,
        "start": 41
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "The trouble comes in the last two sentences' italics. Speech that is obscene for minors is often not so for adults. For them, the category of obscene\u2014and therefore unprotected speech\u2014is narrower. See ante, at 472\u2013474. So adults have a constitutional right to view the very same speech that a State may prohibit for children."
    },
    {
      "attribution": "Justice Kagan",
      "case_id": "scotus-23-1122",
      "confidence": 1.0,
      "document_hash": "5c2805a93c6082b67e99b64b0f3ebc8e58a79a3a0eb67fa066bb84274381910a",
      "evidence_id": "ev-5c2805a93c60-0004-0001",
      "kind": "justice_question",
      "opinion_part": "dissent",
      "pages": {
        "end": 41,
        "start": 41
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "What, then, to do?"
    },
    {
      "attribution": "Justice Kagan",
      "case_id": "scotus-23-1122",
      "confidence": 1.0,
      "document_hash": "5c2805a93c6082b67e99b64b0f3ebc8e58a79a3a0eb67fa066bb84274381910a",
      "evidence_id": "ev-5c2805a93c60-0004-0002",
      "kind": "dissent",
      "opinion_part": "dissent",
      "pages": {
        "end": 44,
        "start": 44
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "H. B. 1181 covers speech constitutionally protected for adults; impedes adults' ability to view that speech; and imposes that burden based on the speech's content. Case closed."
    },
    {
      "attribution": "Justice Kagan",
      "case_id": "scotus-23-1122",
      "confidence": 1.0,
      "document_hash": "5c2805a93c6082b67e99b64b0f3ebc8e58a79a3a0eb67fa066bb84274381910a",
      "evidence_id": "ev-5c2805a93c60-0004-0003",
      "kind": "dissent",
      "opinion_part": "dissent",
      "pages": {
        "end": 45,
        "start": 45
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "For the would-be consumer of sexually explicit materials, that requirement is a deterrent: It imposes what our First Amendment decisions often call a \u201cchilling effect.\u201d"
    },
    {
      "attribution": "Justice Kagan",
      "case_id": "scotus-23-1122",
      "confidence": 1.0,
      "document_hash": "5c2805a93c6082b67e99b64b0f3ebc8e58a79a3a0eb67fa066bb84274381910a",
      "evidence_id": "ev-5c2805a93c60-0004-0004",
      "kind": "dissent",
      "opinion_part": "dissent",
      "pages": {
        "end": 46,
        "start": 46
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "All of that leads, under well-settled law, to just one conclusion: H. B. 1181 is subject to strict scrutiny."
    },
    {
      "attribution": "Justice Kagan",
      "case_id": "scotus-23-1122",
      "confidence": 1.0,
      "document_hash": "5c2805a93c6082b67e99b64b0f3ebc8e58a79a3a0eb67fa066bb84274381910a",
      "evidence_id": "ev-5c2805a93c60-0004-0005",
      "kind": "dissent",
      "opinion_part": "dissent",
      "pages": {
        "end": 50,
        "start": 50
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "The frst part of the strict-scrutiny test is here easy to meet. The majority is right that a State has a compelling interest in shielding children from the obscene-for-children materials that H. B. 1181 covers."
    },
    {
      "attribution": "Justice Kagan",
      "case_id": "scotus-23-1122",
      "confidence": 1.0,
      "document_hash": "5c2805a93c6082b67e99b64b0f3ebc8e58a79a3a0eb67fa066bb84274381910a",
      "evidence_id": "ev-5c2805a93c60-0005-0000",
      "kind": "justice_question",
      "opinion_part": "dissent",
      "pages": {
        "end": 51,
        "start": 51
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "How does the majority reach a different result?"
    },
    {
      "attribution": "Justice Kagan",
      "case_id": "scotus-23-1122",
      "confidence": 1.0,
      "document_hash": "5c2805a93c6082b67e99b64b0f3ebc8e58a79a3a0eb67fa066bb84274381910a",
      "evidence_id": "ev-5c2805a93c60-0005-0001",
      "kind": "dissent",
      "opinion_part": "dissent",
      "pages": {
        "end": 54,
        "start": 54
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "Ginsberg v. New York, 390 U. S. 629, 633, 643\u2013644 (1968), to show ID in a store, has to satisfy some form of heightened constitutional scrutiny. See ante, at 486, 495."
    },
    {
      "attribution": "Justice Kagan",
      "case_id": "scotus-23-1122",
      "confidence": 1.0,
      "document_hash": "5c2805a93c6082b67e99b64b0f3ebc8e58a79a3a0eb67fa066bb84274381910a",
      "evidence_id": "ev-5c2805a93c60-0006-0000",
      "kind": "dissent",
      "opinion_part": "dissent",
      "pages": {
        "end": 61,
        "start": 61
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "the Court was unequivocal that because COPA was \u201ca content-based speech restriction,\u201d it must satisfy the strict-scrutiny test."
    },
    {
      "attribution": "Justice Kagan",
      "case_id": "scotus-23-1122",
      "confidence": 1.0,
      "document_hash": "5c2805a93c6082b67e99b64b0f3ebc8e58a79a3a0eb67fa066bb84274381910a",
      "evidence_id": "ev-5c2805a93c60-0006-0001",
      "kind": "dissent",
      "opinion_part": "dissent",
      "pages": {
        "end": 62,
        "start": 62
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "I would demand Texas show more, to ensure it is not undervaluing the interest in free expression."
    }
  ],
  "schema_version": "1.0.0"
}
