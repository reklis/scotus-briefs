  "records": [
    {
      "attribution": "Court",
      "case_id": "2020-18-956",
      "confidence": 1.0,
      "document_hash": "23827beee1980fe872d62c58a9711ba484bbdc73a9aeb0d7c2bcba8cc591c5bc",
      "evidence_id": "ev-23827beee198-0000-0000",
      "kind": "procedural_event",
      "opinion_part": null,
      "pages": {
        "end": 2,
        "start": 2
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "Google LLC v. ORACLE AMERICA, INC. certiorari to the united states court of appeals for the federal circuit No. 18\u2013956. Argued October 7, 2020\u2014Decided April 5, 2021"
    },
    {
      "attribution": "Court",
      "case_id": "2020-18-956",
      "confidence": 1.0,
      "document_hash": "23827beee1980fe872d62c58a9711ba484bbdc73a9aeb0d7c2bcba8cc591c5bc",
      "evidence_id": "ev-23827beee198-0000-0001",
      "kind": "fact",
      "opinion_part": null,
      "pages": {
        "end": 2,
        "start": 2
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "Oracle America, Inc., owns a copyright in Java SE, a computer platform that uses the popular Java computer programming language."
    },
    {
      "attribution": "Court",
      "case_id": "2020-18-956",
      "confidence": 1.0,
      "document_hash": "23827beee1980fe872d62c58a9711ba484bbdc73a9aeb0d7c2bcba8cc591c5bc",
      "evidence_id": "ev-23827beee198-0000-0002",
      "kind": "fact",
      "opinion_part": null,
      "pages": {
        "end": 2,
        "start": 2
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "In 2005, Google acquired Android and sought to build a new software platform for mobile devices."
    },
    {
      "attribution": "Court",
      "case_id": "2020-18-956",
      "confidence": 1.0,
      "document_hash": "23827beee1980fe872d62c58a9711ba484bbdc73a9aeb0d7c2bcba8cc591c5bc",
      "evidence_id": "ev-23827beee198-0000-0003",
      "kind": "fact",
      "opinion_part": null,
      "pages": {
        "end": 2,
        "start": 2
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "Google copied roughly 11,500 lines of code from the Java SE program."
    },
    {
      "attribution": "Court",
      "case_id": "2020-18-956",
      "confidence": 1.0,
      "document_hash": "23827beee1980fe872d62c58a9711ba484bbdc73a9aeb0d7c2bcba8cc591c5bc",
      "evidence_id": "ev-23827beee198-0000-0004",
      "kind": "fact",
      "opinion_part": null,
      "pages": {
        "end": 2,
        "start": 2
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "The Federal Circuit held that the copied lines are copyrightable."
    },
    {
      "attribution": "Court",
      "case_id": "2020-18-956",
      "confidence": 1.0,
      "document_hash": "23827beee1980fe872d62c58a9711ba484bbdc73a9aeb0d7c2bcba8cc591c5bc",
      "evidence_id": "ev-23827beee198-0000-0005",
      "kind": "fact",
      "opinion_part": null,
      "pages": {
        "end": 2,
        "start": 2
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "The Federal Circuit reversed, concluding that Google's copying was not a fair use as a matter of law."
    },
    {
      "attribution": "Justice Breyer",
      "case_id": "2020-18-956",
      "confidence": 1.0,
      "document_hash": "23827beee1980fe872d62c58a9711ba484bbdc73a9aeb0d7c2bcba8cc591c5bc",
      "evidence_id": "ev-23827beee198-0000-0009",
      "kind": "stated_consequence",
      "opinion_part": "majority",
      "pages": {
        "end": 8,
        "start": 8
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "thereby freeing Google from copyright liability."
    },
    {
      "attribution": "Justice Breyer",
      "case_id": "2020-18-956",
      "confidence": 1.0,
      "document_hash": "23827beee1980fe872d62c58a9711ba484bbdc73a9aeb0d7c2bcba8cc591c5bc",
      "evidence_id": "ev-23827beee198-0000-0010",
      "kind": "fact",
      "opinion_part": "majority",
      "pages": {
        "end": 10,
        "start": 10
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "What is an API? The Federal Circuit described an API as a tool that \u201callow[s] programmers to use . . . prewritten code to build certain functions into their own programs, rather than write their own code to perform those functions from scratch.\u201d"
    },
    {
      "attribution": "Justice Breyer",
      "case_id": "2020-18-956",
      "confidence": 1.0,
      "document_hash": "23827beee1980fe872d62c58a9711ba484bbdc73a9aeb0d7c2bcba8cc591c5bc",
      "evidence_id": "ev-23827beee198-0001-0000",
      "kind": "fact",
      "opinion_part": "majority",
      "pages": {
        "end": 11,
        "start": 11
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "The implementing code (which Google independently wrote) is not at issue here."
    },
    {
      "attribution": "Justice Breyer",
      "case_id": "2020-18-956",
      "confidence": 1.0,
      "document_hash": "23827beee1980fe872d62c58a9711ba484bbdc73a9aeb0d7c2bcba8cc591c5bc",
      "evidence_id": "ev-23827beee198-0001-0001",
      "kind": "fact",
      "opinion_part": "majority",
      "pages": {
        "end": 15,
        "start": 14
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "For 37 packages, however, Google copied the declaring code from the Sun Java API. Id., at 106\u2013107."
    },
    {
      "attribution": "Justice Breyer",
      "case_id": "2020-18-956",
      "confidence": 1.0,
      "document_hash": "23827beee1980fe872d62c58a9711ba484bbdc73a9aeb0d7c2bcba8cc591c5bc",
      "evidence_id": "ev-23827beee198-0001-0002",
      "kind": "procedural_event",
      "opinion_part": "majority",
      "pages": {
        "end": 16,
        "start": 15
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "After six weeks of hearing evidence, the jury rejected Oracle's patent claims (which have since dropped out of the case). It also found a limited copyright infringement. It deadlocked as to whether Google could successfully assert a fair use defense. Id., at 976."
    },
    {
      "attribution": "Court",
      "case_id": "2020-18-956",
      "confidence": 1.0,
      "document_hash": "23827beee1980fe872d62c58a9711ba484bbdc73a9aeb0d7c2bcba8cc591c5bc",
      "evidence_id": "ev-23827beee198-0001-0003",
      "kind": "holding",
      "opinion_part": "majority",
      "pages": {
        "end": 16,
        "start": 16
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "On appeal, the Federal Circuit reversed. That court held that both the API's declaring code and its organizational structure could be copyrighted. Oracle, 750 F. 3d, at 1354."
    },
    {
      "attribution": "Justice Breyer",
      "case_id": "2020-18-956",
      "confidence": 0.95,
      "document_hash": "23827beee1980fe872d62c58a9711ba484bbdc73a9aeb0d7c2bcba8cc591c5bc",
      "evidence_id": "ev-23827beee198-0002-0001",
      "kind": "fact",
      "opinion_part": "majority",
      "pages": {
        "end": 23,
        "start": 23
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "The upshot, in our view, is that fair use can play an important role in determining the lawful scope of a computer program copyright, such as the copyright at issue here. It can help to distinguish among technologies. It can distinguish between expressive and functional features of computer code where those features are mixed. It can focus on the legitimate need to provide incentives to produce copyrighted material while examining the extent to which yet further protection creates unrelated or illegitimate harms in other markets or to the development of other products."
    },
    {
      "attribution": "Court",
      "case_id": "2020-18-956",
      "confidence": 0.96,
      "document_hash": "23827beee1980fe872d62c58a9711ba484bbdc73a9aeb0d7c2bcba8cc591c5bc",
      "evidence_id": "ev-23827beee198-0002-0003",
      "kind": "holding",
      "opinion_part": "majority",
      "pages": {
        "end": 26,
        "start": 26
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "The Amendment both requires that \u201cthe right of trial by jury . . . be preserved\u201d and forbids courts to \u201cre-examin[e]\u201d any \u201cfact tried by a jury.\u201d U. S. Const., Amdt. 7; see also Gasperini v. Center for Humanities, Inc., 518 U. S. 415, 432\u2013433 (1996). The Reexamination Clause is no bar here, however, for, as we have said, the ultimate question here is one of law, not fact."
    },
    {
      "attribution": "R Street Institute",
      "case_id": "2020-18-956",
      "confidence": 1.0,
      "document_hash": "23827beee1980fe872d62c58a9711ba484bbdc73a9aeb0d7c2bcba8cc591c5bc",
      "evidence_id": "ev-23827beee198-0003-0001",
      "kind": "amicus_argument",
      "opinion_part": "majority",
      "pages": {
        "end": 32,
        "start": 32
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "Some of the amici refer to what Google did as \u201creimplementation,\u201d defned as the \u201cbuilding of a system . . . that repurposes the same words and syntaxes\u201d of an existing system\u2014in this case so that programmers who had learned an existing system could put their basic skills to use in a new one."
    },
    {
      "attribution": "Oracle",
      "case_id": "2020-18-956",
      "confidence": 1.0,
      "document_hash": "23827beee1980fe872d62c58a9711ba484bbdc73a9aeb0d7c2bcba8cc591c5bc",
      "evidence_id": "ev-23827beee198-0003-0002",
      "kind": "party_argument",
      "opinion_part": "majority",
      "pages": {
        "end": 39,
        "start": 39
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "Oracle presented evidence to the contrary."
    },
    {
      "attribution": "Court",
      "case_id": "2020-18-956",
      "confidence": 1.0,
      "document_hash": "23827beee1980fe872d62c58a9711ba484bbdc73a9aeb0d7c2bcba8cc591c5bc",
      "evidence_id": "ev-23827beee198-0003-0000",
      "kind": "holding",
      "opinion_part": "majority",
      "pages": {
        "end": 41,
        "start": 41
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "We reach the conclusion that in this case, where Google reimplemented a user interface, taking only what was needed to allow users to put their accrued talents to work in a new and transformative program, Google's copying of the Sun Java API was a fair use of that material as a matter of law."
    },
    {
      "attribution": "Justice Thomas",
      "case_id": "2020-18-956",
      "confidence": 1.0,
      "document_hash": "23827beee1980fe872d62c58a9711ba484bbdc73a9aeb0d7c2bcba8cc591c5bc",
      "evidence_id": "ev-23827beee198-0004-0000",
      "kind": "dissent",
      "opinion_part": "dissent",
      "pages": {
        "end": 44,
        "start": 44
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "Oracle spent years developing a programming library that successfully attracted software developers, thus enhancing the value of Oracle's products. 1 Google sought a license to use the library in Android, the operating system it was developing for mobile phones. But when the companies could not agree on terms, Google simply copied verbatim 11,500 lines of code from the library. As a result, it erased 97.5% of the value of Oracle's partnership with Amazon, made tens of billions of dollars, and established its position as the owner of the largest mobile operating system in the world. Despite this, the majority holds that this copying was fair use."
    },
    {
      "attribution": "Justice Thomas",
      "case_id": "2020-18-956",
      "confidence": 1.0,
      "document_hash": "23827beee1980fe872d62c58a9711ba484bbdc73a9aeb0d7c2bcba8cc591c5bc",
      "evidence_id": "ev-23827beee198-0005-0000",
      "kind": "dissent",
      "opinion_part": "dissent",
      "pages": {
        "end": 55,
        "start": 55
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "Thomas, J., dissenting"
    },
    {
      "attribution": "Justice Thomas",
      "case_id": "2020-18-956",
      "confidence": 1.0,
      "document_hash": "23827beee1980fe872d62c58a9711ba484bbdc73a9aeb0d7c2bcba8cc591c5bc",
      "evidence_id": "ev-23827beee198-0005-0001",
      "kind": "fact",
      "opinion_part": "dissent",
      "pages": {
        "end": 57,
        "start": 57
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "By copying Oracle's work, Google decimated Oracle's mar-\nket and created a mobile operating system now in over 2.5\nbillion actively used devices, earning tens of billions of\ndollars every year."
    },
    {
      "attribution": "Justice Thomas",
      "case_id": "2020-18-956",
      "confidence": 1.0,
      "document_hash": "23827beee1980fe872d62c58a9711ba484bbdc73a9aeb0d7c2bcba8cc591c5bc",
      "evidence_id": "ev-23827beee198-0005-0002",
      "kind": "fact",
      "opinion_part": "dissent",
      "pages": {
        "end": 57,
        "start": 57
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "In 2015 alone, the year before the fair-\nuse trial, Google earned $18 billion from Android."
    }
  ],
  "schema_version": "1.0.0"
}
