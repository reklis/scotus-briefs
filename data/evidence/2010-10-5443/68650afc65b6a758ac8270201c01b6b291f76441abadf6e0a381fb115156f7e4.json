        "start": 46
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "I'm not sure I understand your answer to Justice Kagan's hypothetical."
    },
    {
      "attribution": "Justice Breyer",
      "case_id": "2010-10-5443",
      "confidence": 1.0,
      "document_hash": "68650afc65b6a758ac8270201c01b6b291f76441abadf6e0a381fb115156f7e4",
