        "end": 38,
        "start": 38
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "I would like to start by going back to the language of Rule 23 and, in particular, the predominance"
    },
    {
      "attribution": "Justice Breyer",
      "case_id": "2012-11-1085",
      "confidence": 0.9,
