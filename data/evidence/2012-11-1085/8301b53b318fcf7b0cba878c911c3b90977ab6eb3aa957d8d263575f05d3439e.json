        "start": 41
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "Petitioners would have this Court do is isolate the two inquiries when they're really the same question."
    },
    {
      "attribution": "Court",
      "case_id": "2012-11-1085",
      "confidence": 0.9,
