        "start": 40
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "JUSTICE BREYER: Is that exactly right?"
    },
    {
      "attribution": "Petitioners",
      "case_id": "2012-11-1085",
      "confidence": 0.9,
      "document_hash": "8301b53b318fcf7b0cba878c911c3b90977ab6eb3aa957d8d263575f05d3439e",
      "evidence_id": "ev-8301b53b318f-0002-0001",
