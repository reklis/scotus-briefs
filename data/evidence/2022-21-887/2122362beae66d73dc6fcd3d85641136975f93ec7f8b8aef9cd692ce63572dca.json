      "kind": "holding",
      "opinion_part": "majority",
      "pages": {
        "end": 11,
        "start": 11
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "The judgment of the Court of Appeals is reversed, and the case is remanded for further proceedings consistent with this opinion."
    }
