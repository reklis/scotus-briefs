    },
    {
      "attribution": "Justice Barrett",
      "case_id": "2022-21-1168",
      "confidence": 1.0,
      "document_hash": "5149e9957088896777c37e9b85b7b4f13b1039e3b1ca526cc9a4fff773c15bbc",
      "evidence_id": "ev-5149e9957088-0005-0000",
      "kind": "dissent",
      "opinion_part": "dissent",
      "pages": {
        "end": 53,
        "start": 53
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "But the plurality cannot identify a single case from that period supporting its theory."
    }
