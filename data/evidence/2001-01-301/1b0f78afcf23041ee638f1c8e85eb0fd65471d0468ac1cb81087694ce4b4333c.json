{
  "case_id": "2001-01-301",
  "document_hash": "1b0f78afcf23041ee638f1c8e85eb0fd65471d0468ac1cb81087694ce4b4333c",
  "records": [
    {
      "attribution": "Chief Justice Rehnquist",
      "case_id": "2001-01-301",
      "confidence": 1.0,
      "document_hash": "1b0f78afcf23041ee638f1c8e85eb0fd65471d0468ac1cb81087694ce4b4333c",
      "evidence_id": "ev-1b0f78afcf23-0000-0000",
      "kind": "justice_question",
      "opinion_part": null,
