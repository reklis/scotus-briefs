  "records": [
    {
      "attribution": "Court",
      "case_id": "2004-04-563",
      "confidence": 1.0,
      "document_hash": "5f0acfd4b50253923d2cde94732e7110a7ac8b6e4708c947416b27bd36f61be0",
      "evidence_id": "ev-5f0acfd4b502-0000-0000",
