      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "QUESTION: Could they not --"
    },
    {
      "attribution": "Chief Justice Rehnquist",
      "case_id": "2001-00-832",
      "confidence": 1.0,
      "document_hash": "107abe67cf54b0c5d5fa4e08efbf7103e6288b596bebb036dec1abba918487cc",
      "evidence_id": "ev-107abe67cf54-0003-0005",
