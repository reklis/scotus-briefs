      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "ORAL ARGUMENT OF JONATHAN C. BOND FOR THE UNITED STATES, AS AMICUS CURIAE, SUPPORTING THE RESPONDENTS"
    },
    {
      "attribution": "Justice Sotomayor",
      "case_id": "2019-18-328",
      "confidence": 1.0,
      "document_hash": "b360289d7a29611552fe106378a728e4d40dea0637f66643ae458b16570577c4",
