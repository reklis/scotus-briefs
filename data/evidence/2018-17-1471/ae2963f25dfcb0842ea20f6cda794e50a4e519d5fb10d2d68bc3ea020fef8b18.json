        "start": 58
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "CHIEF JUSTICE ROBERTS: Where do people speak colloquially of third-party defendants?"
    },
    {
      "attribution": "Chief Justice Roberts",
      "case_id": "2018-17-1471",
      "confidence": 1.0,
      "document_hash": "ae2963f25dfcb0842ea20f6cda794e50a4e519d5fb10d2d68bc3ea020fef8b18",
      "evidence_id": "ev-ae2963f25dfc-0002-0004",
