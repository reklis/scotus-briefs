      "opinion_part": null,
      "pages": {
        "end": 65,
        "start": 65
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "CHIEF JUSTICE ROBERTS: Why isn't -- okay, each and every. Why doesn't it mean each and every defendant in the civil action, in the proceeding?"
    },
    {
      "attribution": "Justice Kagan",
      "case_id": "2018-17-1471",
      "confidence": 1.0,
      "document_hash": "ae2963f25dfcb0842ea20f6cda794e50a4e519d5fb10d2d68bc3ea020fef8b18",
