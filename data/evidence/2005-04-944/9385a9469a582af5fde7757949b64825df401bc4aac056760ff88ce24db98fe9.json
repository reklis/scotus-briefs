      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "CHIEF JUSTICE ROBERTS: Does it make a difference on the -- the -- does the categorization make a difference on the relevant time of the inquiry for the 15 employees?"
    },
    {
      "attribution": "Justice Scalia",
      "case_id": "2005-04-944",
      "confidence": 0.96,
      "document_hash": "9385a9469a582af5fde7757949b64825df401bc4aac056760ff88ce24db98fe9",
      "evidence_id": "ev-9385a9469a58-0002-0002",
      "kind": "justice_question",
      "opinion_part": null,
      "pages": {
