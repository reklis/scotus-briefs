      "schema_version": "1.0.0",
      "status": "supported",
      "text": "We are here today to obtain a construction of the Federal Trademark Dilution Act, FTDA, that will keep Federal trademark law in its proper bounds."
    },
    {
      "attribution": "Justice",
      "case_id": "2002-01-1015",
      "confidence": 1.0,
      "document_hash": "c70b02f1b4d1a824bf09dde065c238b1e45ddfba0d61bc88821241de5d2b52de",
