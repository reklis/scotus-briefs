      "schema_version": "1.0.0",
      "status": "supported",
      "text": "Paragraph 6 of section 2255 provides that, quote, a 1-year period of limitation shall apply to a motion under this section."
    },
    {
      "attribution": "Justice Ginsburg",
      "case_id": "2002-01-1500",
      "confidence": 0.92,
      "document_hash": "d21b53158b853c4e053f6b3d273f1dae62cc5d87e7a1d0812ffaf05e68e4affb",
