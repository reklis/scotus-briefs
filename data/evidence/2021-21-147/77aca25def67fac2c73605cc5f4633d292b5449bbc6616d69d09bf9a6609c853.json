      "schema_version": "1.0.0",
      "status": "supported",
      "text": "Applying the foregoing principles, the Court of Appeals plainly erred when it created causes of action for Boule's"
    },
    {
      "attribution": "Court",
      "case_id": "2021-21-147",
      "confidence": 0.96,
      "document_hash": "77aca25def67fac2c73605cc5f4633d292b5449bbc6616d69d09bf9a6609c853",
      "evidence_id": "ev-77aca25def67-0001-0000",
