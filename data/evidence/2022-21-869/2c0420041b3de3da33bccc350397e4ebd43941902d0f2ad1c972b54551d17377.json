  "records": [
    {
      "attribution": "Court",
      "case_id": "2022-21-869",
      "confidence": 1.0,
      "document_hash": "2c0420041b3de3da33bccc350397e4ebd43941902d0f2ad1c972b54551d17377",
      "evidence_id": "ev-2c0420041b3d-0000-0000",
      "kind": "procedural_event",
