  "records": [
    {
      "attribution": "Supreme Court",
      "case_id": "2001-99-1996",
      "confidence": 1.0,
      "document_hash": "a6f14db4cf364d5a31e7011feea2ff1d5627a46e5729cb0ddcec1c5da7d63219",
      "evidence_id": "ev-a6f14db4cf36-0000-0000",
      "kind": "procedural_event",
      "opinion_part": null,
