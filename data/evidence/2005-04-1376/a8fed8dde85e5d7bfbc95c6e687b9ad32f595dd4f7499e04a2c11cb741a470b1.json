      "opinion_part": null,
      "pages": {
        "end": 23,
        "start": 23
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "JUSTICE KENNEDY: Did Judge McConnell, in the Tenth Circuit, suggest -- because he discussed this -- suggest that the result might have been different if the marriage had been before?"
    },
    {
      "attribution": "Court",
      "case_id": "2005-04-1376",
      "confidence": 0.9,
