      "pages": {
        "end": 22,
        "start": 22
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "JUSTICE BREYER: Ten to 20 years?"
    },
    {
      "attribution": "Justice Kennedy",
      "case_id": "2005-04-1376",
      "confidence": 0.9,
      "document_hash": "a8fed8dde85e5d7bfbc95c6e687b9ad32f595dd4f7499e04a2c11cb741a470b1",
      "evidence_id": "ev-a8fed8dde85e-0001-0003",
