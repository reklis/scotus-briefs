      "pages": {
        "end": 8,
        "start": 8
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "The soundness of that straightforward conclusion is \u201creinforced by the consequences that would follow\u201d from a contrary approach."
    },
    {
      "attribution": "Court",
      "case_id": "2022-21-442",
