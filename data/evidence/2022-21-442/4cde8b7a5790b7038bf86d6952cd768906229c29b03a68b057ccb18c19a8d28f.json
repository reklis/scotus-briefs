      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "The CCA denied rehearing by summary order in October 2017."
    },
    {
      "attribution": "Justice Thomas",
      "case_id": "2022-21-442",
      "confidence": 1.0,
      "document_hash": "4cde8b7a5790b7038bf86d6952cd768906229c29b03a68b057ccb18c19a8d28f",
