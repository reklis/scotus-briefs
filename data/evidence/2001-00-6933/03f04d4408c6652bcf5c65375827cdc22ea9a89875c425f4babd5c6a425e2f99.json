      "schema_version": "1.0.0",
      "status": "supported",
      "text": "ORAL ARGUMENT OF BONNIE I. ROBIN-VERGEER, ESQ. On behalf of the Petitioner"
    },
    {
      "attribution": "Bonnie I. Robin-Vergeer",
      "case_id": "2001-00-6933",
      "confidence": 1.0,
      "document_hash": "03f04d4408c6652bcf5c65375827cdc22ea9a89875c425f4babd5c6a425e2f99",
      "evidence_id": "ev-03f04d4408c6-0000-0001",
