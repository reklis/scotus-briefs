{
  "case_id": "2022-21-1170",
  "document_hash": "e4dc0a4e320a58cfa025c3124c5b303866d0eea27f20924722f6839934fe6097",
  "records": [
    {
      "attribution": "Court",
      "case_id": "2022-21-1170",
      "confidence": 1.0,
      "document_hash": "e4dc0a4e320a58cfa025c3124c5b303866d0eea27f20924722f6839934fe6097",
      "evidence_id": "ev-e4dc0a4e320a-0000-0001",
      "kind": "fact",
      "opinion_part": null,
      "pages": {
        "end": 2,
        "start": 2
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "In the operative indictment and at trial, the Government relied solely on the Second Circuit's right-to-control theory of wire fraud, under which the Government can establish wire fraud by showing that the defendant schemed to deprive a victim of potentially valuable economic information necessary to make discretionary economic decisions."
    },
    {
      "attribution": "Court",
      "case_id": "2022-21-1170",
      "confidence": 1.0,
      "document_hash": "e4dc0a4e320a58cfa025c3124c5b303866d0eea27f20924722f6839934fe6097",
      "evidence_id": "ev-e4dc0a4e320a-0000-0002",
      "kind": "procedural_event",
      "opinion_part": null,
      "pages": {
        "end": 2,
        "start": 2
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "certiorari to the united states court of appeals for the second circuit"
    },
    {
      "attribution": "United States",
      "case_id": "2022-21-1170",
      "confidence": 1.0,
      "document_hash": "e4dc0a4e320a58cfa025c3124c5b303866d0eea27f20924722f6839934fe6097",
      "evidence_id": "ev-e4dc0a4e320a-0000-0004",
      "kind": "party_argument",
      "opinion_part": "majority",
      "pages": {
        "end": 4,
        "start": 4
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "Deputy Solicitor General Feigin argued the cause for the United States."
    },
    {
      "attribution": "Court",
      "case_id": "2022-21-1170",
      "confidence": 1.0,
      "document_hash": "e4dc0a4e320a58cfa025c3124c5b303866d0eea27f20924722f6839934fe6097",
      "evidence_id": "ev-e4dc0a4e320a-0001-0000",
      "kind": "holding",
      "opinion_part": "majority",
      "pages": {
        "end": 12,
        "start": 12
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "In sum, the wire fraud statute reaches only traditional\nproperty interests. The right to valuable economic informa-\ntion needed to make discretionary economic decisions is not\na traditional property interest. Accordingly, the right-to-\ncontrol theory cannot form the basis for a conviction under\nthe federal fraud statutes."
    },
    {
      "attribution": "Justice Alito",
      "case_id": "2022-21-1170",
      "confidence": 1.0,
      "document_hash": "e4dc0a4e320a58cfa025c3124c5b303866d0eea27f20924722f6839934fe6097",
      "evidence_id": "ev-e4dc0a4e320a-0001-0001",
      "kind": "concurrence",
      "opinion_part": "concurrence",
      "pages": {
        "end": 13,
        "start": 13
      },
      "schema_version": "1.0.0",
      "status": "supported",
      "text": "Accordingly, we decline the Government's request to affrm\nCiminelli's convictions on alternative grounds."
    }
  ],
  "schema_version": "1.0.0"
}
