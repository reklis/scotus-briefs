{
  "case_id": "2005-05-8794",
  "document_hash": "86f5d456d8897c95feb3383bfb3e6cdb0c79c0de5890488dc7f6ace536ced968",
  "records": [
    {
      "attribution": "Court",
      "case_id": "2005-05-8794",
