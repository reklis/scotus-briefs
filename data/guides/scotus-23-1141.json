            }
          },
          {
            "document_hash": "3bf648c8d88b1204f354168f13ac94f67f750f69238f07786c7992e063eb7a66",
            "evidence_ids": [
              "ev-3bf648c8d88b-0001-0005"
            ],
            "pages": {
              "end": 20,
              "start": 20
            }
          }
        ],
        "text": "The Court held that Mexico had not plausibly alleged aiding and abetting by the manufacturers, and therefore the PLCAA prevents the suit from going forward."
      }
    ],
