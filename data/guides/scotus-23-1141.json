            ],
            "pages": {
              "end": 12,
              "start": 12
            }
          }
        ],
        "text": "The manufacturers moved to dismiss the complaint, arguing that the PLCAA bars the suit."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "3bf648c8d88b1204f354168f13ac94f67f750f69238f07786c7992e063eb7a66",
            "evidence_ids": [
              "ev-3bf648c8d88b-0001-0003"
            ],
            "pages": {
