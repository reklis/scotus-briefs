              "end": 43,
              "start": 43
            }
          }
        ],
        "text": "Justice Alito later asked about the attack described by Mr. Williams involving the councilwoman."
      },
      {
        "attribution": "Justice Ginsburg",
        "citations": [
          {
            "document_hash": "01b1e0b1cf378dcae284afc0a584df56fc27ae927c62a176f44a3df1c7568b54",
