                "end": 4,
                "start": 4
              }
            }
          ],
          "text": "According to Petitioner (Michael G. Frick), the petitioner contends that, under AEDPA, recharacterization should never occur unless the petitioner himself consents."
        },
        {
          "attribution": "Mr. Frick",
          "citations": [
            {
              "document_hash": "7e8fb17aa3cd8e37246b4b8b30837396dec03a255a8655f3cc7a8bb862ce4df7",
