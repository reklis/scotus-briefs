                "ev-7e8fb17aa3cd-0001-0001"
              ],
              "pages": {
                "end": 20,
                "start": 20
              }
            }
          ],
          "text": "According to Mr. Frick, frick also noted that recharacterizations have historically been made for the benefit of pro se prisoners."
        }
      ],
      "heading": "Petitioner (Michael G. Frick)",
      "status": "complete",
      "summary": null,
