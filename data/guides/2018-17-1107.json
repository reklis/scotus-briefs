              "start": 45
            }
          }
        ],
        "text": "Justice Breyer asked, \"What happens to all those people? What happens to all those laws?\""
      },
      {
        "attribution": "Justice ALITO",
        "citations": [
          {
            "document_hash": "e822f1390831c8d4a2868135baf3e0040f73861b12ef526bfb1733fb5ccc2f9b",
