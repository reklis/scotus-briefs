                "start": 39
              }
            }
          ],
          "text": "According to FERC, fERC asserts it has jurisdiction over transmission under the wholesale sales and transmission clauses of the statute."
        },
        {
          "attribution": "FERC",
          "citations": [
            {
              "document_hash": "d335501401b3d8804c6a1f43bb23e49f997234e7915398e825ed1088184a0038",
