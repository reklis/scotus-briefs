            "evidence_ids": [
              "ev-d335501401b3-0002-0004"
            ],
            "pages": {
              "end": 45,
              "start": 44
            }
          }
        ],
        "text": "Petitioners argue that states should be able to set retail rates that include transmission costs, while respondents contend that FERC has jurisdiction over transmission but may choose not to exercise it."
      }
