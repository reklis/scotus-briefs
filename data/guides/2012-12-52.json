  "overview": {
    "claims": [
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "eefc4879d57f4c9c96dc8602e9f3153a9524c4304dfb59196e706765806d64da",
            "evidence_ids": [
              "ev-eefc4879d57f-0000-0001"
            ],
            "pages": {
              "end": 3,
              "start": 3
            }
          }
        ],
        "text": "The case concerns whether Section 14501 of the United States Transportation Code preempts state consumer\u2011protection tort claims against a tow\u2011truck company that lawfully towed a vehicle and later disposed of it after the owner failed to pay towing and storage fees."
      },
      {
        "attribution": "Petitioner",
        "citations": [
          {
            "document_hash": "eefc4879d57f4c9c96dc8602e9f3153a9524c4304dfb59196e706765806d64da",
            "evidence_ids": [
              "ev-eefc4879d57f-0000-0002"
            ],
            "pages": {
              "end": 3,
              "start": 3
            }
          }
        ],
        "text": "The petitioner argues that the state consumer\u2011protection claims are preempted because they target the conduct of non\u2011consensual tows performed by tow\u2011truck companies."
      }
    ],
    "heading": "Overview",
    "status": "complete",
    "summary": null,
    "summary_citations": []
  },
  "party_positions": [
    {
      "claims": [
        {
          "attribution": "Petitioner",
          "citations": [
            {
              "document_hash": "eefc4879d57f4c9c96dc8602e9f3153a9524c4304dfb59196e706765806d64da",
              "evidence_ids": [
                "ev-eefc4879d57f-0000-0002"
              ],
              "pages": {
                "end": 3,
                "start": 3
              }
            }
          ],
          "text": "According to Petitioner, both claims are preempted because they are directed at the conduct \u2013 the type of conduct that tow\u2011truck companies all over the country engage in \u2013 dealing with a particular type of tow referred to in the business as non\u2011consensual tows."
        },
        {
          "attribution": "Mr. Bouffard",
          "citations": [
            {
              "document_hash": "eefc4879d57f4c9c96dc8602e9f3153a9524c4304dfb59196e706765806d64da",
              "evidence_ids": [
                "ev-eefc4879d57f-0001-0002"
              ],
              "pages": {
                "end": 22,
                "start": 22
              }
            }
          ],
          "text": "According to Mr. Bouffard, consumer protection is not an area of traditional state regulation."
        }
      ],
