              "ev-27dd16f9c708-0003-0004"
            ],
            "pages": {
              "end": 37,
              "start": 33
            }
          }
        ],
        "text": "Justice Breyer dissented, arguing that \u00a7\u202f1231 should not be read to deny bond hearings to aliens seeking withholding\u2011only relief and that \u00a7\u202f1226 should apply instead."
      }
    ],
