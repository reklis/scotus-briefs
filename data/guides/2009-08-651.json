  "overview": {
    "claims": [
      {
        "attribution": "Petitioner",
        "citations": [
          {
            "document_hash": "2680d3fef795246349cdf4ba48574b87c70617184e33c0ef1dde61c780711ccd",
            "evidence_ids": [
              "ev-2680d3fef795-0000-0000"
            ],
            "pages": {
              "end": 3,
              "start": 3
            }
          },
          {
            "document_hash": "2680d3fef795246349cdf4ba48574b87c70617184e33c0ef1dde61c780711ccd",
            "evidence_ids": [
              "ev-2680d3fef795-0001-0000"
            ],
            "pages": {
              "end": 20,
              "start": 20
            }
          }
        ],
        "text": "The case Jose Padilla v. Kentucky concerns whether the Sixth Amendment requires defense counsel to advise a defendant about immigration consequences of a guilty plea."
      },
      {
        "attribution": "Petitioner",
        "citations": [
          {
            "document_hash": "2680d3fef795246349cdf4ba48574b87c70617184e33c0ef1dde61c780711ccd",
            "evidence_ids": [
              "ev-2680d3fef795-0000-0000"
            ],
            "pages": {
              "end": 3,
              "start": 3
            }
          }
        ],
        "text": "The petitioner argues that the Kentucky Supreme Court\u2019s rule is a categorical restriction of the Sixth Amendment and provides no remedy for defendants misadvised about deportation."
      },
      {
        "attribution": "United States",
        "citations": [
          {
            "document_hash": "2680d3fef795246349cdf4ba48574b87c70617184e33c0ef1dde61c780711ccd",
            "evidence_ids": [
              "ev-2680d3fef795-0001-0000"
            ],
            "pages": {
              "end": 20,
              "start": 20
            }
          }
        ],
        "text": "The United States government maintains that the Sixth Amendment does not create a duty to advise about collateral consequences, and that the Kentucky rule is overly expansive."
      },
      {
        "attribution": "United States",
        "citations": [
          {
            "document_hash": "2680d3fef795246349cdf4ba48574b87c70617184e33c0ef1dde61c780711ccd",
            "evidence_ids": [
              "ev-2680d3fef795-0001-0002"
            ],
            "pages": {
              "end": 26,
              "start": 26
            }
          }
        ],
        "text": "According to United States, there is a split among federal circuits: ten circuits say there is no duty to advise about collateral consequences, while seven circuits allow a claim for affirmative misadvice."
      }
    ],
    "heading": "Overview",
    "status": "complete",
    "summary": null,
    "summary_citations": []
  },
  "party_positions": [
    {
      "claims": [
        {
          "attribution": "Petitioner",
          "citations": [
            {
              "document_hash": "2680d3fef795246349cdf4ba48574b87c70617184e33c0ef1dde61c780711ccd",
              "evidence_ids": [
                "ev-2680d3fef795-0000-0000"
              ],
              "pages": {
                "end": 3,
                "start": 3
              }
            }
          ],
          "text": "The petitioner argues that the Kentucky Supreme Court announced a categorical rule that is overly restrictive of the Sixth Amendment and provides no remedy for a defendant misadvised about deportation."
        },
        {
          "attribution": "Petitioner",
          "citations": [
            {
              "document_hash": "2680d3fef795246349cdf4ba48574b87c70617184e33c0ef1dde61c780711ccd",
              "evidence_ids": [
                "ev-2680d3fef795-0000-0001"
              ],
              "pages": {
                "end": 4,
                "start": 4
              }
            }
          ],
          "text": "The petitioner contends that the test for misadvice should be whether it is a material misrepresentation that would be material to a reasonable defendant deciding whether to plead guilty."
        }
      ],
      "heading": "Petitioner (Jose Padilla)",
      "status": "complete",
      "summary": null,
      "summary_citations": []
    },
    {
      "claims": [
        {
          "attribution": "Respondent",
          "citations": [
            {
              "document_hash": "2680d3fef795246349cdf4ba48574b87c70617184e33c0ef1dde61c780711ccd",
              "evidence_ids": [
                "ev-2680d3fef795-0001-0003"
              ],
              "pages": {
                "end": 35,
                "start": 35
              }
            }
          ],
          "text": "According to Respondent, the respondent cites Hill v. Lockhart, emphasizing that the voluntariness of a plea depends on counsel\u2019s advice and whether that advice is within the range of competence in a criminal proceeding."
        }
      ],
      "heading": "Respondent (Kentucky)",
      "status": "complete",
      "summary": null,
      "summary_citations": []
    },
    {
      "claims": [
        {
          "attribution": "United States",
          "citations": [
            {
              "document_hash": "2680d3fef795246349cdf4ba48574b87c70617184e33c0ef1dde61c780711ccd",
              "evidence_ids": [
                "ev-2680d3fef795-0001-0000"
              ],
              "pages": {
                "end": 20,
                "start": 20
              }
            }
          ],
          "text": "The United States argues there is a fundamental difference between the petitioner\u2019s claim of a duty to advise on all collateral consequences and the government\u2019s view that such a duty is not required under the Sixth Amendment."
        },
        {
          "attribution": "United States",
          "citations": [
            {
              "document_hash": "2680d3fef795246349cdf4ba48574b87c70617184e33c0ef1dde61c780711ccd",
              "evidence_ids": [
                "ev-2680d3fef795-0001-0002"
              ],
              "pages": {
                "end": 26,
                "start": 26
              }
            }
          ],
          "text": "According to United States, the amicus notes that ten federal circuits currently hold there is no duty to advise about collateral consequences, while seven circuits allow a claim for affirmative misadvice about such consequences."
        }
      ],
      "heading": "United States (Amicus)",
      "status": "complete",
      "summary": null,
      "summary_citations": []
    }
