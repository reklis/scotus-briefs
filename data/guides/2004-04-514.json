              "start": 20
            }
          }
        ],
        "text": "Justice Stevens asked whether the petitioner herself and the defendant had been interviewed."
      },
      {
        "attribution": "Justice GINSBURG",
        "citations": [
          {
            "document_hash": "71980649e42dab6a81b31ab164899fb8c80c7f3a9f6f2bf7be75b1c1ef6ee4bf",
