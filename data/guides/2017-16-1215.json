            }
          },
          {
            "document_hash": "b2eb95a27a0d39eb030aebbec648ca9dd949286a76fbbdcfc681851a89357e43",
            "evidence_ids": [
              "ev-b2eb95a27a0d-0001-0003"
            ],
            "pages": {
              "end": 27,
              "start": 27
            }
          },
          {
            "document_hash": "b2eb95a27a0d39eb030aebbec648ca9dd949286a76fbbdcfc681851a89357e43",
            "evidence_ids": [
              "ev-b2eb95a27a0d-0002-0001"
            ],
            "pages": {
              "end": 45,
              "start": 45
            }
          }
        ],
        "text": "Both the petitioner, the respondent, and the United States (Amicus) argue about the meaning of a \u201cstatement respecting financial condition\u201d and whether it should be limited to balance\u2011sheet items or include broader statements about ability to pay."
      }
    ],
