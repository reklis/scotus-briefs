          }
        ],
        "text": "According to National Association of Manufacturers, the Clean Water Act limits judicial review by courts of appeals to seven specific EPA actions defined in Section\u202f1369(b)(1)."
      },
      {
        "attribution": "National Association of Manufacturers",
        "citations": [
          {
            "document_hash": "3e86501da6dfa2c9530ed2d4b85080b74b40f0b7aa010ac7b85d55cb0fe77bbb",
            "evidence_ids": [
              "ev-3e86501da6df-0000-0000"
            ],
            "pages": {
              "end": 4,
              "start": 4
            }
          }
        ],
        "text": "According to National Association of Manufacturers, congress intentionally listed only those actions, unlike the Clean Air Act which provides broader appellate review."
      }
    ],
