              "evidence_ids": [
                "ev-46081876c294-0002-0000"
              ],
              "pages": {
                "end": 38,
                "start": 38
              }
            }
          ],
          "text": "Mr. Rothfeld argues that Congress intended all statutory categories of child survivor benefit applicants to qualify without reference to State law."
        }
      ],
