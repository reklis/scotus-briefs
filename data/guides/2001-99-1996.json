  "party_positions": [
    {
      "claims": [
        {
          "attribution": "Bruce E. Johnson",
          "citations": [
            {
              "document_hash": "a6f14db4cf364d5a31e7011feea2ff1d5627a46e5729cb0ddcec1c5da7d63219",
              "evidence_ids": [
                "ev-a6f14db4cf36-0000-0001"
              ],
              "pages": {
                "end": 3,
                "start": 3
              }
            }
          ],
          "text": "According to Bruce E. Johnson, the patents on the corn plant varieties are invalid because Congress enacted a specific statutory scheme (the Plant Variety Protection Act) to govern protection of such living things."
        }
      ],
      "heading": "Petitioner \u2013 J.E.M. AG SUPPLY, INC., DBA FARM ADVANTAGE INC.",
      "status": "complete",
      "summary": null,
      "summary_citations": []
    },
    {
      "claims": [
        {
          "attribution": "Edmund J. Sease",
          "citations": [
            {
              "document_hash": "a6f14db4cf364d5a31e7011feea2ff1d5627a46e5729cb0ddcec1c5da7d63219",
              "evidence_ids": [
                "ev-a6f14db4cf36-0001-0000"
              ],
              "pages": {
                "end": 19,
                "start": 19
              }
            }
          ],
          "text": "According to Edmund J. Sease, congress intended the Plant Variety Protection statute to regulate the right to exclude others from sexually multiplying plant varieties, not to intervene in ordinary seed marketing."
        },
        {
          "attribution": "Edmund J. Sease",
          "citations": [
            {
              "document_hash": "a6f14db4cf364d5a31e7011feea2ff1d5627a46e5729cb0ddcec1c5da7d63219",
              "evidence_ids": [
                "ev-a6f14db4cf36-0001-0001"
              ],
              "pages": {
                "end": 22,
                "start": 22
              }
            }
          ],
          "text": "According to Edmund J. Sease, the Plant Variety Protection system requires disclosure of breeding history, a requirement that does not exist for utility patents."
        },
        {
          "attribution": "Edmund J. Sease",
          "citations": [
            {
              "document_hash": "a6f14db4cf364d5a31e7011feea2ff1d5627a46e5729cb0ddcec1c5da7d63219",
              "evidence_ids": [
                "ev-a6f14db4cf36-0001-0005"
              ],
              "pages": {
                "end": 34,
                "start": 34
              }
            }
          ],
          "text": "According to Edmund J. Sease, the respondent asserts that the plaintiff\u2019s activities constitute infringement of the utility patent."
        },
        {
          "attribution": "Edmund J. Sease",
          "citations": [
            {
              "document_hash": "a6f14db4cf364d5a31e7011feea2ff1d5627a46e5729cb0ddcec1c5da7d63219",
              "evidence_ids": [
                "ev-a6f14db4cf36-0001-0006"
              ],
              "pages": {
                "end": 34,
                "start": 34
              }
            }
          ],
          "text": "According to Edmund J. Sease, the respondent notes that a party can obtain permission to use the patented seed by paying a licensing fee."
        },
        {
          "attribution": "Mr. Sease",
          "citations": [
            {
              "document_hash": "a6f14db4cf364d5a31e7011feea2ff1d5627a46e5729cb0ddcec1c5da7d63219",
              "evidence_ids": [
                "ev-a6f14db4cf36-0002-0000"
              ],
              "pages": {
                "end": 35,
                "start": 35
              }
            }
          ],
          "text": "According to Mr. Sease, utility patent protection is critically important in the seed industry because seeds can be easily copied through self\u2011replication."
        }
      ],
      "heading": "Respondent \u2013 PIONEER HI\u2011BRED INTERNATIONAL, INC.",
      "status": "complete",
      "summary": null,
      "summary_citations": []
    },
    {
      "claims": [
        {
          "attribution": "Lawrence G. Wallace",
          "citations": [
            {
              "document_hash": "a6f14db4cf364d5a31e7011feea2ff1d5627a46e5729cb0ddcec1c5da7d63219",
              "evidence_ids": [
                "ev-a6f14db4cf36-0002-0001"
              ],
              "pages": {
                "end": 39,
                "start": 39
              }
            }
          ],
          "text": "According to Lawrence G. Wallace, the Court\u2019s prior discussion in Diamond v. Chakrabarty highlighted the central role of the Plant Patent Act and the Plant Variety Protection Act in debates over plant\u2011related intellectual property."
        }
