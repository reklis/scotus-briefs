            "pages": {
              "end": 20,
              "start": 20
            }
          }
        ],
        "text": "According to Justice Scalia, justice Scalia responded that attorney\u2019s fees are never appropriate."
      },
      {
        "attribution": "Justice Ginsburg",
        "citations": [
          {
            "document_hash": "c21766635739c600330da2e90e7e9778181b58393426832692c71ceb01d5be09",
