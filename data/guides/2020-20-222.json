  },
  "case_id": "2020-20-222",
  "decision": {
    "claims": [
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "f63bb538fd6b0a9af67d4588b3d65fef090ae457a7503196b09e822b7e304129",
            "evidence_ids": [
              "ev-f63bb538fd6b-0001-0000"
            ],
            "pages": {
              "end": 12,
              "start": 12
            }
          }
        ],
        "text": "The Court held that the generic nature of a misrepresentation can be important evidence of a lack of price impact."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "f63bb538fd6b0a9af67d4588b3d65fef090ae457a7503196b09e822b7e304129",
            "evidence_ids": [
              "ev-f63bb538fd6b-0001-0004"
            ],
            "pages": {
              "end": 15,
              "start": 15
            }
          }
        ],
        "text": "The Court held that the defendant bears the burden of persuasion to prove a lack of price impact."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "f63bb538fd6b0a9af67d4588b3d65fef090ae457a7503196b09e822b7e304129",
            "evidence_ids": [
              "ev-f63bb538fd6b-0002-0000"
            ],
            "pages": {
              "end": 23,
              "start": 23
            }
          }
        ],
        "text": "The Court affirmed that the plaintiff bears the burden of proving the essential elements of its claim, including reliance."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "f63bb538fd6b0a9af67d4588b3d65fef090ae457a7503196b09e822b7e304129",
            "evidence_ids": [
              "ev-f63bb538fd6b-0002-0001"
            ],
            "pages": {
              "end": 23,
              "start": 23
            }
          }
        ],
        "text": "The Court stated that once the plaintiff shows the required element, the presumption of reliance drops and the trier of fact decides reliance, with the plaintiff still bearing the burden of proof."
      },
      {
        "attribution": "Justice Barrett",
        "citations": [
          {
            "document_hash": "f63bb538fd6b0a9af67d4588b3d65fef090ae457a7503196b09e822b7e304129",
            "evidence_ids": [
              "ev-f63bb538fd6b-0002-0004"
            ],
            "pages": {
              "end": 27,
              "start": 27
            }
          }
        ],
        "text": "Justice Barrett filed a dissent."
      }
    ],
