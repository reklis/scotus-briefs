          }
        ],
        "text": "OSHA published its COVID\u201119 vaccine mandate on November\u202f5,\u202f2021."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "797cd667f062a7e051d50682446c857399f07ff306ae972f72345c0721dc8fab",
            "evidence_ids": [
              "ev-797cd667f062-0000-0006"
            ],
            "pages": {
              "end": 8,
              "start": 8
            }
          }
        ],
        "text": "Covered employers must develop, implement, and enforce a mandatory COVID\u201119 vaccination policy."
      },
      {
        "attribution": "Agency",
        "citations": [
          {
            "document_hash": "53aeb924bcde3513081a06427fe9e3459306e1498fa94da1df1827f0d4ebc7e3",
