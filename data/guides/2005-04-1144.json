              "end": 6,
              "start": 6
            }
          }
        ],
        "text": "Justice Kennedy asked whether the petitioner\u2019s reference was to the specific act under review or to the broader law and constitutional protections."
      },
      {
        "attribution": "Justice Kennedy",
        "citations": [
          {
            "document_hash": "dc05b8b416e9b39d837952ed2a2981706e8c99d589ea660f32ac09ea81369f5e",
