  "overview": {
    "claims": [
      {
        "attribution": "Roberto A. Lange",
        "citations": [
          {
            "document_hash": "de18b96983ea01ba3ab98573a30647660d9572248433428bdf85a14a25359d9d",
            "evidence_ids": [
              "ev-de18b96983ea-0000-0001"
            ],
            "pages": {
              "end": 3,
              "start": 3
            }
          }
        ],
        "text": "According to Roberto A. Lange, the case concerns whether a stay and abeyance procedure should be used to apply the total exhaustion rule."
      },
      {
        "attribution": "Roberto A. Lange",
        "citations": [
          {
            "document_hash": "de18b96983ea01ba3ab98573a30647660d9572248433428bdf85a14a25359d9d",
            "evidence_ids": [
              "ev-de18b96983ea-0000-0001"
            ],
            "pages": {
              "end": 3,
              "start": 3
            }
          }
        ],
        "text": "According to Roberto A. Lange, several Justices of this Court have endorsed stay and abeyance, and seven of the eight circuit courts of appeals have permitted it in similar circumstances."
      },
      {
        "attribution": "State",
        "citations": [
          {
            "document_hash": "de18b96983ea01ba3ab98573a30647660d9572248433428bdf85a14a25359d9d",
            "evidence_ids": [
              "ev-de18b96983ea-0001-0000"
            ],
            "pages": {
              "end": 19,
              "start": 19
            }
          }
        ],
        "text": "The State argues that circuit courts have approved stay and abeyance and that it is not causing undue delay."
      },
      {
        "attribution": "Respondent",
        "citations": [
          {
            "document_hash": "de18b96983ea01ba3ab98573a30647660d9572248433428bdf85a14a25359d9d",
            "evidence_ids": [
              "ev-de18b96983ea-0001-0002"
            ],
            "pages": {
              "end": 21,
              "start": 21
            }
          }
        ],
        "text": "The Respondent contends that stay and abeyance extends the statute of limitations beyond one year and conflicts with the total exhaustion requirement of 2254(b)."
      },
      {
        "attribution": "Respondent",
        "citations": [
          {
            "document_hash": "de18b96983ea01ba3ab98573a30647660d9572248433428bdf85a14a25359d9d",
            "evidence_ids": [
              "ev-de18b96983ea-0001-0002"
            ],
            "pages": {
              "end": 21,
              "start": 21
            }
          }
        ],
        "text": "The Respondent also argues that stay and abeyance erodes each side of the triangular statutory design."
      },
      {
        "attribution": "Roberto A. Lange",
        "citations": [
          {
            "document_hash": "de18b96983ea01ba3ab98573a30647660d9572248433428bdf85a14a25359d9d",
            "evidence_ids": [
              "ev-de18b96983ea-0000-0003"
            ],
            "pages": {
              "end": 6,
              "start": 6
            }
          }
        ],
        "text": "Roberto A. Lange argues that the petition does not constitute a free ride and does not frustrate the one\u2011year statute of limitations."
      },
      {
        "attribution": "Mr. Lange",
        "citations": [
          {
            "document_hash": "de18b96983ea01ba3ab98573a30647660d9572248433428bdf85a14a25359d9d",
            "evidence_ids": [
              "ev-de18b96983ea-0002-0002"
            ],
            "pages": {
              "end": 42,
              "start": 42
            }
          }
        ],
        "text": "Mr. Lange says a district court should ensure a petition meets the standards of \u00a72254(b)(2) when evaluating a stay and abeyance request."
      }
    ],
    "heading": "Overview",
    "status": "complete",
    "summary": null,
    "summary_citations": []
  },
  "party_positions": [
    {
      "claims": [
        {
          "attribution": "Roberto A. Lange",
          "citations": [
            {
              "document_hash": "de18b96983ea01ba3ab98573a30647660d9572248433428bdf85a14a25359d9d",
              "evidence_ids": [
                "ev-de18b96983ea-0000-0001"
              ],
              "pages": {
                "end": 3,
                "start": 3
              }
            }
          ],
          "text": "According to Roberto A. Lange, stay and abeyance is the proper way to administer the total exhaustion rule under the unique facts of this case."
        },
        {
          "attribution": "Roberto A. Lange",
          "citations": [
            {
              "document_hash": "de18b96983ea01ba3ab98573a30647660d9572248433428bdf85a14a25359d9d",
              "evidence_ids": [
                "ev-de18b96983ea-0000-0003"
              ],
              "pages": {
                "end": 6,
                "start": 6
              }
            }
          ],
          "text": "According to Roberto A. Lange, i disagree that this is a free ride, and it does not frustrate the one\u2011year statute of limitations."
        },
        {
          "attribution": "Mr. Lange",
          "citations": [
            {
              "document_hash": "de18b96983ea01ba3ab98573a30647660d9572248433428bdf85a14a25359d9d",
              "evidence_ids": [
                "ev-de18b96983ea-0002-0002"
              ],
              "pages": {
                "end": 42,
                "start": 42
              }
            }
          ],
          "text": "According to Mr. Lange, a district court should ensure the petition meets the standards of \u00a72254(b)(2) when evaluating a request for stay and abeyance."
        }
      ],
      "heading": "Roberto A. Lange (Petitioner)",
      "status": "complete",
      "summary": null,
      "summary_citations": []
    },
    {
      "claims": [
        {
          "attribution": "State",
          "citations": [
            {
              "document_hash": "de18b96983ea01ba3ab98573a30647660d9572248433428bdf85a14a25359d9d",
              "evidence_ids": [
                "ev-de18b96983ea-0001-0000"
              ],
              "pages": {
                "end": 19,
                "start": 19
              }
            }
          ],
          "text": "According to State, circuit courts of appeals have approved the stay and abeyance procedure and there is no evidence it is being misused or causing undue delay."
        }
      ],
      "heading": "State",
      "status": "complete",
      "summary": null,
      "summary_citations": []
    },
    {
      "claims": [
        {
          "attribution": "Respondent",
          "citations": [
            {
              "document_hash": "de18b96983ea01ba3ab98573a30647660d9572248433428bdf85a14a25359d9d",
              "evidence_ids": [
                "ev-de18b96983ea-0001-0002"
              ],
              "pages": {
                "end": 21,
                "start": 21
              }
            }
          ],
          "text": "According to Respondent, stay and abeyance erodes each side of the triangular statutory design, extends the statute of limitations beyond one year, and ignores the total exhaustion requirement of \u00a72254(b)."
        },
        {
          "attribution": "Respondent",
          "citations": [
            {
              "document_hash": "de18b96983ea01ba3ab98573a30647660d9572248433428bdf85a14a25359d9d",
              "evidence_ids": [
                "ev-de18b96983ea-0001-0005"
              ],
              "pages": {
                "end": 27,
                "start": 27
              }
            }
          ],
          "text": "According to Respondent, the claim that stay and abeyance erodes the statutory design is not true with respect to the exhausted claims."
        }
      ],
      "heading": "Respondent",
      "status": "complete",
      "summary": null,
      "summary_citations": []
    },
    {
      "claims": [
        {
          "attribution": "General Long",
          "citations": [
            {
              "document_hash": "de18b96983ea01ba3ab98573a30647660d9572248433428bdf85a14a25359d9d",
              "evidence_ids": [
                "ev-de18b96983ea-0002-0001"
              ],
              "pages": {
                "end": 36,
                "start": 36
              }
            }
          ],
          "text": "According to General Long, the predicate for obtaining stay and abeyance is that there must be at least one exhausted claim and one unexhausted claim."
        }
      ],
      "heading": "General Long",
      "status": "complete",
      "summary": null,
      "summary_citations": []
