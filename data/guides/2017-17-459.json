  "party_positions": [
    {
      "claims": [
        {
          "attribution": "Petitioner",
          "citations": [
            {
              "document_hash": "362e695b0f41fbd8209dcbcb337c3c1aec8d7c2ec2609608e85059b2dae3b3e8",
              "evidence_ids": [
                "ev-362e695b0f41-0000-0001"
              ],
              "pages": {
                "end": 4,
                "start": 4
              }
            }
          ],
          "text": "The petitioner argues that the stop\u2011time rule requires the government to serve a notice to appear that includes the date and time of the hearing."
        },
        {
          "attribution": "Mr. Zimmer",
          "citations": [
            {
              "document_hash": "362e695b0f41fbd8209dcbcb337c3c1aec8d7c2ec2609608e85059b2dae3b3e8",
              "evidence_ids": [
                "ev-362e695b0f41-0001-0000"
              ],
              "pages": {
                "end": 24,
                "start": 24
              }
            }
          ],
          "text": "According to Mr. Zimmer, mr. Zimmer emphasized that there is a practical difference in cases like Camarillo where the notice\u2011to\u2011appear requirements are not met."
        },
        {
          "attribution": "Mr. Liu",
          "citations": [
            {
              "document_hash": "362e695b0f41fbd8209dcbcb337c3c1aec8d7c2ec2609608e85059b2dae3b3e8",
              "evidence_ids": [
                "ev-362e695b0f41-0001-0002"
              ],
              "pages": {
                "end": 40,
                "start": 40
              }
            }
          ],
          "text": "Mr. Liu contended that a notice to appear lacking a date and time is still a valid notice to appear."
        },
        {
          "attribution": "Mr. Liu",
          "citations": [
            {
              "document_hash": "362e695b0f41fbd8209dcbcb337c3c1aec8d7c2ec2609608e85059b2dae3b3e8",
              "evidence_ids": [
                "ev-362e695b0f41-0002-0000"
              ],
              "pages": {
                "end": 45,
                "start": 45
              }
            }
          ],
          "text": "Mr. Liu argued that Congress intended the stop\u2011time rule to apply to notices issued before the statute\u2019s effective date."
        }
      ],
