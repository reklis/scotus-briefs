                "ev-fbba9e12b6e0-0000-0002"
              ],
              "pages": {
                "end": 6,
                "start": 6
              }
            }
          ],
          "text": "H&M argues that Unicolors\u2019 registration certificate is inaccurate because it attempted to register 31 separate works in a single application."
        },
        {
          "attribution": "H&M",
          "citations": [
            {
              "document_hash": "fbba9e12b6e0b0b17302a0fb433b8dd6440b445f459a8966a4be2f2d716dce13",
