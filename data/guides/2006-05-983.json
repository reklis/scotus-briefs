  "oral_argument": {
    "claims": [
      {
        "attribution": "Justice Ginsburg",
        "citations": [
          {
            "document_hash": "05d47561fd0f2c28d42338d0046f44931a8b4870c47235a8defce500d886a8ab",
            "evidence_ids": [
              "ev-05d47561fd0f-0000-0004"
            ],
            "pages": {
              "end": 10,
              "start": 10
            }
          }
        ],
        "text": "Justice Ginsburg asked whether parents are an aggrieved party for purposes of the administrative process and noted there is no provision for proceeding without counsel in court."
      },
      {
        "attribution": "Justice Kennedy",
        "citations": [
          {
            "document_hash": "05d47561fd0f2c28d42338d0046f44931a8b4870c47235a8defce500d886a8ab",
            "evidence_ids": [
              "ev-05d47561fd0f-0000-0005"
            ],
            "pages": {
              "end": 14,
              "start": 14
            }
          }
        ],
        "text": "Justice Kennedy asked whether any argument had been made that the claim was frivolous."
      },
      {
        "attribution": "Justice Kennedy",
        "citations": [
          {
            "document_hash": "05d47561fd0f2c28d42338d0046f44931a8b4870c47235a8defce500d886a8ab",
            "evidence_ids": [
              "ev-05d47561fd0f-0001-0002"
            ],
            "pages": {
              "end": 21,
              "start": 21
            }
          }
        ],
        "text": "Justice Kennedy asked where the statutory provision (1401) was located."
      },
      {
        "attribution": "Justice Breyer",
        "citations": [
          {
            "document_hash": "05d47561fd0f2c28d42338d0046f44931a8b4870c47235a8defce500d886a8ab",
            "evidence_ids": [
              "ev-05d47561fd0f-0002-0000"
            ],
            "pages": {
              "end": 38,
              "start": 38
            }
          }
        ],
        "text": "Justice Breyer asked whether the parent lacked a right taken away by the hearing officer, affecting standing to sue."
      },
      {
        "attribution": "Justice Souter",
        "citations": [
          {
            "document_hash": "05d47561fd0f2c28d42338d0046f44931a8b4870c47235a8defce500d886a8ab",
            "evidence_ids": [
              "ev-05d47561fd0f-0003-0000"
            ],
            "pages": {
              "end": 56,
              "start": 56
            }
          }
        ],
        "text": "According to Justice Souter, justice Souter noted the lack of First Circuit precedent on the issue."
      },
      {
        "attribution": "Justice Ginsburg",
        "citations": [
          {
            "document_hash": "05d47561fd0f2c28d42338d0046f44931a8b4870c47235a8defce500d886a8ab",
            "evidence_ids": [
              "ev-05d47561fd0f-0003-0001"
            ],
            "pages": {
              "end": 57,
              "start": 57
            }
          }
        ],
        "text": "According to Justice Ginsburg, justice Ginsburg questioned whether hiring an attorney would constitute a cost under the phrase \u201cat no cost to the parent.\u201d"
      }
    ],
    "heading": "Oral Argument",
    "status": "complete",
    "summary": null,
