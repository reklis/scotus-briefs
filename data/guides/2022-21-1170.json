  "background_and_question": {
    "claims": [
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "e4dc0a4e320a58cfa025c3124c5b303866d0eea27f20924722f6839934fe6097",
            "evidence_ids": [
              "ev-e4dc0a4e320a-0000-0001"
            ],
            "pages": {
              "end": 2,
              "start": 2
            }
          }
        ],
        "text": "The United States prosecuted Ciminelli under the federal wire\u2011fraud statute, relying solely on the Second Circuit\u2019s right\u2011to\u2011control theory, which treats the deprivation of potentially valuable economic information as a form of property fraud."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "e4dc0a4e320a58cfa025c3124c5b303866d0eea27f20924722f6839934fe6097",
            "evidence_ids": [
              "ev-e4dc0a4e320a-0001-0000"
            ],
            "pages": {
              "end": 12,
              "start": 12
            }
          }
        ],
        "text": "The Court needed to decide whether the right\u2011to\u2011control theory fits within the wire\u2011fraud statute\u2019s definition of \u201cproperty\u201d."
      }
    ],
    "heading": "Background & Question",
    "status": "complete",
    "summary": null,
    "summary_citations": []
  },
  "case_id": "2022-21-1170",
  "decision": {
    "claims": [
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "e4dc0a4e320a58cfa025c3124c5b303866d0eea27f20924722f6839934fe6097",
            "evidence_ids": [
              "ev-e4dc0a4e320a-0001-0000"
            ],
            "pages": {
              "end": 12,
              "start": 12
            }
          }
        ],
        "text": "The majority held that the wire\u2011fraud statute reaches only traditional property interests and that the right\u2011to\u2011control theory is not a traditional property interest, so it cannot support a conviction under the federal fraud statutes."
      },
      {
        "attribution": "Justice Alito",
        "citations": [
          {
            "document_hash": "e4dc0a4e320a58cfa025c3124c5b303866d0eea27f20924722f6839934fe6097",
            "evidence_ids": [
              "ev-e4dc0a4e320a-0001-0001"
            ],
            "pages": {
              "end": 13,
              "start": 13
            }
          }
        ],
        "text": "Justice Alito concurred, stating that the Court declines to affirm the convictions on any alternative grounds."
      }
    ],
    "heading": "Decision",
