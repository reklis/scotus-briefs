              ],
              "pages": {
                "end": 3,
                "start": 3
              }
            }
          ],
          "text": "According to John G. Roberts, eRISA\u2019s civil enforcement provisions are the exclusive remedy, so the Illinois independent external review law is preempted."
        }
      ],
      "heading": "Petitioner (Rush Prudential HMO, Inc.)",
      "status": "complete",
      "summary": null,
      "summary_citations": []
    },
    {
      "claims": [
        {
