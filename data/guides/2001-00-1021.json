              "end": 33,
              "start": 33
            }
          }
        ],
        "text": "Justice Souter asked about the traditional elements of arbitration, including review of evidence and opportunity to argue."
      },
      {
        "attribution": "Justice",
        "citations": [
          {
            "document_hash": "c3221463d19964fabc3a32c9eeb915b50d904f3a96cce7a5d0b9789fe86c08ba",
