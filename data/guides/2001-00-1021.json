            "pages": {
              "end": 4,
              "start": 4
            }
          }
        ],
        "text": "Justice asked whether the plan was in the record."
      },
      {
        "attribution": "Justice O'Connor",
        "citations": [
          {
            "document_hash": "c3221463d19964fabc3a32c9eeb915b50d904f3a96cce7a5d0b9789fe86c08ba",
