          "citations": [
            {
              "document_hash": "c3221463d19964fabc3a32c9eeb915b50d904f3a96cce7a5d0b9789fe86c08ba",
              "evidence_ids": [
                "ev-c3221463d199-0001-0001"
              ],
              "pages": {
                "end": 24,
                "start": 24
              }
            }
          ],
          "text": "According to Mr. Albers, illinois section\u202f4\u201110 does not conflict with ERISA and is enforceable to protect Illinois insureds."
        },
        {
          "attribution": "Mr. Albers",
          "citations": [
            {
              "document_hash": "c3221463d19964fabc3a32c9eeb915b50d904f3a96cce7a5d0b9789fe86c08ba",
              "evidence_ids": [
                "ev-c3221463d199-0002-0000"
              ],
              "pages": {
                "end": 36,
                "start": 36
              }
            }
          ],
          "text": "According to Mr. Albers, the dispute is an arbitration that proceeds to a neutral third party."
        },
        {
          "attribution": "Mr. Albers",
          "citations": [
            {
              "document_hash": "c3221463d19964fabc3a32c9eeb915b50d904f3a96cce7a5d0b9789fe86c08ba",
              "evidence_ids": [
                "ev-c3221463d199-0002-0001"
              ],
              "pages": {
                "end": 37,
                "start": 37
              }
            }
          ],
          "text": "According to Mr. Albers, the HMO Insurance Act is part of the Illinois Insurance Code and meets the factors the Court has set for what constitutes an insurer."
        }
      ],
