              "end": 3,
              "start": 3
            }
          }
        ],
        "text": "According to John G. Roberts, petitioner argues that Illinois law providing an independent review of HMO benefit denials is preempted by ERISA."
      },
      {
        "attribution": "Mr. Albers",
        "citations": [
          {
            "document_hash": "c3221463d19964fabc3a32c9eeb915b50d904f3a96cce7a5d0b9789fe86c08ba",
            "evidence_ids": [
              "ev-c3221463d199-0001-0001"
            ],
            "pages": {
              "end": 24,
              "start": 24
            }
          }
        ],
        "text": "According to Mr. Albers, respondent contends that Illinois section\u202f4\u201110 is not in conflict with ERISA and therefore is enforceable."
      }
    ],
    "heading": "Overview",
    "status": "complete",
    "summary": null,
    "summary_citations": []
  },
  "party_positions": [
    {
      "claims": [
        {
          "attribution": "John G. Roberts",
          "citations": [
            {
              "document_hash": "c3221463d19964fabc3a32c9eeb915b50d904f3a96cce7a5d0b9789fe86c08ba",
