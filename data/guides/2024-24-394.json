              "end": 10,
              "start": 10
            }
          }
        ],
        "text": "Justice Sotomayor asked whether a religious school could change its curriculum to teach only creationism."
      },
      {
        "attribution": "Justice Alito",
        "citations": [
          {
            "document_hash": "90e3c01ef6654550bb985f24f6a673251334ce0647976c74322dfb3e9bd9e6f6",
            "evidence_ids": [
              "ev-90e3c01ef665-0000-0005"
            ],
            "pages": {
              "end": 19,
              "start": 19
            }
          }
        ],
        "text": "Justice Alito asked whether the grants and tax credits in Trinity Lutheran, Espinoza, and Carson involve a contract distinction."
      },
      {
        "attribution": "Justice Sotomayor",
        "citations": [
          {
            "document_hash": "90e3c01ef6654550bb985f24f6a673251334ce0647976c74322dfb3e9bd9e6f6",
            "evidence_ids": [
              "ev-90e3c01ef665-0001-0000"
            ],
            "pages": {
              "end": 24,
              "start": 24
            }
          }
        ],
        "text": "Justice Sotomayor asked whether the schools are only teaching the Catholic religion."
      },
      {
        "attribution": "Justice Gorsuch",
        "citations": [
          {
            "document_hash": "90e3c01ef6654550bb985f24f6a673251334ce0647976c74322dfb3e9bd9e6f6",
            "evidence_ids": [
              "ev-90e3c01ef665-0001-0005"
            ],
            "pages": {
              "end": 29,
              "start": 29
            }
          }
        ],
        "text": "Justice Gorsuch asked about historical examples of state funding of religious schools and the lack of a free\u2011exercise claim."
      },
      {
        "attribution": "Justice Kavanaugh",
        "citations": [
          {
            "document_hash": "90e3c01ef6654550bb985f24f6a673251334ce0647976c74322dfb3e9bd9e6f6",
            "evidence_ids": [
              "ev-90e3c01ef665-0001-0006"
            ],
            "pages": {
              "end": 33,
              "start": 33
            }
          }
        ],
        "text": "Justice Kavanaugh asked whether a student in Oklahoma is free to attend a public school if they choose."
      },
      {
        "attribution": "Justice Thomas",
        "citations": [
          {
            "document_hash": "90e3c01ef6654550bb985f24f6a673251334ce0647976c74322dfb3e9bd9e6f6",
            "evidence_ids": [
              "ev-90e3c01ef665-0002-0000"
            ],
            "pages": {
              "end": 45,
              "start": 45
            }
          }
        ],
        "text": "Justice Thomas asked what features would convert St.\u202fIsidore into a state actor."
      },
      {
        "attribution": "Justice Gorsuch",
        "citations": [
          {
            "document_hash": "90e3c01ef6654550bb985f24f6a673251334ce0647976c74322dfb3e9bd9e6f6",
            "evidence_ids": [
              "ev-90e3c01ef665-0002-0007"
            ],
            "pages": {
              "end": 59,
              "start": 59
            }
          }
        ],
        "text": "Justice Gorsuch asked whether, under strict scrutiny, the government has a compelling interest."
      },
      {
        "attribution": "Justice Kavanaugh",
        "citations": [
          {
            "document_hash": "90e3c01ef6654550bb985f24f6a673251334ce0647976c74322dfb3e9bd9e6f6",
            "evidence_ids": [
              "ev-90e3c01ef665-0002-0009"
            ],
            "pages": {
              "end": 61,
              "start": 61
            }
          }
        ],
        "text": "Justice Kavanaugh asked about the similarity of Oklahoma\u2019s program to those in other states."
      },
      {
        "attribution": "Justice Jackson",
        "citations": [
          {
            "document_hash": "90e3c01ef6654550bb985f24f6a673251334ce0647976c74322dfb3e9bd9e6f6",
            "evidence_ids": [
              "ev-90e3c01ef665-0002-0010"
            ],
            "pages": {
              "end": 65,
              "start": 65
            }
          }
        ],
        "text": "Justice Jackson asked whether the federal law requiring charter schools to be nonsectarian is unconstitutional."
      },
      {
        "attribution": "Justice SOTOMAYOR",
        "citations": [
          {
            "document_hash": "90e3c01ef6654550bb985f24f6a673251334ce0647976c74322dfb3e9bd9e6f6",
            "evidence_ids": [
              "ev-90e3c01ef665-0003-0003"
            ],
            "pages": {
              "end": 69,
              "start": 69
            }
          }
        ],
        "text": "Justice Sotomayor referenced the Peltier v. Charter School case and asked about the opposite position taken today."
      },
      {
        "attribution": "Justice KAGAN",
        "citations": [
          {
            "document_hash": "90e3c01ef6654550bb985f24f6a673251334ce0647976c74322dfb3e9bd9e6f6",
            "evidence_ids": [
              "ev-90e3c01ef665-0003-0004"
            ],
            "pages": {
              "end": 71,
              "start": 71
            }
          }
        ],
        "text": "Justice Kagan asked \u201cAnd what\u2019s the difference?\u201d"
      },
      {
        "attribution": "Justice JACKSON",
        "citations": [
          {
            "document_hash": "90e3c01ef6654550bb985f24f6a673251334ce0647976c74322dfb3e9bd9e6f6",
            "evidence_ids": [
              "ev-90e3c01ef665-0003-0001"
            ],
            "pages": {
              "end": 73,
              "start": 73
            }
          }
        ],
        "text": "Justice Jackson asked whether the board would have to choose among charter school applicants of different religions."
      },
      {
        "attribution": "Justice Jackson",
        "citations": [
          {
            "document_hash": "90e3c01ef6654550bb985f24f6a673251334ce0647976c74322dfb3e9bd9e6f6",
            "evidence_ids": [
