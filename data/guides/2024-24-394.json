            }
          }
        ],
        "text": "Justice Jackson asked whether the board would have to choose among charter school applicants of different religions (repeated citation)."
      },
      {
        "attribution": "Justice Thomas",
        "citations": [
          {
            "document_hash": "90e3c01ef6654550bb985f24f6a673251334ce0647976c74322dfb3e9bd9e6f6",
            "evidence_ids": [
              "ev-90e3c01ef665-0004-0003"
            ],
            "pages": {
              "end": 92,
              "start": 92
            }
          }
        ],
        "text": "Justice Thomas asked whether St.\u202fIsidore can participate in the charter program and remain private."
      },
      {
        "attribution": "Justice Kavanaugh",
        "citations": [
          {
            "document_hash": "90e3c01ef6654550bb985f24f6a673251334ce0647976c74322dfb3e9bd9e6f6",
            "evidence_ids": [
              "ev-90e3c01ef665-0005-0002"
            ],
            "pages": {
              "end": 122,
              "start": 122
            }
          }
        ],
        "text": "Justice Kavanaugh asked how the program differs from a choice program where no student is compelled to attend a religious charter school."
      },
      {
        "attribution": "Justice Alito",
        "citations": [
          {
            "document_hash": "90e3c01ef6654550bb985f24f6a673251334ce0647976c74322dfb3e9bd9e6f6",
            "evidence_ids": [
