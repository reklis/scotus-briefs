                "ev-990193c52e02-0001-0004"
              ],
              "pages": {
                "end": 26,
                "start": 26
              }
            }
          ],
          "text": "According to Petitioner, section\u202f355(g) is a review\u2011exclusivity provision that applies to determinations of any claim for benefits or refunds under the RUIA."
        },
        {
          "attribution": "Petitioner",
          "citations": [
            {
              "document_hash": "990193c52e02034416020633723d2ee2612a185b13b567f909aff449d36a0991",
              "evidence_ids": [
                "ev-990193c52e02-0002-0003"
              ],
              "pages": {
                "end": 60,
                "start": 60
              }
            }
          ],
          "text": "According to Petitioner, the petition for reopening is based on an error on the face of the record, as argued in the Fifth Circuit."
        }
