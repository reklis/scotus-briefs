  "overview": {
    "claims": [
      {
        "attribution": "Union Pacific Railroad",
        "citations": [
          {
            "document_hash": "f7c5ac7d273cf5b4f22d4217d2d8c5c4cd80379f782675713b0042bb656151b1",
            "evidence_ids": [
