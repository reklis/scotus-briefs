                "ev-f7c5ac7d273c-0001-0005"
              ],
              "pages": {
                "end": 34,
                "start": 34
              }
            }
          ],
          "text": "According to Thomas H. Geoghegan, section\u202f2 of the Railway Labor Act governs conferencing, while Section\u202f3 contains no mention of conferencing."
        },
        {
          "attribution": "Mr. GEOGHEGAN",
          "citations": [
            {
              "document_hash": "f7c5ac7d273cf5b4f22d4217d2d8c5c4cd80379f782675713b0042bb656151b1",
