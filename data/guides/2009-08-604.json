                "ev-f7c5ac7d273c-0002-0000"
              ],
              "pages": {
                "end": 38,
                "start": 38
              }
            }
          ],
          "text": "According to Mr. GEOGHEGAN, section\u202f301.5 requires parties to raise relevant argumentative facts."
        },
        {
          "attribution": "Mr. Ballenger",
          "citations": [
            {
              "document_hash": "f7c5ac7d273cf5b4f22d4217d2d8c5c4cd80379f782675713b0042bb656151b1",
              "evidence_ids": [
                "ev-f7c5ac7d273c-0003-0005"
              ],
              "pages": {
                "end": 59,
                "start": 59
              }
            }
          ],
          "text": "According to Mr. Ballenger, even if a court believes an arbitrator committed serious error, the board\u2019s decision stands if it is arguably construing or applying the relevant rules."
