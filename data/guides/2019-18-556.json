                "end": 4,
                "start": 4
              }
            }
          ],
          "text": "According to Toby Crouse, Kansas argues that reasonable suspicion is a minimal standard that permits a brief investigation based on an officer\u2019s objective and particularized suspicion."
        }
      ],
      "heading": "Petitioner (Kansas)",
      "status": "complete",
      "summary": null,
      "summary_citations": []
    },
    {
      "claims": [
        {
