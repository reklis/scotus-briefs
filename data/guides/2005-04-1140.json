              "pages": {
                "end": 33,
                "start": 33
              }
            }
          ],
          "text": "Mr. Chilton argued that discretion is appropriate under the statute and cited congressional intent."
        },
        {
          "attribution": "Mr. Chilton",
          "citations": [
            {
              "document_hash": "56020f80f97b5d0067ac93ebb4519d0f2367e4eb21cf0a0f17ea2bd1b0bffa90",
