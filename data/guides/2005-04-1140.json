              "end": 7,
              "start": 7
            }
          }
        ],
        "text": "According to Justice Souter, justice Souter inquired about examples where a remand on a plaintiff\u2019s motion would not allow fee awards."
      },
      {
        "attribution": "Justice Kennedy",
        "citations": [
          {
            "document_hash": "56020f80f97b5d0067ac93ebb4519d0f2367e4eb21cf0a0f17ea2bd1b0bffa90",
