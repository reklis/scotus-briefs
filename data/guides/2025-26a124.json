  "case_id": "2025-26a124",
  "decision": {
    "claims": [
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "9729f21f8a1810e15b17af17b6b2fa720036719f56502834751dab36a0e99db5",
            "evidence_ids": [
              "ev-9729f21f8a18-0000-0002"
            ],
            "pages": {
              "end": 1,
              "start": 1
            }
          }
        ],
        "text": "The Court granted the stay."
      },
      {
        "attribution": "Justice Sotomayor",
        "citations": [
          {
            "document_hash": "9729f21f8a1810e15b17af17b6b2fa720036719f56502834751dab36a0e99db5",
            "evidence_ids": [
              "ev-9729f21f8a18-0000-0005"
            ],
            "pages": {
              "end": 11,
              "start": 11
            }
          }
        ],
        "text": "Justice Sotomayor (dissent) dissented, stating the decision does not address whether the President's attempts to interfere with states' administration of the November 2026 elections are lawful."
      },
      {
        "attribution": "Justice Sotomayor",
        "citations": [
          {
            "document_hash": "9729f21f8a1810e15b17af17b6b2fa720036719f56502834751dab36a0e99db5",
            "evidence_ids": [
              "ev-9729f21f8a18-0001-0000"
            ],
            "pages": {
              "end": 13,
              "start": 13
            }
          }
        ],
        "text": "Justice Sotomayor (dissent) noted that the standard tolerates suits involving 'actual or imminent' injuries, allowing pre\u2011enforcement suits."
      },
      {
        "attribution": "Justice Sotomayor",
        "citations": [
          {
            "document_hash": "9729f21f8a1810e15b17af17b6b2fa720036719f56502834751dab36a0e99db5",
            "evidence_ids": [
              "ev-9729f21f8a18-0001-0001"
            ],
            "pages": {
              "end": 14,
              "start": 14
            }
          }
        ],
        "text": "Justice Sotomayor (dissent) criticized the majority for treating the case as speculative, noting the Government's contradictory statements about implementing the Executive Order."
      },
      {
        "attribution": "Justice Jackson",
        "citations": [
          {
            "document_hash": "9729f21f8a1810e15b17af17b6b2fa720036719f56502834751dab36a0e99db5",
            "evidence_ids": [
              "ev-9729f21f8a18-0002-0003"
            ],
            "pages": {
              "end": 27,
              "start": 27
            }
          }
        ],
        "text": "Justice Jackson (dissent) argued that the harm\u2011related stay factors weigh heavily against granting the stay applications."
      },
      {
        "attribution": "Justice Jackson",
        "citations": [
          {
            "document_hash": "9729f21f8a1810e15b17af17b6b2fa720036719f56502834751dab36a0e99db5",
            "evidence_ids": [
              "ev-9729f21f8a18-0003-0000"
            ],
            "pages": {
              "end": 34,
              "start": 34
            }
          }
        ],
        "text": "Justice Jackson (dissent) stated that political candidates can clear Article III's harm hurdle based solely on the risk of an unlawful rule."
      },
      {
        "attribution": "Justice Jackson",
        "citations": [
          {
            "document_hash": "9729f21f8a1810e15b17af17b6b2fa720036719f56502834751dab36a0e99db5",
            "evidence_ids": [
              "ev-9729f21f8a18-0003-0001"
            ],
            "pages": {
              "end": 35,
              "start": 35
            }
          }
        ],
        "text": "Justice Jackson (dissent) argued that sovereign states have a concrete injury when the President interferes with ballot\u2011distribution plans they are executing."
      },
      {
        "attribution": "Justice Jackson",
        "citations": [
          {
            "document_hash": "9729f21f8a1810e15b17af17b6b2fa720036719f56502834751dab36a0e99db5",
            "evidence_ids": [
              "ev-9729f21f8a18-0003-0002"
            ],
            "pages": {
              "end": 36,
              "start": 36
            }
          }
        ],
        "text": "Justice Jackson (dissent) said the stay bid was empty, strategic, and bad\u2011faith and should have been swiftly rejected."
      },
      {
        "attribution": "Justice Jackson",
        "citations": [
          {
            "document_hash": "9729f21f8a1810e15b17af17b6b2fa720036719f56502834751dab36a0e99db5",
            "evidence_ids": [
              "ev-9729f21f8a18-0003-0003"
            ],
            "pages": {
              "end": 37,
              "start": 37
            }
          }
        ],
        "text": "Justice Jackson (dissent) argued the Government suffers no harm from an injunction limiting unlawful actions, not from hypothetical or speculative acts."
      }
    ],
