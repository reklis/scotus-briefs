  "oral_argument": {
    "claims": [
      {
        "attribution": "Chief Justice Roberts",
        "citations": [
          {
            "document_hash": "f56255e24aa1d3ada1f16e94e2329e5ff669ed9cc7dd4ab3b1f9cc3c5f0c5aba",
