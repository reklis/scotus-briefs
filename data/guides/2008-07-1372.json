            }
          },
          {
            "document_hash": "7b71e5e2d8beed064dde295e1418f6a4a12534de208094bed020f7c713ac85a2",
            "evidence_ids": [
              "ev-7b71e5e2d8be-0003-0000"
            ],
            "pages": {
              "end": 56,
              "start": 56
            }
          }
        ],
        "text": "Petitioners argue that the State of Hawaii holds perfect title to the lands under the Newlands Resolution, the Organic Act, and the Admission Act."
      },
      {
        "attribution": "Respondents",
        "citations": [
          {
            "document_hash": "7b71e5e2d8beed064dde295e1418f6a4a12534de208094bed020f7c713ac85a2",
            "evidence_ids": [
              "ev-7b71e5e2d8be-0001-0003"
            ],
            "pages": {
              "end": 22,
              "start": 22
            }
          }
        ],
        "text": "Respondents argue that the legislature could choose not to sell the lands and could enact a moratorium to promote the welfare of Native Hawaiians."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "7b71e5e2d8beed064dde295e1418f6a4a12534de208094bed020f7c713ac85a2",
            "evidence_ids": [
              "ev-7b71e5e2d8be-0002-0003"
            ],
            "pages": {
              "end": 48,
              "start": 48
            }
          }
        ],
        "text": "The Court notes that a unilateral moratorium on the sale of ceded lands was imposed by the Hawaii Department of Land and Natural Resources shortly after the litigation began."
      }
    ],
