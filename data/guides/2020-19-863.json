              "ev-52e1c2d11acf-0001-0000"
            ],
            "pages": {
              "end": 18,
              "start": 18
            }
          }
        ],
        "text": "The majority held that interpreting the phrase \u201ca notice to appear\u201d to require a single notice means the statute mandates one written document, not multiple."
      },
      {
        "attribution": "Justice Kavanaugh",
        "citations": [
          {
            "document_hash": "52e1c2d11acf20ed9b9c9c493251eace454892f9c420d41a236199b7ae3d5150",
            "evidence_ids": [
              "ev-52e1c2d11acf-0002-0001"
            ],
            "pages": {
              "end": 26,
              "start": 26
            }
          },
          {
            "document_hash": "52e1c2d11acf20ed9b9c9c493251eace454892f9c420d41a236199b7ae3d5150",
            "evidence_ids": [
              "ev-52e1c2d11acf-0003-0001"
            ],
            "pages": {
              "end": 35,
              "start": 35
            }
          },
          {
            "document_hash": "52e1c2d11acf20ed9b9c9c493251eace454892f9c420d41a236199b7ae3d5150",
            "evidence_ids": [
              "ev-52e1c2d11acf-0003-0002"
            ],
            "pages": {
              "end": 40,
              "start": 40
            }
          }
        ],
        "text": "Justice Kavanaugh dissented, arguing that the statutory phrase \u201cwritten notice\u201d does not require a single document and that the Court\u2019s decision will not meaningfully benefit non\u2011citizens while imposing significant costs on the immigration system."
      }
    ],
