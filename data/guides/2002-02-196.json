  "party_positions": [
    {
      "claims": [
        {
          "attribution": "National Park Hospitality Association",
          "citations": [
            {
              "document_hash": "14c45a11a5c2f9572bc1612451fff19287d2fd6cb53153241dd44e9c4c075b88",
              "evidence_ids": [
                "ev-14c45a11a5c2-0000-0000"
              ],
              "pages": {
                "end": 3,
                "start": 3
              }
            }
          ],
          "text": "According to National Park Hospitality Association, the Contract Disputes Act should apply to contracts between the National Park Service and private concessioners."
        },
        {
          "attribution": "National Park Hospitality Association",
          "citations": [
            {
              "document_hash": "14c45a11a5c2f9572bc1612451fff19287d2fd6cb53153241dd44e9c4c075b88",
              "evidence_ids": [
                "ev-14c45a11a5c2-0000-0001"
              ],
              "pages": {
                "end": 5,
                "start": 5
              }
            }
          ],
          "text": "According to National Park Hospitality Association, a regulation that categorically excludes National Park Service concession contracts from the CDA is arbitrary because some contracts are subject to the CDA."
        },
        {
          "attribution": "National Park Hospitality Association",
          "citations": [
            {
              "document_hash": "14c45a11a5c2f9572bc1612451fff19287d2fd6cb53153241dd44e9c4c075b88",
              "evidence_ids": [
                "ev-14c45a11a5c2-0000-0003"
              ],
              "pages": {
                "end": 8,
                "start": 8
              }
            }
          ],
          "text": "According to National Park Hospitality Association, the petitioner is harmed because concessioners need to know their rights under the contract when deciding whether and how much to bid."
        }
      ],
      "heading": "National Park Hospitality Association (Petitioner)",
      "status": "complete",
      "summary": null,
      "summary_citations": []
    },
    {
      "claims": [
        {
          "attribution": "Government",
          "citations": [
            {
              "document_hash": "14c45a11a5c2f9572bc1612451fff19287d2fd6cb53153241dd44e9c4c075b88",
              "evidence_ids": [
                "ev-14c45a11a5c2-0002-0000"
              ],
              "pages": {
                "end": 55,
                "start": 55
              }
            }
          ],
          "text": "According to Government, only three cases have applied the CDA to national park concessions, and the Government prevailed on the merits in two of them."
        },
        {
          "attribution": "Government",
          "citations": [
            {
              "document_hash": "14c45a11a5c2f9572bc1612451fff19287d2fd6cb53153241dd44e9c4c075b88",
              "evidence_ids": [
                "ev-14c45a11a5c2-0003-0005"
              ],
              "pages": {
                "end": 61,
                "start": 61
              }
            }
          ],
          "text": "According to Government, the Government is the sole beneficiary of contractual provisions requiring construction, repair, and maintenance of facilities in the national parks."
        }
      ],
