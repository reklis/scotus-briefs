            "evidence_ids": [
              "ev-14c45a11a5c2-0001-0024"
            ],
            "pages": {
              "end": 37,
              "start": 37
            }
          }
        ],
        "text": "Justice Ginsburg asked whether the claim was ripe and why it had not been discussed earlier."
      },
      {
        "attribution": "Justice Breyer",
        "citations": [
          {
            "document_hash": "14c45a11a5c2f9572bc1612451fff19287d2fd6cb53153241dd44e9c4c075b88",
