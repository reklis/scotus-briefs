  "case_id": "2022-21-1326",
  "decision": {
    "claims": [
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "f61c8b24700a5622e896ddc0af619f2b5c3baf9bef0ffc1e2083039d0d33dfbf",
            "evidence_ids": [
              "ev-f61c8b24700a-0001-0007"
            ],
            "pages": {
              "end": 21,
              "start": 21
            }
          }
        ],
        "text": "The Court vacated the judgments below and remanded the cases to the Seventh Circuit for further proceedings consistent with this opinion."
      },
      {
        "attribution": "Justice Thomas",
        "citations": [
          {
            "document_hash": "f61c8b24700a5622e896ddc0af619f2b5c3baf9bef0ffc1e2083039d0d33dfbf",
            "evidence_ids": [
              "ev-f61c8b24700a-0001-0001"
            ],
            "pages": {
              "end": 12,
              "start": 12
            }
          }
        ],
        "text": "The Court did not review the meaning of the phrase \u201cusual and customary\u201d or whether any of the respondents\u2019 claims were false."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "f61c8b24700a5622e896ddc0af619f2b5c3baf9bef0ffc1e2083039d0d33dfbf",
            "evidence_ids": [
              "ev-f61c8b24700a-0001-0004"
            ],
            "pages": {
              "end": 15,
              "start": 15
            }
          }
        ],
        "text": "The Court emphasized that scienter focuses on the defendant\u2019s state of mind at the time the false claim was submitted, not on any later beliefs."
      },
      {
        "attribution": "Justice Thomas",
        "citations": [
          {
            "document_hash": "f61c8b24700a5622e896ddc0af619f2b5c3baf9bef0ffc1e2083039d0d33dfbf",
            "evidence_ids": [
              "ev-f61c8b24700a-0001-0000"
            ],
            "pages": {
              "end": 11,
              "start": 11
            }
          }
        ],
        "text": "The Court noted that the Seventh Circuit\u2019s two\u2011step inquiry from Safeco requires assessing whether the defendant\u2019s conduct was consistent with any objectively reasonable interpretation of the law that has not been definitively ruled out."
      }
    ],
    "heading": "Decision",
