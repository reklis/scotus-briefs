          {
            "document_hash": "d0a0d77f92a05704880b38eb7ccc2a74e76ecabd1f876929da7c579d05bc04e7",
            "evidence_ids": [
              "ev-d0a0d77f92a0-0002-0004"
            ],
            "pages": {
              "end": 41,
              "start": 40
            }
          }
        ],
        "text": "Vermont enacted a statute that restricts the sale of prescribing\u2011information about doctors, aiming to protect physician privacy and control over that data."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "d0a0d77f92a05704880b38eb7ccc2a74e76ecabd1f876929da7c579d05bc04e7",
            "evidence_ids": [
              "ev-d0a0d77f92a0-0002-0006"
            ],
            "pages": {
              "end": 38,
              "start": 38
            }
          }
        ],
        "text": "The statute also seeks to contain health\u2011care costs by promoting the use of less expensive drugs and ensuring prescribers receive unbiased information."
      }
    ],
    "heading": "Overview",
    "status": "complete",
    "summary": null,
    "summary_citations": []
