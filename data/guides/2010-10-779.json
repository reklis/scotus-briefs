  "party_positions": [
    {
      "claims": [
        {
          "attribution": "BRIDGET C. ASAY",
          "citations": [
            {
              "document_hash": "d0a0d77f92a05704880b38eb7ccc2a74e76ecabd1f876929da7c579d05bc04e7",
              "evidence_ids": [
                "ev-d0a0d77f92a0-0000-0003"
