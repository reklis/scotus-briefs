        ],
        "text": "According to Justice Scalia, justice Scalia: Could the data be used for purposes other than those intended by the statute?"
      },
      {
        "attribution": "Justice Alito",
        "citations": [
          {
            "document_hash": "d0a0d77f92a05704880b38eb7ccc2a74e76ecabd1f876929da7c579d05bc04e7",
            "evidence_ids": [
