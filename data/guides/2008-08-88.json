  "oral_argument": {
    "claims": [
      {
        "attribution": "Chief Justice Roberts; Justice Alito; Justice Kennedy; Justice Souter",
        "citations": [
          {
            "document_hash": "4b7756ab59de8d030fa5f55d7a49978787d94fe59d9a5b054441f13f20f6ecdb",
            "evidence_ids": [
              "ev-4b7756ab59de-0000-0004",
