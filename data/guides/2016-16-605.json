                "start": 20
              }
            }
          ],
          "text": "According to Ms. Harrington, standing is required for certain actions, such as seeking damages or filing a new claim."
        },
        {
          "attribution": "Ms. Harrington",
          "citations": [
            {
              "document_hash": "5f5a0eb0504cc6c066057b59a1d2471d34978fc57ecfcd47c9f86b7594105769",
