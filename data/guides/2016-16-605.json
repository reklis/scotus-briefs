            "pages": {
              "end": 21,
              "start": 21
            }
          }
        ],
        "text": "Justice Sotomayor asked, \u201cWhy did they bother?\u201d"
      },
      {
        "attribution": "Justice Breyer",
        "citations": [
          {
            "document_hash": "5f5a0eb0504cc6c066057b59a1d2471d34978fc57ecfcd47c9f86b7594105769",
