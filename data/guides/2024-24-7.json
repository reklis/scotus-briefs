              "ev-b5d7daa36624-0000-0001"
            ],
            "pages": {
              "end": 2,
              "start": 2
            }
          }
        ],
        "text": "California estimated that its emissions regulations would cut gasoline demand by more than $1\u202fbillion in 2020 and over $10\u202fbillion by 2030."
      },
      {
        "attribution": "Fuel producers",
        "citations": [
          {
            "document_hash": "b5d7daa366245deda468df4b5f19d0cc00a08aeeada5d83c308abad031571c2a",
            "evidence_ids": [
              "ev-b5d7daa36624-0000-0002"
            ],
            "pages": {
              "end": 2,
              "start": 2
            }
          }
        ],
        "text": "According to Fuel producers, several fuel producers sued the EPA, arguing that the agency lacked authority to approve the California regulations because they target global climate change rather than local air\u2011quality problems."
      },
      {
        "attribution": "EPA",
        "citations": [
          {
            "document_hash": "b5d7daa366245deda468df4b5f19d0cc00a08aeeada5d83c308abad031571c2a",
            "evidence_ids": [
              "ev-b5d7daa36624-0000-0004"
            ],
            "pages": {
              "end": 2,
              "start": 2
            }
          }
        ],
        "text": "The EPA did not challenge the fuel producers\u2019 standing in the D.C. Circuit."
      },
      {
        "attribution": "MR. KNEEDLER",
        "citations": [
          {
            "document_hash": "05f2a4cd4aa661bb34fc5eed40dbcedbaee6f16ba85e0d323d6e65ffb6ea0a0d",
            "evidence_ids": [
              "ev-05f2a4cd4aa6-0002-0004"
            ],
            "pages": {
              "end": 45,
              "start": 45
            }
          }
        ],
        "text": "The D.C. Circuit dismissed the petition for lack of standing, and the parties did not seek review of that decision."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "b5d7daa366245deda468df4b5f19d0cc00a08aeeada5d83c308abad031571c2a",
            "evidence_ids": [
              "ev-b5d7daa36624-0000-0006"
            ],
            "pages": {
              "end": 2,
              "start": 2
            }
          }
        ],
        "text": "The case was argued on April\u202f23,\u202f2025 and decided on June\u202f20,\u202f2025."
      }
    ],
