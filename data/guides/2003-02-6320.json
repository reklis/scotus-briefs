  "overview": {
    "claims": [
      {
        "attribution": "Chief Justice Rehnquist",
        "citations": [
          {
            "document_hash": "ad9797ec722593b68c1ac8140c40d9cdec4bff17e406a7bb3a7151b6990aece9",
            "evidence_ids": [
              "ev-ad9797ec7225-0000-0000"
