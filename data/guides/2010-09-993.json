  "overview": {
    "claims": [
      {
        "attribution": "Petitioners",
        "citations": [
          {
            "document_hash": "3c4e4102dfa846f72807d51613cabfd0d0e09453270bd23a7dffe46717643f43",
            "evidence_ids": [
              "ev-3c4e4102dfa8-0000-0001"
            ],
            "pages": {
              "end": 4,
              "start": 4
            }
          }
        ],
        "text": "Petitioners argue that the Supremacy Clause and the Hatch\u2011Waxman statute require generic drugs to carry the same warnings as their brand\u2011name counterparts, so a state cannot impose different warning requirements."
      },
      {
        "attribution": "Petitioners",
        "citations": [
          {
            "document_hash": "3c4e4102dfa846f72807d51613cabfd0d0e09453270bd23a7dffe46717643f43",
            "evidence_ids": [
              "ev-3c4e4102dfa8-0000-0003"
            ],
            "pages": {
              "end": 6,
              "start": 6
            }
          }
        ],
        "text": "Petitioners contend that a state\u2011law claim that a generic failed to ask the FDA for a label change is pre\u2011empted by the Court\u2019s decision in Buckman, because disclosure obligations are inherently federal."
      }
    ],
    "heading": "Overview",
    "status": "complete",
    "summary": "This case concerns whether state\u2011law failure\u2011to\u2011warn claims against generic drug manufacturers are pre\u2011empted by federal law under the Hatch\u2011Waxman amendments and Supreme Court precedent such as Buckman.",
    "summary_citations": [
      {
        "document_hash": "3c4e4102dfa846f72807d51613cabfd0d0e09453270bd23a7dffe46717643f43",
        "evidence_ids": [
          "ev-3c4e4102dfa8-0000-0001"
        ],
