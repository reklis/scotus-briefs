            "pages": {
              "end": 34,
              "start": 34
            }
          }
        ],
        "text": "The D.C. Circuit consolidated related challenges into a single proceeding and issued an unpublished order."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "98dc84420df006fb94835269e9e88bd2e2a8f206be5762daeffd2f41a431bae6",
