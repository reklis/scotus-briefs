  "overview": {
    "claims": [
      {
        "attribution": "Petitioner Denezpi",
        "citations": [
          {
            "document_hash": "a8b478ea4a87a7bf666a17a31581935177394d3c6e84801c89d990800500d4b5",
            "evidence_ids": [
              "ev-a8b478ea4a87-0001-0000"
            ],
            "pages": {
              "end": 11,
              "start": 11
            }
          },
          {
            "document_hash": "b48b2ef6f5a9e9788342bd4f7d1f3270108c581911f4a3b073858823c4a653f0",
            "evidence_ids": [
              "ev-b48b2ef6f5a9-0000-0001"
            ],
            "pages": {
              "end": 6,
              "start": 6
            }
          }
        ],
        "text": "The case examines whether the Double Jeopardy Clause bars successive prosecutions of a Native American defendant by tribal courts and by federal courts operating under the Criminal Code of the Federal Regulations (CFR)."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "a8b478ea4a87a7bf666a17a31581935177394d3c6e84801c89d990800500d4b5",
            "evidence_ids": [
              "ev-a8b478ea4a87-0000-0003"
            ],
            "pages": {
              "end": 2,
              "start": 2
            }
          }
        ],
        "text": "The District Court denied Denezpi's motion to dismiss the double\u2011jeopardy claim."
      }
    ],
    "heading": "Overview",
    "status": "complete",
    "summary": null,
    "summary_citations": []
  },
  "party_positions": [
    {
      "claims": [
        {
          "attribution": "Petitioner Denezpi",
          "citations": [
            {
              "document_hash": "a8b478ea4a87a7bf666a17a31581935177394d3c6e84801c89d990800500d4b5",
              "evidence_ids": [
                "ev-a8b478ea4a87-0000-0001"
              ],
              "pages": {
                "end": 3,
                "start": 3
              }
            }
          ],
          "text": "According to Petitioner Denezpi, denezpi contends that the dual\u2011sovereignty doctrine does not apply when the same sovereign, the United States, conducts both prosecutions, even if one is in a tribal court."
        },
        {
          "attribution": "Petitioner Denezpi",
          "citations": [
            {
              "document_hash": "a8b478ea4a87a7bf666a17a31581935177394d3c6e84801c89d990800500d4b5",
              "evidence_ids": [
                "ev-a8b478ea4a87-0001-0000"
              ],
              "pages": {
                "end": 11,
                "start": 11
              }
            }
          ],
          "text": "According to Petitioner Denezpi, he asserts that successive prosecutions by the same sovereign are prohibited by the Double Jeopardy Clause because they are for the same offense."
        },
        {
          "attribution": "Petitioner",
          "citations": [
            {
              "document_hash": "b48b2ef6f5a9e9788342bd4f7d1f3270108c581911f4a3b073858823c4a653f0",
              "evidence_ids": [
                "ev-b48b2ef6f5a9-0003-0007"
              ],
              "pages": {
                "end": 74,
                "start": 74
              }
            }
          ],
          "text": "According to Petitioner, he advocates that tribes should be allowed to appoint their own prosecutors to respect tribal sovereignty."
        },
        {
          "attribution": "Petitioner (Michael B. Kimberly)",
          "citations": [
            {
              "document_hash": "b48b2ef6f5a9e9788342bd4f7d1f3270108c581911f4a3b073858823c4a653f0",
              "evidence_ids": [
                "ev-b48b2ef6f5a9-0000-0000"
              ],
              "pages": {
                "end": 4,
                "start": 4
              }
            }
          ],
          "text": "According to Petitioner (Michael B. Kimberly), according to Petitioner (Michael B. Kimberly), the Double Jeopardy Clause implicates two distinct exercises of sovereign authority: defining the offense and putting an individual in jeopardy for that offense."
        }
      ],
