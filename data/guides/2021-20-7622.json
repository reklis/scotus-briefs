{
  "background_and_question": {
    "claims": [
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "a8b478ea4a87a7bf666a17a31581935177394d3c6e84801c89d990800500d4b5",
            "evidence_ids": [
              "ev-a8b478ea4a87-0000-0003"
            ],
            "pages": {
              "end": 2,
              "start": 2
            }
          }
        ],
        "text": "The District Court denied Denezpi's motion."
      },
      {
        "attribution": "Petitioner Denezpi",
        "citations": [
          {
            "document_hash": "a8b478ea4a87a7bf666a17a31581935177394d3c6e84801c89d990800500d4b5",
            "evidence_ids": [
              "ev-a8b478ea4a87-0000-0001"
            ],
            "pages": {
              "end": 3,
              "start": 3
            }
          }
        ],
        "text": "According to Petitioner Denezpi, denezpi argues that the dual\u2011sovereignty doctrine applies only when offenses are enacted and enforced by separate sovereigns, and that his second prosecution by a CFR court violates double jeopardy because both prosecutions are by the United States."
      },
      {
        "attribution": "Justice Thomas",
        "citations": [
          {
            "document_hash": "b48b2ef6f5a9e9788342bd4f7d1f3270108c581911f4a3b073858823c4a653f0",
            "evidence_ids": [
              "ev-b48b2ef6f5a9-0000-0001"
            ],
            "pages": {
              "end": 6,
              "start": 6
            }
          }
        ],
        "text": "According to Justice Thomas, the Court is asked whether the two prosecutions constitute the same offense for double\u2011jeopardy purposes."
      }
    ],
    "heading": "Background and Question",
