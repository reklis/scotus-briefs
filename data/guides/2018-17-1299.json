  "overview": {
    "claims": [
      {
        "attribution": "Franchise Tax Board of California",
        "citations": [
          {
            "document_hash": "13c0c6a00e7e9bcb70cbe7a594a5bb7842588bd40d9b99bb47e7883c79615b87",
