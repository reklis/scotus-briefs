              "end": 3,
              "start": 3
            }
          }
        ],
        "text": "Biotech crops have produced enormous benefits for the nation's farmers and consumers."
      },
      {
        "attribution": "Garre",
        "citations": [
          {
            "document_hash": "ad593954159f4c645054c9f816055b126286c8819af862be25e8322338302ae4",
            "evidence_ids": [
              "ev-ad593954159f-0000-0001"
            ],
            "pages": {
              "end": 3,
              "start": 3
            }
          }
        ],
        "text": "According to Garre, the district court issued a broad\u2011based injunction against planting a highly beneficial, genetically engineered alfalfa crop, and erred in two fundamental respects."
      }
    ],
    "heading": "Overview",
