              "start": 4
            }
          }
        ],
        "text": "Justice Kennedy asked whether this is a Chevron\u2011deference case."
      },
      {
        "attribution": "Justice Alito",
        "citations": [
          {
            "document_hash": "6eecd173282b39919a4a0086e23c8d35fbfdb621b68918c14d432c858adfad11",
            "evidence_ids": [
