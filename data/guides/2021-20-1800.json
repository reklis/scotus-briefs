              "ev-15e99cd593a6-0000-0005"
            ],
            "pages": {
              "end": 2,
              "start": 2
            }
          }
        ],
        "text": "The Supreme Court granted certiorari to resolve the questions of whether Boston\u2019s flag\u2011raising forum is government speech and whether the city could lawfully deny a petition to raise a religious flag."
      },
      {
        "attribution": "Justice Breyer",
        "citations": [
          {
            "document_hash": "15e99cd593a6011d20a94bb44af6e10228e6c5bb87c3f3d97ee3638ecd857226",
            "evidence_ids": [
              "ev-15e99cd593a6-0001-0000"
            ],
            "pages": {
              "end": 11,
              "start": 11
            }
          }
        ],
        "text": "Justice Breyer asked when government\u2011public engagement transmits the government\u2019s own message versus when it creates a forum for private speakers."
      },
      {
        "attribution": "Justice Thomas",
        "citations": [
          {
            "document_hash": "ecf79e111aaf5fa85d7a9214b5f8c925fe9a872e3e9434661c76262b42f8b6b0",
            "evidence_ids": [
              "ev-ecf79e111aaf-0000-0002"
            ],
            "pages": {
              "end": 7,
              "start": 7
            }
          }
        ],
        "text": "According to Justice Thomas, justice Thomas questioned whether the city\u2019s designation of the flagpole as a limited or designated public forum was necessary for the petitioners to succeed."
      }
    ],
