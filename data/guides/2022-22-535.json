  "party_positions": [
    {
      "claims": [
        {
          "attribution": "General Prelogar",
          "citations": [
            {
              "document_hash": "463a78cada97e3c67158872692ba4c6999b4de384652196f4e344e465231d480",
              "evidence_ids": [
                "ev-463a78cada97-0001-0001"
              ],
              "pages": {
                "end": 25,
                "start": 25
              }
            }
          ],
          "text": "According to General Prelogar, the Secretary made the requisite findings that the financial harms derive directly from and are a but\u2011for result of the COVID pandemic."
        },
        {
          "attribution": "General Prelogar",
          "citations": [
            {
              "document_hash": "463a78cada97e3c67158872692ba4c6999b4de384652196f4e344e465231d480",
              "evidence_ids": [
                "ev-463a78cada97-0001-0005"
              ],
              "pages": {
                "end": 41,
                "start": 41
              }
            }
          ],
          "text": "According to General Prelogar, the proper review is arbitrary and capricious because the statute tolerates some overbreadth, requiring examination of the Secretary\u2019s justification."
        }
      ],
      "heading": "Department of Education (General Prelogar)",
      "status": "complete",
      "summary": null,
      "summary_citations": []
    },
    {
      "claims": [
        {
          "attribution": "Mr. Connolly",
          "citations": [
            {
              "document_hash": "463a78cada97e3c67158872692ba4c6999b4de384652196f4e344e465231d480",
              "evidence_ids": [
                "ev-463a78cada97-0003-0001"
              ],
              "pages": {
                "end": 66,
                "start": 66
              }
            }
          ],
          "text": "According to Mr. Connolly, congress required that waivers and modifications under the HEROES Act be authorized by the Act; merely labeling something a waiver is insufficient."
        },
        {
          "attribution": "Mr. Connolly",
          "citations": [
            {
              "document_hash": "463a78cada97e3c67158872692ba4c6999b4de384652196f4e344e465231d480",
              "evidence_ids": [
                "ev-463a78cada97-0003-0006"
              ],
              "pages": {
                "end": 70,
                "start": 70
              }
            }
          ],
          "text": "According to Mr. Connolly, the negotiated rulemaking statute is relevant to the analysis of the Department\u2019s authority."
        }
      ],
      "heading": "Department of Education (Mr. Connolly)",
      "status": "complete",
      "summary": null,
      "summary_citations": []
    },
    {
      "claims": [
        {
          "attribution": "Respondents Myra Brown and Alexander Taylor",
          "citations": [
            {
              "document_hash": "70318283ef0b48f1536222f5538c5184177424fd3ae256579d4d380ae5f411b4",
              "evidence_ids": [
                "ev-70318283ef0b-0000-0000"
              ],
              "pages": {
                "end": 2,
                "start": 2
              }
            }
          ],
          "text": "According to Respondents Myra Brown and Alexander Taylor, the HEROES Act\u2019s procedural exemptions apply only when the rule is substantively authorized; therefore the Secretary must follow negotiated rulemaking and notice\u2011and\u2011comment."
        },
        {
          "attribution": "Brown and Taylor",
          "citations": [
            {
              "document_hash": "70318283ef0b48f1536222f5538c5184177424fd3ae256579d4d380ae5f411b4",
              "evidence_ids": [
                "ev-70318283ef0b-0001-0001"
              ],
              "pages": {
                "end": 14,
                "start": 14
              }
            }
          ],
          "text": "According to Brown and Taylor, if the Plan is vacated, the Department may seek loan relief under the Higher Education Act, which could affect the outcome."
        }
      ],
      "heading": "Respondents (Myra Brown and Alexander Taylor)",
