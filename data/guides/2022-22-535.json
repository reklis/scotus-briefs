  "case_id": "2022-22-535",
  "decision": {
    "claims": [
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "70318283ef0b48f1536222f5538c5184177424fd3ae256579d4d380ae5f411b4",
            "evidence_ids": [
              "ev-70318283ef0b-0000-0006"
            ],
            "pages": {
              "end": 7,
              "start": 7
            }
          }
        ],
        "text": "The respondents lack standing to bring their procedural claim."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "70318283ef0b48f1536222f5538c5184177424fd3ae256579d4d380ae5f411b4",
            "evidence_ids": [
              "ev-70318283ef0b-0001-0003"
            ],
            "pages": {
              "end": 19,
              "start": 19
            }
          }
        ],
        "text": "The Court vacates the judgment of the United States District Court for the Northern District of Texas."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "70318283ef0b48f1536222f5538c5184177424fd3ae256579d4d380ae5f411b4",
            "evidence_ids": [
              "ev-70318283ef0b-0001-0003"
            ],
            "pages": {
              "end": 19,
              "start": 19
            }
          }
        ],
        "text": "The case is remanded with instructions to dismiss."
      },
      {
        "attribution": "Justice Alito",
        "citations": [
          {
            "document_hash": "70318283ef0b48f1536222f5538c5184177424fd3ae256579d4d380ae5f411b4",
            "evidence_ids": [
              "ev-70318283ef0b-0001-0004"
            ],
            "pages": {
              "end": 20,
              "start": 20
            }
          }
        ],
        "text": "The Department\u2019s application for a stay is denied as moot."
      }
    ],
