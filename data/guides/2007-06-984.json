            },
            {
              "document_hash": "fe2d9545532c5a621c63ae9eefa8f0a501f5eeb881702098cfc64b82ecea85b3",
              "evidence_ids": [
                "ev-fe2d9545532c-0001-0002"
              ],
              "pages": {
                "end": 22,
                "start": 22
              }
            }
          ],
          "text": "According to Mr. Donovan, the President\u2019s determination is an independent source of authority, and without it the Court would apply the treaty obligation under the Supremacy Clause."
        },
        {
          "attribution": "Mr. Cruz",
          "citations": [
            {
              "document_hash": "fe2d9545532c5a621c63ae9eefa8f0a501f5eeb881702098cfc64b82ecea85b3",
