              "start": 14
            }
          }
        ],
        "text": "A Justice asked whether the settlement clearly does not bind the Government."
      },
      {
        "attribution": "Justice",
        "citations": [
          {
            "document_hash": "414632c01a7decef6f679163735a9b1420f98c250211cbb592f5c64c44af886c",
