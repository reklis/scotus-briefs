              "pages": {
                "end": 35,
                "start": 35
              }
            }
          ],
          "text": "According to Mr. Lunn, section\u202f3583(k) stretches what the original jury\u2011authorized sentence permitted."
        },
        {
          "attribution": "Mr. Lunn",
          "citations": [
            {
              "document_hash": "fa2afda9ecdd54f12884b7a045852688847a0464138a95fcfd2f3945949e18c4",
              "evidence_ids": [
