              "end": 21,
              "start": 20
            }
          },
          {
            "document_hash": "a8fed8dde85e5d7bfbc95c6e687b9ad32f595dd4f7499e04a2c11cb741a470b1",
            "evidence_ids": [
              "ev-a8fed8dde85e-0001-0004"
            ],
            "pages": {
              "end": 21,
              "start": 21
            }
          }
        ],
        "text": "According to Mr. Gossett, petitioner further argues that had an individual left the United States in 1996, the IIRIRA would render them inadmissible for five years, preventing readmission."
      },
      {
        "attribution": "Justice Breyer",
        "citations": [
          {
            "document_hash": "a8fed8dde85e5d7bfbc95c6e687b9ad32f595dd4f7499e04a2c11cb741a470b1",
            "evidence_ids": [
              "ev-a8fed8dde85e-0001-0000"
            ],
            "pages": {
              "end": 22,
              "start": 22
            }
          }
        ],
        "text": "Justice Breyer asked whether the relevant period could be ten to twenty years."
      },
      {
        "attribution": "Justice Kennedy",
        "citations": [
          {
            "document_hash": "a8fed8dde85e5d7bfbc95c6e687b9ad32f595dd4f7499e04a2c11cb741a470b1",
            "evidence_ids": [
              "ev-a8fed8dde85e-0001-0003"
            ],
            "pages": {
              "end": 23,
              "start": 23
            }
          }
        ],
        "text": "Justice Kennedy asked whether a different result might have occurred if a marriage had taken place before a certain date."
      },
      {
        "attribution": "Justice Breyer",
        "citations": [
          {
            "document_hash": "a8fed8dde85e5d7bfbc95c6e687b9ad32f595dd4f7499e04a2c11cb741a470b1",
            "evidence_ids": [
              "ev-a8fed8dde85e-0002-0000"
            ],
            "pages": {
              "end": 38,
              "start": 38
            }
          }
        ],
        "text": "Justice Breyer later asked whether an illegal entrant married to an American could ever remain in the country."
      },
      {
        "attribution": "Justice Scalia",
        "citations": [
          {
            "document_hash": "a8fed8dde85e5d7bfbc95c6e687b9ad32f595dd4f7499e04a2c11cb741a470b1",
            "evidence_ids": [
              "ev-a8fed8dde85e-0002-0001"
            ],
            "pages": {
              "end": 52,
              "start": 52
            }
          }
        ],
        "text": "Justice Scalia asked a follow\u2011up question about the issue."
      }
