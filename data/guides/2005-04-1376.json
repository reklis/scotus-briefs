        ],
        "text": "Petitioner argues that Congress intended the 1996 reinstatement provision to apply only prospectively."
      },
      {
        "attribution": "Mr. Gossett",
        "citations": [
          {
            "document_hash": "a8fed8dde85e5d7bfbc95c6e687b9ad32f595dd4f7499e04a2c11cb741a470b1",
            "evidence_ids": [
