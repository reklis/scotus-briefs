  "oral_argument": {
    "claims": [
      {
        "attribution": "Justice Ginsburg",
        "citations": [
          {
            "document_hash": "c46f3eea9ab7f06994bc2fa2fa732a2461cbc470cc53addcb66950aaf0a5c7a5",
