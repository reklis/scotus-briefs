  "oral_argument": {
    "claims": [
      {
        "attribution": "Justice Kagan",
        "citations": [
          {
            "document_hash": "23b8a204b8836873f7e4a1f94a1661b5b4eca0831e9c1819020e8c1cf7943f55",
            "evidence_ids": [
              "ev-23b8a204b883-0000-0003"
            ],
            "pages": {
              "end": 3,
              "start": 3
            }
          }
        ],
        "text": "Justice Kagan asked, \u201cWhat power is Congress exercising here?\u201d"
      },
      {
        "attribution": "Chief Justice Roberts",
        "citations": [
          {
            "document_hash": "23b8a204b8836873f7e4a1f94a1661b5b4eca0831e9c1819020e8c1cf7943f55",
            "evidence_ids": [
              "ev-23b8a204b883-0000-0010"
            ],
            "pages": {
              "end": 3,
              "start": 3
            }
          }
        ],
        "text": "According to Chief Justice Roberts, chief Justice Roberts announced, \u201cWe\u2019ll hear argument first this morning in Case 10\u2011699, Zivotofsky v. Clinton.\u201d"
      },
      {
        "attribution": "Justice Scalia",
        "citations": [
          {
            "document_hash": "23b8a204b8836873f7e4a1f94a1661b5b4eca0831e9c1819020e8c1cf7943f55",
            "evidence_ids": [
              "ev-23b8a204b883-0000-0006"
            ],
            "pages": {
              "end": 11,
              "start": 11
            }
          }
        ],
        "text": "According to Justice Scalia, justice Scalia questioned, \u201cCongress is supreme, then?\u201d"
      },
      {
        "attribution": "Chief Justice Roberts",
        "citations": [
          {
            "document_hash": "23b8a204b8836873f7e4a1f94a1661b5b4eca0831e9c1819020e8c1cf7943f55",
            "evidence_ids": [
              "ev-23b8a204b883-0000-0007"
            ],
            "pages": {
              "end": 12,
              "start": 12
            }
          }
        ],
        "text": "Chief Justice Roberts asked whether the outcome would differ if Congress required \u201cJerusalem, Israel\u201d on passports."
      },
      {
        "attribution": "Justice Scalia",
        "citations": [
          {
            "document_hash": "23b8a204b8836873f7e4a1f94a1661b5b4eca0831e9c1819020e8c1cf7943f55",
            "evidence_ids": [
              "ev-23b8a204b883-0001-0000"
            ],
            "pages": {
              "end": 21,
              "start": 21
            }
          }
        ],
        "text": "According to Justice Scalia, justice Scalia noted that a personal identification choice can have significant foreign\u2011policy implications."
      },
      {
        "attribution": "Justice Ginsburg",
        "citations": [
          {
            "document_hash": "23b8a204b8836873f7e4a1f94a1661b5b4eca0831e9c1819020e8c1cf7943f55",
            "evidence_ids": [
              "ev-23b8a204b883-0001-0002"
            ],
            "pages": {
              "end": 23,
              "start": 23
            }
          }
        ],
        "text": "Justice Ginsburg pointed out that the D.C. Circuit had decided a related question and asked whether the issue is a political question."
      },
      {
        "attribution": "Justice Breyer",
        "citations": [
          {
            "document_hash": "23b8a204b8836873f7e4a1f94a1661b5b4eca0831e9c1819020e8c1cf7943f55",
            "evidence_ids": [
              "ev-23b8a204b883-0001-0005"
            ],
            "pages": {
              "end": 26,
              "start": 26
            }
          }
        ],
        "text": "Justice Breyer asked whether \u201cexclusive power\u201d means the President can act without congressional authority."
      },
      {
        "attribution": "Chief Justice Roberts",
        "citations": [
          {
            "document_hash": "23b8a204b8836873f7e4a1f94a1661b5b4eca0831e9c1819020e8c1cf7943f55",
            "evidence_ids": [
              "ev-23b8a204b883-0001-0006"
            ],
            "pages": {
              "end": 31,
              "start": 31
            }
          }
        ],
        "text": "According to Chief Justice Roberts, chief Justice Roberts questioned how labeling the issue a political question advances the analysis."
      },
      {
        "attribution": "Justice Alito",
        "citations": [
          {
            "document_hash": "23b8a204b8836873f7e4a1f94a1661b5b4eca0831e9c1819020e8c1cf7943f55",
            "evidence_ids": [
              "ev-23b8a204b883-0001-0007"
            ],
            "pages": {
              "end": 32,
              "start": 32
            }
          }
        ],
        "text": "Justice Alito asked what the precise question is that must be identified to decide if it is a political question."
      },
      {
        "attribution": "Justice Kagan",
        "citations": [
          {
            "document_hash": "23b8a204b8836873f7e4a1f94a1661b5b4eca0831e9c1819020e8c1cf7943f55",
            "evidence_ids": [
              "ev-23b8a204b883-0002-0004"
            ],
            "pages": {
              "end": 42,
              "start": 42
            }
          }
        ],
        "text": "Justice Kagan asked whether the argument would be the same if the constitutional provision were not present."
      },
      {
        "attribution": "Chief Justice Roberts",
        "citations": [
          {
            "document_hash": "23b8a204b8836873f7e4a1f94a1661b5b4eca0831e9c1819020e8c1cf7943f55",
            "evidence_ids": [
              "ev-23b8a204b883-0002-0005"
            ],
            "pages": {
              "end": 56,
              "start": 56
            }
          }
        ],
        "text": "According to Chief Justice Roberts, chief Justice Roberts announced, \u201cThe case is submitted.\u201d"
      }
