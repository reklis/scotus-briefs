            ],
            "pages": {
              "end": 32,
              "start": 32
            }
          }
        ],
        "text": "According to Kenneth W. Ravenell, ravenell asserts that Edwards v. Arizona supports the view that a cure should not be applied unless the defendant himself initiates contact."
      },
      {
        "attribution": "Ravenell",
        "citations": [
          {
            "document_hash": "1648089627b37d6cc9dc179b480f2bbdb499570bb4ab3fb74223e1d4c84eb0a2",
            "evidence_ids": [
              "ev-1648089627b3-0002-0000"
