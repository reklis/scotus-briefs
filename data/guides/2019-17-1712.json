  "background_and_question": {
    "claims": [
      {
        "attribution": "Petitioners",
        "citations": [
          {
            "document_hash": "e8ad065b81e81700654e9dfffc84c790ddf0c23fc9f38a0b425cff129dacf914",
            "evidence_ids": [
              "ev-e8ad065b81e8-0000-0000"
            ],
            "pages": {
              "end": 4,
              "start": 4
            }
          }
        ],
        "text": "According to Petitioners, the case concerns an alleged loss of $750\u202fmillion from a trust due to trustees\u2019 disloyalty and imprudence."
      },
      {
        "attribution": "Respondents",
        "citations": [
          {
            "document_hash": "e8ad065b81e81700654e9dfffc84c790ddf0c23fc9f38a0b425cff129dacf914",
            "evidence_ids": [
              "ev-e8ad065b81e8-0000-0001"
            ],
            "pages": {
              "end": 5,
              "start": 5
            }
          }
        ],
        "text": "Respondents contend that participants in defined\u2011benefit plans do not have an interest in the plan assets."
      },
      {
        "attribution": "Chief Justice Roberts",
        "citations": [
          {
            "document_hash": "e8ad065b81e81700654e9dfffc84c790ddf0c23fc9f38a0b425cff129dacf914",
            "evidence_ids": [
              "ev-e8ad065b81e8-0000-0002"
            ],
            "pages": {
              "end": 6,
              "start": 6
            }
          }
        ],
        "text": "Chief Justice Roberts asked whether the petitioners\u2019 argument depends on a forward\u2011looking theory of injury."
      },
      {
        "attribution": "Joseph R. PALMORE",
        "citations": [
          {
            "document_hash": "e8ad065b81e81700654e9dfffc84c790ddf0c23fc9f38a0b425cff129dacf914",
            "evidence_ids": [
              "ev-e8ad065b81e8-0001-0002"
            ],
            "pages": {
              "end": 35,
              "start": 35
            }
          }
        ],
        "text": "According to Joseph R. PALMORE, petitioners\u2019 counsel argued that, under ERISA, plaintiffs must demonstrate an injury, which the petitioners cannot do."
      }
    ],
