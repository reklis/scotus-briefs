              "start": 5
            }
          }
        ],
        "text": "Respondents argue that participants in defined\u2011benefit plans have no ownership interest in the plan assets."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "e8ad065b81e81700654e9dfffc84c790ddf0c23fc9f38a0b425cff129dacf914",
