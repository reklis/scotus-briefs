              "end": 48,
              "start": 48
            }
          }
        ],
        "text": "The case centers on whether liability under Sections\u202f11 and\u202f12 of the 1933 Securities Act applies only to shares issued pursuant to a registration statement."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "c58e1b7c61a65c49f2b7fcd66c2f2cd20dc8529dfa400064347d37b4ade651df",
            "evidence_ids": [
              "ev-c58e1b7c61a6-0000-0003"
            ],
            "pages": {
              "end": 8,
              "start": 8
            }
          }
        ],
        "text": "The district court denied Slack\u2019s motion to dismiss the complaint and certified the ruling for interlocutory appeal."
      }
    ],
