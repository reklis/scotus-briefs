                "start": 5
              }
            }
          ],
          "text": "According to Halkbank, the indictment should be dismissed because 18\u202fU.S.C.\u202f\u00a7\u202f3231 does not extend to prosecutions of instrumentalities of foreign states."
        },
        {
          "attribution": "Halkbank",
          "citations": [
            {
              "document_hash": "868a92d02c0b86ce69bb94dc1b957bbbf7281b33399377945519f10ad42cafda",
              "evidence_ids": [
                "ev-868a92d02c0b-0000-0004"
              ],
              "pages": {
                "end": 5,
                "start": 5
              }
            }
          ],
          "text": "According to Halkbank, the Foreign Sovereign Immunities Act provides absolute immunity from criminal prosecution for instrumentalities of foreign states."
        },
        {
          "attribution": "Halkbank",
          "citations": [
            {
              "document_hash": "868a92d02c0b86ce69bb94dc1b957bbbf7281b33399377945519f10ad42cafda",
              "evidence_ids": [
                "ev-868a92d02c0b-0001-0003"
              ],
              "pages": {
                "end": 13,
                "start": 13
              }
            }
          ],
          "text": "According to Halkbank, section\u202f1604 renders Halkbank immune not only from civil suits but also from criminal prosecutions."
        }
      ],
      "heading": "Halkbank",
      "status": "complete",
      "summary": null,
