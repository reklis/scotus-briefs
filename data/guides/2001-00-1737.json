              "start": 5
            }
          }
        ],
        "text": "Justice Kennedy asked whether the mayor\u2019s records are open to the public."
      },
      {
        "attribution": "Justice Kennedy",
        "citations": [
          {
            "document_hash": "59d8591f9a3dc92d965e0c54afa094ac5a2d844c2e761a81a4cb95aeae6eb7b9",
