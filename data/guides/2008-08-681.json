              "end": 9,
              "start": 9
            }
          }
        ],
        "text": "According to Justice Scalia, justice Scalia noted that deciding it the same way twice would be improper."
      },
      {
        "attribution": "Chief Justice Roberts",
        "citations": [
          {
            "document_hash": "4ca0a58fa4da8a3b2c7de1cf7823f24e7e33796816a5ad875eb05a34c3e8740d",
