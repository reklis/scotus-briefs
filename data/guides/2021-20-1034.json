        ],
        "text": "Petitioner Narkis Golan, a United States citizen, married respondent Isacco Saada, an Italian citizen, in Italy and they have a son, B.\u202fA.\u202fS., born in 2016."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "0b686ce3baeceade91a82826fc80957c3ba46062679b3d0eba88b20fd25a2f84",
            "evidence_ids": [
              "ev-0b686ce3baec-0000-0000"
            ],
            "pages": {
              "end": 2,
              "start": 2
            }
          }
        ],
        "text": "Golan filed a petition in the U.S. District Court for the Eastern District of New York seeking an order to return B.\u202fA.\u202fS. to Italy under the Hague Convention."
      },
      {
        "attribution": "Justice Kagan",
        "citations": [
          {
            "document_hash": "6779fe44e8632209c327ae74ac88c5dc5cee939ba4fb9afebd2e8324e1fa2121",
            "evidence_ids": [
              "ev-6779fe44e863-0000-0001"
            ],
            "pages": {
              "end": 9,
              "start": 9
            }
          }
        ],
        "text": "Justice Kagan asked whether the grave\u2011risk exception requires courts to consider ameliorative measures before deciding to return a child."
      }
    ],
