              "evidence_ids": [
                "ev-6779fe44e863-0003-0004"
              ],
              "pages": {
                "end": 74,
                "start": 74
              }
            }
          ],
          "text": "According to Blondin amicus, the Blondin amicus brief criticizes the grave\u2011risk process for requiring expert testimony, arguing that it causes delays and prolongs cases."
        }
