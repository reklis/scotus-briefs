        ],
        "text": "Larry Dean Dusenbery v. United States concerns the forfeiture of $22,000 after the government mailed a notice to him while he was incarcerated."
      },
      {
        "attribution": "United States",
        "citations": [
          {
            "document_hash": "3bd0aa3ba0b2b317f9cf73902198efdb1a4af16aff40dc56c5bf476a7c19755e",
            "evidence_ids": [
              "ev-3bd0aa3ba0b2-0000-0001"
            ],
            "pages": {
              "end": 3,
              "start": 3
            }
          }
        ],
        "text": "According to United States, the dispute centers on whether the 1988 mailing procedures satisfied due process notice requirements, even if the notice was not actually received."
      }
    ],
