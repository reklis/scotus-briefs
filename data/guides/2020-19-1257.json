  "party_positions": [
    {
      "claims": [
        {
          "attribution": "MICHAEL A. CARVIN",
          "citations": [
            {
              "document_hash": "55b2508ae388309d74b45f6641632ad6ab468797e777622073ce852eeb5b0c3e",
              "evidence_ids": [
                "ev-55b2508ae388-0000-0000"
              ],
              "pages": {
                "end": 5,
                "start": 5
              }
            }
          ],
          "text": "According to MICHAEL A. CARVIN, arizona has not denied any voting opportunity; there is no literacy test or vote\u2011dilution that bars minorities from voting."
        },
        {
          "attribution": "MICHAEL A. CARVIN",
          "citations": [
            {
              "document_hash": "55b2508ae388309d74b45f6641632ad6ab468797e777622073ce852eeb5b0c3e",
              "evidence_ids": [
                "ev-55b2508ae388-0000-0002"
              ],
              "pages": {
                "end": 7,
                "start": 7
              }
            }
          ],
          "text": "According to MICHAEL A. CARVIN, section\u202f2 of the VRA requires that voting practices provide equal opportunity; it does not prohibit rules that merely result in disparate outcomes when external socioeconomic factors are involved."
        },
        {
          "attribution": "Ms. Amunson",
          "citations": [
            {
              "document_hash": "55b2508ae388309d74b45f6641632ad6ab468797e777622073ce852eeb5b0c3e",
              "evidence_ids": [
                "ev-55b2508ae388-0004-0006"
              ],
              "pages": {
                "end": 87,
                "start": 87
              }
            }
          ],
          "text": "According to Ms. Amunson, criminalizing non\u2011fraudulent ballot collection does not further the state\u2019s interest in preventing fraud."
        },
        {
          "attribution": "Petitioner",
          "citations": [
            {
              "document_hash": "55b2508ae388309d74b45f6641632ad6ab468797e777622073ce852eeb5b0c3e",
              "evidence_ids": [
                "ev-55b2508ae388-0005-0001"
              ],
              "pages": {
                "end": 113,
                "start": 113
              }
            }
          ],
          "text": "According to Petitioner, there is no evidence of ballot\u2011collection fraud anywhere in the country, and the Carter\u2011Baker Report was not considered by the legislature."
        },
        {
          "attribution": "Proponents of the bill",
          "citations": [
            {
              "document_hash": "eb2b04082193bdd9504dcae829d7cddd88684f276d5a06d69f85691af6d3867e",
              "evidence_ids": [
                "ev-eb2b04082193-0004-0005"
              ],
              "pages": {
                "end": 43,
                "start": 43
              }
            }
          ],
          "text": "Proponents of the bill argue that mail\u2011in ballots are more susceptible to fraud than in\u2011person voting."
        }
      ],
