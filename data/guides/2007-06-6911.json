              "end": 4,
              "start": 4
            }
          }
        ],
        "text": "Justice Ginsburg asked whether a Vermont statute that never removes civil rights would equate a first\u2011degree murderer to someone whose rights were removed and later restored."
      },
      {
        "attribution": "Justice Scalia",
        "citations": [
          {
            "document_hash": "2e9c42eb6cfd922568f786a3e13fce2a1d560c93ef0723da8e9006855e5fc8f7",
            "evidence_ids": [
              "ev-2e9c42eb6cfd-0000-0003"
            ],
            "pages": {
              "end": 5,
              "start": 5
            }
          }
        ],
        "text": "Justice Scalia asked how civil rights that have been taken away are typically restored."
      },
      {
        "attribution": "Chief Justice Roberts",
        "citations": [
          {
            "document_hash": "2e9c42eb6cfd922568f786a3e13fce2a1d560c93ef0723da8e9006855e5fc8f7",
            "evidence_ids": [
              "ev-2e9c42eb6cfd-0000-0005"
            ],
            "pages": {
              "end": 9,
              "start": 9
            }
          }
        ],
        "text": "Chief Justice Roberts asked if the petitioner\u2019s argument would effectively weed out certain misdemeanor provisions when civil rights were never taken away."
      }
    ],
    "heading": "Oral Argument",
