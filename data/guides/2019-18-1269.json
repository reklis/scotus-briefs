  "oral_argument": {
    "claims": [
      {
        "attribution": "JUSTICE GINSBURG",
        "citations": [
          {
            "document_hash": "2d3c9def0f46f4396731888707f6de6f68a64de341e4c3661dce33166ec2e62b",
            "evidence_ids": [
              "ev-2d3c9def0f46-0000-0006"
            ],
            "pages": {
              "end": 6,
              "start": 6
            }
          }
        ],
        "text": "Justice Ginsburg asked whether the government had abandoned the Bob Richards rule."
      },
      {
        "attribution": "JUSTICE KAGAN",
        "citations": [
          {
            "document_hash": "2d3c9def0f46f4396731888707f6de6f68a64de341e4c3661dce33166ec2e62b",
            "evidence_ids": [
              "ev-2d3c9def0f46-0000-0007"
            ],
            "pages": {
              "end": 7,
              "start": 7
            }
          }
        ],
        "text": "According to JUSTICE KAGAN, justice Kagan questioned why the Court should consider the Bob Richards rule at all, noting that both sides agreed it should not be dispositive."
      },
      {
        "attribution": "JUSTICE SOTOMAYOR",
        "citations": [
          {
            "document_hash": "2d3c9def0f46f4396731888707f6de6f68a64de341e4c3661dce33166ec2e62b",
            "evidence_ids": [
              "ev-2d3c9def0f46-0000-0008"
            ],
            "pages": {
              "end": 8,
              "start": 8
            }
          }
        ],
        "text": "Justice Sotomayor asked whether state law could trump a contract allocation of ownership under the Bob Richards rule."
      },
      {
        "attribution": "JUSTICE SOTOMAYOR",
        "citations": [
          {
            "document_hash": "2d3c9def0f46f4396731888707f6de6f68a64de341e4c3661dce33166ec2e62b",
            "evidence_ids": [
              "ev-2d3c9def0f46-0000-0009"
            ],
            "pages": {
              "end": 9,
              "start": 9
            }
          }
        ],
        "text": "Justice Sotomayor further asked whether a clear agency relationship in a contract would be altered by state law."
      },
      {
        "attribution": "JUSTICE BREYER",
        "citations": [
          {
            "document_hash": "2d3c9def0f46f4396731888707f6de6f68a64de341e4c3661dce33166ec2e62b",
            "evidence_ids": [
              "ev-2d3c9def0f46-0000-0011"
            ],
            "pages": {
              "end": 11,
              "start": 11
            }
          }
        ],
        "text": "Justice Breyer inquired whether the issue had been argued in the lower courts."
      },
      {
        "attribution": "JUSTICE BREYER",
        "citations": [
          {
            "document_hash": "2d3c9def0f46f4396731888707f6de6f68a64de341e4c3661dce33166ec2e62b",
            "evidence_ids": [
              "ev-2d3c9def0f46-0000-0012"
            ],
            "pages": {
              "end": 12,
              "start": 12
            }
          }
        ],
        "text": "According to JUSTICE BREYER, justice Breyer noted that the lower courts had considered Colorado case law."
      },
      {
        "attribution": "JUSTICE KAVANAUGH",
        "citations": [
          {
            "document_hash": "2d3c9def0f46f4396731888707f6de6f68a64de341e4c3661dce33166ec2e62b",
            "evidence_ids": [
              "ev-2d3c9def0f46-0000-0014"
            ],
            "pages": {
              "end": 15,
              "start": 15
            }
          }
        ],
        "text": "Justice Kavanaugh asked whether the Court could deem the Bob Richards rule \u201cnot good law\u201d and send the case back."
      },
      {
        "attribution": "Justice Alito",
        "citations": [
          {
            "document_hash": "2d3c9def0f46f4396731888707f6de6f68a64de341e4c3661dce33166ec2e62b",
            "evidence_ids": [
              "ev-2d3c9def0f46-0002-0001"
            ],
            "pages": {
              "end": 47,
              "start": 47
            }
          }
        ],
        "text": "According to Justice Alito, justice Alito questioned whether the dispute was about general agency law, i.e., state law."
      },
      {
        "attribution": "Justice Kavanaugh",
        "citations": [
          {
            "document_hash": "2d3c9def0f46f4396731888707f6de6f68a64de341e4c3661dce33166ec2e62b",
            "evidence_ids": [
              "ev-2d3c9def0f46-0002-0002"
            ],
            "pages": {
              "end": 52,
              "start": 52
            }
          }
        ],
        "text": "Justice Kavanaugh asked what would happen if IRS regulations conflicted with state law."
      }
    ],
