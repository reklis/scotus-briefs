  "party_positions": [
    {
      "claims": [
        {
          "attribution": "Petitioner",
          "citations": [
            {
              "document_hash": "2d3c9def0f46f4396731888707f6de6f68a64de341e4c3661dce33166ec2e62b",
              "evidence_ids": [
                "ev-2d3c9def0f46-0000-0003"
              ],
              "pages": {
                "end": 4,
                "start": 4
              }
            }
          ],
          "text": "Petitioner argues that state law, which normally governs property\u2011rights disputes, should control the ownership of the tax refund."
        },
        {
          "attribution": "Petitioner",
          "citations": [
            {
              "document_hash": "2d3c9def0f46f4396731888707f6de6f68a64de341e4c3661dce33166ec2e62b",
              "evidence_ids": [
                "ev-2d3c9def0f46-0003-0000"
              ],
              "pages": {
                "end": 66,
                "start": 66
              }
            }
          ],
          "text": "Petitioner contends that the \u201cBob Richards\u201d rule is not a valid rule of federal common law and should not be applied."
        },
        {
          "attribution": "Mr. Reich",
          "citations": [
            {
              "document_hash": "2d3c9def0f46f4396731888707f6de6f68a64de341e4c3661dce33166ec2e62b",
              "evidence_ids": [
                "ev-2d3c9def0f46-0001-0001"
              ],
              "pages": {
                "end": 26,
                "start": 26
              }
            }
          ],
          "text": "According to Mr. Reich, petitioner also argues that the government\u2019s refusal to defend the Bob Richards rule should not prevent the Court from addressing the question."
        }
      ],
      "heading": "Petitioner Position",
      "status": "complete",
      "summary": null,
      "summary_citations": []
    },
    {
      "claims": [
        {
          "attribution": "Petitioner",
          "citations": [
            {
              "document_hash": "2d3c9def0f46f4396731888707f6de6f68a64de341e4c3661dce33166ec2e62b",
              "evidence_ids": [
                "ev-2d3c9def0f46-0000-0004"
              ],
              "pages": {
                "end": 5,
                "start": 5
              }
            }
          ],
          "text": "According to Petitioner, the government (FDIC) has historically advocated the Bob Richards rule, which presumes that the subsidiary whose losses generated the refund owns the refund."
        },
        {
          "attribution": "Government",
          "citations": [
            {
              "document_hash": "2d3c9def0f46f4396731888707f6de6f68a64de341e4c3661dce33166ec2e62b",
              "evidence_ids": [
                "ev-2d3c9def0f46-0003-0001"
              ],
              "pages": {
                "end": 67,
                "start": 67
              }
            }
          ],
          "text": "The government maintains that an agreement must contain explicit language disavowing the Bob Richards rule in order for a court to depart from that presumption."
        }
      ],
      "heading": "Respondent (Government) Position",
      "status": "complete",
      "summary": null,
      "summary_citations": []
    }
