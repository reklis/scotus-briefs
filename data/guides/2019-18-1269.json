  "overview": {
    "claims": [
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "2d3c9def0f46f4396731888707f6de6f68a64de341e4c3661dce33166ec2e62b",
            "evidence_ids": [
              "ev-2d3c9def0f46-0001-0000"
            ],
            "pages": {
              "end": 29,
              "start": 29
            }
          }
        ],
        "text": "The case concerns a $4\u202fmillion tax refund that the IRS paid to United Western Bank\u2019s bankruptcy estate."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "2d3c9def0f46f4396731888707f6de6f68a64de341e4c3661dce33166ec2e62b",
            "evidence_ids": [
              "ev-2d3c9def0f46-0001-0004"
            ],
            "pages": {
              "end": 31,
              "start": 31
            }
          }
        ],
        "text": "The refund must be delivered to the bank within ten business days after the IRS payment."
      },
      {
        "attribution": "Petitioner",
        "citations": [
          {
            "document_hash": "2d3c9def0f46f4396731888707f6de6f68a64de341e4c3661dce33166ec2e62b",
            "evidence_ids": [
              "ev-2d3c9def0f46-0000-0003"
            ],
            "pages": {
              "end": 4,
              "start": 4
            }
          },
          {
            "document_hash": "2d3c9def0f46f4396731888707f6de6f68a64de341e4c3661dce33166ec2e62b",
            "evidence_ids": [
              "ev-2d3c9def0f46-0000-0004"
            ],
            "pages": {
              "end": 5,
              "start": 5
            }
          }
        ],
        "text": "According to Petitioner, the dispute turns on whether courts should apply state law or the federal \u201cBob Richards\u201d rule to decide ownership of the refund."
      }
    ],
    "heading": "Overview",
    "status": "complete",
    "summary": null,
    "summary_citations": []
