    "claims": [
      {
        "attribution": "Justice Scalia",
        "citations": [
          {
            "document_hash": "4c4a4dea5b66b54093ef645ddf0c3d24afa2386f14e3be9be8373b45aa0129aa",
            "evidence_ids": [
              "ev-4c4a4dea5b66-0001-0000"
            ],
            "pages": {
              "end": 22,
              "start": 22
            }
          }
        ],
        "text": "According to Justice Scalia, the Court heard arguments concerning whether errors at the grand\u2011jury stage that are cured at trial should affect the defendants\u2019 substantial rights."
      },
      {
        "attribution": "Justice Kennedy",
        "citations": [
          {
            "document_hash": "4c4a4dea5b66b54093ef645ddf0c3d24afa2386f14e3be9be8373b45aa0129aa",
            "evidence_ids": [
              "ev-4c4a4dea5b66-0000-0003"
            ],
            "pages": {
              "end": 4,
              "start": 4
            }
          }
        ],
        "text": "Justice Kennedy asked whether a sentencing error could simply be sent back to the trial judge for correction."
      },
      {
        "attribution": "Justice O'Connor",
        "citations": [
          {
            "document_hash": "4c4a4dea5b66b54093ef645ddf0c3d24afa2386f14e3be9be8373b45aa0129aa",
            "evidence_ids": [
              "ev-4c4a4dea5b66-0000-0004"
            ],
            "pages": {
              "end": 7,
              "start": 7
            }
          }
        ],
        "text": "According to Justice O'Connor, justice O\u2019Connor questioned whether the case required overruling *Ex parte Bain* and whether the issue was jurisdictional because the indictment lacked a specific quantity."
      },
      {
        "attribution": "Justice Ginsburg",
        "citations": [
          {
            "document_hash": "4c4a4dea5b66b54093ef645ddf0c3d24afa2386f14e3be9be8373b45aa0129aa",
            "evidence_ids": [
              "ev-4c4a4dea5b66-0000-0005"
            ],
            "pages": {
              "end": 8,
              "start": 8
            }
          }
        ],
        "text": "Justice Ginsburg asked whether the error in question qualified as a jurisdictional defect."
      },
      {
        "attribution": "Justice Breyer",
        "citations": [
          {
            "document_hash": "4c4a4dea5b66b54093ef645ddf0c3d24afa2386f14e3be9be8373b45aa0129aa",
            "evidence_ids": [
              "ev-4c4a4dea5b66-0001-0002"
            ],
            "pages": {
              "end": 34,
              "start": 34
            }
          }
        ],
        "text": "Justice Breyer warned that recognizing grand\u2011jury errors could open the floodgates to challenges of grand\u2011jury proceedings."
      },
      {
        "attribution": "Chief Justice",
        "citations": [
          {
            "document_hash": "4c4a4dea5b66b54093ef645ddf0c3d24afa2386f14e3be9be8373b45aa0129aa",
            "evidence_ids": [
              "ev-4c4a4dea5b66-0002-0000"
            ],
            "pages": {
              "end": 35,
              "start": 35
            }
          }
        ],
        "text": "According to Chief Justice, chief Justice questioned whether second\u2011guessing the grand jury is any worse than second\u2011guessing a petty jury."
      }
    ],
