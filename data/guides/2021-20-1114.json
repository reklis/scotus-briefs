  "why_it_matters": {
    "claims": [
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "4a073a7488831863f1a28a7a7cd2692ca70bc6ba192bef152e63bd0c9ee59675",
            "evidence_ids": [
              "ev-4a073a748883-0000-0008"
            ],
            "pages": {
              "end": 5,
              "start": 5
            }
          }
        ],
        "text": "HHS\u2019s total reimbursements to hospitals for prescription drugs total tens of billions of dollars each year."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "4a073a7488831863f1a28a7a7cd2692ca70bc6ba192bef152e63bd0c9ee59675",
            "evidence_ids": [
              "ev-4a073a748883-0000-0009"
            ],
            "pages": {
              "end": 5,
              "start": 5
            }
          }
        ],
        "text": "For 340B hospitals, the case involves economic consequences of about $1.6\u202fbillion annually."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "4a073a7488831863f1a28a7a7cd2692ca70bc6ba192bef152e63bd0c9ee59675",
            "evidence_ids": [
              "ev-4a073a748883-0000-0010"
            ],
            "pages": {
              "end": 7,
              "start": 7
            }
          }
        ],
        "text": "Statutory \u201coption\u202f2\u201d does not authorize HHS to vary reimbursement rates for different groups of hospitals."
      },
      {
        "attribution": "37 State and Regional Hospital Associations",
        "citations": [
          {
            "document_hash": "4a073a7488831863f1a28a7a7cd2692ca70bc6ba192bef152e63bd0c9ee59675",
            "evidence_ids": [
              "ev-4a073a748883-0001-0003"
            ],
            "pages": {
              "end": 16,
              "start": 16
            }
          }
        ],
        "text": "According to 37 State and Regional Hospital Associations, amici noted that the payments to 340B hospitals help offset the considerable costs these providers incur in caring for the uninsured, underinsured, and patients in remote areas."
      }
    ],
