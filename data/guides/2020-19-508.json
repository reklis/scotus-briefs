  "overview": {
    "claims": [
      {
        "attribution": "Supreme Court",
        "citations": [
          {
            "document_hash": "a3b3061f560bff34209f0327909e0cdbe408ebd589948ddcabc85e3290b54835",
            "evidence_ids": [
