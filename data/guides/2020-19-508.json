            }
          },
          {
            "document_hash": "da6febf7dfa311d8d03a94170df8c36e43ec81e4bf15055caf4ddcdfdf194736",
            "evidence_ids": [
              "ev-da6febf7dfa3-0000-0001"
            ],
            "pages": {
              "end": 4,
              "start": 4
            }
          }
        ],
        "text": "The Commission argued that \u00a713(b) permits monetary relief, while the petitioners argued it does not."
      }
