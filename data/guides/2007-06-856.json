              "end": 3,
              "start": 3
            }
          }
        ],
        "text": "Justice Scalia asked for the code numbers of the ERISA sections referenced."
      },
      {
        "attribution": "Justice Ginsburg",
        "citations": [
          {
            "document_hash": "e84af8b76a3f99ec010531d8476a3f3114cfeb26f959979e412335019fdd6bdc",
            "evidence_ids": [
              "ev-e84af8b76a3f-0001-0004"
            ],
            "pages": {
              "end": 27,
              "start": 27
            }
          }
        ],
        "text": "Justice Ginsburg asked whether the government's position on the (a)(1)(B) argument was that it is available, but (a)(2) is also available."
      },
      {
        "attribution": "Justice Scalia",
        "citations": [
          {
            "document_hash": "e84af8b76a3f99ec010531d8476a3f3114cfeb26f959979e412335019fdd6bdc",
            "evidence_ids": [
              "ev-e84af8b76a3f-0001-0003"
            ],
            "pages": {
              "end": 23,
              "start": 23
            }
          }
        ],
        "text": "According to Justice Scalia, section (a)(2) refers to 1109 and does not specify who may be sued."
      },
      {
        "attribution": "Justice Breyer",
        "citations": [
          {
            "document_hash": "e84af8b76a3f99ec010531d8476a3f3114cfeb26f959979e412335019fdd6bdc",
            "evidence_ids": [
              "ev-e84af8b76a3f-0002-0001"
            ],
            "pages": {
              "end": 39,
              "start": 39
            }
          }
        ],
        "text": "Justice Breyer asked why relief is not available under (a)(2)."
      },
      {
        "attribution": "Justice Souter",
        "citations": [
          {
            "document_hash": "e84af8b76a3f99ec010531d8476a3f3114cfeb26f959979e412335019fdd6bdc",
            "evidence_ids": [
              "ev-e84af8b76a3f-0002-0003"
            ],
            "pages": {
              "end": 41,
              "start": 41
            }
          }
        ],
        "text": "Justice Souter asked how to determine whether a loss from an individual account suffices as a loss to the plan for pleading purposes."
      },
      {
        "attribution": "Justice Ginsburg",
        "citations": [
          {
            "document_hash": "e84af8b76a3f99ec010531d8476a3f3114cfeb26f959979e412335019fdd6bdc",
            "evidence_ids": [
              "ev-e84af8b76a3f-0002-0004"
            ],
            "pages": {
              "end": 53,
              "start": 53
            }
          }
        ],
        "text": "According to Justice Ginsburg, the case was dismissed on the pleadings."
      }
    ],
