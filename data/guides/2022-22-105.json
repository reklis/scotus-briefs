              "end": 2,
              "start": 2
            }
          }
        ],
        "text": "Section 16(a) of the Federal Arbitration Act does not say whether district\u2011court proceedings must be stayed pending resolution of an interlocutory appeal."
      },
      {
        "attribution": "Coinbase, Inc.",
        "citations": [
          {
            "document_hash": "d8359aba3435e4b8198b3221c34fc496b91354ef8636a3f49b0218c9e56408eb",
            "evidence_ids": [
              "ev-d8359aba3435-0000-0000"
            ],
            "pages": {
              "end": 4,
              "start": 4
            }
          }
        ],
        "text": "According to Coinbase, Inc., when a party appeals the denial of a motion to compel arbitration, the appeal stays the litigation, based on the long\u2011standing divestiture rule and Congress\u2019s adoption of an asymmetric interlocutory rule in FAA Section\u202f16(a)."
      }
    ],
    "heading": "Overview",
    "status": "complete",
    "summary": null,
    "summary_citations": []
  },
  "party_positions": [
    {
      "claims": [
        {
          "attribution": "Bielski",
          "citations": [
