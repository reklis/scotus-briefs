  "oral_argument": {
    "claims": [
      {
        "attribution": "Justice Thomas",
        "citations": [
          {
            "document_hash": "d8359aba3435e4b8198b3221c34fc496b91354ef8636a3f49b0218c9e56408eb",
            "evidence_ids": [
              "ev-d8359aba3435-0000-0001"
            ],
            "pages": {
              "end": 6,
              "start": 6
            }
          }
        ],
        "text": "According to Justice Thomas, justice Thomas: Haven\u2019t we treated qualified immunity differently from other interlocutory appeals?"
      },
      {
        "attribution": "Justice Thomas",
        "citations": [
          {
            "document_hash": "d8359aba3435e4b8198b3221c34fc496b91354ef8636a3f49b0218c9e56408eb",
            "evidence_ids": [
              "ev-d8359aba3435-0000-0002"
            ],
            "pages": {
              "end": 7,
              "start": 7
            }
          }
        ],
        "text": "According to Justice Thomas, justice Thomas: Does it follow automatically that when you have an interlocutory appeal, there\u2019s an automatic stay?"
      },
      {
        "attribution": "Justice Sotomayor",
        "citations": [
          {
            "document_hash": "d8359aba3435e4b8198b3221c34fc496b91354ef8636a3f49b0218c9e56408eb",
            "evidence_ids": [
              "ev-d8359aba3435-0000-0003"
            ],
            "pages": {
              "end": 8,
              "start": 8
            }
          }
        ],
        "text": "Justice Sotomayor: Why is that different than a forum selection clause, which we say is not subject to an automatic stay?"
      },
      {
        "attribution": "Justice Gorsuch",
        "citations": [
          {
            "document_hash": "d8359aba3435e4b8198b3221c34fc496b91354ef8636a3f49b0218c9e56408eb",
            "evidence_ids": [
              "ev-d8359aba3435-0001-0003"
            ],
            "pages": {
              "end": 29,
              "start": 29
            }
          }
        ],
        "text": "According to Justice Gorsuch, justice Gorsuch: Where does this background rule come from? Is it a federal common law principle? How old is it?"
      },
      {
        "attribution": "Justice Alito",
        "citations": [
          {
            "document_hash": "d8359aba3435e4b8198b3221c34fc496b91354ef8636a3f49b0218c9e56408eb",
            "evidence_ids": [
              "ev-d8359aba3435-0003-0000"
            ],
            "pages": {
              "end": 66,
              "start": 66
            }
          }
        ],
        "text": "According to Justice Alito, justice Alito: Was that right?"
      },
      {
        "attribution": "Justice Kavanaugh",
        "citations": [
          {
            "document_hash": "d8359aba3435e4b8198b3221c34fc496b91354ef8636a3f49b0218c9e56408eb",
            "evidence_ids": [
              "ev-d8359aba3435-0003-0004"
            ],
            "pages": {
              "end": 73,
              "start": 73
            }
          }
        ],
        "text": "According to Justice Kavanaugh, justice Kavanaugh: Should we have an automatic stay on the discretionary factors if discovery is about to be ordered?"
      },
      {
        "attribution": "Justice Sotomayor",
        "citations": [
          {
            "document_hash": "d8359aba3435e4b8198b3221c34fc496b91354ef8636a3f49b0218c9e56408eb",
            "evidence_ids": [
              "ev-d8359aba3435-0003-0006"
            ],
            "pages": {
              "end": 83,
              "start": 83
            }
          }
        ],
        "text": "Justice Sotomayor: If we say a stay is mandatory, could state courts say no?"
      },
      {
        "attribution": "Justice Jackson",
        "citations": [
          {
            "document_hash": "d8359aba3435e4b8198b3221c34fc496b91354ef8636a3f49b0218c9e56408eb",
            "evidence_ids": [
              "ev-d8359aba3435-0002-0001"
            ],
            "pages": {
              "end": 46,
              "start": 46
            }
          }
        ],
        "text": "According to Justice Jackson, justice Jackson: Can you help me understand why this is not that scenario?"
      }
    ],
