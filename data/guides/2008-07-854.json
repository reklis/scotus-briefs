              "start": 23
            }
          }
        ],
        "text": "Justice Ginsburg asked what year the prosecution occurred and noted that the case was creating a database."
      },
      {
        "attribution": "Justice Alito",
        "citations": [
          {
            "document_hash": "6ab8ec21006ec8570d912efa69199859f3cbda0c74cea37ba4b0609d14a02c90",
