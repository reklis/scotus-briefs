  "overview": {
    "claims": [
      {
        "attribution": "Petitioners",
        "citations": [
          {
            "document_hash": "90c1760a468a200bf8fcdd78bfd92d9e9a2c41d7ed74a47eb4b627f4f317c1b3",
            "evidence_ids": [
