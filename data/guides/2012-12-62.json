                "end": 40,
                "start": 40
              }
            }
          ],
          "text": "Petitioner argues that the district court gave undue deference to the sentencing guidelines as a legal matter."
        },
        {
          "attribution": "Petitioner",
          "citations": [
            {
              "document_hash": "9777734eaa3c7da01e7fb7e83448d1f529a421d3e4df9d812fa503cc76067214",
