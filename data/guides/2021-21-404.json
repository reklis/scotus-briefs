  "oral_argument": {
    "claims": [
      {
        "attribution": "Justice Kagan",
        "citations": [
          {
            "document_hash": "8a29967361ad198168098af207e6d7045f634a911a4a48708c8cd91f6d31156d",
            "evidence_ids": [
              "ev-8a29967361ad-0001-0001"
            ],
            "pages": {
              "end": 26,
              "start": 26
            }
          }
        ],
        "text": "Justice Kagan asked what the statute would have to look like to mean what Washington says it means."
      },
      {
        "attribution": "Justice Barrett",
        "citations": [
          {
            "document_hash": "8a29967361ad198168098af207e6d7045f634a911a4a48708c8cd91f6d31156d",
            "evidence_ids": [
              "ev-8a29967361ad-0001-0005"
            ],
            "pages": {
              "end": 29,
              "start": 29
            }
          }
        ],
        "text": "Justice Barrett asked whether an otherwise existing generally applicable law can be applied to federal facilities under \u00a73172."
      },
      {
        "attribution": "Justice Thomas",
        "citations": [
          {
            "document_hash": "8a29967361ad198168098af207e6d7045f634a911a4a48708c8cd91f6d31156d",
            "evidence_ids": [
              "ev-8a29967361ad-0001-0003"
            ],
            "pages": {
              "end": 32,
              "start": 32
            }
          }
        ],
        "text": "Justice Thomas asked whether the case would be stronger if the Washington Supreme Court had decided it."
      },
      {
        "attribution": "Justice Breyer",
        "citations": [
          {
            "document_hash": "8a29967361ad198168098af207e6d7045f634a911a4a48708c8cd91f6d31156d",
            "evidence_ids": [
              "ev-8a29967361ad-0002-0000"
            ],
            "pages": {
              "end": 45,
              "start": 45
            }
          }
        ],
        "text": "Justice Breyer asked about the authority for the claim under Washington law."
      },
      {
        "attribution": "Justice Alito",
        "citations": [
          {
            "document_hash": "8a29967361ad198168098af207e6d7045f634a911a4a48708c8cd91f6d31156d",
            "evidence_ids": [
              "ev-8a29967361ad-0002-0001"
            ],
            "pages": {
              "end": 46,
              "start": 46
            }
          }
        ],
        "text": "Justice Alito asked whether the statute allows a state to single out a federal facility by name."
      },
      {
        "attribution": "Justice Barrett",
        "citations": [
          {
            "document_hash": "8a29967361ad198168098af207e6d7045f634a911a4a48708c8cd91f6d31156d",
            "evidence_ids": [
              "ev-8a29967361ad-0002-0002"
            ],
            "pages": {
              "end": 49,
              "start": 49
            }
          }
        ],
        "text": "Justice Barrett asked whether the state has exclusive jurisdiction except as Congress may allow."
      },
      {
        "attribution": "Mr. Stewart",
        "citations": [
          {
            "document_hash": "8a29967361ad198168098af207e6d7045f634a911a4a48708c8cd91f6d31156d",
            "evidence_ids": [
              "ev-8a29967361ad-0001-0000"
            ],
            "pages": {
              "end": 23,
              "start": 23
            }
          }
        ],
        "text": "According to Mr. Stewart, mr. Stewart noted that even when Congress clearly waives immunity, disputes about the scope of that waiver require a clear\u2011statement requirement."
      },
      {
        "attribution": "Justice Kagan",
        "citations": [
          {
            "document_hash": "8a29967361ad198168098af207e6d7045f634a911a4a48708c8cd91f6d31156d",
            "evidence_ids": [
              "ev-8a29967361ad-0003-0000"
            ],
            "pages": {
              "end": 65,
              "start": 65
            }
          }
        ],
        "text": "According to Justice Kagan, justice Kagan explained that \u00a73172(c) does not affect federal employees, only federal contract workers."
      },
      {
        "attribution": "Justice Breyer",
        "citations": [
          {
            "document_hash": "8a29967361ad198168098af207e6d7045f634a911a4a48708c8cd91f6d31156d",
            "evidence_ids": [
              "ev-8a29967361ad-0003-0001"
            ],
            "pages": {
              "end": 65,
              "start": 65
            }
          }
        ],
        "text": "According to Justice Breyer, justice Breyer clarified that the complaint is not that Washington is treating workers too generously."
      }
    ],
