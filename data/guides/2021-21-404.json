              "start": 5
            }
          }
        ],
        "text": "The Supreme Court held that Washington\u2019s workers\u2019 compensation law is unconstitutional because it discriminates against the Federal Government, violating the Supremacy Clause."
      },
      {
        "attribution": "United States",
        "citations": [
          {
            "document_hash": "11e8d038e8804c511df6f790afbbca61922aacab96865312e740ae0cc38bb290",
            "evidence_ids": [
              "ev-11e8d038e880-0000-0005"
            ],
            "pages": {
              "end": 7,
              "start": 7
            }
          }
        ],
        "text": "The decision could affect between $17\u202fmillion and $37\u202fmillion in workers\u2019 compensation claims that the United States seeks to recoup or avoid paying."
      }
    ],
    "heading": "Overview",
