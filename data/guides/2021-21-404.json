              "pages": {
                "end": 2,
                "start": 2
              }
            }
          ],
          "text": "According to United States, washington\u2019s law discriminates against the Federal Government and therefore violates the Supremacy Clause."
        }
      ],
      "heading": "United States (Petitioner)",
      "status": "complete",
      "summary": null,
      "summary_citations": []
    },
    {
      "claims": [
        {
          "attribution": "Washington",
          "citations": [
            {
              "document_hash": "11e8d038e8804c511df6f790afbbca61922aacab96865312e740ae0cc38bb290",
              "evidence_ids": [
                "ev-11e8d038e880-0000-0002"
              ],
              "pages": {
                "end": 4,
                "start": 4
              }
            }
          ],
          "text": "According to Washington, the waiver language in the statute only permits the extension of generally applicable workers\u2019 compensation laws to federal premises, not a discriminatory scheme."
        },
        {
          "attribution": "Washington",
          "citations": [
            {
              "document_hash": "11e8d038e8804c511df6f790afbbca61922aacab96865312e740ae0cc38bb290",
              "evidence_ids": [
                "ev-11e8d038e880-0001-0001"
              ],
              "pages": {
                "end": 12,
                "start": 12
              }
            }
          ],
          "text": "According to Washington, other congressional waivers of intergovernmental immunity explicitly maintain the prohibition against discriminatory state laws."
        }
      ],
