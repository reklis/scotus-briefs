  "case_id": "2021-21-404",
  "decision": {
    "claims": [
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "11e8d038e8804c511df6f790afbbca61922aacab96865312e740ae0cc38bb290",
            "evidence_ids": [
              "ev-11e8d038e880-0000-0004"
            ],
            "pages": {
              "end": 5,
              "start": 5
            }
          }
        ],
        "text": "The Court held that Washington\u2019s law is unconstitutional under the Supremacy Clause."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "11e8d038e8804c511df6f790afbbca61922aacab96865312e740ae0cc38bb290",
            "evidence_ids": [
              "ev-11e8d038e880-0001-0003"
            ],
            "pages": {
              "end": 12,
              "start": 12
            }
          }
        ],
        "text": "The Court found Washington\u2019s other arguments unconvincing."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "11e8d038e8804c511df6f790afbbca61922aacab96865312e740ae0cc38bb290",
            "evidence_ids": [
              "ev-11e8d038e880-0001-0002"
            ],
            "pages": {
              "end": 14,
              "start": 14
            }
          }
        ],
        "text": "The Court concluded that Washington\u2019s law facially discriminates against the Federal Government and its contractors, and because \u00a73172 does not clearly waive the Government\u2019s immunity, the law is unconstitutional under the Supremacy Clause."
      }
    ],
