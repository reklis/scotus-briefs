              "ev-20bcb13ee8d8-0000-0003"
            ],
            "pages": {
              "end": 3,
              "start": 3
            }
          }
        ],
        "text": "Congress defined a \u201cserious\u201d drug offense in the ACCA as one for which a State penalty of ten years or more is prescribed, intending Federal courts to look to the law presently in effect in that State."
      },
      {
        "attribution": "Justice Sotomayor",
        "citations": [
          {
            "document_hash": "20bcb13ee8d83269368ea9ab9f5d24cae285bf2b6ebb8bb3a40a780dbccefe1c",
            "evidence_ids": [
              "ev-20bcb13ee8d8-0001-0001"
            ],
            "pages": {
              "end": 22,
              "start": 22
            }
          }
        ],
        "text": "According to Justice Sotomayor, the Court is asked to decide whether a change in state law after the offense but before sentencing can affect the ACCA\u2019s \u201cserious\u201d drug offense determination."
      }
    ],
