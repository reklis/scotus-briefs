  "background_and_question": {
    "claims": [
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "04de0530b297067d10c9f63230646000a1600ff432d262c7da7ceb35cb14a89e",
            "evidence_ids": [
              "ev-04de0530b297-0000-0000"
            ],
            "pages": {
              "end": 2,
              "start": 2
            }
          }
        ],
        "text": "The question for decision is whether the Federal Arbitration Act, 9 U.S.C. \u00a7\u202f1 et seq., preempts a rule of California law that invalidates contractual waivers of the right to assert representative claims under California\u2019s Labor Code Private Attorneys General Act of 2004 (PAGA)."
      }
    ],
    "heading": "Background and Question",
    "status": "complete",
    "summary": null,
    "summary_citations": []
  },
  "case_id": "2021-20-1573",
  "decision": {
    "claims": [
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "04de0530b297067d10c9f63230646000a1600ff432d262c7da7ceb35cb14a89e",
            "evidence_ids": [
              "ev-04de0530b297-0002-0000"
            ],
            "pages": {
              "end": 25,
              "start": 25
            }
          }
        ],
        "text": "The Court held that the FAA preempts the rule of Iskanian insofar as it precludes division of PAGA actions into individual and non\u2011individual claims through an agreement to arbitrate."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "04de0530b297067d10c9f63230646000a1600ff432d262c7da7ceb35cb14a89e",
            "evidence_ids": [
              "ev-04de0530b297-0001-0003"
            ],
            "pages": {
              "end": 16,
              "start": 16
            }
          }
        ],
        "text": "The Court reiterated that the FAA does not require enforcement of waivers of substantive rights; its mandate is limited to enforcing arbitration agreements."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "04de0530b297067d10c9f63230646000a1600ff432d262c7da7ceb35cb14a89e",
            "evidence_ids": [
              "ev-04de0530b297-0001-0004"
            ],
            "pages": {
              "end": 18,
              "start": 18
            }
          }
        ],
        "text": "The Court found that PAGA actions do not involve the class\u2011arbitration problems of notice, due process, and adequate representation."
      },
      {
        "attribution": "Justice Thomas",
        "citations": [
          {
            "document_hash": "04de0530b297067d10c9f63230646000a1600ff432d262c7da7ceb35cb14a89e",
            "evidence_ids": [
              "ev-04de0530b297-0002-0004"
            ],
            "pages": {
              "end": 28,
              "start": 28
            }
          }
        ],
        "text": "Justice Thomas dissented, maintaining that the FAA does not apply to proceedings in state courts."
      }
    ],
