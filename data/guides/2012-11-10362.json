  "background_and_question": {
    "claims": [
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "89fe56b7fcc8aa56d5ba3f914638ed044ec6296aecc3302261620039df0ff237",
            "evidence_ids": [
              "ev-89fe56b7fcc8-0000-0000"
            ],
            "pages": {
              "end": 1,
              "start": 1
            }
          }
        ],
        "text": "The case was heard on oral argument before the Supreme Court at 10:25\u202fa.m."
      },
      {
        "attribution": "United States (government)",
        "citations": [
          {
            "document_hash": "89fe56b7fcc8aa56d5ba3f914638ed044ec6296aecc3302261620039df0ff237",
            "evidence_ids": [
              "ev-89fe56b7fcc8-0001-0000"
            ],
            "pages": {
              "end": 20,
              "start": 20
            }
          }
        ],
        "text": "According to United States (government), according to United States (government), according to United States (government), the Government argued that the Third Circuit\u2019s decision is binding only within that circuit."
      },
      {
        "attribution": "United States (government)",
        "citations": [
          {
            "document_hash": "89fe56b7fcc8aa56d5ba3f914638ed044ec6296aecc3302261620039df0ff237",
            "evidence_ids": [
              "ev-89fe56b7fcc8-0001-0002"
            ],
            "pages": {
              "end": 21,
              "start": 21
            }
          }
        ],
        "text": "According to United States (government), according to United States (government), according to United States (government), the Government argued that the position it took never reached the Solicitor General\u2019s office."
      },
      {
        "attribution": "United States (government)",
        "citations": [
          {
            "document_hash": "89fe56b7fcc8aa56d5ba3f914638ed044ec6296aecc3302261620039df0ff237",
            "evidence_ids": [
              "ev-89fe56b7fcc8-0001-0004"
            ],
            "pages": {
              "end": 23,
              "start": 23
            }
          }
        ],
        "text": "According to United States (government), according to United States (government), according to United States (government), the Government argued that certain torts approximate what Congress intended regarding liability of federal law\u2011enforcement officers."
      },
      {
        "attribution": "Government",
        "citations": [
          {
            "document_hash": "89fe56b7fcc8aa56d5ba3f914638ed044ec6296aecc3302261620039df0ff237",
            "evidence_ids": [
              "ev-89fe56b7fcc8-0002-0003"
            ],
            "pages": {
              "end": 40,
              "start": 40
            }
          }
        ],
        "text": "The Government argued that OSHA inspectors are not law\u2011enforcement officers because OSHA enforcement is not criminal law."
      },
      {
        "attribution": "Chief Justice Roberts",
        "citations": [
          {
            "document_hash": "89fe56b7fcc8aa56d5ba3f914638ed044ec6296aecc3302261620039df0ff237",
            "evidence_ids": [
              "ev-89fe56b7fcc8-0003-0003"
            ],
            "pages": {
              "end": 58,
              "start": 58
            }
          }
        ],
        "text": "Chief Justice Roberts appointed Mr. Bucholtz as amicus curiae to brief and argue the case."
      },
      {
        "attribution": "Mr. Paolella",
        "citations": [
          {
            "document_hash": "89fe56b7fcc8aa56d5ba3f914638ed044ec6296aecc3302261620039df0ff237",
            "evidence_ids": [
              "ev-89fe56b7fcc8-0003-0004"
            ],
            "pages": {
              "end": 58,
              "start": 58
            }
          }
        ],
        "text": "According to Mr. Paolella, mr. Paolella urged the Court to reverse the judgment below."
      },
      {
        "attribution": "Justice Scalia",
        "citations": [
          {
            "document_hash": "89fe56b7fcc8aa56d5ba3f914638ed044ec6296aecc3302261620039df0ff237",
            "evidence_ids": [
              "ev-89fe56b7fcc8-0001-0001"
            ],
            "pages": {
              "end": 20,
              "start": 20
            }
          }
        ],
        "text": "Justice Scalia asked how long ago the United States took the opposite position argued by amicus."
      },
      {
        "attribution": "Justice Kagan",
        "citations": [
          {
            "document_hash": "89fe56b7fcc8aa56d5ba3f914638ed044ec6296aecc3302261620039df0ff237",
            "evidence_ids": [
              "ev-89fe56b7fcc8-0001-0008"
            ],
            "pages": {
              "end": 31,
              "start": 31
            }
          }
        ],
        "text": "Justice Kagan asked what the difference is between the two things referenced by the petitioner."
      },
      {
        "attribution": "Justice Scalia",
        "citations": [
          {
            "document_hash": "89fe56b7fcc8aa56d5ba3f914638ed044ec6296aecc3302261620039df0ff237",
            "evidence_ids": [
              "ev-89fe56b7fcc8-0002-0000"
            ],
            "pages": {
              "end": 38,
              "start": 38
            }
          }
        ],
        "text": "Justice Scalia asked whether an EPA officer who writes a compliance letter is a law\u2011enforcement officer."
      },
      {
        "attribution": "Justice Kennedy",
        "citations": [
          {
            "document_hash": "89fe56b7fcc8aa56d5ba3f914638ed044ec6296aecc3302261620039df0ff237",
            "evidence_ids": [
              "ev-89fe56b7fcc8-0002-0004"
            ],
            "pages": {
              "end": 41,
              "start": 41
            }
          }
        ],
        "text": "Justice Kennedy asked how the Government\u2019s argument helps the petitioner\u2019s case."
      },
      {
        "attribution": "Justice Sotomayor",
        "citations": [
          {
            "document_hash": "89fe56b7fcc8aa56d5ba3f914638ed044ec6296aecc3302261620039df0ff237",
            "evidence_ids": [
              "ev-89fe56b7fcc8-0002-0007"
            ],
            "pages": {
              "end": 44,
              "start": 44
            }
          }
        ],
        "text": "Justice Sotomayor asked how broadly or narrowly the Court should define law\u2011enforcement activities."
      }
    ],
