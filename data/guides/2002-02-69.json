  "background_and_question": {
    "claims": [
      {
        "attribution": "Petitioners",
        "citations": [
          {
            "document_hash": "68c1690f074181cc8644817f744cd23cd5564496b905f23e8d16205d2efeb51d",
            "evidence_ids": [
              "ev-68c1690f0741-0000-0001"
            ],
            "pages": {
              "end": 3,
              "start": 3
            }
          }
        ],
        "text": "The petitioners argue that when parties knowingly and voluntarily proceed to trial before a magistrate judge, they consent within the meaning of 28\u202fU.S.C.\u202f\u00a7\u202f636(c)(1)."
      },
      {
        "attribution": "Petitioners",
        "citations": [
          {
            "document_hash": "68c1690f074181cc8644817f744cd23cd5564496b905f23e8d16205d2efeb51d",
            "evidence_ids": [
              "ev-68c1690f0741-0002-0003"
            ],
            "pages": {
              "end": 51,
              "start": 50
            }
          }
        ],
        "text": "The petitioners maintain that consent must be expressly communicated to the clerk and be clear, a view supported by eight courts of appeals."
      },
      {
        "attribution": "Ms. Frost",
        "citations": [
          {
            "document_hash": "68c1690f074181cc8644817f744cd23cd5564496b905f23e8d16205d2efeb51d",
            "evidence_ids": [
              "ev-68c1690f0741-0001-0002"
            ],
            "pages": {
              "end": 27,
              "start": 27
            }
          }
        ],
        "text": "Ms. Frost contends that all parties must expressly consent before a magistrate may exercise jurisdiction under \u00a7\u202f636(c) and Rule\u202f73(b), because the statutes require express consent."
      },
      {
        "attribution": "Justice Stevens",
        "citations": [
          {
            "document_hash": "68c1690f074181cc8644817f744cd23cd5564496b905f23e8d16205d2efeb51d",
            "evidence_ids": [
              "ev-68c1690f0741-0000-0000"
            ],
            "pages": {
              "end": 3,
              "start": 3
            }
          }
        ],
        "text": "Justice Stevens asked whether Rule\u202f73(b) applies."
      },
      {
        "attribution": "Justice Kennedy",
        "citations": [
          {
            "document_hash": "68c1690f074181cc8644817f744cd23cd5564496b905f23e8d16205d2efeb51d",
            "evidence_ids": [
              "ev-68c1690f0741-0000-0003"
            ],
            "pages": {
              "end": 4,
              "start": 4
            }
          }
        ],
        "text": "Justice Kennedy asked whether consent must precede the magistrate\u2019s action."
      },
      {
        "attribution": "Justice Ginsburg",
        "citations": [
          {
            "document_hash": "68c1690f074181cc8644817f744cd23cd5564496b905f23e8d16205d2efeb51d",
            "evidence_ids": [
              "ev-68c1690f0741-0001-0005"
            ],
            "pages": {
              "end": 31,
              "start": 31
            }
          }
        ],
        "text": "According to Justice Ginsburg, justice Ginsburg questioned why a general appearance in magistrate court is not equivalent to consent."
      }
    ],
