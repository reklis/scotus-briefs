              "end": 21,
              "start": 21
            }
          }
        ],
        "text": "According to Justice Sotomayor, justice Sotomayor questioned whether every rejected employee will be told the reason for rejection."
      },
      {
        "attribution": "Justice Kennedy",
        "citations": [
          {
            "document_hash": "969b9f7f92feb3e68b234be0d899605cbae19588f26eac707e64daa047115472",
