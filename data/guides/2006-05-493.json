              "start": 21
            }
          },
          {
            "document_hash": "359c1a228a56a793fcb9adac51b014dfecbc660d2c9b9f37e20fa1cde17d08f1",
            "evidence_ids": [
              "ev-359c1a228a56-0001-0002"
            ],
            "pages": {
              "end": 22,
              "start": 22
            }
          }
        ],
        "text": "Justice Ginsburg inquired about the source of factor (k), asking whether it derives from a model code and how many other states have similar instructions."
      },
      {
        "attribution": "Justice Ginsburg",
        "citations": [
          {
            "document_hash": "359c1a228a56a793fcb9adac51b014dfecbc660d2c9b9f37e20fa1cde17d08f1",
            "evidence_ids": [
              "ev-359c1a228a56-0002-0000"
            ],
            "pages": {
              "end": 40,
              "start": 40
            }
          }
        ],
        "text": "Justice Ginsburg asked for clarification of the petitioner\u2019s brief, noting that the challenge to factor (k) was limited to the exclusion of Skipper evidence in that particular case."
      }
    ],
