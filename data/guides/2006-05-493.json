              "start": 4
            }
          }
        ],
        "text": "Justice Stevens asked whether facts that occurred before the crime differ from facts that might have occurred after the crime."
      },
      {
        "attribution": "Justice KENNEDY",
        "citations": [
          {
            "document_hash": "359c1a228a56a793fcb9adac51b014dfecbc660d2c9b9f37e20fa1cde17d08f1",
            "evidence_ids": [
              "ev-359c1a228a56-0000-0002"
            ],
            "pages": {
              "end": 6,
              "start": 6
            }
          }
        ],
        "text": "Justice Kennedy asked how post\u2011crime prison conduct reduces the seriousness of a previous crime."
      },
      {
        "attribution": "Justice Ginsburg",
        "citations": [
          {
            "document_hash": "359c1a228a56a793fcb9adac51b014dfecbc660d2c9b9f37e20fa1cde17d08f1",
            "evidence_ids": [
              "ev-359c1a228a56-0001-0001"
