  "overview": {
    "claims": [
      {
        "attribution": "Petitioner",
        "citations": [
          {
            "document_hash": "359c1a228a56a793fcb9adac51b014dfecbc660d2c9b9f37e20fa1cde17d08f1",
            "evidence_ids": [
              "ev-359c1a228a56-0000-0000"
            ],
            "pages": {
              "end": 3,
              "start": 3
            }
          }
        ],
        "text": "According to Petitioner, the case concerns the constitutional sufficiency of California's catchall factor (k) instruction used in the penalty phase of capital cases."
      },
      {
        "attribution": "Petitioner",
        "citations": [
          {
            "document_hash": "359c1a228a56a793fcb9adac51b014dfecbc660d2c9b9f37e20fa1cde17d08f1",
            "evidence_ids": [
              "ev-359c1a228a56-0000-0006"
            ],
            "pages": {
              "end": 16,
              "start": 16
            }
          }
        ],
        "text": "According to Petitioner, the factor (k) instruction recites California Penal Code \u00a7190.3."
      },
      {
        "attribution": "Petitioner",
        "citations": [
          {
            "document_hash": "359c1a228a56a793fcb9adac51b014dfecbc660d2c9b9f37e20fa1cde17d08f1",
            "evidence_ids": [
              "ev-359c1a228a56-0000-0003"
            ],
            "pages": {
              "end": 7,
              "start": 7
            }
          }
        ],
        "text": "According to Petitioner, in California, jurors are told that during the penalty phase their sole concern is to choose between death and life without parole."
      },
      {
        "attribution": "Petitioner",
        "citations": [
          {
            "document_hash": "359c1a228a56a793fcb9adac51b014dfecbc660d2c9b9f37e20fa1cde17d08f1",
            "evidence_ids": [
              "ev-359c1a228a56-0000-0005"
            ],
            "pages": {
              "end": 10,
              "start": 10
            }
          }
        ],
        "text": "The petitioner argues that the factor (k) instruction would foreclose consideration of present good\u2011character evidence, including evidence from Boyde and Payton."
      }
    ],
    "heading": "Overview",
    "status": "complete",
    "summary": null,
    "summary_citations": []
  },
  "party_positions": [
    {
      "claims": [
        {
          "attribution": "Petitioner",
          "citations": [
            {
              "document_hash": "359c1a228a56a793fcb9adac51b014dfecbc660d2c9b9f37e20fa1cde17d08f1",
              "evidence_ids": [
                "ev-359c1a228a56-0000-0006"
              ],
              "pages": {
                "end": 16,
                "start": 16
              }
            }
          ],
          "text": "The petitioner contends that the factor (k) instruction is constitutionally sufficient because it follows the statutory language of Penal Code \u00a7190.3."
        },
        {
          "attribution": "Petitioner",
          "citations": [
            {
              "document_hash": "359c1a228a56a793fcb9adac51b014dfecbc660d2c9b9f37e20fa1cde17d08f1",
              "evidence_ids": [
                "ev-359c1a228a56-0000-0005"
              ],
              "pages": {
                "end": 10,
                "start": 10
              }
            }
          ],
          "text": "According to Petitioner, the petitioner asserts that the instruction would prevent the jury from considering any present good\u2011character evidence, such as evidence from Boyde and Payton."
        },
        {
          "attribution": "Petitioner",
          "citations": [
            {
              "document_hash": "359c1a228a56a793fcb9adac51b014dfecbc660d2c9b9f37e20fa1cde17d08f1",
              "evidence_ids": [
                "ev-359c1a228a56-0000-0003"
              ],
              "pages": {
                "end": 7,
                "start": 7
              }
            }
          ],
          "text": "According to Petitioner, the petitioner emphasizes that jurors are instructed that their only decision in the penalty phase is between death and life without parole."
        }
      ],
      "heading": "Petitioner (ROBERT L. AYERS, JR. ACTING WARDEN)",
