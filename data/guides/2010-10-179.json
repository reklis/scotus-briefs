  "party_positions": [
    {
      "claims": [
        {
          "attribution": "Kent L. Richland",
          "citations": [
            {
              "document_hash": "86820512e1805b01b9a7a35b370b5a611b0ba10f75aa61f9e52feedf714d6289",
              "evidence_ids": [
                "ev-86820512e180-0000-0004"
              ],
              "pages": {
                "end": 3,
                "start": 3
              }
            }
          ],
          "text": "According to Kent L. Richland, the bankruptcy court is constitutionally authorized to decide the entire dispute."
        },
        {
          "attribution": "Respondent",
          "citations": [
            {
              "document_hash": "86820512e1805b01b9a7a35b370b5a611b0ba10f75aa61f9e52feedf714d6289",
              "evidence_ids": [
                "ev-86820512e180-0001-0001"
              ],
              "pages": {
                "end": 22,
                "start": 22
              }
            }
          ],
          "text": "According to Respondent, the respondent has not cited any contrary authority from this Court."
        },
        {
          "attribution": "Mr. Englert",
          "citations": [
            {
              "document_hash": "86820512e1805b01b9a7a35b370b5a611b0ba10f75aa61f9e52feedf714d6289",
              "evidence_ids": [
                "ev-86820512e180-0002-0001"
              ],
              "pages": {
                "end": 38,
                "start": 38
              }
            }
          ],
          "text": "According to Mr. Englert, marathon (the respondent) rejects many of the premises of the Court\u2019s questions, starting with the premise that the bankruptcy court lacks jurisdiction."
        }
      ],
      "heading": "Petitioner (Howard K. Stern, Executor of the Estate of Vickie Lynn Marshall)",
      "status": "complete",
      "summary": null,
      "summary_citations": []
    },
    {
      "claims": [
        {
          "attribution": "Respondent",
          "citations": [
