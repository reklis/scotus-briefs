  },
  "case_id": "scotus-23-365",
  "decision": {
    "claims": [
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "f0ea5f7f316e00ac2150526cfc81dc97a3faeb3a5ef26b387754313ff90077c3",
            "evidence_ids": [
              "ev-f0ea5f7f316e-0001-0001"
            ],
            "pages": {
              "end": 13,
              "start": 13
            }
          }
        ],
        "text": "The majority held that \u201cdamage\u201d has a specialized legal meaning referring to monetary redress and that the statute permits a plaintiff to recover triple the amount of damages to make him whole."
      },
      {
        "attribution": "Justice Thomas",
        "citations": [
          {
            "document_hash": "f0ea5f7f316e00ac2150526cfc81dc97a3faeb3a5ef26b387754313ff90077c3",
            "evidence_ids": [
              "ev-f0ea5f7f316e-0002-0000"
            ],
            "pages": {
              "end": 23,
              "start": 23
            }
          }
        ],
        "text": "Justice Thomas (dissent): The phrase \u201cinjured in his business or property\u201d does not preclude recovery for all economic harms and the Second Circuit\u2019s judgment should be affirmed and the case remanded."
      },
      {
        "attribution": "Justice Thomas",
        "citations": [
          {
            "document_hash": "f0ea5f7f316e00ac2150526cfc81dc97a3faeb3a5ef26b387754313ff90077c3",
            "evidence_ids": [
              "ev-f0ea5f7f316e-0003-0000"
            ],
            "pages": {
              "end": 32,
              "start": 32
            }
          }
        ],
        "text": "Justice Thomas (dissent): The majority misunderstands Medical Marijuana\u2019s position."
      },
      {
        "attribution": "Justice Kavanaugh",
        "citations": [
          {
            "document_hash": "f0ea5f7f316e00ac2150526cfc81dc97a3faeb3a5ef26b387754313ff90077c3",
            "evidence_ids": [
              "ev-f0ea5f7f316e-0004-0000"
            ],
            "pages": {
              "end": 43,
              "start": 43
            }
          }
        ],
        "text": "Justice Kavanaugh (dissent): Antitrust laws exclude damages to business or property from personal injuries from being treated as distinct business injuries in antitrust suits."
      },
      {
        "attribution": "Justice Kavanaugh",
        "citations": [
          {
            "document_hash": "f0ea5f7f316e00ac2150526cfc81dc97a3faeb3a5ef26b387754313ff90077c3",
            "evidence_ids": [
              "ev-f0ea5f7f316e-0005-0000"
            ],
            "pages": {
              "end": 58,
              "start": 58
            }
          }
        ],
        "text": "Justice Kavanaugh (dissent): RICO does not authorize personal\u2011injury suits at all."
      }
    ],
