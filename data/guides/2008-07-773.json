  "overview": {
    "claims": [
      {
        "attribution": "Petitioner",
        "citations": [
          {
            "document_hash": "2f8d9b98a34ac9ce48783cd2941e7b1e2bacfeb69be8055c0292a263b0c512fa",
            "evidence_ids": [
              "ev-2f8d9b98a34a-0000-0000"
            ],
            "pages": {
              "end": 3,
              "start": 3
            }
          }
        ],
        "text": "According to Petitioner, the case raises the question whether section\u202f4 of the Federal Arbitration Act implicitly repeals section\u202f1331\u2019s \u201cwell\u2011pleaded complaint\u201d requirement, which would affect federal subject\u2011matter jurisdiction."
      },
      {
        "attribution": "Petitioner",
        "citations": [
          {
            "document_hash": "2f8d9b98a34ac9ce48783cd2941e7b1e2bacfeb69be8055c0292a263b0c512fa",
            "evidence_ids": [
              "ev-2f8d9b98a34a-0000-0005"
            ],
            "pages": {
              "end": 15,
              "start": 15
            }
          }
        ],
        "text": "According to Petitioner, the dispute also concerns whether any \u201clook\u2011through\u201d jurisdiction must be grounded in section\u202f1332 rather than arising from section\u202f4."
      }
    ],
    "heading": "Overview",
    "status": "complete",
    "summary": null,
    "summary_citations": []
  },
  "party_positions": [
    {
      "claims": [
        {
          "attribution": "Petitioner",
          "citations": [
            {
              "document_hash": "2f8d9b98a34ac9ce48783cd2941e7b1e2bacfeb69be8055c0292a263b0c512fa",
              "evidence_ids": [
                "ev-2f8d9b98a34a-0000-0001"
              ],
              "pages": {
                "end": 4,
                "start": 4
              }
            }
          ],
          "text": "According to Petitioner, the ordinary meaning of section\u202f4, the structure of the FAA, and its purposes support the petitioner\u2019s view of subject\u2011matter jurisdiction."
        },
        {
          "attribution": "Petitioner",
          "citations": [
            {
              "document_hash": "2f8d9b98a34ac9ce48783cd2941e7b1e2bacfeb69be8055c0292a263b0c512fa",
              "evidence_ids": [
                "ev-2f8d9b98a34a-0000-0005"
              ],
              "pages": {
                "end": 15,
                "start": 15
              }
            }
          ],
          "text": "According to Petitioner, section\u202f4 has no independent look\u2011through force; any look\u2011through must be grounded in section\u202f1332."
        }
      ],
      "heading": "Petitioner",
      "status": "complete",
      "summary": null,
