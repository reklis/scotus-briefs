              "start": 6
            }
          }
        ],
        "text": "According to Justice Scalia, justice Scalia stated that there is no agreement for transfer of title and explained that a consignment involves giving the property to someone who will sell it."
      },
      {
        "attribution": "Justice Scalia",
        "citations": [
          {
            "document_hash": "57f0f655739db3c5aec3f82a8580018a81d115e138f3d1327d49a85c2e21de62",
            "evidence_ids": [
