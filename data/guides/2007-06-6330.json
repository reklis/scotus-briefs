  "overview": {
    "claims": [
      {
        "attribution": "Respondent",
        "citations": [
          {
            "document_hash": "c25a732096714a4fc0fc7db2225f67e7426ab35201261b3d1d971f711b6da5ed",
            "evidence_ids": [
              "ev-c25a73209671-0001-0003"
            ],
            "pages": {
              "end": 23,
              "start": 23
            }
          }
        ],
        "text": "According to Respondent, the dispute centers on whether a district court can deviate from Congress\u2019s sentencing ratio for crack versus powder cocaine."
      },
      {
        "attribution": "Government",
        "citations": [
          {
            "document_hash": "c25a732096714a4fc0fc7db2225f67e7426ab35201261b3d1d971f711b6da5ed",
            "evidence_ids": [
              "ev-c25a73209671-0001-0001"
            ],
            "pages": {
              "end": 20,
              "start": 20
            }
          }
        ],
        "text": "The Government argues that judges must follow the individualized sentencing requirements of 18\u202fU.S.C.\u202f\u00a7\u202f3553(a) in every case."
      }
    ],
    "heading": "Overview",
    "status": "complete",
    "summary": null,
    "summary_citations": []
