              "ev-06ad0b9857e6-0000-0001"
            ],
            "pages": {
              "end": 6,
              "start": 5
            }
          }
        ],
        "text": "The Court held that a favorable termination of a criminal prosecution for Fourth Amendment malicious\u2011prosecution claims is satisfied when the prosecution ends without a conviction."
      },
      {
        "attribution": "Justice Alito",
        "citations": [
          {
            "document_hash": "06ad0b9857e61cdf4ee8806dd0ab8a8158241a9005e23fbed5f12724b9832e9a",
            "evidence_ids": [
              "ev-06ad0b9857e6-0002-0000"
            ],
            "pages": {
              "end": 23,
              "start": 23
            }
          },
          {
            "document_hash": "06ad0b9857e61cdf4ee8806dd0ab8a8158241a9005e23fbed5f12724b9832e9a",
            "evidence_ids": [
              "ev-06ad0b9857e6-0002-0001"
            ],
            "pages": {
              "end": 24,
              "start": 24
            }
          }
        ],
        "text": "Justice Alito dissented, arguing that the plurality did not suggest that the Fourth Amendment could provide a \u201cpeg\u201d for a malicious\u2011prosecution claim and that the claim is incompatible with established Fourth Amendment jurisprudence."
      }
    ],
