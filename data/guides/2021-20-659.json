              "start": 32
            }
          }
        ],
        "text": "Justice Sotomayor asked whether the plaintiff\u2019s claim was a \u201cManuel\u2011type fabrication of evidence.\u201d"
      },
      {
        "attribution": "Justice Gorsuch",
        "citations": [
          {
            "document_hash": "90d2b7f7a5a2f73a04dda83f9629557d7f9d668e53f4766db47e396b7cf83df7",
            "evidence_ids": [
