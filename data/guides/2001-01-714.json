            }
          },
          {
            "document_hash": "3e34a1134a68630cd60843abd91cdc687d7325c4b75f203b65186dc91b5d8c65",
            "evidence_ids": [
              "ev-3e34a1134a68-0002-0000"
            ],
            "pages": {
              "end": 38,
              "start": 38
            }
          }
        ],
        "text": "The case asks whether the Census Bureau\u2019s imputation method violates the Constitution and whether Utah has standing to sue."
      }
    ],
