              "start": 27
            }
          }
        ],
        "text": "Chief Justice Roberts asked the Government about the broader question raised by Justice Stevens."
      },
      {
        "attribution": "Justice STEVENS",
        "citations": [
          {
            "document_hash": "a3641987d8fd0d06335e722ab03fbfae3d2449c626a3ff8c33d0a9321dfc8f12",
