  "party_positions": [
    {
      "claims": [
        {
          "attribution": "Petitioners",
          "citations": [
            {
              "document_hash": "ade17efb97f08f985a290cbdf74a8def3e3af0c314375330f664e90e79f7d002",
              "evidence_ids": [
                "ev-ade17efb97f0-0000-0002"
              ],
              "pages": {
                "end": 20,
                "start": 19
              }
            }
          ],
          "text": "Petitioners argue that cost\u2011benefit analysis is a longstanding requirement for regulations and should be considered in the EPA\u2019s rulemaking."
        },
        {
          "attribution": "Lazarus; Mr. LAZARUS",
          "citations": [
            {
              "document_hash": "ade17efb97f08f985a290cbdf74a8def3e3af0c314375330f664e90e79f7d002",
              "evidence_ids": [
                "ev-ade17efb97f0-0002-0000"
              ],
              "pages": {
                "end": 41,
                "start": 40
              }
            },
            {
              "document_hash": "ade17efb97f08f985a290cbdf74a8def3e3af0c314375330f664e90e79f7d002",
              "evidence_ids": [
                "ev-ade17efb97f0-0001-0005"
              ],
              "pages": {
                "end": 29,
                "start": 29
              }
            }
          ],
          "text": "Petitioners (Mr. Lazarus) contend that Section\u202f316(b) does not authorize the EPA to weigh costs against benefits; Congress excluded cost\u2011benefit analysis and focused on technology availability."
        },
        {
          "attribution": "Mr. LAZARUS",
          "citations": [
            {
              "document_hash": "ade17efb97f08f985a290cbdf74a8def3e3af0c314375330f664e90e79f7d002",
              "evidence_ids": [
                "ev-ade17efb97f0-0001-0008"
              ],
              "pages": {
                "end": 32,
                "start": 32
              }
            }
          ],
          "text": "According to Mr. LAZARUS, petitioners assert that \u201cavailability includes economic availability.\u201d"
        },
        {
          "attribution": "Mr. LAZARUS",
          "citations": [
            {
              "document_hash": "ade17efb97f08f985a290cbdf74a8def3e3af0c314375330f664e90e79f7d002",
              "evidence_ids": [
                "ev-ade17efb97f0-0001-0009"
              ],
              "pages": {
                "end": 38,
                "start": 38
              }
            }
          ],
          "text": "According to Mr. LAZARUS, petitioners claim that the \u201cbest available\u201d standard does not involve a cost\u2011benefit analysis, only a \u201cbest practical\u201d approach."
        }
      ],
