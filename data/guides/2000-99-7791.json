              "ev-d256a2c260cf-0004-0003"
            ],
            "pages": {
              "end": 73,
              "start": 72
            }
          }
        ],
        "text": "The detention is subject to periodic, automatic review each year, and the alien may request a review in intervening periods."
      },
      {
        "attribution": "Petitioner and Respondent",
        "citations": [
          {
            "document_hash": "d256a2c260cf84b2c51f36a254425581d4a77e936d8b885dbc2cb815940262b4",
