  "overview": {
    "claims": [
      {
        "attribution": "Kentucky",
        "citations": [
          {
            "document_hash": "e864eca0a453a831959d2f72710e99833e27d1b0c2f47543510b1a5fb7615fd4",
            "evidence_ids": [
              "ev-e864eca0a453-0000-0000"
            ],
            "pages": {
              "end": 3,
              "start": 3
            }
          }
        ],
        "text": "According to Kentucky, the case concerns whether police may create exigent circumstances to justify warrantless entry and the suppression of evidence seized after such entry."
      },
      {
        "attribution": "Kentucky",
        "citations": [
          {
            "document_hash": "e864eca0a453a831959d2f72710e99833e27d1b0c2f47543510b1a5fb7615fd4",
            "evidence_ids": [
              "ev-e864eca0a453-0000-0000"
            ],
            "pages": {
              "end": 3,
              "start": 3
            }
          }
        ],
        "text": "Kentucky argues that the subjective intent of police officers is irrelevant to the Fourth Amendment analysis."
      },
      {
        "attribution": "Respondent",
        "citations": [
          {
            "document_hash": "e864eca0a453a831959d2f72710e99833e27d1b0c2f47543510b1a5fb7615fd4",
            "evidence_ids": [
              "ev-e864eca0a453-0001-0000"
            ],
            "pages": {
              "end": 21,
              "start": 21
            }
          }
        ],
        "text": "The respondent argues that there is insufficient evidence of exigency."
      },
      {
        "attribution": "Respondent",
        "citations": [
          {
            "document_hash": "e864eca0a453a831959d2f72710e99833e27d1b0c2f47543510b1a5fb7615fd4",
            "evidence_ids": [
              "ev-e864eca0a453-0001-0002"
            ],
            "pages": {
              "end": 23,
              "start": 23
            }
          }
        ],
        "text": "The respondent argues that police may rely on any ensuing exigency."
      },
      {
        "attribution": "Farley",
        "citations": [
          {
            "document_hash": "e864eca0a453a831959d2f72710e99833e27d1b0c2f47543510b1a5fb7615fd4",
            "evidence_ids": [
              "ev-e864eca0a453-0000-0005"
            ],
            "pages": {
              "end": 9,
              "start": 9
            }
          }
        ],
        "text": "The smell of marijuana can give probable cause to obtain a search warrant."
      }
    ],
