  "party_positions": [
    {
      "claims": [
        {
          "attribution": "Kentucky",
          "citations": [
            {
              "document_hash": "e864eca0a453a831959d2f72710e99833e27d1b0c2f47543510b1a5fb7615fd4",
              "evidence_ids": [
                "ev-e864eca0a453-0000-0000"
              ],
              "pages": {
                "end": 3,
                "start": 3
              }
            }
          ],
          "text": "According to Kentucky, the subjective intent of police officers is irrelevant to the Fourth Amendment analysis."
        },
        {
          "attribution": "Commonwealth",
          "citations": [
            {
              "document_hash": "e864eca0a453a831959d2f72710e99833e27d1b0c2f47543510b1a5fb7615fd4",
              "evidence_ids": [
                "ev-e864eca0a453-0002-0000"
              ],
              "pages": {
                "end": 39,
                "start": 39
              }
            }
          ],
          "text": "According to Commonwealth, reasonable police behavior is not made unreasonable by the possibility that evidence may be destroyed; therefore suppression is not the proper remedy."
        },
        {
          "attribution": "Commonwealth",
          "citations": [
            {
              "document_hash": "e864eca0a453a831959d2f72710e99833e27d1b0c2f47543510b1a5fb7615fd4",
              "evidence_ids": [
                "ev-e864eca0a453-0002-0001"
              ],
              "pages": {
                "end": 40,
                "start": 40
              }
            }
          ],
          "text": "According to Commonwealth, police act unreasonably when they convey to a reasonable person that entry is imminent and inevitable."
        },
        {
          "attribution": "Commonwealth",
          "citations": [
            {
              "document_hash": "e864eca0a453a831959d2f72710e99833e27d1b0c2f47543510b1a5fb7615fd4",
              "evidence_ids": [
                "ev-e864eca0a453-0002-0002"
              ],
              "pages": {
                "end": 41,
                "start": 41
              }
            }
          ],
          "text": "According to Commonwealth, \"Lawful\" is defined as a synonym for \"unreasonable,\" and no prior Fourth Amendment violation is required."
        }
      ],
      "heading": "Kentucky (Petitioner)",
      "status": "complete",
      "summary": null,
      "summary_citations": []
    },
    {
      "claims": [
        {
          "attribution": "Respondent",
          "citations": [
            {
              "document_hash": "e864eca0a453a831959d2f72710e99833e27d1b0c2f47543510b1a5fb7615fd4",
              "evidence_ids": [
                "ev-e864eca0a453-0001-0000"
              ],
              "pages": {
                "end": 21,
                "start": 21
              }
            }
          ],
          "text": "According to Respondent, there is insufficient evidence of exigency to justify suppression of the seized evidence."
        },
        {
          "attribution": "Respondent",
          "citations": [
            {
              "document_hash": "e864eca0a453a831959d2f72710e99833e27d1b0c2f47543510b1a5fb7615fd4",
              "evidence_ids": [
                "ev-e864eca0a453-0001-0002"
              ],
              "pages": {
                "end": 23,
                "start": 23
              }
            }
          ],
          "text": "According to Respondent, under the Court's interpretation of Fourth Amendment warrant exceptions, police may rely on any ensuing exigency."
        }
      ],
      "heading": "Hollis Deshaun King (Respondent)",
