              "ev-a9cac9ed2521-0001-0000"
            ],
            "pages": {
              "end": 15,
              "start": 15
            }
          }
        ],
        "text": "The decision clarifies that the statutory provision governing the effective date of disability compensation does not allow veterans to rely on equitable tolling to overcome missed filing deadlines."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "5f4a9108d72de0004c92014799b2f4462994644b4ee0024d91618ba69951a88f",
            "evidence_ids": [
              "ev-5f4a9108d72d-0001-0000"
            ],
            "pages": {
              "end": 23,
              "start": 23
            }
          }
        ],
        "text": "Because most civil\u2011litigation deadlines are generally tollable, this ruling signals that the specific language of \u00a75110(b)(1) overrides the general presumption in this context."
      }
    ],
