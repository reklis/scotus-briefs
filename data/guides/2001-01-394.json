            "evidence_ids": [
              "ev-3adc3796d5fb-0003-0004"
            ],
            "pages": {
              "end": 52,
              "start": 52
            }
          }
        ],
        "text": "The case was formally submitted to the Court at 11:59\u202fa.m."
      }
