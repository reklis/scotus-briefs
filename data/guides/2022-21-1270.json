  "oral_argument": {
    "claims": [
      {
        "attribution": "Justice Thomas",
        "citations": [
          {
            "document_hash": "808b7a2483191fac3e3f79e0be5b48fff808def10cdfc55a6781b101b100d24b",
            "evidence_ids": [
