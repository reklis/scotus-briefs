              "ev-29b956d5b985-0000-0004"
            ],
            "pages": {
              "end": 6,
              "start": 5
            }
          }
        ],
        "text": "The District Court dismissed the complaint with prejudice and denied leave to amend."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "29b956d5b985309b9b690ecb191c032b3d8c7afb2387c12c3a6a7acbe69652f7",
            "evidence_ids": [
              "ev-29b956d5b985-0000-0008"
            ],
            "pages": {
              "end": 8,
              "start": 8
            }
          }
        ],
        "text": "The Supreme Court granted certiorari to review the case."
      }
    ],
    "heading": "Background and Procedural History",
    "status": "complete",
    "summary": null,
