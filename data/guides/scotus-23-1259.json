  },
  "case_id": "scotus-23-1259",
  "decision": {
    "claims": [
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "29b956d5b985309b9b690ecb191c032b3d8c7afb2387c12c3a6a7acbe69652f7",
            "evidence_ids": [
              "ev-29b956d5b985-0000-0007"
            ],
            "pages": {
              "end": 4,
              "start": 4
            }
          }
        ],
        "text": "The Court reversed and remanded the judgment of the Second Circuit."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "29b956d5b985309b9b690ecb191c032b3d8c7afb2387c12c3a6a7acbe69652f7",
            "evidence_ids": [
              "ev-29b956d5b985-0000-0006"
            ],
            "pages": {
              "end": 9,
              "start": 8
            }
          }
        ],
        "text": "Relief under Rule\u202f60(b)(6) requires extraordinary circumstances, and that standard does not become less demanding when the movant also hopes to amend his complaint."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "29b956d5b985309b9b690ecb191c032b3d8c7afb2387c12c3a6a7acbe69652f7",
            "evidence_ids": [
              "ev-29b956d5b985-0001-0000"
            ],
            "pages": {
              "end": 12,
              "start": 12
            }
          }
        ],
        "text": "Only the Rule\u202f60(b) standard\u2014not a hybrid standard that blends Rule\u202f60(b) and Rule\u202f15(a)\u2014applies when a party seeks relief from a final judgment."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "29b956d5b985309b9b690ecb191c032b3d8c7afb2387c12c3a6a7acbe69652f7",
            "evidence_ids": [
              "ev-29b956d5b985-0001-0001"
            ],
            "pages": {
              "end": 12,
              "start": 12
            }
          }
        ],
        "text": "The District Court was correct to treat the plaintiffs\u2019 motion to vacate and amend as two distinct analyses, with the vacatur question under Rule\u202f60(b)(6) preceding the repleading question under Rule\u202f15(a)."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "29b956d5b985309b9b690ecb191c032b3d8c7afb2387c12c3a6a7acbe69652f7",
            "evidence_ids": [
              "ev-29b956d5b985-0001-0002"
            ],
            "pages": {
              "end": 13,
              "start": 13
            }
          }
        ],
        "text": "Balancing the strict standards of Rule\u202f60(b)(6) against the more relaxed standards of Rule\u202f15 necessarily weakens the former and is incompatible with precedent that Rule\u202f60(b)(6) should only be applied in extraordinary circumstances."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "29b956d5b985309b9b690ecb191c032b3d8c7afb2387c12c3a6a7acbe69652f7",
            "evidence_ids": [
              "ev-29b956d5b985-0001-0003"
            ],
            "pages": {
              "end": 15,
              "start": 15
            }
          }
        ],
        "text": "The judgment of the Second Circuit is reversed, and the case is remanded for further proceedings consistent with this opinion."
      }
    ],
