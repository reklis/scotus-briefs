              "start": 10
            }
          }
        ],
        "text": "Chief Justice Roberts asked for a clear answer on whether the statute covers the facts presented."
      },
      {
        "attribution": "Justice Sotomayor",
        "citations": [
          {
            "document_hash": "dd6c3d8c307d304d7a04ee78c68af1c21a48a0a3e9724f757c9fd311bc316cdd",
