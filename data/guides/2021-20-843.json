            }
          },
          {
            "document_hash": "050f4a002f60f97729bd9a1da879cf1dc0c08955859b56aac8966c0a4bb3e76f",
            "evidence_ids": [
              "ev-050f4a002f60-0010-0001"
            ],
            "pages": {
              "end": 103,
              "start": 103
            }
          }
        ],
        "text": "Justice Breyer dissented, warning of the dangers posed by firearms and questioning the Court\u2019s approach to historical analysis."
      }
