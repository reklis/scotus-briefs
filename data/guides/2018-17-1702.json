              "start": 47
            }
          }
        ],
        "text": "According to Petitioner, petitioners assert that the hot\u2011dog program\u2019s access is analogous to speaking in Central\u202fPark, a public space."
      },
      {
        "attribution": "Petitioner",
        "citations": [
          {
            "document_hash": "a870611aae1bda5ee688b19c191430b90cee6d6b8b491398aa82939446ef9252",
            "evidence_ids": [
              "ev-a870611aae1b-0002-0003"
            ],
            "pages": {
              "end": 49,
              "start": 49
            }
          }
        ],
        "text": "According to Petitioner, petitioners note that states and localities can choose systems that produce different First Amendment consequences."
      },
      {
        "attribution": "Mr. De Leeuw",
        "citations": [
          {
            "document_hash": "a870611aae1bda5ee688b19c191430b90cee6d6b8b491398aa82939446ef9252",
