          }
        ],
        "text": "According to Mr. Hughes, the channel is argued to be a public forum because New York generally opens property it controls for speech."
      },
      {
        "attribution": "Mr. Hughes",
        "citations": [
          {
            "document_hash": "a870611aae1bda5ee688b19c191430b90cee6d6b8b491398aa82939446ef9252",
            "evidence_ids": [
