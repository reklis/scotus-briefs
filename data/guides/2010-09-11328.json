              "start": 5
            }
          }
        ],
        "text": "Justice Kennedy asked why the Court is not simply following the good\u2011faith rule here."
      },
      {
        "attribution": "Justice Alito",
        "citations": [
          {
            "document_hash": "1812768977ea14d58bdea56b6e4475e435d508ad1553b04fd718b06bc8f902d1",
            "evidence_ids": [
