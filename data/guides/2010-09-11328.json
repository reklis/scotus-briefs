                "end": 8,
                "start": 8
              }
            }
          ],
          "text": "According to Petitioner, the petitioner notes that the Eleventh Circuit had not expanded Belton, only made routine applications of it."
        },
        {
          "attribution": "Petitioner",
          "citations": [
            {
              "document_hash": "1812768977ea14d58bdea56b6e4475e435d508ad1553b04fd718b06bc8f902d1",
