                "start": 6
              }
            }
          ],
          "text": "The petitioner says the government's use of the good\u2011faith label is actually a retroactivity argument."
        },
        {
          "attribution": "Petitioner",
          "citations": [
            {
              "document_hash": "1812768977ea14d58bdea56b6e4475e435d508ad1553b04fd718b06bc8f902d1",
