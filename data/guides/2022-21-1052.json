              "ev-f2238ca1e79f-0000-0009"
            ],
            "pages": {
              "end": 10,
              "start": 9
            }
          }
        ],
        "text": "Section\u202f3730(c)(2)(A) permits the government to dismiss the action notwithstanding the relator\u2019s objections, provided the relator receives notice of the motion and an opportunity for a hearing."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "f2238ca1e79ff267c93cd48ecb31b40a14db3f7f5382ec3ab7dd33166d6ea34a",
            "evidence_ids": [
              "ev-f2238ca1e79f-0002-0000"
            ],
            "pages": {
              "end": 22,
              "start": 22
            }
          }
        ],
        "text": "Under Federal Rule\u202f41, the government was entitled to dismiss the qui tam action, and the Court affirmed the judgment in all respects."
      },
      {
        "attribution": "Justice Thomas",
        "citations": [
          {
            "document_hash": "f2238ca1e79ff267c93cd48ecb31b40a14db3f7f5382ec3ab7dd33166d6ea34a",
            "evidence_ids": [
              "ev-f2238ca1e79f-0003-0000",
              "ev-f2238ca1e79f-0003-0001",
              "ev-f2238ca1e79f-0003-0002"
            ],
            "pages": {
              "end": 35,
              "start": 33
            }
          }
        ],
        "text": "Justice Thomas dissented, arguing that Article\u202fII may not permit private relators to represent the United States in FCA suits and that the judgment should be vacated and remanded."
      }
    ],
