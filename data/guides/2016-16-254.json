            "pages": {
              "end": 4,
              "start": 4
            }
          }
        ],
        "text": "Justice Sotomayor asked the parties whether they agree with the proposition that the treaty permits such service."
      },
      {
        "attribution": "Justice Sotomayor",
        "citations": [
          {
            "document_hash": "db154d196f142a5c0c1949fe9c8194009f74b5ee42aac6dd2caa15405b4e3775",
            "evidence_ids": [
