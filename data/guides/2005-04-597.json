  "overview": {
    "claims": [
      {
        "attribution": "Mr. Stewart",
        "citations": [
          {
            "document_hash": "6397a1cfc46cf2958425596afc9b0de607b13c68e6e97fbff082b84ce6379cb0",
            "evidence_ids": [
              "ev-6397a1cfc46c-0001-0003"
            ],
            "pages": {
              "end": 20,
              "start": 20
            }
          }
        ],
        "text": "Rule 50(a)(1) is permissive, allowing the court to decide an issue against a party when there is no legally sufficient evidentiary basis."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "6397a1cfc46cf2958425596afc9b0de607b13c68e6e97fbff082b84ce6379cb0",
            "evidence_ids": [
              "ev-6397a1cfc46c-0002-0002"
            ],
            "pages": {
              "end": 36,
              "start": 36
            }
          }
        ],
        "text": "A motion for a new trial was filed based on newly discovered evidence."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "6397a1cfc46cf2958425596afc9b0de607b13c68e6e97fbff082b84ce6379cb0",
            "evidence_ids": [
              "ev-6397a1cfc46c-0003-0004"
            ],
            "pages": {
              "end": 54,
              "start": 54
            }
          }
        ],
        "text": "The judge may decide a Rule 50(a) motion at any time before entering judgment and can change his or her mind at any time because the issue remains before the court."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "6397a1cfc46cf2958425596afc9b0de607b13c68e6e97fbff082b84ce6379cb0",
            "evidence_ids": [
              "ev-6397a1cfc46c-0003-0003"
            ],
            "pages": {
              "end": 55,
              "start": 55
            }
          }
        ],
        "text": "The differing interpretations of Rule 50(a) create confusion, subjectivity, and inconsistent legal standards nationwide."
      }
    ],
