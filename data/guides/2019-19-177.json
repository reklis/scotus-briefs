              "start": 4
            }
          }
        ],
        "text": "The funding condition at issue requires recipients to adopt a policy opposing prostitution and sex trafficking."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "ea1aa2f8b5f1c1178a6f75e529b90eff828a1bbb579b2f264969071016c3286a",
            "evidence_ids": [
              "ev-ea1aa2f8b5f1-0000-0003"
            ],
            "pages": {
              "end": 6,
              "start": 6
            }
          }
        ],
        "text": "For 17 years, foreign recipients have complied with this condition without harming the AIDS relief program or the respondents' speech."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "ea1aa2f8b5f1c1178a6f75e529b90eff828a1bbb579b2f264969071016c3286a",
            "evidence_ids": [
              "ev-ea1aa2f8b5f1-0000-0011"
            ],
            "pages": {
              "end": 19,
              "start": 19
            }
          }
        ],
        "text": "The court has found no example of anyone perceiving hypocrisy in the message or of the condition setting back work to fight HIV/AIDS."
      }
    ],
