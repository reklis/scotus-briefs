  "why_it_matters": {
    "claims": [
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "bdb340df910de47c56cf3520bf651652c37ed8eb94a0ebd6b685202d3808e21a",
            "evidence_ids": [
              "ev-bdb340df910d-0001-0001"
            ],
            "pages": {
              "end": 20,
              "start": 20
            }
          }
        ],
        "text": "The Court has stated that post\u2011sentencing rehabilitation is logically irrelevant to the statutory sentencing factors listed in 18\u202fU.S.C.\u202f\u00a7\u202f3553(a), such as deterrence and community safety."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "bdb340df910de47c56cf3520bf651652c37ed8eb94a0ebd6b685202d3808e21a",
            "evidence_ids": [
              "ev-bdb340df910d-0001-0003"
            ],
            "pages": {
              "end": 20,
              "start": 20
            }
          }
        ],
        "text": "The sentencing guidelines expressly prohibit a variance from the guidelines based on post\u2011sentencing rehabilitation."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "bdb340df910de47c56cf3520bf651652c37ed8eb94a0ebd6b685202d3808e21a",
            "evidence_ids": [
              "ev-bdb340df910d-0001-0002"
            ],
            "pages": {
              "end": 20,
              "start": 20
            }
          }
        ],
        "text": "The guidelines do allow limited consideration of present\u2011sentencing rehabilitation when selecting a sentence within the guideline range."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "bdb340df910de47c56cf3520bf651652c37ed8eb94a0ebd6b685202d3808e21a",
            "evidence_ids": [
              "ev-bdb340df910d-0001-0008"
            ],
            "pages": {
              "end": 37,
              "start": 37
            }
          }
        ],
        "text": "When a circuit orders de\u202fnovo resentencing, the resentencing judge is not bound by the district court\u2019s earlier determinations."
      }
    ],
