  "overview": {
    "claims": [
      {
        "attribution": "Petitioner",
        "citations": [
          {
            "document_hash": "3a3ffda61a2fb2e27862eb7f23544fc1f0182789d2dd77a7c10c7c3ac7fa4bb1",
            "evidence_ids": [
              "ev-3a3ffda61a2f-0000-0000"
            ],
            "pages": {
              "end": 3,
              "start": 3
            }
          }
        ],
        "text": "According to Petitioner, the case concerns whether the AEDPA tolling rule applies to a prisoner seeking to file a protective habeas petition based on new evidence."
      },
      {
        "attribution": "Petitioner",
        "citations": [
          {
            "document_hash": "3a3ffda61a2fb2e27862eb7f23544fc1f0182789d2dd77a7c10c7c3ac7fa4bb1",
            "evidence_ids": [
              "ev-3a3ffda61a2f-0000-0004"
            ],
            "pages": {
              "end": 7,
              "start": 7
            }
          }
        ],
        "text": "The petitioner argues that filing a protective habeas petition puts the State on notice and allows it to investigate the new evidence."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "3a3ffda61a2fb2e27862eb7f23544fc1f0182789d2dd77a7c10c7c3ac7fa4bb1",
            "evidence_ids": [
              "ev-3a3ffda61a2f-0000-0006"
            ],
            "pages": {
              "end": 9,
              "start": 9
            }
          }
        ],
        "text": "The court indicated that the case was remanded to the district court to determine whether the petitioner has evidence of actual innocence."
      }
    ],
    "heading": "Overview",
    "status": "complete",
