  "case_id": "scotus-23-1122",
  "decision": {
    "claims": [
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "5c2805a93c6082b67e99b64b0f3ebc8e58a79a3a0eb67fa066bb84274381910a",
            "evidence_ids": [
              "ev-5c2805a93c60-0001-0001"
            ],
            "pages": {
              "end": 11,
              "start": 11
            }
          }
        ],
        "text": "The Court denied a stay of the Fifth Circuit's judgment."
      },
      {
        "attribution": "Justice Thomas",
        "citations": [
          {
            "document_hash": "5c2805a93c6082b67e99b64b0f3ebc8e58a79a3a0eb67fa066bb84274381910a",
            "evidence_ids": [
              "ev-5c2805a93c60-0003-0004"
            ],
            "pages": {
              "end": 40,
              "start": 40
            }
          }
        ],
        "text": "The Court affirmed the judgment of the Court of Appeals for the Fifth Circuit."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "5c2805a93c6082b67e99b64b0f3ebc8e58a79a3a0eb67fa066bb84274381910a",
            "evidence_ids": [
              "ev-5c2805a93c60-0003-0000"
            ],
            "pages": {
              "end": 32,
              "start": 32
            }
          }
        ],
        "text": "The Court held that H. B. 1181 triggers only intermediate scrutiny."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "5c2805a93c6082b67e99b64b0f3ebc8e58a79a3a0eb67fa066bb84274381910a",
            "evidence_ids": [
              "ev-5c2805a93c60-0000-0007"
            ],
            "pages": {
              "end": 10,
              "start": 10
            }
          }
        ],
        "text": "The Court also held that because H. B. 1181 restricts access to speech based on its content, it is subject to strict scrutiny."
      },
      {
        "attribution": "Justice Kagan",
        "citations": [
          {
            "document_hash": "5c2805a93c6082b67e99b64b0f3ebc8e58a79a3a0eb67fa066bb84274381910a",
            "evidence_ids": [
              "ev-5c2805a93c60-0004-0004"
            ],
            "pages": {
              "end": 46,
              "start": 46
            }
          }
        ],
        "text": "Justice Kagan dissented, arguing that H. B. 1181 should be subject to strict scrutiny."
      }
    ],
