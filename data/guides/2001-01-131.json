  "background_and_question": {
    "claims": [
      {
        "attribution": "Justice Scalia",
        "citations": [
          {
            "document_hash": "9d1ddb689fb1bc2a11f54196b6f57eb0975a9b2ad671d32908106ff3241aa043",
            "evidence_ids": [
              "ev-9d1ddb689fb1-0001-0000"
            ],
            "pages": {
              "end": 19,
              "start": 19
            }
          }
        ],
        "text": "Justice Scalia asked whether the testimony reflected a universal practice among lawyers representing Social Security clients."
      },
      {
        "attribution": "Justice",
        "citations": [
          {
            "document_hash": "9d1ddb689fb1bc2a11f54196b6f57eb0975a9b2ad671d32908106ff3241aa043",
            "evidence_ids": [
              "ev-9d1ddb689fb1-0002-0000"
            ],
            "pages": {
              "end": 36,
              "start": 36
            }
          }
        ],
        "text": "A Justice asked whether \u00a7\u202f406(b) prohibits a lawyer from charging $300 per hour if the client pays after a successful claim."
      },
      {
        "attribution": "Justice",
        "citations": [
          {
            "document_hash": "9d1ddb689fb1bc2a11f54196b6f57eb0975a9b2ad671d32908106ff3241aa043",
            "evidence_ids": [
              "ev-9d1ddb689fb1-0002-0002"
            ],
            "pages": {
              "end": 37,
              "start": 37
            }
          }
        ],
        "text": "A Justice followed up asking whether the lawyer could bill after the judgment is entered."
      },
      {
        "attribution": "Justice",
        "citations": [
          {
            "document_hash": "9d1ddb689fb1bc2a11f54196b6f57eb0975a9b2ad671d32908106ff3241aa043",
            "evidence_ids": [
              "ev-9d1ddb689fb1-0002-0004"
            ],
            "pages": {
              "end": 38,
              "start": 38
            }
          }
        ],
        "text": "A Justice questioned whether the statute says all fees must be contingent."
      },
      {
        "attribution": "Justice",
        "citations": [
          {
            "document_hash": "9d1ddb689fb1bc2a11f54196b6f57eb0975a9b2ad671d32908106ff3241aa043",
            "evidence_ids": [
              "ev-9d1ddb689fb1-0002-0009"
            ],
            "pages": {
              "end": 42,
              "start": 42
            }
          }
        ],
        "text": "A Justice asked about the frequency with which attorney\u2011fee awards are appealed to the Court of Appeals."
      },
      {
        "attribution": "Justice",
        "citations": [
          {
            "document_hash": "9d1ddb689fb1bc2a11f54196b6f57eb0975a9b2ad671d32908106ff3241aa043",
            "evidence_ids": [
              "ev-9d1ddb689fb1-0002-0011"
            ],
            "pages": {
              "end": 43,
              "start": 43
            }
          }
        ],
        "text": "A Justice asked about statistics concerning the attorney in such appeals."
      },
      {
        "attribution": "Justice Stevens",
        "citations": [
          {
            "document_hash": "9d1ddb689fb1bc2a11f54196b6f57eb0975a9b2ad671d32908106ff3241aa043",
            "evidence_ids": [
              "ev-9d1ddb689fb1-0003-0000"
            ],
            "pages": {
              "end": 53,
              "start": 53
            }
          }
        ],
        "text": "Justice Stevens asked about the EAJA lodestar method."
      },
      {
        "attribution": "Justice O'Connor",
        "citations": [
          {
            "document_hash": "9d1ddb689fb1bc2a11f54196b6f57eb0975a9b2ad671d32908106ff3241aa043",
            "evidence_ids": [
              "ev-9d1ddb689fb1-0003-0001"
            ],
            "pages": {
              "end": 53,
              "start": 53
            }
          }
        ],
        "text": "Justice O'Connor asked whether contingency could be considered by a district court in determining the fee."
      }
    ],
