  "background_and_question": {
    "claims": [
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "8933bf7d996bc5c2ae8ab08459d4a3adc78f35aa83b11886d7b89cba3e00f97b",
            "evidence_ids": [
              "ev-8933bf7d996b-0000-0000"
            ],
            "pages": {
              "end": 2,
              "start": 2
            }
          }
        ],
        "text": "The case arose from an FBI raid on the wrong house on October\u202f18,\u202f2017."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "8933bf7d996bc5c2ae8ab08459d4a3adc78f35aa83b11886d7b89cba3e00f97b",
            "evidence_ids": [
              "ev-8933bf7d996b-0000-0004"
            ],
            "pages": {
              "end": 2,
              "start": 2
            }
          }
        ],
        "text": "Petitioners filed a petition for certiorari to the United States Court of Appeals for the Eleventh Circuit."
      },
      {
        "attribution": "Justice Thomas",
        "citations": [
          {
            "document_hash": "ae8402906c3f6b8a66be948faae8f08b6932b93d4d98c8f81904d14e8c4aa7c7",
            "evidence_ids": [
              "ev-ae8402906c3f-0001-0002"
            ],
            "pages": {
              "end": 30,
              "start": 30
            }
          }
        ],
        "text": "Justice Thomas asked whether a proviso such as this could extend more broadly than the case at hand."
      },
      {
        "attribution": "Justice Jackson",
        "citations": [
          {
            "document_hash": "ae8402906c3f6b8a66be948faae8f08b6932b93d4d98c8f81904d14e8c4aa7c7",
            "evidence_ids": [
              "ev-ae8402906c3f-0002-0001"
            ],
            "pages": {
              "end": 45,
              "start": 45
            }
          }
        ],
        "text": "Justice Jackson asked whether the Court should not reach the Supremacy Clause question."
      },
      {
        "attribution": "Justice Jackson",
        "citations": [
          {
            "document_hash": "ae8402906c3f6b8a66be948faae8f08b6932b93d4d98c8f81904d14e8c4aa7c7",
            "evidence_ids": [
              "ev-ae8402906c3f-0002-0002"
            ],
            "pages": {
              "end": 46,
              "start": 46
            }
          }
        ],
        "text": "According to Justice Jackson, justice Jackson expressed concern about jurisdiction to decide a question that never appeared in the cert petition."
      },
      {
        "attribution": "Justice Jackson",
        "citations": [
          {
            "document_hash": "ae8402906c3f6b8a66be948faae8f08b6932b93d4d98c8f81904d14e8c4aa7c7",
            "evidence_ids": [
              "ev-ae8402906c3f-0002-0004"
            ],
            "pages": {
              "end": 53,
              "start": 53
            }
          }
        ],
        "text": "According to Justice Jackson, justice Jackson noted that the Eleventh Circuit is the only circuit that has adopted this line of thinking."
      }
    ],
