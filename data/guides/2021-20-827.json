{
  "background_and_question": {
    "claims": [
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "b1cb893711d795c32b66fad93265411e704163d6bf44e5c190951cfb8f3bf05e",
            "evidence_ids": [
              "ev-b1cb893711d7-0000-0000"
            ],
            "pages": {
              "end": 2,
              "start": 2
            }
          }
        ],
        "text": "After the September\u202f11,\u202f2001 attacks, the CIA believed Abu\u202fZubaydah was a senior al\u202fQaeda lieutenant with knowledge of future attacks against the United States."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "b1cb893711d795c32b66fad93265411e704163d6bf44e5c190951cfb8f3bf05e",
            "evidence_ids": [
              "ev-b1cb893711d7-0000-0001"
            ],
            "pages": {
              "end": 2,
              "start": 2
            }
          }
        ],
        "text": "The Government intervened and asserted the state\u2011secrets privilege to block Zubaydah\u2019s discovery request."
      },
      {
        "attribution": "Justice Thomas",
        "citations": [
          {
            "document_hash": "d242b06a673cdd9762d4df6a09b3cffa87a33825e92f9c08d53a693dab2e5fc4",
            "evidence_ids": [
              "ev-d242b06a673c-0000-0001"
            ],
            "pages": {
              "end": 6,
              "start": 6
            }
          }
        ],
        "text": "Justice Thomas asked whether the two contractors had previously testified about detainee treatment."
      },
      {
        "attribution": "Justice Kavanaugh",
        "citations": [
          {
            "document_hash": "d242b06a673cdd9762d4df6a09b3cffa87a33825e92f9c08d53a693dab2e5fc4",
            "evidence_ids": [
              "ev-d242b06a673c-0001-0005"
            ],
            "pages": {
              "end": 29,
              "start": 29
            }
          }
        ],
        "text": "According to Justice Kavanaugh, justice Kavanaugh questioned the constitutional versus common\u2011law nature of the privilege and whether Congress could alter it."
      },
      {
        "attribution": "Justice Sotomayor",
        "citations": [
          {
            "document_hash": "d242b06a673cdd9762d4df6a09b3cffa87a33825e92f9c08d53a693dab2e5fc4",
            "evidence_ids": [
              "ev-d242b06a673c-0001-0006"
            ],
            "pages": {
              "end": 32,
              "start": 32
            }
          }
        ],
        "text": "Justice Sotomayor asked whether the case should be analyzed under Reynolds (state\u2011secrets) or an intelligence\u2011law framework."
      },
      {
        "attribution": "Justice Gorsuch",
        "citations": [
          {
            "document_hash": "d242b06a673cdd9762d4df6a09b3cffa87a33825e92f9c08d53a693dab2e5fc4",
            "evidence_ids": [
              "ev-d242b06a673c-0001-0002"
            ],
            "pages": {
              "end": 36,
              "start": 36
            }
          }
        ],
        "text": "Justice Gorsuch asked whether the government bears the burden of proving the privilege."
      }
    ],
    "heading": "Background and Questions",
    "status": "complete",
    "summary": null,
    "summary_citations": []
  },
  "case_id": "2021-20-827",
  "decision": {
    "claims": [
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "b1cb893711d795c32b66fad93265411e704163d6bf44e5c190951cfb8f3bf05e",
            "evidence_ids": [
              "ev-b1cb893711d7-0001-0000"
            ],
            "pages": {
              "end": 19,
              "start": 19
            }
          }
        ],
        "text": "The majority held that the state\u2011secrets privilege applies to the existence (or non\u2011existence) of a CIA facility in Poland and therefore precludes further discovery."
      },
      {
        "attribution": "Justice Kavanaugh",
        "citations": [
          {
            "document_hash": "b1cb893711d795c32b66fad93265411e704163d6bf44e5c190951cfb8f3bf05e",
            "evidence_ids": [
              "ev-b1cb893711d7-0003-0001"
            ],
            "pages": {
              "end": 39,
              "start": 39
            }
          }
        ],
        "text": "Justice Kavanaugh concurred, stating that Zubaydah has shown only a \u201cdubious showing of necessity\u201d for the discovery he seeks."
      },
      {
        "attribution": "Justice Gorsuch",
        "citations": [
          {
            "document_hash": "b1cb893711d795c32b66fad93265411e704163d6bf44e5c190951cfb8f3bf05e",
            "evidence_ids": [
              "ev-b1cb893711d7-0004-0002",
              "ev-b1cb893711d7-0004-0010"
            ],
            "pages": {
              "end": 54,
              "start": 46
            }
          }
        ],
        "text": "Justice Gorsuch dissented, arguing that the treatment of Zubaydah involved severe abuse, that discovery could proceed without confirming the location of the alleged CIA site, and that 28\u202fU.S.C.\u202f\u00a7\u202f1782 authorizes foreign\u2011related discovery."
      }
    ],
    "heading": "Decision",
    "status": "complete",
    "summary": null,
    "summary_citations": []
  },
