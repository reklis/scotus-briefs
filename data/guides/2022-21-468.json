              "start": 20
            }
          },
          {
            "document_hash": "ccdfb4f3491a102d5121840e3e1265f427098cb431b09ea5240d4ce2e6c7fb0a",
            "evidence_ids": [
              "ev-ccdfb4f3491a-0002-0002",
              "ev-ccdfb4f3491a-0002-0003"
            ],
            "pages": {
              "end": 54,
              "start": 53
            }
          }
        ],
        "text": "Petitioners argue that Proposition\u202f12 violates the Dormant Commerce Clause because it imposes an extraterritorial regulation that forces out\u2011of\u2011state pork producers to adopt California\u2019s farming methods without a legitimate local benefit."
      }
