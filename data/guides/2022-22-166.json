              "ev-8420ac57fa4b-0001-0000"
            ],
            "pages": {
              "end": 18,
              "start": 18
            }
          }
        ],
        "text": "Because the Court found that Tyler plausibly alleged a taking, it did not need to decide the excessive\u2011fines claim."
      }
    ],
