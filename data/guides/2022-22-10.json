    "claims": [
      {
        "attribution": "Jeffrey L. Fisher",
        "citations": [
          {
            "document_hash": "993ec9267998faa125bc317382ff888a5e9dd9de0ebaea887b52bb2dec31b88c",
            "evidence_ids": [
              "ev-993ec9267998-0000-0001"
            ],
            "pages": {
              "end": 4,
              "start": 4
            }
          }
        ],
        "text": "According to Jeffrey L. Fisher, petitioner argued that the Fifth Circuit\u2019s interpretation of the aggravated identity\u2011theft statute stretched the law beyond its proper scope."
      },
      {
        "attribution": "Justice Thomas",
        "citations": [
          {
            "document_hash": "993ec9267998faa125bc317382ff888a5e9dd9de0ebaea887b52bb2dec31b88c",
            "evidence_ids": [
              "ev-993ec9267998-0000-0002"
            ],
            "pages": {
              "end": 6,
              "start": 6
            }
          }
        ],
        "text": "During oral argument, Justice Thomas asked whether Dubin was authorized to use Patient\u202fL\u2019s identity for the transaction in question."
      },
      {
        "attribution": "Justice Sotomayor",
        "citations": [
          {
            "document_hash": "993ec9267998faa125bc317382ff888a5e9dd9de0ebaea887b52bb2dec31b88c",
            "evidence_ids": [
              "ev-993ec9267998-0001-0001"
            ],
            "pages": {
              "end": 24,
              "start": 24
            }
          }
        ],
        "text": "According to Justice Sotomayor, justice Sotomayor questioned the meaning of the word \u201cuse\u201d and whether lying about permission constitutes theft."
      },
      {
        "attribution": "Justice Thomas",
        "citations": [
          {
            "document_hash": "993ec9267998faa125bc317382ff888a5e9dd9de0ebaea887b52bb2dec31b88c",
            "evidence_ids": [
              "ev-993ec9267998-0003-0000"
            ],
            "pages": {
              "end": 66,
              "start": 66
            }
          }
        ],
        "text": "Justice Thomas also raised concerns about the statute\u2019s broad language, asking how far the Court will go with terms like \u201cin relation to.\u201d"
      },
      {
        "attribution": "Justice Gorsuch",
        "citations": [
          {
            "document_hash": "993ec9267998faa125bc317382ff888a5e9dd9de0ebaea887b52bb2dec31b88c",
            "evidence_ids": [
              "ev-993ec9267998-0003-0002"
            ],
            "pages": {
              "end": 73,
              "start": 72
            }
          }
        ],
        "text": "Justice Gorsuch asked about the vagueness problem and what notice the statute provides to ordinary people."
      },
      {
        "attribution": "Justice Kagan",
        "citations": [
          {
            "document_hash": "993ec9267998faa125bc317382ff888a5e9dd9de0ebaea887b52bb2dec31b88c",
            "evidence_ids": [
              "ev-993ec9267998-0004-0003"
            ],
            "pages": {
              "end": 95,
              "start": 94
            }
          }
        ],
        "text": "According to Justice Kagan, justice Kagan inquired whether a misrepresentation about identity satisfies the statutory element."
      },
      {
        "attribution": "Justice Jackson",
        "citations": [
          {
            "document_hash": "993ec9267998faa125bc317382ff888a5e9dd9de0ebaea887b52bb2dec31b88c",
            "evidence_ids": [
              "ev-993ec9267998-0004-0000"
            ],
            "pages": {
              "end": 99,
              "start": 99
            }
          }
        ],
        "text": "Justice Jackson asked whether \u201cwithout lawful authority\u201d necessarily means using the identity to commit a crime."
      },
      {
        "attribution": "Justices Sotomayor and Thomas",
        "citations": [
          {
            "document_hash": "993ec9267998faa125bc317382ff888a5e9dd9de0ebaea887b52bb2dec31b88c",
            "evidence_ids": [
              "ev-993ec9267998-0001-0001"
            ],
            "pages": {
              "end": 24,
              "start": 24
            }
          },
          {
            "document_hash": "993ec9267998faa125bc317382ff888a5e9dd9de0ebaea887b52bb2dec31b88c",
            "evidence_ids": [
              "ev-993ec9267998-0003-0000"
            ],
            "pages": {
              "end": 66,
              "start": 66
            }
          }
        ],
        "text": "The core legal question before the Court was whether the use of a patient\u2019s identity without lawful authority satisfies the \u201cmeans of identification\u201d element required for aggravated identity theft."
      }
    ],
