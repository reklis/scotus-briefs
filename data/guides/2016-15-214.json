            "evidence_ids": [
              "ev-e3ac643b4d24-0002-0001"
            ],
            "pages": {
              "end": 41,
              "start": 41
            }
          }
        ],
        "text": "The State says the law aims to phase out substandard lots without interfering with current investment\u2011backed expectations, and that the phase\u2011out is triggered only when lots are in common ownership."
      }
