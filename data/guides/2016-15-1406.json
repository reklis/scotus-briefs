              "start": 4
            }
          }
        ],
        "text": "Justice Sotomayor asked whether the line drawn in *Bagli* between compensatory damages under the contempt inherent power and punishment damages that require criminal civil procedures applies here."
      },
      {
        "attribution": "Justice Kagan",
        "citations": [
          {
            "document_hash": "9503032b1d1f568301ae725d73fb1591e4d624946f606a87da455d3f742f8ba9",
            "evidence_ids": [
              "ev-9503032b1d1f-0000-0004"
            ],
            "pages": {
              "end": 11,
              "start": 11
            }
          }
        ],
        "text": "According to Justice Kagan, justice Kagan inquired whether the parties favored the \u201cbut\u2011for\u201d causation test from *Fox v. Vice*."
      },
      {
        "attribution": "Justice Ginsburg",
        "citations": [
          {
            "document_hash": "9503032b1d1f568301ae725d73fb1591e4d624946f606a87da455d3f742f8ba9",
            "evidence_ids": [
              "ev-9503032b1d1f-0000-0002"
            ],
            "pages": {
              "end": 4,
              "start": 4
            }
          }
        ],
        "text": "Justice Ginsburg asked about the district court\u2019s finding that the case was \u201cpervasive\u201d from the start of discovery through settlement."
      },
      {
        "attribution": "Justice Kennedy",
        "citations": [
          {
            "document_hash": "9503032b1d1f568301ae725d73fb1591e4d624946f606a87da455d3f742f8ba9",
            "evidence_ids": [
              "ev-9503032b1d1f-0001-0009"
            ],
            "pages": {
              "end": 22,
              "start": 22
            }
          }
        ],
        "text": "Justice Kennedy asked what would happen if another case found the present case would have settled much earlier."
      },
      {
        "attribution": "Justice Sotomayor",
        "citations": [
          {
            "document_hash": "9503032b1d1f568301ae725d73fb1591e4d624946f606a87da455d3f742f8ba9",
            "evidence_ids": [
              "ev-9503032b1d1f-0001-0011"
            ],
            "pages": {
              "end": 34,
              "start": 34
            }
          }
        ],
        "text": "Justice Sotomayor later asked the respondent to define \u201cdirect causation.\u201d"
      }
