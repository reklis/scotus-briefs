  "case_id": "scotus-23-1067",
  "decision": {
    "claims": [
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "6e1293decc758c7c322b748ee8f01065b0fc60d21f9ac27a44e264918d695fa0",
            "evidence_ids": [
              "ev-6e1293decc75-0000-0000"
            ],
            "pages": {
              "end": 7,
              "start": 7
            }
          }
        ],
        "text": "The Court held that EPA's disapprovals that are locally or regionally applicable are reviewable in a regional circuit."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "6e1293decc758c7c322b748ee8f01065b0fc60d21f9ac27a44e264918d695fa0",
            "evidence_ids": [
              "ev-6e1293decc75-0001-0003"
            ],
            "pages": {
              "end": 18,
              "start": 18
            }
          }
        ],
        "text": "The Tenth Circuit erred in holding that the challenges should be reviewed in the D.C. Circuit; the Court reversed that judgment and remanded for further proceedings consistent with this opinion."
      },
      {
        "attribution": "Justice Gorsuch",
        "citations": [
          {
            "document_hash": "6e1293decc758c7c322b748ee8f01065b0fc60d21f9ac27a44e264918d695fa0",
            "evidence_ids": [
              "ev-6e1293decc75-0001-0004"
            ],
            "pages": {
              "end": 19,
              "start": 19
            }
          }
        ],
        "text": "Justice Gorsuch filed a concurrence agreeing that the proper venue is a regional circuit, though he reached that conclusion by a different reasoning."
      }
    ],
