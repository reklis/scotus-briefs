            }
          }
        ],
        "text": "EPA issued disapprovals of the Oklahoma and Utah State Implementation Plans (SIPs)."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "6e1293decc758c7c322b748ee8f01065b0fc60d21f9ac27a44e264918d695fa0",
            "evidence_ids": [
              "ev-6e1293decc75-0001-0003"
            ],
            "pages": {
              "end": 18,
              "start": 18
            }
          }
        ],
        "text": "The Tenth Circuit held that the challenges to those disapprovals should be reviewed in the D.C. Circuit."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "6e1293decc758c7c322b748ee8f01065b0fc60d21f9ac27a44e264918d695fa0",
            "evidence_ids": [
              "ev-6e1293decc75-0001-0000"
            ],
            "pages": {
              "end": 11,
              "start": 11
            }
          }
        ],
        "text": "The Court granted certiorari to review the transfer decision."
      }
    ],
