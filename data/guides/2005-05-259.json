                "ev-3eac5e32b531-0003-0001"
              ],
              "pages": {
                "end": 57,
                "start": 57
              }
            }
          ],
          "text": "According to Carter G. Phillips, the jury was not instructed under the Ellerth standard; a variant of that standard was not upheld by the court of appeals."
        },
        {
          "attribution": "Carter G. Phillips",
          "citations": [
            {
              "document_hash": "3eac5e32b531afcce885fb908744b108385604524bddce553340aac490f8f419",
              "evidence_ids": [
                "ev-3eac5e32b531-0003-0000"
              ],
              "pages": {
                "end": 56,
                "start": 56
              }
            }
          ],
          "text": "According to Carter G. Phillips, the rise in retaliation claims is linked to the Ellerth standard and employer policies that, when enforced, can lead to retaliation against complainants like Ms. White."
        }
      ],
