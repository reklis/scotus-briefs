  "overview": {
    "claims": [
      {
        "attribution": "Chief Justice Roberts",
        "citations": [
          {
            "document_hash": "cbde50418314d37d6fd98c47d865572f5289bb1770b3130f386daa5391d5b268",
            "evidence_ids": [
              "ev-cbde50418314-0000-0001"
            ],
            "pages": {
              "end": 3,
              "start": 3
            }
          }
        ],
        "text": "According to Chief Justice Roberts, chief Justice Roberts announced that the Court would hear argument in Uttecht v. Brown."
      },
      {
        "attribution": "Petitioner",
        "citations": [
          {
            "document_hash": "cbde50418314d37d6fd98c47d865572f5289bb1770b3130f386daa5391d5b268",
            "evidence_ids": [
              "ev-cbde50418314-0000-0002"
            ],
            "pages": {
              "end": 3,
              "start": 3
            }
          }
        ],
        "text": "The petitioner argues that the Ninth Circuit's conclusion that Mr. Brown is entitled to habeas corpus relief should be reversed for three reasons."
      },
      {
        "attribution": "Petitioner",
        "citations": [
          {
            "document_hash": "cbde50418314d37d6fd98c47d865572f5289bb1770b3130f386daa5391d5b268",
            "evidence_ids": [
              "ev-cbde50418314-0000-0006"
            ],
            "pages": {
              "end": 13,
              "start": 13
            }
          }
        ],
        "text": "The petitioner further contends that the State courts made no finding of fact, and that there are two State court findings of fact, one by the Washington Supreme Court and one by the trial judge."
      },
      {
        "attribution": "United States (amicus)",
        "citations": [
          {
            "document_hash": "cbde50418314d37d6fd98c47d865572f5289bb1770b3130f386daa5391d5b268",
            "evidence_ids": [
              "ev-cbde50418314-0000-0008"
            ],
            "pages": {
              "end": 19,
              "start": 19
            }
          }
        ],
        "text": "According to United States (amicus), the United States, as amicus curiae, presented oral argument supporting the petitioner."
      },
      {
        "attribution": "Ms. Elliott",
        "citations": [
          {
            "document_hash": "cbde50418314d37d6fd98c47d865572f5289bb1770b3130f386daa5391d5b268",
            "evidence_ids": [
              "ev-cbde50418314-0002-0001"
            ],
            "pages": {
              "end": 38,
              "start": 38
            }
          }
        ],
        "text": "The respondent, represented by Ms. Elliott, argues that under Washington law a juror could be excused if he knows the statutory scheme, and that the death penalty would only be imposed if there is a possibility of release and future killing."
      },
      {
        "attribution": "Prosecution",
        "citations": [
          {
            "document_hash": "cbde50418314d37d6fd98c47d865572f5289bb1770b3130f386daa5391d5b268",
            "evidence_ids": [
              "ev-cbde50418314-0001-0003"
            ],
            "pages": {
              "end": 20,
              "start": 20
            }
          }
        ],
        "text": "The prosecution claims there were twelve objections to jurors for cause because of inability to apply Washington law."
      },
      {
        "attribution": "Chief Justice Roberts",
        "citations": [
          {
            "document_hash": "cbde50418314d37d6fd98c47d865572f5289bb1770b3130f386daa5391d5b268",
            "evidence_ids": [
              "ev-cbde50418314-0000-0009"
            ],
            "pages": {
              "end": 19,
              "start": 19
            }
          }
        ],
        "text": "According to Chief Justice Roberts, chief Justice Roberts allowed the petitioner to reserve time for rebuttal."
      }
    ],
