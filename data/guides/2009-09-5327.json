              "start": 29
            }
          }
        ],
        "text": "Justice Alito asked whether a forged date stamp on a filing eliminates equitable tolling."
      },
      {
        "attribution": "Justice Alito",
        "citations": [
          {
            "document_hash": "d170aa8c7f1e7e94becff9af62ce3c2a77296b82bfcf2c3bbff3a935f6db6e4a",
