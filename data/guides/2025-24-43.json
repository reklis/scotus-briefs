  "case_id": "2025-24-43",
  "decision": {
    "claims": [
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "43a1a329994be812c65f8b6f6bfd8c78f746b893b1ae3357510c603d44842fca",
            "evidence_ids": [
              "ev-43a1a329994b-0000-0000"
            ],
            "pages": {
              "end": 2,
              "start": 2
            }
          }
        ],
        "text": "Held: Title\u202fIX allows schools to provide separate women\u2019s and men\u2019s sports teams defined by biological sex."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "43a1a329994be812c65f8b6f6bfd8c78f746b893b1ae3357510c603d44842fca",
            "evidence_ids": [
              "ev-43a1a329994b-0002-0005"
            ],
            "pages": {
              "end": 34,
              "start": 34
            }
          }
        ],
        "text": "The Court reversed the Fourth Circuit\u2019s judgment and remanded the case for further proceedings consistent with this opinion."
      },
      {
        "attribution": "Justice Otomayor",
        "citations": [
          {
            "document_hash": "43a1a329994be812c65f8b6f6bfd8c78f746b893b1ae3357510c603d44842fca",
            "evidence_ids": [
              "ev-43a1a329994b-0002-0004"
            ],
            "pages": {
              "end": 31,
              "start": 31
            }
          }
        ],
        "text": "According to Justice Otomayor, dissent (Justice Otomayor): The Court should not decide policy questions and should leave them to the democratic process."
      },
      {
        "attribution": "Justice Sotomayor",
        "citations": [
          {
            "document_hash": "43a1a329994be812c65f8b6f6bfd8c78f746b893b1ae3357510c603d44842fca",
            "evidence_ids": [
              "ev-43a1a329994b-0003-0004"
            ],
            "pages": {
              "end": 42,
              "start": 42
            }
          },
          {
            "document_hash": "43a1a329994be812c65f8b6f6bfd8c78f746b893b1ae3357510c603d44842fca",
            "evidence_ids": [
              "ev-43a1a329994b-0003-0005"
            ],
            "pages": {
              "end": 45,
              "start": 45
            }
          }
        ],
        "text": "According to Justice Sotomayor, dissent (Justice Sotomayor): B.\u202fP.\u202fJ. is a transgender girl seeking to live consistent with her gender identity; the ban eliminates an individualized approach."
      }
