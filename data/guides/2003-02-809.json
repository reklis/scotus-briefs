              "start": 49
            }
          }
        ],
        "text": "Police stopped the car and found drugs packaged for distribution in the rear\u2011seat armrest and a large amount of cash in the glove compartment."
      },
      {
        "attribution": "Justice O'Connor",
        "citations": [
          {
            "document_hash": "771567f1beb98787beb477cf982ff7f967b0fdc9151f5e6eda5951915c40b989",
            "evidence_ids": [
              "ev-771567f1beb9-0000-0002"
            ],
            "pages": {
              "end": 4,
              "start": 4
            }
          }
        ],
        "text": "According to Justice O'Connor, the central legal question is whether the officers had probable cause to arrest all three occupants based on those findings."
      }
    ],
