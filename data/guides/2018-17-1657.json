  "party_positions": [
    {
      "claims": [
        {
          "attribution": "Petitioner",
          "citations": [
            {
              "document_hash": "a5e28d8175ceb6e8c3bc9bdfb099e1a04d86988cdb21ba48f7c8e7066138d461",
              "evidence_ids": [
                "ev-a5e28d8175ce-0000-0001"
              ],
              "pages": {
                "end": 4,
                "start": 4
              }
            }
          ],
          "text": "According to Petitioner, section\u202f365 of the Bankruptcy Code lets the trustee decide whether the estate will become a party to an executory contract; rejection constitutes a breach of the contract immediately before the filing of the petition, relieving the debtor of future performance obligations."
        },
        {
          "attribution": "MS. SPINELLI",
          "citations": [
            {
              "document_hash": "a5e28d8175ceb6e8c3bc9bdfb099e1a04d86988cdb21ba48f7c8e7066138d461",
              "evidence_ids": [
                "ev-a5e28d8175ce-0003-0001"
              ],
              "pages": {
                "end": 67,
                "start": 67
              }
            }
          ],
          "text": "According to MS. SPINELLI, the license is analogous to a lease; prior to bankruptcy the debtor conveyed an interest in its intellectual property, creating a lease\u2011like interest that survives the bankruptcy filing."
        }
      ],
      "heading": "Petitioner",
      "status": "complete",
      "summary": null,
      "summary_citations": []
    },
    {
      "claims": [
        {
          "attribution": "Respondents",
          "citations": [
            {
              "document_hash": "a5e28d8175ceb6e8c3bc9bdfb099e1a04d86988cdb21ba48f7c8e7066138d461",
              "evidence_ids": [
                "ev-a5e28d8175ce-0001-0002"
              ],
              "pages": {
                "end": 34,
                "start": 34
              }
            }
          ],
          "text": "According to Respondents, the case is moot because the exclusive distribution rights are off the table, leaving only a non\u2011exclusive trademark license that has already expired."
        },
        {
          "attribution": "Respondents",
          "citations": [
            {
              "document_hash": "a5e28d8175ceb6e8c3bc9bdfb099e1a04d86988cdb21ba48f7c8e7066138d461",
              "evidence_ids": [
                "ev-a5e28d8175ce-0001-0004"
              ],
              "pages": {
                "end": 36,
                "start": 36
              }
            }
          ],
          "text": "According to Respondents, existing Supreme Court precedent would not allow a claim based on the rejected trademark license."
        }
      ],
