                "ev-59ebbc138d52-0001-0001"
              ],
              "pages": {
                "end": 26,
                "start": 26
              }
            }
          ],
          "text": "According to MS. BLATT, ms. Blatt testified that a survey showed 25\u202f% of respondents were confused about the source of the product, which the plaintiff described as a \u201cmassively high\u201d level of confusion."
        },
        {
          "attribution": "Ms. Blatt",
          "citations": [
            {
              "document_hash": "59ebbc138d52549ad4729c03ac29de6947662bdc29c38d156b159b83a4d7cf7d",
              "evidence_ids": [
                "ev-59ebbc138d52-0004-0002"
              ],
              "pages": {
                "end": 95,
                "start": 95
              }
            }
          ],
          "text": "Ms. Blatt argued that all trademarks are expressive and that infringing them implicates speech rights, asserting the plaintiff\u2019s interests include preventing compelled speech in contexts such as pornography and sex toys."
        }
      ],
      "heading": "Jack Daniel's Properties, Inc.",
