              "end": 2,
              "start": 2
            }
          }
        ],
        "text": "BP P.L.C. and other energy companies sued the City of Baltimore in Maryland state court, alleging the companies concealed the environmental impacts of the fossil fuels they promoted."
      },
      {
        "attribution": "District Court",
        "citations": [
          {
            "document_hash": "ce7415c692bf858a28d41a6aca8c170a317841cb77e635290a80a9bfa08c7b81",
            "evidence_ids": [
              "ev-ce7415c692bf-0000-0003"
            ],
            "pages": {
              "end": 2,
              "start": 2
            }
          }
        ],
        "text": "The district court agreed and issued an order remanding the case back to state court."
      },
      {
        "attribution": "Petitioners",
        "citations": [
          {
            "document_hash": "ae28ba47a085c0207cea307a3d6e8fca5a69880230e8af03719b883d7a59e5ea",
            "evidence_ids": [
              "ev-ae28ba47a085-0000-0000"
            ],
            "pages": {
              "end": 5,
              "start": 5
            }
          },
          {
            "document_hash": "ae28ba47a085c0207cea307a3d6e8fca5a69880230e8af03719b883d7a59e5ea",
            "evidence_ids": [
              "ev-ae28ba47a085-0003-0003"
            ],
            "pages": {
              "end": 75,
              "start": 75
            }
          }
        ],
        "text": "Petitioners argue that Section\u202f1447(d) authorizes appellate review of the entire remand order, not just particular issues."
      },
      {
        "attribution": "Respondents",
        "citations": [
          {
            "document_hash": "ce7415c692bf858a28d41a6aca8c170a317841cb77e635290a80a9bfa08c7b81",
            "evidence_ids": [
              "ev-ce7415c692bf-0001-0002"
            ],
            "pages": {
              "end": 12,
              "start": 12
            }
          },
          {
            "document_hash": "ce7415c692bf858a28d41a6aca8c170a317841cb77e635290a80a9bfa08c7b81",
            "evidence_ids": [
              "ev-ce7415c692bf-0001-0003"
            ],
            "pages": {
              "end": 16,
              "start": 16
            }
          },
          {
            "document_hash": "ae28ba47a085c0207cea307a3d6e8fca5a69880230e8af03719b883d7a59e5ea",
            "evidence_ids": [
              "ev-ae28ba47a085-0002-0004"
            ],
            "pages": {
              "end": 45,
              "start": 45
            }
          }
        ],
        "text": "Respondents contend that the defendants never removed the case under \u00a7\u202f1442 or \u00a7\u202f1443, so they are not entitled to any appellate review of the remand order."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "ce7415c692bf858a28d41a6aca8c170a317841cb77e635290a80a9bfa08c7b81",
            "evidence_ids": [
              "ev-ce7415c692bf-0001-0000"
            ],
            "pages": {
              "end": 18,
              "start": 18
            }
          }
        ],
        "text": "The Fourth Circuit erred in holding that it was powerless to consider all of the defendants\u2019 grounds for removal under \u00a7\u202f1447(d)."
      },
      {
        "attribution": "Justice Sotomayor",
        "citations": [
          {
            "document_hash": "ce7415c692bf858a28d41a6aca8c170a317841cb77e635290a80a9bfa08c7b81",
            "evidence_ids": [
              "ev-ce7415c692bf-0001-0001"
            ],
            "pages": {
              "end": 19,
              "start": 19
            }
          }
        ],
        "text": "Justice Sotomayor dissented, vacating the Fourth Circuit judgment and remanding the case for further proceedings consistent with her opinion."
      }
    ],
