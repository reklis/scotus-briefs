  "overview": {
    "claims": [
      {
        "attribution": "Baltimore's Mayor and City Council",
        "citations": [
          {
            "document_hash": "ce7415c692bf858a28d41a6aca8c170a317841cb77e635290a80a9bfa08c7b81",
