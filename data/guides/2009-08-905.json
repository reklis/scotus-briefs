  "background_and_question": {
    "claims": [
      {
        "attribution": "Justice Scalia",
        "citations": [
          {
            "document_hash": "e74248e54e324e3e277d6c53f7cca2f9cc6f0323c36fbe4a45dabd10cebfd55d",
            "evidence_ids": [
              "ev-e74248e54e32-0000-0003"
            ],
            "pages": {
              "end": 6,
              "start": 5
            }
          }
        ],
        "text": "Justice Scalia asked whether the Court should go beyond constructive discovery."
      },
      {
        "attribution": "Justice Scalia",
        "citations": [
          {
            "document_hash": "e74248e54e324e3e277d6c53f7cca2f9cc6f0323c36fbe4a45dabd10cebfd55d",
            "evidence_ids": [
              "ev-e74248e54e32-0001-0000"
            ],
            "pages": {
              "end": 21,
              "start": 21
            }
          }
        ],
        "text": "According to Justice Scalia, justice Scalia questioned whether \u201cafter discovery\u201d always means after actual discovery, referencing the Lampf case."
      },
      {
        "attribution": "Justice Sotomayor",
        "citations": [
          {
            "document_hash": "e74248e54e324e3e277d6c53f7cca2f9cc6f0323c36fbe4a45dabd10cebfd55d",
            "evidence_ids": [
              "ev-e74248e54e32-0001-0001"
            ],
            "pages": {
              "end": 23,
              "start": 23
            }
          }
        ],
        "text": "Justice Sotomayor asked what the difference is between actual knowledge and constructive knowledge."
      },
      {
        "attribution": "Justice Alito",
        "citations": [
          {
            "document_hash": "e74248e54e324e3e277d6c53f7cca2f9cc6f0323c36fbe4a45dabd10cebfd55d",
            "evidence_ids": [
              "ev-e74248e54e32-0001-0002"
            ],
            "pages": {
              "end": 26,
              "start": 26
            }
          }
        ],
        "text": "According to Justice Alito, justice Alito remarked that the distinction between actual and constructive knowledge might be meaningless."
      },
      {
        "attribution": "Justice Breyer",
        "citations": [
          {
            "document_hash": "e74248e54e324e3e277d6c53f7cca2f9cc6f0323c36fbe4a45dabd10cebfd55d",
            "evidence_ids": [
              "ev-e74248e54e32-0002-0000"
            ],
            "pages": {
              "end": 47,
              "start": 47
            }
          }
        ],
        "text": "Justice Breyer sought clarification on the phrasing of the statute\u2019s start point, asking whether it begins when a reasonable person would have found sufficient facts."
      }
    ],
