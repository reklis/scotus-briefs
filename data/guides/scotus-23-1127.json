  "background_and_question": {
    "claims": [
      {
        "attribution": "Todd Heath",
        "citations": [
          {
            "document_hash": "f1f6ead7d2d391deed0c9b7e893994a22b1b3b2ca28d2183d927e78b9854ec13",
