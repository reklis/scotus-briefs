            "evidence_ids": [
              "ev-3bedd2172453-0001-0003"
            ],
            "pages": {
              "end": 26,
              "start": 26
            }
          }
        ],
        "text": "The parties dispute whether corporate form should be ignored in determining employee status, with the petitioner arguing the directors are not employees and the respondent asserting the corporate entity is a separate legal person."
      }
