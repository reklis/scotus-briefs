  "oral_argument": {
    "claims": [
      {
        "attribution": "Chief Justice Roberts",
        "citations": [
          {
            "document_hash": "5a454a7240b1e92b0b9c192aeda39608cd4d257c92d7d01dfc46867ae8e19239",
            "evidence_ids": [
              "ev-5a454a7240b1-0000-0005"
            ],
            "pages": {
              "end": 8,
              "start": 8
            }
          }
        ],
        "text": "Chief Justice Roberts asked whether the statutory language is unambiguous regarding the phrase \u201cstatutory penalties.\u201d"
      },
      {
        "attribution": "Chief Justice Roberts",
        "citations": [
          {
            "document_hash": "5a454a7240b1e92b0b9c192aeda39608cd4d257c92d7d01dfc46867ae8e19239",
            "evidence_ids": [
              "ev-5a454a7240b1-0000-0006"
            ],
            "pages": {
              "end": 9,
              "start": 9
            }
          }
        ],
        "text": "Chief Justice Roberts asked about the practical need to apply the First Step Act to subsection (c) given the retroactive sentencing guidelines."
      },
      {
        "attribution": "Justice Thomas",
        "citations": [
          {
            "document_hash": "5a454a7240b1e92b0b9c192aeda39608cd4d257c92d7d01dfc46867ae8e19239",
            "evidence_ids": [
              "ev-5a454a7240b1-0000-0007"
            ],
            "pages": {
              "end": 10,
              "start": 10
            }
          }
        ],
        "text": "Justice Thomas asked whether the statutory penalty for the petitioner was modified by the Fair Sentencing Act."
      },
      {
        "attribution": "Justice Alito",
        "citations": [
          {
            "document_hash": "5a454a7240b1e92b0b9c192aeda39608cd4d257c92d7d01dfc46867ae8e19239",
            "evidence_ids": [
              "ev-5a454a7240b1-0000-0008"
            ],
            "pages": {
              "end": 16,
              "start": 16
            }
          }
        ],
        "text": "Justice Alito asked whether the clause \u201cstatutory penalties for which were modified by Section\u202f2 or\u202f3\u201d modifies the violation or the statute itself."
      },
      {
        "attribution": "Justice Kagan",
        "citations": [
          {
            "document_hash": "5a454a7240b1e92b0b9c192aeda39608cd4d257c92d7d01dfc46867ae8e19239",
            "evidence_ids": [
              "ev-5a454a7240b1-0001-0000"
            ],
            "pages": {
              "end": 24,
              "start": 24
            }
          }
        ],
        "text": "Justice Kagan asked whether Congress would have wanted lower\u2011level offenders to miss out on the benefit of the statute."
      },
      {
        "attribution": "Justice Breyer",
        "citations": [
          {
            "document_hash": "5a454a7240b1e92b0b9c192aeda39608cd4d257c92d7d01dfc46867ae8e19239",
            "evidence_ids": [
              "ev-5a454a7240b1-0003-0000"
            ],
            "pages": {
              "end": 66,
              "start": 66
            }
          }
        ],
        "text": "Justice Breyer asked why the government argued the position it took."
      },
      {
        "attribution": "Justice Sotomayor",
        "citations": [
          {
            "document_hash": "5a454a7240b1e92b0b9c192aeda39608cd4d257c92d7d01dfc46867ae8e19239",
            "evidence_ids": [
