  "overview": {
    "claims": [
      {
        "attribution": "Petitioner Terry",
        "citations": [
          {
            "document_hash": "94805387e04969a2d76b540582bbb3166bfe423879cc9f24af0f2eae3c16a195",
            "evidence_ids": [
              "ev-94805387e049-0000-0002"
            ],
            "pages": {
              "end": 2,
              "start": 2
            }
          }
        ],
        "text": "According to Petitioner Terry, petitioner Tarahrick Terry argues that he is eligible for a sentence reduction for his 2008 crack\u2011cocaine conviction."
      },
      {
        "attribution": "Justice Thomas",
        "citations": [
          {
            "document_hash": "94805387e04969a2d76b540582bbb3166bfe423879cc9f24af0f2eae3c16a195",
            "evidence_ids": [
              "ev-94805387e049-0001-0002"
            ],
            "pages": {
              "end": 14,
              "start": 14
            }
          }
        ],
        "text": "The Fair Sentencing Act of 2010 (Section\u202f2) increased the crack\u2011cocaine quantity thresholds, reducing the crack\u2011to\u2011powder ratio from 100\u2011to\u20111 to 18\u2011to\u20111."
      },
      {
        "attribution": "Justice Thomas",
        "citations": [
          {
            "document_hash": "94805387e04969a2d76b540582bbb3166bfe423879cc9f24af0f2eae3c16a195",
            "evidence_ids": [
              "ev-94805387e049-0001-0001"
            ],
            "pages": {
              "end": 14,
              "start": 14
            }
          }
        ],
        "text": "Under the 1986 law, crack\u2011cocaine sentences were about 50\u202f% longer than those for powder cocaine."
      },
      {
        "attribution": "Justice Thomas",
        "citations": [
          {
            "document_hash": "94805387e04969a2d76b540582bbb3166bfe423879cc9f24af0f2eae3c16a195",
            "evidence_ids": [
              "ev-94805387e049-0001-0007"
            ],
            "pages": {
              "end": 18,
              "start": 18
            }
          }
        ],
        "text": "The First Step Act provides for sentence reductions, with an average reduction of almost six years."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "94805387e04969a2d76b540582bbb3166bfe423879cc9f24af0f2eae3c16a195",
            "evidence_ids": [
              "ev-94805387e049-0000-0006"
            ],
            "pages": {
              "end": 6,
              "start": 6
            }
          }
        ],
        "text": "The District Court sentenced Terry to 188\u202fmonths, the bottom of the career\u2011offender guideline range."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "94805387e04969a2d76b540582bbb3166bfe423879cc9f24af0f2eae3c16a195",
            "evidence_ids": [
              "ev-94805387e049-0000-0001"
            ],
            "pages": {
              "end": 2,
              "start": 2
            }
          }
        ],
        "text": "The case was argued on May\u202f4,\u202f2021 and decided on June\u202f14,\u202f2021."
      }
    ],
