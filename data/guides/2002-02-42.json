              "ev-d87ef8ddee07-0000-0004"
            ],
            "pages": {
              "end": 18,
              "start": 18
            }
          }
        ],
        "text": "A Justice inquired whether the Court would ask to overrule Nevada v. Hall if footnote 24 lacks sufficient guidance for stable jurisprudence."
      },
      {
        "attribution": "Justice Kennedy",
        "citations": [
          {
            "document_hash": "d87ef8ddee07a499ff25f8ac131c741d1172673dfcd5f03509027b5a18ce0f5d",
            "evidence_ids": [
              "ev-d87ef8ddee07-0002-0000"
            ],
            "pages": {
              "end": 36,
              "start": 36
            }
          }
        ],
        "text": "According to Justice Kennedy, justice Kennedy questioned whether Nevada could sue California under a parens patriae theory if California officials acted pervasively in Nevada."
      }
