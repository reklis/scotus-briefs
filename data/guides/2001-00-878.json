                "ev-d5a4950198d9-0002-0009"
              ],
              "pages": {
                "end": 39,
                "start": 39
              }
            }
          ],
          "text": "According to Paul M. Smith, respondents allege that the Interstate Commerce Commission misinterpreted the interconnection agreements and that its order requiring reciprocal compensation violated the Telecommunications Act and applicable FCC rulings."
        },
        {
          "attribution": "Ms. McDowell",
          "citations": [
            {
              "document_hash": "d5a4950198d9dfe4bc27b4b1df24696f23ea57b60a95ddaec5f7cedb5a0692c0",
              "evidence_ids": [
