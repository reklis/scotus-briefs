              "start": 4
            }
          }
        ],
        "text": "Petitioners argue that Section\u202f14(e) does not confer any implied private right."
      },
      {
        "attribution": "Petitioners",
        "citations": [
          {
            "document_hash": "04b51750f422c8f96391e8a358f1d4ef6ba9d4278664c06e690160e5c109aa39",
            "evidence_ids": [
