          }
        ],
        "text": "Justice Ginsburg asked whether the case is analogous to the Westfall Act for federal employees."
      },
      {
        "attribution": "Justice Kagan",
        "citations": [
          {
            "document_hash": "f869b1b1e4b97621db3f42af5c77c3dfbb12cac2e2c2538b07dcd51e1be86fdf",
            "evidence_ids": [
