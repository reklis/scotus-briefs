              "end": 52,
              "start": 52
            }
          }
        ],
        "text": "According to Petitioner, illinois Attorney General Lisa Madigan sued Telemarketing Associates Inc. alleging that charitable solicitations were fraudulent because only a nominal amount of each donation actually reached the charitable purpose."
      },
      {
        "attribution": "Petitioner (Richard S. Huszagh)",
        "citations": [
          {
            "document_hash": "5dc8d619552069c29a1804baed87c00b4e13246086d0b11fa2d5aca8e0b96eed",
            "evidence_ids": [
              "ev-5dc8d6195520-0000-0001"
            ],
            "pages": {
              "end": 3,
              "start": 3
            }
          }
        ],
        "text": "According to Petitioner (Richard S. Huszagh), the dispute focuses on how much of the donated money actually goes to the charitable purpose versus how much is retained for fundraising costs."
      }
    ],
    "heading": "Overview",
    "status": "complete",
    "summary": null,
    "summary_citations": []
  },
  "party_positions": [
    {
      "claims": [
        {
          "attribution": "Petitioner (Richard S. Huszagh)",
          "citations": [
