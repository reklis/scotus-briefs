  "background_and_question": {
    "claims": [
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "0bf000520325677686b868e688dfc4ce2c8491957f18f46626522729608f9ed2",
            "evidence_ids": [
              "ev-0bf000520325-0000-0001"
            ],
            "pages": {
              "end": 3,
              "start": 3
            }
          }
        ],
        "text": "Postal inspectors applied for a warrant that described the premises and items to be seized, based on an affidavit that a child\u2011pornography videotape would be delivered to the respondent\u2019s house and that the warrant would not be executed until after delivery."
      },
      {
        "attribution": "Justice Souter",
        "citations": [
          {
            "document_hash": "0bf000520325677686b868e688dfc4ce2c8491957f18f46626522729608f9ed2",
            "evidence_ids": [
              "ev-0bf000520325-0000-0003"
            ],
            "pages": {
              "end": 4,
              "start": 4
            }
          }
        ],
        "text": "According to Justice Souter, the Court considered whether the Fourth Amendment requires a warrant to specify the time of execution, i.e., whether a valid warrant must contain an indication of the time within which it may be served or executed."
      }
    ],
