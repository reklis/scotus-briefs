                "ev-e18e66443d32-0002-0002"
              ],
              "pages": {
                "end": 36,
                "start": 36
              }
            }
          ],
          "text": "According to Mr. Bopp, requiring contributions to be made through a segregated fund imposes an unconstitutional burden on First Amendment political activity."
        },
        {
          "attribution": "Mr. Bopp",
          "citations": [
            {
              "document_hash": "e18e66443d322cb2752f03fb9160d5a4cb320a18dd631dddee13ae48b0d09aa1",
              "evidence_ids": [
                "ev-e18e66443d32-0002-0004"
              ],
              "pages": {
                "end": 37,
                "start": 37
              }
            }
          ],
          "text": "According to Mr. Bopp, pooling resources in an association serves valid associational interests distinct from individual contributions."
        },
        {
          "attribution": "Mr. Bopp",
          "citations": [
            {
              "document_hash": "e18e66443d322cb2752f03fb9160d5a4cb320a18dd631dddee13ae48b0d09aa1",
              "evidence_ids": [
                "ev-e18e66443d32-0002-0009"
              ],
              "pages": {
                "end": 39,
                "start": 39
              }
            }
          ],
          "text": "According to Mr. Bopp, amount limitations are not a total prohibition on contributions."
        },
        {
          "attribution": "Mr. Clement",
          "citations": [
            {
              "document_hash": "e18e66443d322cb2752f03fb9160d5a4cb320a18dd631dddee13ae48b0d09aa1",
              "evidence_ids": [
                "ev-e18e66443d32-0002-0013"
              ],
              "pages": {
                "end": 43,
                "start": 43
              }
            }
          ],
          "text": "According to Mr. Clement, the Court has not required a \u201cleast restrictive means\u201d analysis for contribution regulations, as shown in National Right to Work Committee and California Medical Association cases."
        },
        {
          "attribution": "Mr. Clement",
          "citations": [
            {
              "document_hash": "e18e66443d322cb2752f03fb9160d5a4cb320a18dd631dddee13ae48b0d09aa1",
              "evidence_ids": [
                "ev-e18e66443d32-0002-0014"
              ],
              "pages": {
                "end": 44,
                "start": 44
              }
            }
          ],
          "text": "According to Mr. Clement, segregated funds protect membership lists from disclosure requirements that could otherwise expose association members."
        }
