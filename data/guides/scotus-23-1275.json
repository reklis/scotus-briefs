{
  "background_and_question": {
    "claims": [
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "1d34a3b4a43cc3a02ee71c033327e3d8e3f94ea90e18bf1026df244ea2dbbcb8",
            "evidence_ids": [
              "ev-1d34a3b4a43c-0000-0000"
            ],
            "pages": {
              "end": 2,
              "start": 2
            }
          }
        ],
        "text": "Congress created Medicaid in 1965 to subsidize state health\u2011care for families and individuals whose income and resources are insufficient to meet the costs of necessary medical services."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "1d34a3b4a43cc3a02ee71c033327e3d8e3f94ea90e18bf1026df244ea2dbbcb8",
            "evidence_ids": [
              "ev-1d34a3b4a43c-0002-0000"
            ],
            "pages": {
              "end": 30,
              "start": 30
            }
          }
        ],
        "text": "The Court considered whether the Medicaid free\u2011choice\u2011of\u2011provider provision at \u00a71396a(a)(23)(A) creates an individual right that can be enforced through a \u00a71983 action."
      }
    ],
    "heading": "Background and Question",
    "status": "complete",
    "summary": null,
    "summary_citations": []
  },
  "case_id": "scotus-23-1275",
  "decision": {
    "claims": [
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "1d34a3b4a43cc3a02ee71c033327e3d8e3f94ea90e18bf1026df244ea2dbbcb8",
            "evidence_ids": [
              "ev-1d34a3b4a43c-0001-0002"
            ],
            "pages": {
              "end": 11,
              "start": 11
            }
          }
        ],
        "text": "The Court granted the State\u2019s petition, vacated the Fourth Circuit\u2019s decision, and remanded the case for further proceedings."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "1d34a3b4a43cc3a02ee71c033327e3d8e3f94ea90e18bf1026df244ea2dbbcb8",
            "evidence_ids": [
              "ev-1d34a3b4a43c-0002-0000"
            ],
            "pages": {
              "end": 30,
              "start": 30
            }
          }
        ],
        "text": "The Court held that \u00a71396a(a)(23)(A) does not create an individual right enforceable under \u00a71983."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "1d34a3b4a43cc3a02ee71c033327e3d8e3f94ea90e18bf1026df244ea2dbbcb8",
            "evidence_ids": [
              "ev-1d34a3b4a43c-0001-0005"
            ],
            "pages": {
              "end": 13,
              "start": 13
            }
          }
        ],
        "text": "The majority reiterated that \u00a71983 suits are permissible only when a federal spending\u2011power statute \u201cclearly\u201d and \u201cunambiguously\u201d confers an individual right in \u201ctypical\u201d cases."
      },
      {
        "attribution": "Justice Thomas",
        "citations": [
          {
            "document_hash": "1d34a3b4a43cc3a02ee71c033327e3d8e3f94ea90e18bf1026df244ea2dbbcb8",
            "evidence_ids": [
              "ev-1d34a3b4a43c-0003-0001"
            ],
            "pages": {
              "end": 31,
              "start": 31
            }
          }
        ],
        "text": "Justice Thomas filed a concurrence emphasizing the scope of \u00a71983 for individuals whose constitutional rights have been deprived by state officials."
      },
      {
        "attribution": "Justice Jackson",
        "citations": [
          {
            "document_hash": "1d34a3b4a43cc3a02ee71c033327e3d8e3f94ea90e18bf1026df244ea2dbbcb8",
            "evidence_ids": [
              "ev-1d34a3b4a43c-0005-0000"
            ],
            "pages": {
              "end": 52,
              "start": 52
            }
          }
        ],
        "text": "Justice Jackson dissented, arguing that the Medicaid free\u2011choice\u2011of\u2011provider provision does confer an individual right and should be enforceable under \u00a71983."
      }
    ],
