              "ev-3637675ef23b-0000-0001"
            ],
            "pages": {
              "end": 5,
              "start": 5
            }
          }
        ],
        "text": "According to Vincent Levy, vincent Levy referenced the RJR\u202fNabisco decision that private plaintiffs may sue under civil RICO for treble damages if they suffer a domestic injury."
      },
      {
        "attribution": "Justice Thomas",
        "citations": [
          {
            "document_hash": "3637675ef23b2e24cbefffc084a0828ec4d83fd773ff20e5a24ec20d9c4d46db",
            "evidence_ids": [
              "ev-3637675ef23b-0000-0003"
            ],
            "pages": {
              "end": 7,
              "start": 7
            }
          }
        ],
        "text": "Justice Thomas asked how the party would treat real property under the domicile\u2011based approach."
      },
      {
        "attribution": "Justice Kagan",
        "citations": [
          {
            "document_hash": "3637675ef23b2e24cbefffc084a0828ec4d83fd773ff20e5a24ec20d9c4d46db",
            "evidence_ids": [
              "ev-3637675ef23b-0002-0002"
            ],
            "pages": {
              "end": 56,
              "start": 56
            }
          }
        ],
        "text": "According to Justice Kagan, justice Kagan questioned whether the argument relied more on precedent than statutory text."
      },
      {
        "attribution": "Justice Alito",
        "citations": [
          {
            "document_hash": "3637675ef23b2e24cbefffc084a0828ec4d83fd773ff20e5a24ec20d9c4d46db",
