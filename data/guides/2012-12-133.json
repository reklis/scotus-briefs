                "ev-6c9ca02ab896-0000-0004"
              ],
              "pages": {
                "end": 4,
                "start": 4
              }
            }
          ],
          "text": "According to Michael Kellogg, arbitrators should be free to devise efficient, cost\u2011effective procedures for handling claims, including sharing expert and attorney costs among parties."
        },
        {
          "attribution": "Plaintiffs",
          "citations": [
            {
              "document_hash": "6c9ca02ab89619ee4d04422844bbf2a100a82dda982232d048d801cba5a7355a",
              "evidence_ids": [
