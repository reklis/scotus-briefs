              "end": 3,
              "start": 3
            }
          }
        ],
        "text": "According to United States (Petitioner), customs officials have historically had the power to open containers and conduct thorough searches without a warrant, probable cause, or particularized suspicion."
      },
      {
        "attribution": "Government",
        "citations": [
          {
            "document_hash": "de105645df7a296c5f38b16ea82f0b0436d409d5157040d7fef6e8e5b9e30bcc",
