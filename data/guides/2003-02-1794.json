            ],
            "pages": {
              "end": 44,
              "start": 44
            }
          }
        ],
        "text": "Justice asked, \u201cThey can't open it.\u201d"
      },
      {
        "attribution": "Justice Kennedy",
        "citations": [
          {
            "document_hash": "de105645df7a296c5f38b16ea82f0b0436d409d5157040d7fef6e8e5b9e30bcc",
