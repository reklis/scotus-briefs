              "ev-de105645df7a-0001-0002"
            ],
            "pages": {
              "end": 24,
              "start": 24
            }
          }
        ],
        "text": "The government argues that it can search property without suspicion and use whatever force is reasonably necessary."
      },
      {
        "attribution": "MS. BLATT",
        "citations": [
          {
            "document_hash": "de105645df7a296c5f38b16ea82f0b0436d409d5157040d7fef6e8e5b9e30bcc",
            "evidence_ids": [
              "ev-de105645df7a-0001-0001"
            ],
            "pages": {
              "end": 23,
              "start": 23
            }
          }
        ],
        "text": "Approximately 25\u202f% of drug seizures are hidden in vehicle gas tanks, giving customs an essential interest in detecting and deterring such contraband."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "de105645df7a296c5f38b16ea82f0b0436d409d5157040d7fef6e8e5b9e30bcc",
            "evidence_ids": [
              "ev-de105645df7a-0000-0004"
            ],
            "pages": {
              "end": 12,
              "start": 12
            }
          }
        ],
        "text": "Customs may be liable for up to $1,000 under the Small Claims Act for certain actions."
      }
