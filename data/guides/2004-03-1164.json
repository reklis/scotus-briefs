              "ev-0fa29d4a03ae-0002-0000"
            ],
            "pages": {
              "end": 39,
              "start": 39
            }
          }
        ],
        "text": "Justice Breyer asked whether the program\u2019s primary aim is commercial advertising."
      },
      {
        "attribution": "Justice Souter",
        "citations": [
          {
            "document_hash": "0fa29d4a03ae175b8b37eae634f9972c67b102818af27c8ca90f593c29782374",
