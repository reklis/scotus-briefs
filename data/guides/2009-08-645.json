        ],
        "text": "According to Petitioner, the Hague Convention requires the return of a child abducted in violation of a custody right."
      },
      {
        "attribution": "Petitioner",
        "citations": [
          {
            "document_hash": "e4252ced49a05b56390cc2b42a2bb33e56610eb9dd24a84438800219a8c87a17",
            "evidence_ids": [
