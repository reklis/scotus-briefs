  "overview": {
    "claims": [
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "23827beee1980fe872d62c58a9711ba484bbdc73a9aeb0d7c2bcba8cc591c5bc",
            "evidence_ids": [
              "ev-23827beee198-0000-0001"
            ],
            "pages": {
              "end": 2,
              "start": 2
            }
          }
        ],
        "text": "Oracle America, Inc. owns a copyright in Java SE, a computer platform that uses the Java programming language."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "23827beee1980fe872d62c58a9711ba484bbdc73a9aeb0d7c2bcba8cc591c5bc",
            "evidence_ids": [
              "ev-23827beee198-0000-0002",
              "ev-23827beee198-0000-0003"
            ],
            "pages": {
              "end": 2,
              "start": 2
            }
          }
        ],
        "text": "In 2005 Google acquired Android and copied roughly 11,500 lines of code from the Java SE program."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "23827beee1980fe872d62c58a9711ba484bbdc73a9aeb0d7c2bcba8cc591c5bc",
            "evidence_ids": [
              "ev-23827beee198-0000-0004",
              "ev-23827beee198-0000-0005"
            ],
            "pages": {
              "end": 2,
              "start": 2
            }
          }
        ],
        "text": "The Federal Circuit initially held that the copied lines were copyrightable, but on appeal it reversed that decision."
      },
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "23827beee1980fe872d62c58a9711ba484bbdc73a9aeb0d7c2bcba8cc591c5bc",
            "evidence_ids": [
              "ev-23827beee198-0003-0000"
            ],
            "pages": {
              "end": 41,
              "start": 41
            }
          }
        ],
        "text": "The Supreme Court held that Google\u2019s copying of the Java API declaring code was a fair use of that material as a matter of law."
      }
    ],
    "heading": "Overview",
    "status": "complete",
    "summary": null,
    "summary_citations": []
  },
  "party_positions": [
    {
      "claims": [
        {
          "attribution": "Google LLC",
          "citations": [
            {
              "document_hash": "0ff88de86221334e2bd06763dfe399841d3b9d1e943b330f2e969f33c28d1b36",
              "evidence_ids": [
                "ev-0ff88de86221-0000-0000"
              ],
              "pages": {
                "end": 4,
                "start": 4
              }
            }
          ],
          "text": "According to Google LLC, google argues that the merger doctrine resolves the copyrightability question because Oracle\u2019s copyright covers only the expression, not the functional idea."
        },
        {
          "attribution": "Google LLC",
          "citations": [
            {
              "document_hash": "0ff88de86221334e2bd06763dfe399841d3b9d1e943b330f2e969f33c28d1b36",
              "evidence_ids": [
                "ev-0ff88de86221-0000-0002"
              ],
              "pages": {
                "end": 5,
                "start": 5
              }
            }
          ],
          "text": "According to Google LLC, google contends that reusing software interfaces is essential for modern interoperable software and that such reuse is a fair use."
        },
        {
          "attribution": "Google",
          "citations": [
            {
              "document_hash": "0ff88de86221334e2bd06763dfe399841d3b9d1e943b330f2e969f33c28d1b36",
              "evidence_ids": [
                "ev-0ff88de86221-0002-0001"
              ],
              "pages": {
                "end": 46,
                "start": 46
              }
            }
          ],
          "text": "Google maintains that its copying was transformative because the code was used to study and understand how the machine worked, not to create a competing product."
        },
        {
          "attribution": "Google",
          "citations": [
            {
              "document_hash": "0ff88de86221334e2bd06763dfe399841d3b9d1e943b330f2e969f33c28d1b36",
              "evidence_ids": [
                "ev-0ff88de86221-0002-0002"
              ],
              "pages": {
                "end": 54,
                "start": 54
              }
            },
            {
              "document_hash": "0ff88de86221334e2bd06763dfe399841d3b9d1e943b330f2e969f33c28d1b36",
              "evidence_ids": [
                "ev-0ff88de86221-0002-0003"
              ],
              "pages": {
                "end": 55,
                "start": 55
              }
            }
          ],
          "text": "Google argues that the declaring code of an API is not copyrightable, only the implementing code is."
        },
        {
          "attribution": "Google",
          "citations": [
            {
              "document_hash": "0ff88de86221334e2bd06763dfe399841d3b9d1e943b330f2e969f33c28d1b36",
              "evidence_ids": [
                "ev-0ff88de86221-0002-0003"
              ],
              "pages": {
                "end": 55,
                "start": 55
              }
            }
          ],
          "text": "According to Google, google points out that multiple circuit courts have held that the distinction between declaring code and implementing code is recognized and that declaring code is not protected."
        }
      ],
      "heading": "Google LLC",
      "status": "complete",
      "summary": null,
      "summary_citations": []
    },
    {
      "claims": [
        {
          "attribution": "Oracle",
          "citations": [
            {
              "document_hash": "0ff88de86221334e2bd06763dfe399841d3b9d1e943b330f2e969f33c28d1b36",
              "evidence_ids": [
                "ev-0ff88de86221-0001-0000"
              ],
              "pages": {
                "end": 23,
                "start": 23
              }
            }
          ],
          "text": "According to Oracle, oracle asserts that Section\u202f102(b) bars copyright protection for the functionality of computer code, including methods of operation."
        },
        {
          "attribution": "Oracle",
          "citations": [
            {
              "document_hash": "0ff88de86221334e2bd06763dfe399841d3b9d1e943b330f2e969f33c28d1b36",
              "evidence_ids": [
                "ev-0ff88de86221-0001-0002"
              ],
              "pages": {
                "end": 30,
                "start": 30
              }
            }
          ],
          "text": "Oracle argues that the method of operation of Java SE cannot be copyrighted."
        }
      ],
      "heading": "Oracle America, Inc.",
      "status": "complete",
      "summary": null,
      "summary_citations": []
    }
