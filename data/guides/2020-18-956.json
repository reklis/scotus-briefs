  "why_it_matters": {
    "claims": [
      {
        "attribution": "Justice Breyer",
        "citations": [
          {
            "document_hash": "23827beee1980fe872d62c58a9711ba484bbdc73a9aeb0d7c2bcba8cc591c5bc",
            "evidence_ids": [
              "ev-23827beee198-0002-0001"
            ],
            "pages": {
              "end": 23,
              "start": 23
            }
          }
        ],
        "text": "The decision clarifies that fair use can be a crucial factor in determining the lawful scope of computer program copyright, especially for technologies that blend expressive and functional elements."
      },
      {
        "attribution": "United States",
        "citations": [
          {
            "document_hash": "0ff88de86221334e2bd06763dfe399841d3b9d1e943b330f2e969f33c28d1b36",
            "evidence_ids": [
              "ev-0ff88de86221-0003-0000",
              "ev-0ff88de86221-0003-0001"
            ],
            "pages": {
              "end": 66,
              "start": 65
            }
          }
        ],
        "text": "According to United States, amicus briefs emphasized that without copyright protection for software, developers would lack incentives to create new code."
      },
      {
        "attribution": "Justice Thomas",
        "citations": [
          {
            "document_hash": "23827beee1980fe872d62c58a9711ba484bbdc73a9aeb0d7c2bcba8cc591c5bc",
            "evidence_ids": [
              "ev-23827beee198-0005-0001"
            ],
            "pages": {
              "end": 57,
              "start": 57
            }
          }
        ],
        "text": "The dissent highlighted the massive economic impact of Google\u2019s copying, noting billions of dollars in revenue and market disruption for Oracle."
      }
    ],
