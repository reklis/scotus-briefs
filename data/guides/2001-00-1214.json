  "overview": {
    "claims": [
      {
        "attribution": "Attorney General of Alabama",
        "citations": [
          {
            "document_hash": "49918ef02235c971f16d047a0160ba3ff8612c12baed5f2954b21acc49b242dd",
            "evidence_ids": [
              "ev-49918ef02235-0000-0001"
            ],
            "pages": {
              "end": 3,
              "start": 3
            }
          }
        ],
        "text": "According to Attorney General of Alabama, the Supreme Court of Alabama held that a probated or suspended sentence, which frees a defendant, nevertheless triggers a right to court\u2011appointed, taxpayer\u2011funded counsel."
      },
      {
        "attribution": "Mr. Mills",
        "citations": [
          {
            "document_hash": "49918ef02235c971f16d047a0160ba3ff8612c12baed5f2954b21acc49b242dd",
            "evidence_ids": [
              "ev-49918ef02235-0001-0002"
            ],
            "pages": {
              "end": 31,
              "start": 31
            }
          },
          {
            "document_hash": "49918ef02235c971f16d047a0160ba3ff8612c12baed5f2954b21acc49b242dd",
            "evidence_ids": [
              "ev-49918ef02235-0002-0000"
            ],
            "pages": {
              "end": 36,
              "start": 36
            }
          }
        ],
        "text": "The case raises the question whether the Sixth Amendment guarantees counsel when a suspended sentence could lead to jail, as required by the Argersinger rule."
      }
    ],
    "heading": "Overview",
    "status": "complete",
    "summary": null,
    "summary_citations": []
  },
  "party_positions": [
    {
      "claims": [
        {
          "attribution": "Attorney General of Alabama",
          "citations": [
            {
              "document_hash": "49918ef02235c971f16d047a0160ba3ff8612c12baed5f2954b21acc49b242dd",
              "evidence_ids": [
                "ev-49918ef02235-0000-0001"
              ],
              "pages": {
                "end": 3,
                "start": 3
              }
            }
          ],
          "text": "According to Attorney General of Alabama, the Supreme Court of Alabama distorted this well\u2011established rule and held that a probated or suspended sentence, which actually liberates a defendant to return to free society, nevertheless triggers a right to court\u2011appointed and taxpayer\u2011funded counsel."
        }
      ],
      "heading": "Alabama (Petitioner)",
      "status": "complete",
      "summary": null,
      "summary_citations": []
    },
    {
      "claims": [
        {
          "attribution": "Mr. Mills",
          "citations": [
            {
              "document_hash": "49918ef02235c971f16d047a0160ba3ff8612c12baed5f2954b21acc49b242dd",
              "evidence_ids": [
                "ev-49918ef02235-0001-0002"
              ],
              "pages": {
                "end": 31,
                "start": 31
              }
            }
          ],
          "text": "According to Mr. Mills, Argersinger requires a trial judge to assure a defendant who proceeds without a lawyer that he will not receive a jail sentence; otherwise the assurance is false."
        },
        {
          "attribution": "Mr. Duke",
          "citations": [
            {
              "document_hash": "49918ef02235c971f16d047a0160ba3ff8612c12baed5f2954b21acc49b242dd",
              "evidence_ids": [
                "ev-49918ef02235-0002-0001"
              ],
              "pages": {
                "end": 38,
                "start": 38
              }
            }
          ],
          "text": "According to Mr. Duke, because the authorized sentence in this case was one year, it guaranteed the defendant a right to a jury trial under the Sixth Amendment, making this a criminal prosecution."
        }
      ],
      "heading": "LeReed Shelton (Respondent)",
      "status": "complete",
      "summary": null,
      "summary_citations": []
    }
