  "background_and_question": {
    "claims": [
      {
        "attribution": "David G. Baker",
        "citations": [
          {
            "document_hash": "ce955b9fad26888a2ac6e9171848b1fb0dcfbea960e87bdc253150290addb283",
            "evidence_ids": [
              "ev-ce955b9fad26-0000-0002"
            ],
            "pages": {
              "end": 4,
              "start": 4
            }
          }
        ],
        "text": "According to David G. Baker, petitioner Robert Louis Marrama argues that his new case is different from the prior one, that his debt exceeds the limit under section 109(e), but he still seeks relief in Chapter 13."
      },
      {
        "attribution": "Justice Ginsburg",
        "citations": [
          {
            "document_hash": "ce955b9fad26888a2ac6e9171848b1fb0dcfbea960e87bdc253150290addb283",
            "evidence_ids": [
              "ev-ce955b9fad26-0000-0003"
            ],
            "pages": {
              "end": 4,
              "start": 4
            }
          }
        ],
        "text": "Justice Ginsburg asked whether Marrama incurred additional debts between the two proceedings."
      },
      {
        "attribution": "Justice Scalia",
        "citations": [
          {
            "document_hash": "ce955b9fad26888a2ac6e9171848b1fb0dcfbea960e87bdc253150290addb283",
            "evidence_ids": [
              "ev-ce955b9fad26-0000-0004"
            ],
            "pages": {
              "end": 7,
              "start": 7
            }
          }
        ],
        "text": "According to Justice Scalia, justice Scalia questioned whether Marrama\u2019s request to file under Chapter 13 is impossible because he is ineligible due to debt limits, suggesting the case may be moot."
      },
      {
        "attribution": "Justice Alito",
        "citations": [
          {
            "document_hash": "ce955b9fad26888a2ac6e9171848b1fb0dcfbea960e87bdc253150290addb283",
            "evidence_ids": [
              "ev-ce955b9fad26-0001-0000"
            ],
            "pages": {
              "end": 21,
              "start": 21
            }
          }
        ],
        "text": "Justice Alito asked if the court could hold a hearing during the period in question."
      },
      {
        "attribution": "Justice Ginsburg",
        "citations": [
          {
            "document_hash": "ce955b9fad26888a2ac6e9171848b1fb0dcfbea960e87bdc253150290addb283",
            "evidence_ids": [
              "ev-ce955b9fad26-0001-0001"
            ],
            "pages": {
              "end": 21,
              "start": 21
            }
          }
        ],
        "text": "Justice Ginsburg asked if there was a hearing on the motion to convert."
      },
      {
        "attribution": "Justice Souter",
        "citations": [
          {
            "document_hash": "ce955b9fad26888a2ac6e9171848b1fb0dcfbea960e87bdc253150290addb283",
            "evidence_ids": [
              "ev-ce955b9fad26-0001-0002"
            ],
            "pages": {
              "end": 22,
              "start": 22
            }
          }
        ],
        "text": "Justice Souter asked whether the case depends on whether an evidentiary hearing was held."
      },
      {
        "attribution": "Justice Stevens",
        "citations": [
          {
            "document_hash": "ce955b9fad26888a2ac6e9171848b1fb0dcfbea960e87bdc253150290addb283",
            "evidence_ids": [
              "ev-ce955b9fad26-0001-0004"
            ],
            "pages": {
              "end": 25,
              "start": 25
            }
          }
        ],
        "text": "Justice Stevens asked if Marrama would be eligible for Chapter 13 when his unsecured debts exceed a certain amount."
      },
      {
        "attribution": "Justice Stevens",
        "citations": [
          {
            "document_hash": "ce955b9fad26888a2ac6e9171848b1fb0dcfbea960e87bdc253150290addb283",
            "evidence_ids": [
              "ev-ce955b9fad26-0001-0005"
            ],
            "pages": {
              "end": 26,
              "start": 25
            }
          }
        ],
        "text": "Justice Stevens asked what the bankruptcy judge should do if, at the time of the conversion motion, the record shows debts exceeding that amount."
      }
    ],
