              "end": 6,
              "start": 6
            }
          }
        ],
        "text": "Justice Gorsuch asked if antitrust law primarily concerns deadweight loss."
      },
      {
        "attribution": "Justice Kennedy",
        "citations": [
          {
            "document_hash": "ed895508f34fd62a5a8e3ec666fa26d46100593e95e30c3df99d2489fa055209",
