              "start": 25
            }
          }
        ],
        "text": "According to Justice Breyer, justice Breyer made an analogy comparing the case to \u201cnuts and bolts.\u201d"
      },
      {
        "attribution": "Justice Gorsuch",
        "citations": [
          {
            "document_hash": "ed895508f34fd62a5a8e3ec666fa26d46100593e95e30c3df99d2489fa055209",
            "evidence_ids": [
