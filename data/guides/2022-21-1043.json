  "case_id": "2022-21-1043",
  "decision": {
    "claims": [
      {
        "attribution": "Court",
        "citations": [
          {
            "document_hash": "372f0e4580b4a13e6a3ad449a750ba0ed78a79045fe07b17ef24ac032161be13",
            "evidence_ids": [
              "ev-372f0e4580b4-0001-0003"
            ],
            "pages": {
              "end": 18,
              "start": 18
            }
          }
        ],
        "text": "The Court held that \u00a7\u00a7\u202f1114(1)(a) and\u202f1125(a)(1) are not extraterritorial; the \u201cuse in commerce\u201d requirement provides the dividing line between foreign and domestic applications of the Lanham Act."
      },
      {
        "attribution": "Justice Jackson",
        "citations": [
          {
            "document_hash": "372f0e4580b4a13e6a3ad449a750ba0ed78a79045fe07b17ef24ac032161be13",
            "evidence_ids": [
              "ev-372f0e4580b4-0001-0004"
            ],
            "pages": {
              "end": 19,
              "start": 19
            }
          }
        ],
        "text": "Justice Jackson, in a concurring opinion, agreed that the \u201cuse in commerce\u201d test defines the boundary between foreign and domestic applications."
      }
    ],
