    {
      "claims": [
        {
          "attribution": "Mr. Garre",
          "citations": [
            {
              "document_hash": "706ba4f37f269665c9e74acf6da06678d4465f5d2ef4d17c9c78216a8a880266",
              "evidence_ids": [
                "ev-706ba4f37f26-0001-0006"
              ],
              "pages": {
                "end": 31,
                "start": 31
              }
            }
          ],
          "text": "According to Mr. Garre, the respondent maintains that the traditional rule places the burden of proof on the party who initiates the proceeding\u2014the parent."
        },
        {
          "attribution": "Mr. Garre",
          "citations": [
            {
              "document_hash": "706ba4f37f269665c9e74acf6da06678d4465f5d2ef4d17c9c78216a8a880266",
              "evidence_ids": [
                "ev-706ba4f37f26-0002-0001"
              ],
              "pages": {
                "end": 44,
                "start": 44
              }
            }
          ],
          "text": "According to Mr. Garre, shifting the burden to school districts would erode the trust Congress placed in state and local educational officials."
        },
        {
          "attribution": "United States",
          "citations": [
            {
              "document_hash": "706ba4f37f269665c9e74acf6da06678d4465f5d2ef4d17c9c78216a8a880266",
              "evidence_ids": [
                "ev-706ba4f37f26-0002-0002"
              ],
              "pages": {
                "end": 46,
                "start": 46
              }
            }
          ],
          "text": "The United States argues that several features of the IDEA confirm that Congress intended the traditional allocation of the burden of proof to apply to administrative hearings."
        },
        {
          "attribution": "Government",
          "citations": [
            {
              "document_hash": "706ba4f37f269665c9e74acf6da06678d4465f5d2ef4d17c9c78216a8a880266",
              "evidence_ids": [
