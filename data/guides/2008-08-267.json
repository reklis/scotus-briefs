            }
          },
          {
            "document_hash": "dfee6d22d9f1f5e78b067ccae1581c7d525e8182b53deb9937581ec94685df13",
            "evidence_ids": [
              "ev-dfee6d22d9f1-0000-0006"
            ],
            "pages": {
              "end": 16,
              "start": 16
            }
          }
        ],
        "text": "According to Petitioner, the case also asks whether a civilian, such as the respondent, may invoke the military court system for such relief."
      }
