# Static production has no runtime environment: GitHub Pages serves validated files.
# These values are for fixture preview or the protected ephemeral build job only.
RAGCHEW_SCOTUS_CONFIG_PATH=config/scotus.yaml
RAGCHEW_PRODUCT_MODE=scotus_legal_briefs
RAGCHEW_SOURCE_USER_AGENT=SCOTUS-Legal-Briefs/0.1 contact=https://github.com/reklis/scotus-briefs

# The protected self-hosted build reaches only this loopback Ollama OpenAI-compatible
# endpoint. It accepts no credentials, query string, remote host, or non-/v1 path.
RAGCHEW_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# One-time legacy migration tools still accept RAGCHEW_DATABASE_DSN explicitly in the
# operator shell. PostgreSQL, MinIO, reader credentials, and receiver tokens are not
# part of the Pages production path and are intentionally absent here.
