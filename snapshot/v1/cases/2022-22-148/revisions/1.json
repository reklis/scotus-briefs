nscript — file page 95, lines 27-25","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2022/22-148_d523.pdf","page_label":"file page 95, lines 27-25"}],"maturity":"post_opinion","official_detail_url":"https://www.supremecourt.gov/oral_arguments/argument_transcript/2022","official_disposition_urls":["https://www.supremecourt.gov/opinions/22pdf/599us1r35_3f14.pdf"],"official_docket_url":"https://www.supremecourt.gov/docket/docketfiles/html/public/22-148.html","primary_docket":"22-148","revisions":[{"correction_note":"Rewritten to the concise citizen-facing editorial standard.","created_at":"2026-08-30T16:27:45.517679Z","maturity":"post_opinion","revision_number":1}],"schema_version":"1.0","sections":[{"heading":"What this case is about","paragraphs":["Jack Daniel's wants the court to uphold the lower court's finding of trademark infringement. VIP Products wants the court to protect its parody as free speech."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 4, lines 23-23","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2022/22-148_d523.pdf","page_label":"file page 4, lines 23-23"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 43, lines 15-29","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2022/22-148_d523.pdf","page_label":"file page 43, lines 15-29"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 59, lines 43-9","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2022/22-148_d523.pdf","page_label":"file page 59, lines 43-9"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 67, lines 19-27","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2022/22-148_d523.pdf","page_label":"file page 67, lines 19-27"},{"evidence_type":"Transcript","label":"Official Supr