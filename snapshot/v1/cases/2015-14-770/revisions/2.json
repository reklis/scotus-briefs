vision_number":2}],"schema_version":"1.1","sections":[{"heading":"What this case is about","paragraphs":["The case involves a statute that targets a specific pending lawsuit. The core dispute is whether Congress can limit a law's effect to one case."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 26, lines 16-4","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2015/14-770_m64o.pdf","page_label":"file page 26, lines 16-4"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 3, lines 20-32","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2015/14-770_m64o.pdf","page_label":"file page 3, lines 20-32"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 44, lines 40-4","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2015/14-770_m64o.pdf","page_label":"file page 44, lines 40-4"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 55, lines 4-46","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2015/14-770_m64o.pdf","page_label":"file page 55, lines 4-46"}]},{"heading":"How the case got here","paragraphs":["The Supreme Court heard oral argument in this case on January 13, 2016."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 3, lines 8-18","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2015/14-770_m64o.pdf","page_label":"file page 3, lines 8-18"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 56, lines 40-48","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2015/14-770_m64o.pdf","page_label":"file page 56, lines 40-48"}]},{"heading":"What each side wants","paragraphs":["the sides that brought the case want the Court to strike down the statute as un