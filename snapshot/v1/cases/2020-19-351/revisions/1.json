":[],"official_docket_url":"https://www.supremecourt.gov/docket/docketfiles/html/public/19-351.html","primary_docket":"19-351","revisions":[{"correction_note":"Rewritten to the concise citizen-facing editorial standard.","created_at":"2026-08-30T17:20:39.848481Z","maturity":"official_transcript","revision_number":1}],"schema_version":"1.0","sections":[{"heading":"What this case is about","paragraphs":["This case tests the scope of the Foreign Sovereign Immunities Act. It asks if the statute covers property rights taken in violation of international law during the Nazi era."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 28, lines 21-29","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2020/19-351_d0fi.pdf","page_label":"file page 28, lines 21-29"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 4, lines 23-19","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2020/19-351_d0fi.pdf","page_label":"file page 4, lines 23-19"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 49, lines 55-49","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2020/19-351_d0fi.pdf","page_label":"file page 49, lines 55-49"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 66, lines 31-45","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2020/19-351_d0fi.pdf","page_label":"file page 66, lines 31-45"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 86, lines 49-53","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2020/19-351_d0fi.pdf","page_label":"file page 86, lines 49-53"}]},{"heading":"How the case got here","paragraphs":["The Supreme Court heard oral argument in this case on December 7, 2020."],"sources":[{"evidence_type":"Transcript","label"