gument_transcripts/2023/22-800_6j36.pdf","page_label":"file page 130, lines 45-7"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 140, lines 39-47","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-800_6j36.pdf","page_label":"file page 140, lines 39-47"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 4, lines 23-33","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-800_6j36.pdf","page_label":"file page 4, lines 23-33"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 56, lines 31-7","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-800_6j36.pdf","page_label":"file page 56, lines 31-7"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 65, lines 49-27","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-800_6j36.pdf","page_label":"file page 65, lines 49-27"}]},{"heading":"How the case got here","paragraphs":["The Supreme Court heard oral argument in this case on December 5, 2023."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 139, lines 27-35","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-800_6j36.pdf","page_label":"file page 139, lines 27-35"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 4, lines 11-21","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-800_6j36.pdf","page_label":"file page 4, lines 11-21"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 70, lines 17-47","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-800_6j36.pdf","page_label":"file page 70, lines 17-47"}]},{"heading":"What each side wants","paragraphs":["Th