transcripts/2024/24-394_3135.pdf","page_label":"file page 5, lines 25-9"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 66, lines 55-53","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2024/24-394_3135.pdf","page_label":"file page 66, lines 55-53"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 89, lines 33-45","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2024/24-394_3135.pdf","page_label":"file page 89, lines 33-45"}]},{"heading":"How the case got here","paragraphs":["The Supreme Court heard oral argument in this case on April 30, 2025."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 142, lines 19-37","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2024/24-394_3135.pdf","page_label":"file page 142, lines 19-37"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 5, lines 11-23","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2024/24-394_3135.pdf","page_label":"file page 5, lines 11-23"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 69, lines 43-47","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2024/24-394_3135.pdf","page_label":"file page 69, lines 43-47"}]},{"heading":"What each side wants","paragraphs":["the sides that brought the case want the Court to strike down the funding exclusion.","the opposing sides want the Court to uphold the funding exclusion."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 130, lines 53-51","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2024/24-394_3135.pdf","page_label":"file page 130, lines 53-51"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 149,