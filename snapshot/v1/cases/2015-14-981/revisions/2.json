015","official_disposition_urls":[],"official_docket_url":"https://www.supremecourt.gov/docket/docketfiles/html/public/14-981.html","primary_docket":"14-981","revisions":[{"correction_note":"Rewritten to the concise citizen-facing editorial standard.","created_at":"2026-08-30T19:09:59.582202Z","maturity":"official_transcript","revision_number":1},{"correction_note":"Migrated to the dated official Court activity contract without model use.","created_at":"2026-09-05T03:22:24Z","maturity":"official_transcript","revision_number":2}],"schema_version":"1.1","sections":[{"heading":"What this case is about","paragraphs":["The case tests whether a public university may consider race as one factor in admissions. the side that brought the case argues this practice violates the Constitution. the opposing side argues it serves a compelling state interest."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 3, lines 30-20","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2015/14-981_onjq.pdf","page_label":"file page 3, lines 30-20"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 38, lines 34-32","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2015/14-981_onjq.pdf","page_label":"file page 38, lines 34-32"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 58, lines 4-18","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2015/14-981_onjq.pdf","page_label":"file page 58, lines 4-18"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 69, lines 8-4","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2015/14-981_onjq.pdf","page_label":"file page 69, lines 8-4"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 89, lines 8-28","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2015/14-981_onjq.pdf","page_label":"file page 89, lines 8-28"}]},{"heading":"How the case got here","paragraphs":["The Supreme Court heard oral argument in this case on December 9, 2015."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 3, lines 8-28","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2015/14-981_onjq.pdf","page_label":"file page 3, lines 8-28"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 72, lines 34-44","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2015/14-981_onjq.pdf","page_label":"file page 72, lines 34-44"}]},{"heading":"What each side wants","paragraphs":["Fisher wants the Court to strike down the university's race-conscious admissions policy.","The university wants the Court to uphold its holistic review process."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 3, lines 30-20","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2015/14-981_onjq.pdf","page_label":"file page 3, lines 30-20"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 38, lines 34-32","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2015/14-981_onjq.pdf","page_label":"file page 38, lines 34-32"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 58, lines 4-18","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2015/14-981_onjq.pdf","page_label":"file page 58, lines 4-18"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 69, lines 8-4","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2015/14-981_onjq.pdf","page_label":"file page 69, lines 8-4"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — 