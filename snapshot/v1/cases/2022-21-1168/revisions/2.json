premecourt.gov/oral_arguments/argument_transcripts/2022/21-1168_k6g1.pdf","page_label":"file page 54, lines 55-35"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 67, lines 7-15","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2022/21-1168_k6g1.pdf","page_label":"file page 67, lines 7-15"}]},{"heading":"What each side says","paragraphs":["Mallory argues that historical state laws established consent-by-registration as a valid legal practice.","Norfolk Southern argues that registration does not imply consent to jurisdiction for unrelated claims."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 102, lines 13-15","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2022/21-1168_k6g1.pdf","page_label":"file page 102, lines 13-15"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 123, lines 11-19","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2022/21-1168_k6g1.pdf","page_label":"file page 123, lines 11-19"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 4, lines 23-17","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2022/21-1168_k6g1.pdf","page_label":"file page 4, lines 23-17"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 54, lines 55-35","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2022/21-1168_k6g1.pdf","page_label":"file page 54, lines 55-35"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 67, lines 7-15","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2022/21-1168_k6g1.pdf","page_label":"file page 67, lines 7-15"}]},{"heading":"What the justices asked","paragraphs":["Justice Kagan asked if registration papers explicitly state consent to 