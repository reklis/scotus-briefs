arguments/argument_transcripts/2022/21-1168_k6g1.pdf","page_label":"file page 8, lines 43-23"}]}],"caption":"Mallory v. Norfolk Southern Railway Co.","case_history":[{"changed_at":"2026-08-29T20:06:17.161690Z","explanation":"An official oral-argument transcript was verified.","status":"argued"},{"changed_at":"2026-08-29T20:06:17.168551Z","explanation":"An official oral-argument transcript was verified.","status":"argued"},{"changed_at":"2026-08-29T23:57:17.748967Z","explanation":"An official Court opinion was verified.","status":"decided"}],"case_status":"decided","dek":"A railroad company challenges a Pennsylvania law that treats business registration as consent to local court jurisdiction.","dek_sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 102, lines 13-15","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2022/21-1168_k6g1.pdf","page_label":"file page 102, lines 13-15"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 123, lines 11-19","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2022/21-1168_k6g1.pdf","page_label":"file page 123, lines 11-19"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 4, lines 23-17","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2022/21-1168_k6g1.pdf","page_label":"file page 4, lines 23-17"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 54, lines 55-35","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2022/21-1168_k6g1.pdf","page_label":"file page 54, lines 55-35"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 67, lines 7-15","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2022/21-1168_k6g1.pdf","page_label":"file page 67, lines 7-15"}],"dispositions":[],"latest_court_document_d