nscripts/2014/14-46_1b5p.pdf","page_label":"file page 8, lines 47-1"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 86, lines 41-5","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2014/14-46_1b5p.pdf","page_label":"file page 86, lines 41-5"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 9, lines 27-13","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2014/14-46_1b5p.pdf","page_label":"file page 9, lines 27-13"}]}],"caption":"Michigan v. EPA","case_history":[{"changed_at":"2026-08-29T20:06:23.134985Z","explanation":"An official oral-argument transcript was verified.","status":"argued"},{"changed_at":"2026-08-29T20:06:23.156319Z","explanation":"An official oral-argument transcript was verified.","status":"argued"}],"case_status":"argued","dek":"States argue the EPA ignored costs. The agency says health risks drive the rule.","dek_sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 28, lines 17-45","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2014/14-46_1b5p.pdf","page_label":"file page 28, lines 17-45"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 4, lines 21-45","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2014/14-46_1b5p.pdf","page_label":"file page 4, lines 21-45"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 41, lines 17-11","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2014/14-46_1b5p.pdf","page_label":"file page 41, lines 17-11"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 55, lines 29-35","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2014/14-46_1b5p.pdf","page_label":"file page 55, lines 29-35"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 70, lines 49-23","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2014/14-46_1b5p.pdf","page_label":"file page 70, lines 49-23"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 86, lines 41-5","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2014/14-46_1b5p.pdf","page_label":"file page 86, lines 41-5"}],"maturity":"official_transcript","official_detail_url":"https://www.supremecourt.gov/oral_arguments/argument_transcript/2014","official_disposition_urls":[],"official_docket_url":"https://www.supremecourt.gov/docket/docketfiles/html/public/14-46.html","primary_docket":"14-46","revisions":[{"correction_note":"Rewritten to the concise citizen-facing editorial standard.","created_at":"2026-08-31T20:06:19.002050Z","maturity":"official_transcript","revision_number":1}],"schema_version":"1.0","sections":[{"heading":"What this case is about","paragraphs":["The dispute centers on whether the EPA must consider economic costs when setting pollution limits for power plants. Michigan and other states claim the agency ignored these costs. The EPA argues that public health concerns alone justify the regulation."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 28, lines 17-45","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2014/14-46_1b5p.pdf","page_label":"file page 28, lines 17-45"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 4, lines 21-45","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2014/14-46_1b5p.pdf","page_label":"file page 4, lines 21-45"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 41, lines 17-11","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2014/14-46_1b5p.pdf","page_label":"file page 41, lines 17-11"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 55, lines 29-35","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2014/14-46_1b5p.pdf","page_label":"file page 55, lines 29-35"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 70, lines 49-23","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2014/14-46_1b5p.pdf","page_label":"file page 70, lines 49-23"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 86, lines 41-5","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2014/14-46_1b5p.pdf","page_label":"file page 86, lines 41-5"}]},{"heading":"How the case got here","paragraphs":["The Supreme Court heard oral argument in this case on March 25, 2015."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 4, lines 7-19","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2014/14-46_1b5p.pdf","page_label":"file page 4, lines 7-19"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 79, lines 13-21","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2014/14-46_1b5p.pdf","page_label":"file page 79, lines 13-21"}]},{"heading":"What each side wants","paragraphs":["Michigan and other states want the EPA to consider costs when setting pollution limits.","The EPA wants to rely solely on health risks to justify its pollution limits."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 28, lines 17-45","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2014/14-46_1b5p.pdf","page_label":"file page 28, lines 17-45"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 4, lines 21-45","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2014/14-46_1b5p.pdf","page_label":"file page 4, lines 21-45"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 41, lines 17-11","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2014/14-46_1b5p.pdf","page_label":"file page 41, lines 17-11"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 55, lines 29-35","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2014/14-46_1b5p.pdf","page_label":"file page 55, lines 29-35"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 70, lines 49-23","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2014/14-46_1b5p.pdf","page_label":"file page 70, lines 49-23"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 86, lines 41-5","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2014/14-46_1b5p.pdf","page_label":"file page 86, lines 41-5"}]},{"heading":"What each side says","paragraphs":["Michigan argues the law requires the EPA to weigh both necessity and appropriateness, including costs.","The EPA argues the law focuses on health concerns and does not mention costs."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 28, lines 17-45","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2014/14-46_1b5p.pdf","page_label":"file page 28, lines 17-45"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 4, lines 21-45","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2014/14-46_1b5p.pdf","page_label":"file page 4, lines 21-45"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 41, lines 17-11","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2014/14-46_1b5p.pdf","page_label":"file page 41, lines 17-11"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 55, lines 29-35","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2014/14-46_1b5p.pdf","page_label":"file page 55, lines 29-35"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 70, lines 49-23","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2014/14-46_1b5p.pdf","page_label":"file page 70, lines 49-23"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 86, lines 41-5","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2014/14-46_1b5p.pdf","page_label":"file page 86, lines 41-5"}]},{"heading":"What the justices asked","paragraphs":["Justice Kagan asked if the EPA ignored technology availability.","Justice Scalia asked for a citation to the lower court opinion."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 10, lines 29-43","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2014/14-46_1b5p.pdf","page_label":"file page 10, lines 29-43"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 10, lines 45-7","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2014/14-46_1b5p.pdf","page_label":"file page 10, lines 45-7"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 4, lines 47-15","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2014/14-46_1b5p.pdf","page_label":"file page 4, lines 47-15"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 5, lines 31-37","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2014/14-46_1b5p.pdf","page_label":"file page 5, lines 31-37"},{"evidence_type":"Tr