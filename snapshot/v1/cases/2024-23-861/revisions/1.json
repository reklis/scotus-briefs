ublic/23-861.html","primary_docket":"23-861","revisions":[{"correction_note":"Rewritten to the concise citizen-facing editorial standard.","created_at":"2026-08-30T15:57:12.556346Z","maturity":"post_opinion","revision_number":1}],"schema_version":"1.0","sections":[{"heading":"What this case is about","paragraphs":["Feliciano seeks differential pay for his active duty service. The Department of Transportation denies the claim. The case tests the statutory scope of the word during."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 4, lines 23-25","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2024/23-861_7k8b.pdf","page_label":"file page 4, lines 23-25"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 42, lines 49-7","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2024/23-861_7k8b.pdf","page_label":"file page 42, lines 49-7"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 66, lines 37-39","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2024/23-861_7k8b.pdf","page_label":"file page 66, lines 37-39"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 78, lines 47-11","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2024/23-861_7k8b.pdf","page_label":"file page 78, lines 47-11"}]},{"heading":"How the case got here","paragraphs":["The Supreme Court heard oral argument in this case on December 9, 2024."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 4, lines 11-21","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2024/23-861_7k8b.pdf","page_label":"file page 4, lines 11-21"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 70, lines 31-35","official_url":"https://www.suprem