nt_transcripts/2023/22-529_f64i.pdf","page_label":"file page 84, lines 43-49"}]},{"heading":"How the case got here","paragraphs":["The Supreme Court heard oral argument in this case on February 27, 2024."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 5, lines 11-21","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-529_f64i.pdf","page_label":"file page 5, lines 11-21"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 71, lines 23-45","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-529_f64i.pdf","page_label":"file page 71, lines 23-45"}]},{"heading":"What each side wants","paragraphs":["the sides that brought the case want the Court to apply a practical effect test to determine preemption.","the opposing sides want the Court to apply a test that examines the significance of the interference."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 124, lines 17-29","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-529_f64i.pdf","page_label":"file page 124, lines 17-29"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 48, lines 13-1","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-529_f64i.pdf","page_label":"file page 48, lines 13-1"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 5, lines 23-17","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-529_f64i.pdf","page_label":"file page 5, lines 23-17"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 67, lines 7-11","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-529_f64i.pdf","page_label":"file page 67, lines 7-11"},{"evidence_type":"Transcript","lab