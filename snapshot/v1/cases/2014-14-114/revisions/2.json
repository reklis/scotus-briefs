n_number":1},{"correction_note":"Migrated to the dated official Court activity contract without model use.","created_at":"2026-09-05T03:22:24Z","maturity":"official_transcript","revision_number":2}],"schema_version":"1.1","sections":[{"heading":"What this case is about","paragraphs":["The case tests whether the Affordable Care Act grants tax credits to people buying insurance on federal exchanges. the sides that brought the case claim the text restricts credits to state exchanges. The government claims the text allows credits on any exchange."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 3, lines 18-26","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2014/14-114_1bo2.pdf","page_label":"file page 3, lines 18-26"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 39, lines 14-48","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2014/14-114_1bo2.pdf","page_label":"file page 39, lines 14-48"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 56, lines 8-28","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2014/14-114_1bo2.pdf","page_label":"file page 56, lines 8-28"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 77, lines 36-28","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2014/14-114_1bo2.pdf","page_label":"file page 77, lines 36-28"}]},{"heading":"How the case got here","paragraphs":["The Supreme Court heard oral argument in this case on March 4, 2015."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 3, lines 8-16","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2014/14-114_1bo2.pdf","page_label":"file page 3, lines 8-16"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — fi