ublic/22-915.html","primary_docket":"22-915","revisions":[{"correction_note":"Rewritten to the concise citizen-facing editorial standard.","created_at":"2026-08-30T16:18:55.544484Z","maturity":"post_opinion","revision_number":1},{"correction_note":"Migrated to the dated official Court activity contract without model use.","created_at":"2026-09-05T03:22:24Z","maturity":"post_opinion","revision_number":2}],"schema_version":"1.1","sections":[{"heading":"What this case is about","paragraphs":["The case tests the scope of the Second Amendment. It asks if the right to bear arms extends to individuals convicted of domestic violence."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 102, lines 13-35","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-915_6khn.pdf","page_label":"file page 102, lines 13-35"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 4, lines 23-29","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-915_6khn.pdf","page_label":"file page 4, lines 23-29"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 58, lines 37-47","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-915_6khn.pdf","page_label":"file page 58, lines 37-47"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 65, lines 9-53","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-915_6khn.pdf","page_label":"file page 65, lines 9-53"}]},{"heading":"How the case got here","paragraphs":["The Supreme Court heard oral argument in this case on November 7, 2023."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 4, lines 11-21","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-915_6khn.pdf","page_label":"file page 4,