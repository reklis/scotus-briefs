":"https://www.supremecourt.gov/docket/docketfiles/html/public/20-1034.html","primary_docket":"20-1034","revisions":[{"correction_note":"Rewritten to the concise citizen-facing editorial standard.","created_at":"2026-08-30T16:50:08.539662Z","maturity":"post_opinion","revision_number":1}],"schema_version":"1.0","sections":[{"heading":"What this case is about","paragraphs":["The Hague Convention governs international child abductions. A grave risk exception allows courts to deny return. The dispute centers on whether courts must evaluate safety measures before applying this exception."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 30, lines 37-31","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-1034_i425.pdf","page_label":"file page 30, lines 37-31"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 5, lines 31-23","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-1034_i425.pdf","page_label":"file page 5, lines 31-23"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 58, lines 51-11","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-1034_i425.pdf","page_label":"file page 58, lines 51-11"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 66, lines 7-47","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-1034_i425.pdf","page_label":"file page 66, lines 7-47"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 81, lines 53-43","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-1034_i425.pdf","page_label":"file page 81, lines 53-43"}]},{"heading":"How the case got here","paragraphs":["The Supreme Court heard oral argument in this case on March 22, 2022."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 5, lines 11-29","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-1034_i425.pdf","page_label":"file page 5, lines 11-29"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 72, lines 53-19","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-1034_i425.pdf","page_label":"file page 72, lines 53-19"}]},{"heading":"What each side wants","paragraphs":["the sides that brought the case want a final denial of the child's return.","the opposing sides want courts to evaluate safety measures first."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 30, lines 37-31","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-1034_i425.pdf","page_label":"file page 30, lines 37-31"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 5, lines 31-23","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-1034_i425.pdf","page_label":"file page 5, lines 31-23"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 58, lines 51-11","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-1034_i425.pdf","page_label":"file page 58, lines 51-11"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 66, lines 7-47","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-1034_i425.pdf","page_label":"file page 66, lines 7-47"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 81, lines 53-43","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-1034_i425.pdf","page_label":"file page 81, lines 53-43"}]},{"heading":"What each side says","paragraphs":["the sides that brought the case argue the convention allows denial once grave risk exists.","the opposing sides argue the convention requires considering reasonable safety measures."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 30, lines 37-31","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-1034_i425.pdf","page_label":"file page 30, lines 37-31"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 5, lines 31-23","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-1034_i425.pdf","page_label":"file page 5, lines 31-23"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 58, lines 51-11","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-1034_i425.pdf","page_label":"file page 58, lines 51-11"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 66, lines 7-47","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-1034_i425.pdf","page_label":"file page 66, lines 7-47"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 81, lines 53-43","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-1034_i425.pdf","page_label":"file page 81, lines 53-43"}]},{"heading":"What the justices asked","paragraphs":["Chief Justice Roberts asked if a simple grave risk case allows immediate denial.","Justice Breyer asked if the term ameliorative measures was the correct legal standard."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 10, lines 31-53","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-1034_i425.pdf","page_label":"file page 10, lines 31-53"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 11, lines 51-51","official_url":"https