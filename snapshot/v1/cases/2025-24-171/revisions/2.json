s://www.supremecourt.gov/oral_arguments/argument_transcripts/2025/24-171_ap6c.pdf","page_label":"file page 9, lines 21-37"}]}],"caption":"Cox Communications v. Sony Music Entertainment","case_history":[{"changed_at":"2026-08-29T20:06:13.963729Z","explanation":"An official oral-argument transcript was verified.","status":"argued"},{"changed_at":"2026-08-29T20:06:13.994053Z","explanation":"An official oral-argument transcript was verified.","status":"argued"},{"changed_at":"2026-08-29T23:55:37.403265Z","explanation":"An official Court opinion was verified.","status":"decided"}],"case_status":"decided","dek":"Sony Music Entertainment argues Cox should be liable for its users' copyright infringement. Cox says it provides basic internet infrastructure and should not bear that responsibility.","dek_sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 104, lines 33-39","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2025/24-171_ap6c.pdf","page_label":"file page 104, lines 33-39"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 4, lines 23-47","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2025/24-171_ap6c.pdf","page_label":"file page 4, lines 23-47"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 42, lines 21-11","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2025/24-171_ap6c.pdf","page_label":"file page 42, lines 21-11"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 62, lines 47-43","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2025/24-171_ap6c.pdf","page_label":"file page 62, lines 47-43"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 67, lines 55-43","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2025/24-171_ap6c.pdf","page_label":"file page 67, lines 55-43"}],"dispositions":[],"latest_court_document_date":"2025-12-01T00:00:00Z","maturity":"post_opinion","official_detail_url":"https://www.supremecourt.gov/oral_arguments/argument_transcript/2025","official_disposition_urls":["https://www.supremecourt.gov/opinions/25pdf/607us2r22_k4lo.pdf"],"official_docket_url":"https://www.supremecourt.gov/docket/docketfiles/html/public/24-171.html","primary_docket":"24-171","revisions":[{"correction_note":"Rewritten to the concise citizen-facing editorial standard.","created_at":"2026-08-30T14:21:25.381619Z","maturity":"post_opinion","revision_number":1},{"correction_note":"Migrated to the dated official Court activity contract without model use.","created_at":"2026-09-05T03:22:24Z","maturity":"post_opinion","revision_number":2}],"schema_version":"1.1","sections":[{"heading":"What this case is about","paragraphs":["Sony Music Entertainment says Cox Communications should be liable for its users' copyright infringement. Cox says it merely provides basic internet infrastructure. Cox argues no tort or copyright theory supports holding it responsible."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 104, lines 33-39","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2025/24-171_ap6c.pdf","page_label":"file page 104, lines 33-39"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 4, lines 23-47","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2025/24-171_ap6c.pdf","page_label":"file page 4, lines 23-47"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 42, lines 21-11","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2025/24-171_ap6c.pdf","page_label":"file page 42, lines 21-11"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 62, lines 47-43","o