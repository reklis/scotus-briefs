_transcripts/2023/22-277_5924.pdf","page_label":"file page 156, lines 37-19"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 5, lines 23-13","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-277_5924.pdf","page_label":"file page 5, lines 23-13"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 63, lines 45-39","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-277_5924.pdf","page_label":"file page 63, lines 45-39"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 65, lines 47-29","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-277_5924.pdf","page_label":"file page 65, lines 47-29"}]},{"heading":"What each side says","paragraphs":["Florida argues the law prevents platforms from discriminating against users.","NetChoice argues the law compels speech and discriminates by viewpoint."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 115, lines 19-37","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-277_5924.pdf","page_label":"file page 115, lines 19-37"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 129, lines 29-33","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-277_5924.pdf","page_label":"file page 129, lines 29-33"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 156, lines 37-19","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-277_5924.pdf","page_label":"file page 156, lines 37-19"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 5, lines 23-13","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-277_5924.pdf","page_label":"file