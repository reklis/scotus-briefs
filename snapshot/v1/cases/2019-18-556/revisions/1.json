_arguments/argument_transcripts/2019/18-556_5ifl.pdf","page_label":"file page 4, lines 10-20"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 74, lines 28-46","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2019/18-556_5ifl.pdf","page_label":"file page 74, lines 28-46"}]},{"heading":"What each side wants","paragraphs":["Kansas wants a rule that suspended owners are presumed drivers.","The driver wants the Court to reject that automatic presumption."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 24, lines 22-50","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2019/18-556_5ifl.pdf","page_label":"file page 24, lines 22-50"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 36, lines 10-12","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2019/18-556_5ifl.pdf","page_label":"file page 36, lines 10-12"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 4, lines 22-14","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2019/18-556_5ifl.pdf","page_label":"file page 4, lines 22-14"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 71, lines 14-20","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2019/18-556_5ifl.pdf","page_label":"file page 71, lines 14-20"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 78, lines 24-42","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2019/18-556_5ifl.pdf","page_label":"file page 78, lines 24-42"}]},{"heading":"What each side says","paragraphs":["Kansas claims common sense supports the inference of reasonable suspicion.","The driver claims the record lacks facts to support the inference."],"sources":[{"evidence_type":"Trans