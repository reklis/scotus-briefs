gument_transcripts/2021/20-1312_j5fl.pdf","page_label":"file page 8, lines 21-43"}]}],"caption":"Becerra v. Empire Health Foundation","case_history":[{"changed_at":"2026-08-29T20:06:17.872899Z","explanation":"An official oral-argument transcript was verified.","status":"argued"},{"changed_at":"2026-08-29T20:06:17.901371Z","explanation":"An official oral-argument transcript was verified.","status":"argued"},{"changed_at":"2026-08-29T23:57:08.946338Z","explanation":"An official Court opinion was verified.","status":"decided"}],"case_status":"decided","dek":"Hospitals argue the law counts all indigent patients. The government argues it counts only those with active benefits.","dek_sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 35, lines 45-53","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-1312_j5fl.pdf","page_label":"file page 35, lines 45-53"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 4, lines 23-11","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-1312_j5fl.pdf","page_label":"file page 4, lines 23-11"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 63, lines 13-39","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-1312_j5fl.pdf","page_label":"file page 63, lines 13-39"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 73, lines 53-29","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-1312_j5fl.pdf","page_label":"file page 73, lines 53-29"}],"maturity":"post_opinion","official_detail_url":"https://www.supremecourt.gov/oral_arguments/argument_transcript/2021","official_disposition_urls":["https://www.supremecourt.gov/opinions/21pdf/597us1r59_i4dk.pdf"],"official_docket_url":"https://www.supremecourt.gov/docket/docketfiles/html/public/20-1312.html","primary_docket":"20-1312","revisions":[{"correction_note":"Rewritten to the concise citizen-facing editorial standard.","created_at":"2026-08-31T19:12:23.544550Z","maturity":"post_opinion","revision_number":1}],"schema_version":"1.0","sections":[{"heading":"What this case is about","paragraphs":["This case tests how to read a Medicare payment formula. The formula counts patient days for people entitled to benefits. The dispute centers on who qualifies as entitled."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 35, lines 45-53","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-1312_j5fl.pdf","page_label":"file page 35, lines 45-53"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 4, lines 23-11","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-1312_j5fl.pdf","page_label":"file page 4, lines 23-11"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 63, lines 13-39","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-1312_j5fl.pdf","page_label":"file page 63, lines 13-39"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 73, lines 53-29","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-1312_j5fl.pdf","page_label":"file page 73, lines 53-29"}]},{"heading":"How the case got here","paragraphs":["The Supreme Court heard oral argument in this case on November 29, 2021."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 4, lines 11-21","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-1312_j5fl.pdf","page_label":"file page 4, lines 11-21"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 77, lines 31-33","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-1312_j5fl.pdf","page_label":"file page 77, lines 31-33"}]},{"heading":"What each side wants","paragraphs":["Hospitals want the law to count all indigent patient days.","The government wants the law to count only days with active benefits."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 35, lines 45-53","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-1312_j5fl.pdf","page_label":"file page 35, lines 45-53"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 4, lines 23-11","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-1312_j5fl.pdf","page_label":"file page 4, lines 23-11"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 63, lines 13-39","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-1312_j5fl.pdf","page_label":"file page 63, lines 13-39"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 73, lines 53-29","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-1312_j5fl.pdf","page_label":"file page 73, lines 53-29"}]},{"heading":"What each side says","paragraphs":["Hospitals argue the statute plainly requires counting all indigent patients.","The government argues the phrase for such days limits the count."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 35, lines 45-53","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-1312_j5fl.pdf","page_label":"file page 35, lines 45-53"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 4, lines 23-11","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-1312_j5fl.pdf","page_label":"file page 4, lines 23-11"},{"evidence