oral_arguments/argument_transcripts/2021/20-804_d18f.pdf","page_label":"file page 61, lines 49-21"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 84, lines 43-21","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-804_d18f.pdf","page_label":"file page 84, lines 43-21"}]},{"heading":"What each side says","paragraphs":["The board argues censure is a protected expression of government opinion.","The member argues censure is a punishment for his speech."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 25, lines 47-7","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-804_d18f.pdf","page_label":"file page 25, lines 47-7"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 4, lines 31-35","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-804_d18f.pdf","page_label":"file page 4, lines 31-35"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 43, lines 33-39","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-804_d18f.pdf","page_label":"file page 43, lines 33-39"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 61, lines 49-21","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-804_d18f.pdf","page_label":"file page 61, lines 49-21"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 84, lines 43-21","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-804_d18f.pdf","page_label":"file page 84, lines 43-21"}]},{"heading":"What the justices asked","paragraphs":["Justice Thomas asked if legislative bodies have limits on expelling members.","Justice Sotomayor asked how ineligibility for travel reimbursement differs from jail."],"sou