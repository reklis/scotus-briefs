ines 9-15","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2024/23-753_5i26.pdf","page_label":"file page 9, lines 9-15"}]}],"caption":"San Francisco v. EPA","case_history":[{"changed_at":"2026-08-29T20:06:36.111355Z","explanation":"An official oral-argument transcript was verified.","status":"argued"},{"changed_at":"2026-08-29T20:06:36.114397Z","explanation":"An official oral-argument transcript was verified.","status":"argued"},{"changed_at":"2026-08-29T23:57:58.268302Z","explanation":"An official Court opinion was verified.","status":"decided"}],"case_status":"decided","dek":"San Francisco argues EPA must set specific discharge limits. EPA argues it can set flexible goals.","dek_sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 103, lines 51-35","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2024/23-753_5i26.pdf","page_label":"file page 103, lines 51-35"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 4, lines 25-9","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2024/23-753_5i26.pdf","page_label":"file page 4, lines 25-9"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 52, lines 11-11","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2024/23-753_5i26.pdf","page_label":"file page 52, lines 11-11"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 69, lines 27-25","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2024/23-753_5i26.pdf","page_label":"file page 69, lines 27-25"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 82, lines 55-13","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2024/23-753_5i26.pdf","page_label":"file page 82, lines 55-13"}],"maturity":"post_opinion","official_detail_url":"https://www.supremecourt.gov/oral_arguments/argument_transcript/2024","official_disposition_urls":["https://www.supremecourt.gov/opinions/24pdf/604us1r16_o759.pdf"],"official_docket_url":"https://www.supremecourt.gov/docket/docketfiles/html/public/23-753.html","primary_docket":"23-753","revisions":[{"correction_note":"Rewritten to the concise citizen-facing editorial standard.","created_at":"2026-08-30T16:00:54.004337Z","maturity":"post_opinion","revision_number":1}],"schema_version":"1.0","sections":[{"heading":"What this case is about","paragraphs":["The dispute centers on how the Clean Water Act defines effluent limitations. San Francisco claims the law requires specific numeric limits. EPA claims the law allows flexible performance goals."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 103, lines 51-35","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2024/23-753_5i26.pdf","page_label":"file page 103, lines 51-35"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 4, lines 25-9","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2024/23-753_5i26.pdf","page_label":"file page 4, lines 25-9"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 52, lines 11-11","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2024/23-753_5i26.pdf","page_label":"file page 52, lines 11-11"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 69, lines 27-25","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2024/23-753_5i26.pdf","page_label":"file page 69, lines 27-25"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 82, lines 55-13","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2024/23-753_5i26.pdf","page_label":"file page 82, lines 55-13"}]},{"heading":"How the case got here","paragraphs":["The Supreme Court heard oral argument in this case on October 16, 2024."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 4, lines 11-23","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2024/23-753_5i26.pdf","page_label":"file page 4, lines 11-23"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 72, lines 31-47","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2024/23-753_5i26.pdf","page_label":"file page 72, lines 31-47"}]},{"heading":"What each side wants","paragraphs":["San Francisco wants specific, measurable discharge limits in its permits.","EPA wants to use flexible goals that allow dischargers to choose methods."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 103, lines 51-35","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2024/23-753_5i26.pdf","page_label":"file page 103, lines 51-35"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 4, lines 25-9","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2024/23-753_5i26.pdf","page_label":"file page 4, lines 25-9"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 52, lines 11-11","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2024/23-753_5i26.pdf","page_label":"file page 52, lines 11-11"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 69, lines 27-25","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2024/23-753_5i26.pdf","page_label":"file page 69, lines 27-25"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 82, lines 55-13","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2024/23-753_5i26.pdf","page_label":"file page 82, lines 55-13"}]},{"heading":"What each side says","paragraphs":["San Francisco argues Section 301(b)(1)(C) mandates specific effluent limitations.","EPA argues the statute authorizes both specific limits and flexible goals."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 103, lines 51-35","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2024/23-753_5i26.pdf","page_label":"file page 103, lines 51-35"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 4, lines 25-9","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2024/23-753_5i26.pdf","page_label":"file page 4, lines 25-9"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 52, lines 11-11","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2024/23-753_5i26.pdf","page_label":"file page 52, lines 11-11"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 69, lines 27-25","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2024/23-753_5i26.pdf","page_label":"file page 69, lines 27-25"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 82, lines 55-13","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2024/23-753_5i26.pdf","page_label":"file page 82, lines 55-13"}]},{"heading":"What the justices asked","paragraphs":["Justice Kagan asked what the regulation actually does.","Justice Kagan questioned if the statute bans flexible approaches."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 10, lines 19-45","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2024/23-753_5i26.pdf","page_label":"file page 10, lines 19-45"},{"evidence_type":