{"accepted_at":"2026-08-30T16:00:54.004337Z","case":{"argument_date":"2024-10-16T00:00:00Z","arguments":[{"argument_date":"2024-10-16T00:00:00Z","heading":"What happened at the argument","official_detail_url":"https://www.supremecourt.gov/oral_arguments/argument_transcript/2024","official_transcript_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2024/23-753_5i26.pdf","paragraphs":["Ms. Steeley argued EPA must translate water quality goals into specific discharge limits.","Ms. Steeley stated the city needs clear limits to ensure compliance.","Mr. Liu argued the Court previously rejected San Francisco's narrow reading.","Mr. Liu stated the statutory text supports both specific and flexible limits."],"reargument":false,"sequence":1,"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 10, lines 19-45","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2024/23-753_5i26.pdf","page_label":"file page 10, lines 19-45"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 10, lines 49-7","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2024/23-753_5i26.pdf","page_label":"file page 10, lines 49-7"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 103, lines 51-35","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2024/23-753_5i26.pdf","page_label":"file page 103, lines 51-35"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 11, lines 15-29","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2024/23-753_5i26.pdf","page_label":"file page 11, lines 15-29"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 11, lines 43-25","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2024/23-753_5i26.pdf","page_label":"file page 11, lines