rguments/argument_transcripts/2020/19-511_l537.pdf","page_label":"file page 9, lines 37-49"}]}],"caption":"Facebook, Inc. v. Duguid","case_history":[{"changed_at":"2026-08-29T20:06:18.818835Z","explanation":"An official oral-argument transcript was verified.","status":"argued"},{"changed_at":"2026-08-29T20:06:18.842173Z","explanation":"An official oral-argument transcript was verified.","status":"argued"},{"changed_at":"2026-08-29T23:56:29.300508Z","explanation":"An official Court opinion was verified.","status":"decided"}],"case_status":"decided","dek":"Facebook argues the law targets only random number generators. Duguid argues the law covers any stored number system.","dek_sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 28, lines 33-45","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2020/19-511_l537.pdf","page_label":"file page 28, lines 33-45"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 4, lines 23-19","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2020/19-511_l537.pdf","page_label":"file page 4, lines 23-19"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 50, lines 29-13","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2020/19-511_l537.pdf","page_label":"file page 50, lines 29-13"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 67, lines 17-39","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2020/19-511_l537.pdf","page_label":"file page 67, lines 17-39"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 85, lines 41-55","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2020/19-511_l537.pdf","page_label":"file page 85, lines 41-55"}],"maturity":"post_opinion","official_detail_url":"https://www.supremecourt.gov/oral_arguments/argument_transcript/2020","official_disposition_urls":["https://www.supremecourt.gov/opinions/20pdf/592us2r23_1bn2.pdf"],"official_docket_url":"https://www.supremecourt.gov/docket/docketfiles/html/public/19-511.html","primary_docket":"19-511","revisions":[{"correction_note":"Rewritten to the concise citizen-facing editorial standard.","created_at":"2026-08-30T17:20:06.395989Z","maturity":"post_opinion","revision_number":1}],"schema_version":"1.0","sections":[{"heading":"What this case is about","paragraphs":["The case tests the scope of the Telephone Consumer Protection Act. Facebook seeks a narrow reading of the dialer definition. Duguid seeks a broad reading that covers stored numbers."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 28, lines 33-45","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2020/19-511_l537.pdf","page_label":"file page 28, lines 33-45"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 4, lines 23-19","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2020/19-511_l537.pdf","page_label":"file page 4, lines 23-19"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 50, lines 29-13","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2020/19-511_l537.pdf","page_label":"file page 50, lines 29-13"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 67, lines 17-39","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2020/19-511_l537.pdf","page_label":"file page 67, lines 17-39"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 85, lines 41-55","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2020/19-511_l537.pdf","page_label":"file page 85, lines 41-55"}]},{"heading":"How the case got here