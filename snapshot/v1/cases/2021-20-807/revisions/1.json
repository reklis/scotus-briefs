, lines 31-35","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-807_m64o.pdf","page_label":"file page 65, lines 31-35"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 69, lines 15-41","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-807_m64o.pdf","page_label":"file page 69, lines 15-41"}],"maturity":"post_opinion","official_detail_url":"https://www.supremecourt.gov/oral_arguments/argument_transcript/2021","official_disposition_urls":["https://www.supremecourt.gov/opinions/21pdf/596us1r28_6j36.pdf"],"official_docket_url":"https://www.supremecourt.gov/docket/docketfiles/html/public/20-807.html","primary_docket":"20-807","revisions":[{"correction_note":"Rewritten to the concise citizen-facing editorial standard.","created_at":"2026-08-30T16:49:36.826135Z","maturity":"post_opinion","revision_number":1}],"schema_version":"1.0","sections":[{"heading":"What this case is about","paragraphs":["This case tests the definition of in use for locomotives. the side that brought the case argues a parked engine remains in use. the opposing side argues a parked engine is not in use."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 103, lines 19-19","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-807_m64o.pdf","page_label":"file page 103, lines 19-19"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 103, lines 49-37","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-807_m64o.pdf","page_label":"file page 103, lines 49-37"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 39, lines 45-43","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-807_m64o.pdf","page_label":"file page 39, lines 45-43"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 4, lines 27-23","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-807_m64o.pdf","page_label":"file page 4, lines 27-23"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 65, lines 31-35","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-807_m64o.pdf","page_label":"file page 65, lines 31-35"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 69, lines 15-41","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-807_m64o.pdf","page_label":"file page 69, lines 15-41"}]},{"heading":"How the case got here","paragraphs":["The Supreme Court heard oral argument in this case on March 28, 2022."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 4, lines 11-25","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-807_m64o.pdf","page_label":"file page 4, lines 11-25"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 75, lines 31-11","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-807_m64o.pdf","page_label":"file page 75, lines 31-11"}]},{"heading":"What each side wants","paragraphs":["the side that brought the case wants the Court to hold that a parked locomotive is in use.","the opposing side wants the Court to hold that a parked locomotive is not in use."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 103, lines 19-19","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-807_m64o.pdf","page_label":"file page 103, lines 19-19"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 103, lines 49-37","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-807_m64o.pdf","page_label":"file page 103, lines 49-37"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 39, lines 45-43","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-807_m64o.pdf","page_label":"file page 39, lines 45-43"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 4, lines 27-23","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-807_m64o.pdf","page_label":"file page 4, lines 27-23"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 65, lines 31-35","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-807_m64o.pdf","page_label":"file page 65, lines 31-35"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 69, lines 15-41","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-807_m64o.pdf","page_label":"file page 69, lines 15-41"}]},{"heading":"What each side says","paragraphs":["the side that brought the case argues that a motionless locomotive serves functions that keep it in use.","the opposing side argues that a parked locomotive is not in use because it is not hauling goods."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 103, lines 19-19","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-807_m64o.pdf","page_label":"file page 103, lines 19-19"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 103, lines 49-37","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-807_m64o.pdf","page_label":"file page 103, lines 49-37"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 39, lines 45-43","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-807_m64o.pdf","page_label":"file page 39, lines 45-43"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 4, lines 27-23","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-807_m64o.pdf","page_label":"file page 4, lines 27-23"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 65, lines 31-35","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-807_m64o.pdf","page_label":"file page 65, lines 31-35"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 69, lines 15-41","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-807_m64o.pdf","page_label":"file page 69, lines 15-41"}]},{"heading":"What the justices asked","paragraphs":["Justice Kagan asked why the Court discusses the word use when the regulation does not use it.","Chief Justice Roberts asked if a car in a driveway is in use under similar logic."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 11, lines 27-39","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-807_m64o.pdf","page_label":"file page 11, lines 27-39"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 12, lines 31-51","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-807_m64o.pdf","page_label":"file page 12, lines 31-51"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 13, lines 51-53","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-807_m64o.pdf","page_label":"file page 13, lines 51-53"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 14, lines 37-49","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2021/20-807_m64o.pdf","page_label