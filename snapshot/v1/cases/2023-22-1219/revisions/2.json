 9-13","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-1219_4246.pdf","page_label":"file page 71, lines 9-13"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 72, lines 37-41","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-1219_4246.pdf","page_label":"file page 72, lines 37-41"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 73, lines 11-35","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-1219_4246.pdf","page_label":"file page 73, lines 11-35"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 73, lines 39-49","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-1219_4246.pdf","page_label":"file page 73, lines 39-49"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 76, lines 49-13","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-1219_4246.pdf","page_label":"file page 76, lines 49-13"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 8, lines 41-47","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-1219_4246.pdf","page_label":"file page 8, lines 41-47"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 8, lines 51-1","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-1219_4246.pdf","page_label":"file page 8, lines 51-1"}]}],"caption":"Relentless, Inc. v. Dept. of Commerce","case_history":[{"changed_at":"2026-08-29T20:06:15.986711Z","explanation":"An official oral-argument transcript was verified.","status":"argued"},{"changed_at":"2026-08-29T20:06:16.007384Z","explanation":"An official oral-argument transcript was verified.","status":"argued"},{"changed_at":"2026-08-29T20:06:16.019483Z","explanation":"An official oral-argument transcript was verified.","status":"argued"}],"case_status":"argued","dek":"Relentless argues Chevron deference violates the Constitution. The government defends the framework as essential to administrative law.","dek_sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 130, lines 9-37","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-1219_4246.pdf","page_label":"file page 130, lines 9-37"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 152, lines 31-45","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-1219_4246.pdf","page_label":"file page 152, lines 31-45"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 4, lines 23-23","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-1219_4246.pdf","page_label":"file page 4, lines 23-23"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 46, lines 17-19","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-1219_4246.pdf","page_label":"file page 46, lines 17-19"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 68, lines 9-35","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-1219_4246.pdf","page_label":"file page 68, lines 9-35"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 76, lines 49-13","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-1219_4246.pdf","page_label":"file page 76, lines 49-13"}],"dispositions":[],"latest_court_document_date":"2024-01-17T00:00:00Z","maturity":"official_transcript","official_detail_url":"https://www.supremecourt.gov/oral_arguments/argument_transcript/2023","official_disposition_urls":[],"official_docket_url":"https://www.supremecourt.gov/docket/docketfiles/html/public/22-1219.html","primary_docket":"22-1219","revisions":[{"correction_note":"Rewritten to the concise citizen-facing editorial standard.","created_at":"2026-08-30T16:13:50.308019Z","maturity":"official_transcript","revision_number":1},{"correction_note":"Migrated to the dated official Court activity contract without model use.","created_at":"2026-09-05T03:22:24Z","maturity":"official_transcript","revision_number":2}],"schema_version":"1.1","sections":[{"heading":"What this case is about","paragraphs":["The case tests the Chevron doctrine. This rule lets courts defer to agency interpretations of ambiguous statutes. the sides that brought the case seek to overrule it. the opposing sides seek to preserve it."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 130, lines 9-37","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-1219_4246.pdf","page_label":"file page 130, lines 9-37"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 152, lines 31-45","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-1219_4246.pdf","page_label":"file page 152, lines 31-45"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 4, lines 23-23","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-1219_4246.pdf","page_label":"file page 4, lines 23-23"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 46, lines 17-19","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-1219_4246.pdf","page_label":"file page 46, lines 17-19"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 68, lines 9-35","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-1219_4246.pdf","page_label":"file page 68, lines 9-35"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 76, lines 49-13","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-1219_4246.pdf","page_label":"file page 76, lines 49-13"}]},{"heading":"How the case got here","paragraphs":["The Supreme Court heard oral argument in this case on January 17, 2024."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 130, lines 47-21","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-1219_4246.pdf","page_label":"file page 130, lines 47-21"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 4, lines 11-21","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-1219_4246.pdf","page_label":"file page 4, lines 11-21"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 73, lines 11-35","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-1219_4246.pdf","page_label":"file page 73, lines 11-35"}]},{"heading":"What each side wants","paragraphs":["Relentless wants the Court to overrule Chevron. It seeks independent judicial interpretation of statutes.","The government wants the Court to preserve Chevron. It seeks continued deference to agency expertise."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 130, lines 9-37","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-1219_4246.pdf","page_label":"file page 130, lines 9-37"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 152, lines 31-45","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-1219_4246.pdf","page_label":"file page 152, lines 31-45"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 4, lines 23-23","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-1219_4246.pdf","page_label":"file page 4, lines 23-23"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 46, lines 17-19","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-1219_4246.pdf","page_label":"file page 46, lines 17-19"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 68, lines 9-35","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-1219_4246.pdf","page_label":"file page 68, lines 9-35"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 76, lines 49-13","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-1219_4246.pdf","page_label":"file page 76, lines 49-13"}]},{"heading":"What each side says","paragraphs":["Relentless argues Chevron violates Article III. It claims judges must use independent judgment to interpret law.","The government argues Chevron is a bedrock principle. It claims overruling it requires extraordinary justification."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 130, lines 9-37","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-1219_4246.pdf","page_label":"file page 130, lines 9-37"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 152, lines 31-45","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-1219_4246.pdf","page_label":"file page 152, lines 31-45"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 4, lines 23-23","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2023/22-1219_4246.pdf","page_label":"file page 4, lines 23-23"},{"evidence_type":"Transcript","label"