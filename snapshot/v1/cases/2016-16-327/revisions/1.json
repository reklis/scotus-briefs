al_arguments/argument_transcripts/2016/16-327_d18e.pdf","page_label":"file page 61, lines 22-30"}]},{"heading":"What each side wants","paragraphs":["Lee wants a new trial or a different plea deal.","The government wants to keep the conviction and removal."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 3, lines 18-38","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2016/16-327_d18e.pdf","page_label":"file page 3, lines 18-38"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 33, lines 18-50","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2016/16-327_d18e.pdf","page_label":"file page 33, lines 18-50"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 5, lines 30-34","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2016/16-327_d18e.pdf","page_label":"file page 5, lines 30-34"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 59, lines 22-26","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2016/16-327_d18e.pdf","page_label":"file page 59, lines 22-26"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 63, lines 4-8","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2016/16-327_d18e.pdf","page_label":"file page 63, lines 4-8"}]},{"heading":"What each side says","paragraphs":["Lee argues his lawyer's error forced a bad outcome.","The government argues Lee must prove he would have rejected the plea."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 3, lines 18-38","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2016/16-327_d18e.pdf","page_label":"file page 3, lines 18-38"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript