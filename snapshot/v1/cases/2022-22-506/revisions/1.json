nes 23-15","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2022/22-506_k53l.pdf","page_label":"file page 62, lines 23-15"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 76, lines 39-25","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2022/22-506_k53l.pdf","page_label":"file page 76, lines 39-25"}]},{"heading":"How the case got here","paragraphs":["The Supreme Court heard oral argument in this case on February 28, 2023."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 129, lines 9-21","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2022/22-506_k53l.pdf","page_label":"file page 129, lines 9-21"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 4, lines 11-21","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2022/22-506_k53l.pdf","page_label":"file page 4, lines 11-21"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 73, lines 49-31","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2022/22-506_k53l.pdf","page_label":"file page 73, lines 49-31"}]},{"heading":"What each side wants","paragraphs":["The federal government wants to keep the debt cancellation plan active.","Nebraska wants the Court to block the debt cancellation plan."],"sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 125, lines 51-7","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2022/22-506_k53l.pdf","page_label":"file page 125, lines 51-7"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 131, lines 49-9","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2022/22-506_k53l.pdf","page_label":"file page 131, lines 49-9"},{"evidence_type":"Transcri