 39-25","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2022/22-506_k53l.pdf","page_label":"file page 76, lines 39-25"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 8, lines 25-51","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2022/22-506_k53l.pdf","page_label":"file page 8, lines 25-51"}]}],"caption":"Biden v. Nebraska","case_history":[{"changed_at":"2026-08-29T20:06:16.684698Z","explanation":"An official oral-argument transcript was verified.","status":"argued"},{"changed_at":"2026-08-29T20:06:16.714314Z","explanation":"An official oral-argument transcript was verified.","status":"argued"},{"changed_at":"2026-08-29T20:06:16.717093Z","explanation":"An official oral-argument transcript was verified.","status":"argued"},{"changed_at":"2026-08-29T23:57:23.976271Z","explanation":"An official Court opinion was verified.","status":"decided"}],"case_status":"decided","dek":"The federal government claims pandemic laws let it erase student debt. Nebraska argues Congress must pass a specific law first.","dek_sources":[{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 125, lines 51-7","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2022/22-506_k53l.pdf","page_label":"file page 125, lines 51-7"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 131, lines 49-9","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2022/22-506_k53l.pdf","page_label":"file page 131, lines 49-9"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 4, lines 23-21","official_url":"https://www.supremecourt.gov/oral_arguments/argument_transcripts/2022/22-506_k53l.pdf","page_label":"file page 4, lines 23-21"},{"evidence_type":"Transcript","label":"Official Supreme Court Transcript — file page 62, lines 23-15","official_url":"https://ww